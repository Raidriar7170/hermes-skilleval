+@pytest.mark.parametrize("size", (0, -1))
+@pytest.mark.parametrize("input", ([], iter(("a", "b"))))
+def test_chunks_size_must_be_positive(size, input):
+    with pytest.raises(ValueError, match="size must be positive"):
+        utils.chunks(input, size)
+
+
+def test_chunks_invalid_size_does_not_consume_iterable():
+    consumed = False
+
+    def input():
+        nonlocal consumed
+        consumed = True
+        yield "a"
+
+    with pytest.raises(ValueError, match="size must be positive"):
+        utils.chunks(input(), 0)
+    assert consumed is False
+
+
+def test_chunks_positive_size_remains_lazy():
+    consumed = False
+
+    def input():
+        nonlocal consumed
+        consumed = True
+        yield from ("a", "b")
+
+    chunks = utils.chunks(input(), 2)
+    assert consumed is False
+    assert list(map(list, chunks)) == [["a", "b"]]
+
+
