diff --git a/tests/test_convert/test_geojs.py b/tests/test_convert/test_geojs.py
new file mode 100644
index 0000000000000000000000000000000000000000..526edf27372593535012df18a905c91cc269180a
--- /dev/null
+++ b/tests/test_convert/test_geojs.py
@@ -0,0 +1,24 @@
+import io
+import unittest
+
+from csvkit.convert.geojs import geojson2csv
+
+
+class TestGeoJSON(unittest.TestCase):
+
+    def test_null_properties(self):
+        with open('examples/assist_null_properties.json') as f:
+            output = geojson2csv(f)
+
+        reader = io.StringIO(output)
+        self.assertEqual(reader.readline(), 'id,name,count,metadata,geojson,type,longitude,latitude\n')
+        self.assertEqual(
+            reader.readline(),
+            'null-point,,,,"{""type"": ""Point"", ""coordinates"": [12.5, -4.25]}",Point,12.5,-4.25\n',
+        )
+        self.assertEqual(
+            reader.readline(),
+            'normal-point,kept,2,"{""active"": true}",'
+            '"{""type"": ""Point"", ""coordinates"": [1, 2]}",Point,1,2\n',
+        )
+        self.assertEqual(reader.read(), '')
