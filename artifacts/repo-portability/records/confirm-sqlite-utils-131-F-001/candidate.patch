+@pytest.mark.parametrize("command", ("insert", "upsert"))
+@pytest.mark.parametrize("table_exists", (False, True))
+def test_insert_upsert_explicit_types(db_path, command, table_exists):
+    db = Database(db_path)
+    if table_exists:
+        db["data"].create(
+            {
+                "id": str,
+                "as_text": str,
+                "as_integer": str,
+                "as_float": str,
+                "as_blob": str,
+            },
+            pk="id",
+        )
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            command,
+            db_path,
+            "data",
+            "-",
+            "--csv",
+            "--pk",
+            "id",
+            "--type",
+            "as_text",
+            "text",
+            "--type",
+            "as_integer",
+            "integer",
+            "--type",
+            "as_float",
+            "float",
+            "--type",
+            "as_blob",
+            "blob",
+        ],
+        catch_exceptions=False,
+        input="id,as_text,as_integer,as_float,as_blob\n1,123,42,5,hello",
+    )
+    assert result.exit_code == 0, result.output
+    assert db["data"].columns_dict == {
+        "id": str if table_exists else int,
+        "as_text": str,
+        "as_integer": int,
+        "as_float": float,
+        "as_blob": bytes,
+    }
+
+
+def test_explicit_types_with_no_detect_types(db_path):
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "data",
+            "-",
+            "--csv",
+            "--no-detect-types",
+            "--type",
+            "value",
+            "integer",
+        ],
+        catch_exceptions=False,
+        input="id,value\n1,42",
+    )
+    assert result.exit_code == 0, result.output
+    assert Database(db_path)["data"].columns_dict == {"id": str, "value": int}
+
+
+def test_explicit_type_rejects_unsupported_type(db_path):
+    result = CliRunner().invoke(
+        cli.cli,
+        ["insert", db_path, "data", "-", "--type", "id", "varchar"],
+        input='{"id": 1}',
+    )
+    assert result.exit_code == 2
+    assert "Invalid value for '--type'" in result.output
+    assert "varchar" in result.output
+
+
