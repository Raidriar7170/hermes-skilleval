diff --git a/tests/test_utilities/test_csvpy.py b/tests/test_utilities/test_csvpy.py
new file mode 100644
index 0000000000000000000000000000000000000000..b643e3e1e0b8b846b0e4613655c3c2cfc5f4fe32
--- /dev/null
+++ b/tests/test_utilities/test_csvpy.py
@@ -0,0 +1,35 @@
+import code
+import csv
+import os
+import tempfile
+from unittest.mock import patch
+
+from csvkit.utilities.csvpy import CSVPy
+from tests.utils import CSVKitTestCase
+
+
+class TestCSVPy(CSVKitTestCase):
+    Utility = CSVPy
+
+    def test_dict_field_size_limit(self):
+        default_limit = csv.field_size_limit()
+        value = 'a' * (default_limit + 1)
+
+        try:
+            with tempfile.TemporaryDirectory() as directory:
+                path = os.path.join(directory, 'test.csv')
+                with open(path, 'w', newline='') as f:
+                    f.write(f'header\n{value}\n')
+
+                def interact_with_reader(*args, **kwargs):
+                    reader = kwargs['local']['reader']
+                    self.assertEqual(next(reader), {'header': value})
+
+                with patch.dict('sys.modules', {'IPython.frontend.terminal.embed': None}), \
+                        patch.object(code, 'interact', side_effect=interact_with_reader) as interact:
+                    utility = self.Utility(['--dict', '-z', str(len(value)), path])
+                    utility.run()
+
+                interact.assert_called_once()
+        finally:
+            csv.field_size_limit(default_limit)
