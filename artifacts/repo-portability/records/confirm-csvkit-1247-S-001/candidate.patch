 import unittest
+from decimal import Decimal
 
-from csvkit.cli import match_column_identifier, parse_column_identifiers
+from csvkit.cli import default_float_decimal, default_str_decimal, match_column_identifier, parse_column_identifiers
 
 
 class TestCli(unittest.TestCase):
 
+    def test_json_serialization_helpers(self):
+        values = [
+            datetime.date(2020, 1, 2),
+            Decimal('1.5'),
+            datetime.timedelta(0),
+            datetime.timedelta(days=-1, seconds=86398, microseconds=500000),
+            datetime.timedelta(seconds=60, microseconds=250000),
+        ]
+
+        self.assertEqual(
+            json.loads(json.dumps(values, default=default_str_decimal)),
+            ['2020-01-02', '1.5', 0.0, -1.5, 60.25],
+        )
+        self.assertEqual(
+            json.loads(json.dumps(values, default=default_float_decimal)),
+            ['2020-01-02', 1.5, 0.0, -1.5, 60.25],
+        )
+
     def setUp(self):
         self.headers = ['id', 'name', 'i_work_here', '1', 'more-header-values', 'stuff', 'blueberry']
 
