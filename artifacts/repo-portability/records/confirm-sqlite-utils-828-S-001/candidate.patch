+def test_fts_tokenize_escaped(fresh_db):
+    table = fresh_db["articles"]
+    table.insert({"text": "hello"})
+    with pytest.raises(sqlite3.OperationalError):
+        table.enable_fts(
+            ["text"],
+            tokenize="porter'); CREATE TABLE injected (id INTEGER); /*",
+        )
+    assert fresh_db.table_names() == ["articles"]
+    assert list(table.rows) == [{"text": "hello"}]
