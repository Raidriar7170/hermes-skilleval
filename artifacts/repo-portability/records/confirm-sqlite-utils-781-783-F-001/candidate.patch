+    table = db["data"]
+    table.insert({"team": "A", "person": "1", "name": "Alice"})
+
+    table.insert_all(
+        iter((("team", "person", "name"), ("A", "1", "Ignored"))),
+        ignore=True,
+    )
+
+    assert table.last_pk == ("A", "1")
+    assert table.last_rowid == 1
