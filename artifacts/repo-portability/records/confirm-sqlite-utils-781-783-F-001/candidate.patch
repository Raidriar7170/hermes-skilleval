@@ -1008,6 +1008,63 @@ def test_insert_ignore_with_pk_after_other_table_insert(fresh_db):
     assert list(fresh_db["users"].rows) == [user]
 
 
+def test_insert_ignore_uses_existing_table_primary_key(fresh_db):
+    fresh_db.execute("create table docs (id integer primary key, title text)")
+    table = fresh_db["docs"]
+    table.insert({"id": 1, "title": "Exists"})
+
+    table.insert({"id": 1, "title": "Ignored"}, ignore=True)
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+
+
+@pytest.mark.parametrize("without_rowid", (False, True))
+def test_insert_ignore_compound_primary_key(fresh_db, without_rowid):
+    fresh_db.execute(
+        "create table memberships (team text, person text, role text, "
+        "primary key (team, person)){}".format(
+            " without rowid" if without_rowid else ""
+        )
+    )
+    table = fresh_db["memberships"]
+    table.insert({"team": "A", "person": "Cleo", "role": "member"})
+
+    table.insert(
+        {"team": "A", "person": "Cleo", "role": "ignored"}, ignore=True
+    )
+
+    assert table.last_pk == ("A", "Cleo")
+    assert table.last_rowid == (None if without_rowid else 1)
+
+
+def test_insert_ignore_hash_id(fresh_db):
+    table = fresh_db["dogs"]
+    record = {"name": "Cleo", "twitter": "cleopaws"}
+    expected_hash = table.insert(record, hash_id="id").last_pk
+
+    table.insert(record, hash_id="id", ignore=True)
+
+    assert table.last_pk == expected_hash
+    assert table.last_rowid == 1
+
+
+def test_insert_ignore_unresolvable_conflict_leaves_identifiers_unset(fresh_db):
+    fresh_db.execute(
+        "create table users (id integer primary key, email text unique, name text)"
+    )
+    table = fresh_db["users"]
+    table.insert({"id": 1, "email": "cleopaws@example.com", "name": "Cleo"})
+
+    table.insert(
+        {"id": 2, "email": "cleopaws@example.com", "name": "Ignored"},
+        ignore=True,
+    )
+
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
