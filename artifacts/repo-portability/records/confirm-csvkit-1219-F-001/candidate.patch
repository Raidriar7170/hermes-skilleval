diff --git a/tests/test_utilities/test_csvpy.py b/tests/test_utilities/test_csvpy.py
new file mode 100644
index 0000000000000000000000000000000000000000..ab2f3c7cfe305501d279cb65d3a7143c1136fa7c
--- /dev/null
+++ b/tests/test_utilities/test_csvpy.py
@@ -0,0 +1,26 @@
+import csv
+import tempfile
+from unittest.mock import patch
+
+from csvkit.utilities.csvpy import CSVPy
+from tests.utils import CSVKitTestCase
+
+
+class TestCSVPy(CSVKitTestCase):
+    Utility = CSVPy
+
+    def test_dict_maxfieldsize(self):
+        old_limit = csv.field_size_limit()
+        self.addCleanup(csv.field_size_limit, old_limit)
+        value = 'a' * (old_limit + 1)
+
+        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8') as f:
+            f.write('column\n')
+            f.write(f'{value}\n')
+            f.flush()
+
+            def interact(message, local):
+                self.assertEqual(next(local['reader']), {'column': value})
+
+            with patch('code.interact', side_effect=interact):
+                self.Utility(['--dict', '-z', str(len(value)), f.name]).run()
