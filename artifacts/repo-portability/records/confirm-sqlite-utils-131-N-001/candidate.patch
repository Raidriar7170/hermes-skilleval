+@pytest.mark.parametrize("command", ("insert", "upsert"))
+@pytest.mark.parametrize("existing", (False, True))
+def test_insert_upsert_explicit_types_override_detected_types(
+    db_path, command, existing
+):
+    db = Database(db_path)
+    if existing:
+        db["data"].create(
+            {"id": str, "score": str, "count": str, "payload": str}, pk="id"
+        )
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            command,
+            db_path,
+            "data",
+            "-",
+            "--csv",
+            "--pk",
+            "id",
+            "--type",
+            "id",
+            "text",
+            "--type",
+            "score",
+            "float",
+            "--type",
+            "count",
+            "integer",
+            "--type",
+            "payload",
+            "blob",
+        ],
+        catch_exceptions=False,
+        input="id,score,count,payload\n001,10,3.5,hello",
+    )
+    assert result.exit_code == 0, result.output
+    assert db["data"].columns_dict == {
+        "id": str,
+        "score": float,
+        "count": int,
+        "payload": bytes,
+    }
+    assert list(db["data"].rows) == [
+        {"id": "001", "score": 10.0, "count": 3.5, "payload": "hello"}
+    ]
+
+
+@pytest.mark.parametrize("command", ("insert", "upsert"))
+def test_insert_upsert_explicit_types_with_no_detect_types(db_path, command):
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            command,
+            db_path,
+            "data",
+            "-",
+            "--csv",
+            "--pk",
+            "id",
+            "--no-detect-types",
+            "--type",
+            "id",
+            "integer",
+        ],
+        catch_exceptions=False,
+        input="id,name\n1,Cleo",
+    )
+    assert result.exit_code == 0, result.output
+    db = Database(db_path)
+    assert db["data"].columns_dict == {"id": int, "name": str}
+    assert list(db["data"].rows) == [{"id": 1, "name": "Cleo"}]
+
