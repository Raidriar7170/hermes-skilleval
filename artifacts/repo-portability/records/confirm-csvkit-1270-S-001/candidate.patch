@@ -358,20 +358,36 @@ class CSVKitUtility:
             if getattr(self.args, 'out_quoting', None) == 2:  # QUOTE_NONUMERIC
                 types = [number_type, text_type]
             else:
-                # See the order in the `agate.TypeTester` class.
-                types = [
-                    agate.Boolean(**type_kwargs),
-                    agate.TimeDelta(**type_kwargs),
-                    agate.Date(date_format=self.args.date_format, **type_kwargs),
-                    agate.DateTime(datetime_format=self.args.datetime_format, **type_kwargs),
-                    text_type,
-                ]
-
-                # In order to parse dates like "20010101".
                 if self.args.date_format or self.args.datetime_format:
-                    types.insert(-1, number_type)
+                    # Prefer explicitly configured date and datetime formats to
+                    # numbers, so that formats like "%Y%m%d" continue to work.
+                    # Prefer numbers to temporal types using their default
+                    # parsers, which can otherwise interpret values like "5.5".
+                    types = [agate.Boolean(**type_kwargs), agate.TimeDelta(**type_kwargs)]
+
+                    if self.args.date_format:
+                        types.append(agate.Date(date_format=self.args.date_format, **type_kwargs))
+                    if self.args.datetime_format:
+                        types.append(agate.DateTime(datetime_format=self.args.datetime_format, **type_kwargs))
+
+                    types.append(number_type)
+
+                    if not self.args.date_format:
+                        types.append(agate.Date(**type_kwargs))
+                    if not self.args.datetime_format:
+                        types.append(agate.DateTime(**type_kwargs))
+
+                    types.append(text_type)
                 else:
-                    types.insert(1, number_type)
+                    # See the order in the `agate.TypeTester` class.
+                    types = [
+                        agate.Boolean(**type_kwargs),
+                        number_type,
+                        agate.TimeDelta(**type_kwargs),
+                        agate.Date(**type_kwargs),
+                        agate.DateTime(**type_kwargs),
+                        text_type,
+                    ]
 
         return agate.TypeTester(types=types)
 
