+@pytest.mark.parametrize("command", ("insert", "upsert"))
+def test_csv_type_overrides_detected_types(db_path, command):
+    args = [
+        command,
+        db_path,
+        "measurements",
+        "-",
+        "--csv",
+        "--type",
+        "id",
+        "TEXT",
+        "--type",
+        "score",
+        "float",
+        "--type",
+        "count",
+        "integer",
+        "--type",
+        "payload",
+        "blob",
+    ]
+    if command == "upsert":
+        args.extend(("--pk", "id"))
+    result = CliRunner().invoke(
+        cli.cli,
+        args,
+        catch_exceptions=False,
+        input="id,score,count,payload\n001,2,3,hello",
+    )
+    assert result.exit_code == 0, result.output
+    db = Database(db_path)
+    assert db["measurements"].columns_dict == {
+        "id": str,
+        "score": float,
+        "count": int,
+        "payload": bytes,
+    }
+    assert list(db["measurements"].rows) == [
+        {"id": "001", "score": 2.0, "count": 3, "payload": "hello"}
+    ]
+
+
+def test_type_override_with_no_detect_types(db_path):
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "measurements",
+            "-",
+            "--csv",
+            "--no-detect-types",
+            "--type",
+            "score",
+            "float",
+        ],
+        catch_exceptions=False,
+        input="id,score\n001,2",
+    )
+    assert result.exit_code == 0, result.output
+    db = Database(db_path)
+    assert db["measurements"].columns_dict == {"id": str, "score": float}
+    assert list(db["measurements"].rows) == [{"id": "001", "score": 2.0}]
+
+
+@pytest.mark.parametrize("command", ("insert", "upsert"))
+def test_type_override_existing_table(db_path, command):
+    db = Database(db_path)
+    db["measurements"].insert({"id": 1, "score": "1.5"}, pk="id")
+    db["measurements"].create_index(["score"])
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            command,
+            db_path,
+            "measurements",
+            "-",
+            "--csv",
+            "--pk",
+            "id",
+            "--type",
+            "score",
+            "float",
+        ],
+        catch_exceptions=False,
+        input=("id,score\n2,2.5" if command == "insert" else "id,score\n1,2.5"),
+    )
+    assert result.exit_code == 0, result.output
+    assert db["measurements"].columns_dict == {"id": int, "score": float}
+    assert db["measurements"].indexes[0].columns == ["score"]
+    expected = (
+        [{"id": 1, "score": 2.5}]
+        if command == "upsert"
+        else [{"id": 1, "score": 1.5}, {"id": 2, "score": 2.5}]
+    )
+    assert list(db["measurements"].rows) == expected
+
+
+@pytest.mark.parametrize("command", ("insert", "upsert"))
+def test_type_override_rejects_unsupported_type(tmpdir, command):
+    db_path = str(tmpdir / "invalid.db")
+    result = CliRunner().invoke(
+        cli.cli,
+        [command, db_path, "data", "-", "--type", "id", "real"],
+        input='{"id": 1}',
+    )
+    assert result.exit_code == 2
+    assert "is not one of 'text', 'integer', 'float', 'blob'" in result.output
+
