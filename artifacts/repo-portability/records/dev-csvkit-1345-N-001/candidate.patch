diff --git a/tests/test_convert/test_convert.py b/tests/test_convert/test_convert.py
index eb17845f3c026ec1394c6436d1ec9863c4f21511..0a7d2f49dbfe30c0c21a0639947b0d798f1207a2 100644
--- a/tests/test_convert/test_convert.py
+++ b/tests/test_convert/test_convert.py
@@ -26,5 +26,15 @@ class TestConvert(unittest.TestCase):
     def test_guess_json(self):
         self.assertEqual('json', convert.guess_format('testdata.json'))
 
+    def test_guess_ndjson(self):
+        for extension in ('ndjson', 'jsonl', 'jl'):
+            with self.subTest(extension=extension):
+                self.assertEqual('ndjson', convert.guess_format(f'testdata.{extension}'))
+
+    def test_guess_ndjson_uppercase(self):
+        for extension in ('NDJSON', 'JSONL', 'JL'):
+            with self.subTest(extension=extension):
+                self.assertEqual('ndjson', convert.guess_format(f'testdata.{extension}'))
+
     def test_guess_invalid(self):
         self.assertEqual(None, convert.guess_format('testdata.invalid'))
