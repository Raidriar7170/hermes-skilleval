+
+
+def test_upsert_rowid_primary_key(db_path):
+    db = Database(db_path)
+    db["t"].insert({"title": "Hello"})
+
+    result = CliRunner().invoke(
+        cli.cli,
+        ["upsert", db_path, "t", "-", "--pk", "rowid"],
+        input='{"rowid": 1, "title": "Updated"}',
