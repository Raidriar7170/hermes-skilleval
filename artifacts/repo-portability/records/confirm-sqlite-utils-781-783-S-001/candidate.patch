@@ -1,4 +1,4 @@
-from sqlite_utils.db import PrimaryKeyRequired
+from sqlite_utils.db import InvalidColumns, PrimaryKeyRequired
 from sqlite_utils import Database
 import pytest
 
@@ -13,6 +13,41 @@ def test_upsert(use_old_upsert):
     assert table.last_pk == 1
 
 
+@pytest.mark.parametrize("use_old_upsert", (False, True))
+@pytest.mark.parametrize("rowid_alias", ("rowid", "_rowid_", "oid", "ROWID"))
+def test_upsert_rowid_alias(use_old_upsert, rowid_alias):
+    db = Database(memory=True, use_old_upsert=use_old_upsert)
+    table = db["t"]
+    table.insert({"title": "Hello"})
+    schema_before = table.schema
+    indexes_before = table.indexes
+
+    table.upsert({rowid_alias: 1, "title": "Updated"}, pk=rowid_alias)
+
+    assert list(db.query("select rowid, * from t")) == [
+        {"rowid": 1, "title": "Updated"}
+    ]
+    assert table.last_pk == 1
+    assert table.schema == schema_before
+    assert table.indexes == indexes_before
+
+
+def test_upsert_rowid_alias_rejected_without_rowid(fresh_db):
+    fresh_db.execute(
+        "create table t (id text primary key, title text) without rowid"
+    )
+    table = fresh_db["t"]
+    table.insert({"id": "one", "title": "Original"})
+    schema_before = table.schema
+
+    with pytest.raises(InvalidColumns, match="Invalid primary key column"):
+        table.upsert({"rowid": 1, "title": "Updated"}, pk="rowid")
+
+    assert list(table.rows) == [{"id": "one", "title": "Original"}]
+    assert table.schema == schema_before
+    assert not fresh_db.conn.in_transaction
+
+
