+    assert table.last_rowid == 1
     assert list(fresh_db["users"].rows) == [user]
 
 
+def test_insert_ignore_infers_existing_primary_key(fresh_db):
+    fresh_db.execute("create table docs (id integer primary key, title text)")
+    table = fresh_db["docs"]
+    table.insert({"id": 1, "title": "Exists"}, pk="id")
+
+    table.insert({"id": 1, "title": "Ignored"}, ignore=True)
+
+    assert table.last_rowid == 1
+    assert table.last_pk == 1
+    assert list(table.rows) == [{"id": 1, "title": "Exists"}]
+
+
+def test_insert_ignore_compound_primary_key(fresh_db):
+    table = fresh_db["items"]
+    table.insert(
+        {"kind": "book", "slug": "one", "title": "Exists"},
+        pk=("kind", "slug"),
+    )
+
+    table.insert(
+        {"kind": "book", "slug": "one", "title": "Ignored"}, ignore=True
+    )
+
+    assert table.last_rowid == 1
+    assert table.last_pk == ("book", "one")
+    assert list(table.rows) == [
+        {"kind": "book", "slug": "one", "title": "Exists"}
+    ]
+
+
+def test_insert_ignore_hash_id(fresh_db):
+    table = fresh_db["dogs"]
+    record = {"name": "Cleo", "twitter": "cleopaws"}
+    expected_hash = table.insert(record, hash_id="id").last_pk
+
+    table.insert(record, hash_id="id", ignore=True)
+
+    assert table.last_rowid == 1
+    assert table.last_pk == expected_hash
+    assert table.count == 1
+
+
+def test_insert_ignore_unresolvable_conflict_leaves_identifiers_unset(fresh_db):
+    fresh_db.execute(
+        "create table users (id integer primary key, username text unique)"
+    )
+    table = fresh_db["users"]
+    table.insert({"id": 1, "username": "cleopaws"})
+
+    table.insert({"id": 2, "username": "cleopaws"}, ignore=True)
+
+    assert table.last_rowid is None
+    assert table.last_pk is None
+    assert list(table.rows) == [{"id": 1, "username": "cleopaws"}]
+
+
+def test_insert_ignore_without_rowid_resolves_primary_key_only(fresh_db):
+    fresh_db.execute(
+        "create table items "
+        "(kind text, slug text, primary key (kind, slug)) without rowid"
+    )
+    table = fresh_db["items"]
+    table.insert({"kind": "book", "slug": "one"})
+
+    table.insert({"kind": "book", "slug": "one"}, ignore=True)
+
+    assert table.last_rowid is None
+    assert table.last_pk == ("book", "one")
+
+
+@pytest.mark.parametrize("rowid_alias", ("rowid", "_rowid_", "oid"))
+def test_insert_ignore_infers_rowid_alias(fresh_db, rowid_alias):
+    table = fresh_db["items"]
+    table.insert({"title": "Exists"})
+
+    table.insert({rowid_alias: 1, "title": "Ignored"}, ignore=True)
+
+    assert table.last_rowid == 1
+    assert table.last_pk == 1
+    assert list(fresh_db.query("select rowid, * from items")) == [
+        {"rowid": 1, "title": "Exists"}
+    ]
+
+
