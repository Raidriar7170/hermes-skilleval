@@ -286,3 +286,24 @@ def test_list_mode_single_record_upsert_last_pk():
 
     # Verify last_pk is populated correctly
     assert table.last_pk == 1
+
+
+def test_list_mode_single_ignored_record_identifiers():
+    db = Database(memory=True)
+    table = db["data"]
+    table.insert(
+        {"kind": "book", "slug": "one", "value": "Exists"},
+        pk=("kind", "slug"),
+    )
+
+    def ignored_data():
+        yield ["kind", "slug", "value"]
+        yield ["book", "one", "Ignored"]
+
+    table.insert_all(ignored_data(), pk=("kind", "slug"), ignore=True)
+
+    assert table.last_rowid == 1
+    assert table.last_pk == ("book", "one")
+    assert list(table.rows) == [
+        {"kind": "book", "slug": "one", "value": "Exists"}
+    ]
