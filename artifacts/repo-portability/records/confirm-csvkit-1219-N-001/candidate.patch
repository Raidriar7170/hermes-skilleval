+            with tempfile.TemporaryDirectory() as dirname:
+                path = os.path.join(dirname, 'large.csv')
+
+                with open(path, 'w', newline='') as f:
+                    writer = csv.writer(f)
+                    writer.writerow(['a'])
+                    writer.writerow([field])
+
+                self.assertRows(['--maxfieldsize', str(len(field)), path], [
