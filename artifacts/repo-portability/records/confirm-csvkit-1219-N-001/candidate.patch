--- /dev/null
+++ b/tests/test_utilities/test_csvpy.py
@@ -0,0 +1,24 @@
+import csv
+import unittest
+from unittest.mock import patch
+
+from csvkit.utilities.csvpy import CSVPy
+
+
+class TestCSVPy(unittest.TestCase):
+
+    def test_dict_field_size_limit(self):
+        previous_limit = csv.field_size_limit()
+        rows = []
+
+        def interact(banner, local):
+            rows.extend(local['reader'])
+
+        try:
+            with patch.dict('sys.modules', {'IPython.frontend.terminal.embed': None}):
+                with patch('code.interact', side_effect=interact):
+                    CSVPy(['--dict', '-z', '1024', 'examples/dummy.csv']).run()
+        finally:
+            csv.field_size_limit(previous_limit)
+
+        self.assertEqual(rows, [{'a': '1', 'b': '2', 'c': '3'}])
