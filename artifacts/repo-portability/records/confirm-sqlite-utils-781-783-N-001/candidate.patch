+    def _is_hidden_rowid_alias(self, column: str) -> bool:
+        """Is column an unshadowed alias for this table's hidden rowid?"""
+        if fold_identifier_case(column) not in {"rowid", "_rowid_", "oid"}:
+            return False
+        if re.search(r"\bWITHOUT\s+ROWID\b", self.schema, re.IGNORECASE):
+            return False
+        return resolve_casing(column, self.columns_dict) not in self.columns_dict
+
+    def _hidden_rowid_alias(self) -> Optional[str]:
+        """Return an unshadowed name that can be used to select the hidden rowid."""
+        for alias in ("rowid", "_rowid_", "oid"):
+            if self._is_hidden_rowid_alias(alias):
+                return alias
+        return None
+
+    def _set_last_identifiers_for_ignored_insert(
+        self,
+        record: Dict[str, Any],
+        pk: Optional[Any],
+        hash_id: Optional[str],
+        hash_id_columns: Optional[Iterable[str]],
+    ) -> None:
+        """Populate last_rowid and last_pk if the ignored row can be found."""
+        if hash_id:
+            pk_columns = [hash_id]
+            pk_values = [hash_record(record, hash_id_columns)]
+        else:
+            if pk:
+                pk_columns = [pk] if isinstance(pk, str) else list(pk)
+            else:
+                pk_columns = [column.name for column in self.columns if column.is_pk]
+                if not pk_columns:
+                    # An implicit rowid can only identify the existing row if
+                    # the record supplied one of its unshadowed aliases.
+                    pk_columns = [
+                        column
+                        for column in record
+                        if self._is_hidden_rowid_alias(column)
+                    ][:1]
+                    if not pk_columns:
+                        return
+            try:
+                record_pk_columns = [
+                    resolve_casing(column, record) for column in pk_columns
+                ]
+                pk_values = [record[column] for column in record_pk_columns]
+            except KeyError:
+                return
+
+        select_parts = []
+        rowid_alias = self._hidden_rowid_alias()
+        if rowid_alias:
+            select_parts.append(
+                "{} as {}".format(
+                    quote_identifier(rowid_alias),
+                    quote_identifier("_sqlite_utils_rowid"),
+                )
+            )
+        select_parts.extend(
+            "{} as {}".format(
+                quote_identifier(column),
+                quote_identifier("_sqlite_utils_pk_{}".format(index)),
+            )
+            for index, column in enumerate(pk_columns)
+        )
+        where = " AND ".join(
+            "{} IS ?".format(quote_identifier(column)) for column in pk_columns
+        )
+        row = self.db.execute(
+            "SELECT {} FROM {} WHERE {} LIMIT 1".format(
+                ", ".join(select_parts), quote_identifier(self.name), where
+            ),
+            pk_values,
+        ).fetchone()
+        if row is None:
+            return
+        offset = 0
+        if rowid_alias:
+            self.last_rowid = row[0]
+            offset = 1
+        resolved_pk = tuple(row[offset:])
+        self.last_pk = resolved_pk[0] if len(resolved_pk) == 1 else resolved_pk
+
