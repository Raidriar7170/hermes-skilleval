@@ -13,6 +13,19 @@ def test_upsert(use_old_upsert):
     assert table.last_pk == 1
 
 
+@pytest.mark.parametrize("use_old_upsert", (False, True))
+@pytest.mark.parametrize("rowid_alias", ("rowid", "_rowid_", "oid"))
+def test_upsert_rowid_alias(use_old_upsert, rowid_alias):
+    db = Database(memory=True, use_old_upsert=use_old_upsert)
+    table = db["table"]
+    table.insert({"name": "Cleo"})
+
+    table.upsert({rowid_alias: 1, "name": "Nixie"}, pk=rowid_alias)
+
+    assert list(table.rows) == [{"name": "Nixie"}]
+    assert table.last_pk == 1
+
+
