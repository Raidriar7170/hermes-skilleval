diff --git a/tests/test_create.py b/tests/test_create.py
index 42fa1c4222e2597a6a303480eb1b71841f924ddc..5d175e91dbcee9108fd9205cab66b7d68bb926fc 100644
--- a/tests/test_create.py
+++ b/tests/test_create.py
@@ -1008,6 +1008,81 @@ def test_insert_ignore_with_pk_after_other_table_insert(fresh_db):
     assert list(fresh_db["users"].rows) == [user]
 
 
+def test_insert_ignore_infers_existing_primary_key(fresh_db):
+    fresh_db.execute("create table docs (id integer primary key, title text)")
+    table = fresh_db["docs"]
+    table.insert({"id": 1, "title": "Exists"}, pk="id")
+
+    table.insert({"id": 1, "title": "Ignored"}, ignore=True)
+
+    assert table.last_rowid == 1
+    assert table.last_pk == 1
+
+
+def test_insert_ignore_resolves_compound_primary_key(fresh_db):
+    table = fresh_db["items"]
+    table.insert(
+        {"category": "dog", "id": 1, "name": "Cleo"},
+        pk=("category", "id"),
+    )
+
+    table.insert({"category": "dog", "id": 1, "name": "Ignored"}, ignore=True)
+
+    assert table.last_rowid == 1
+    assert table.last_pk == ("dog", 1)
+
+
+def test_insert_ignore_resolves_hash_id(fresh_db):
+    table = fresh_db["items"]
+    table.insert({"name": "Cleo"}, hash_id="id")
+    expected_hash = table.last_pk
+
+    table.insert({"name": "Cleo"}, hash_id="id", ignore=True)
+
+    assert table.last_rowid == 1
+    assert table.last_pk == expected_hash
+
+
+@pytest.mark.parametrize("rowid_alias", ("rowid", "_rowid_", "oid"))
+def test_insert_ignore_resolves_rowid_alias(fresh_db, rowid_alias):
+    table = fresh_db["items"]
+    table.insert({"name": "Cleo"})
+
+    table.insert(
+        {rowid_alias: 1, "name": "Ignored"},
+        pk=rowid_alias,
+        ignore=True,
+    )
+
+    assert table.last_rowid == 1
+    assert table.last_pk == 1
+
+
+def test_insert_ignore_unresolvable_conflict_leaves_identifiers_unset(fresh_db):
+    fresh_db.execute("create table items (id integer primary key, name text unique)")
+    table = fresh_db["items"]
+    table.insert({"id": 1, "name": "Cleo"})
+
+    table.insert({"id": 2, "name": "Cleo"}, ignore=True)
+
+    assert table.last_rowid is None
+    assert table.last_pk is None
+
+
+def test_insert_ignore_without_rowid_resolves_primary_key(fresh_db):
+    fresh_db.execute(
+        "create table items (category text, id integer, name text, "
+        "primary key (category, id)) without rowid"
+    )
+    table = fresh_db["items"]
+    table.insert({"category": "dog", "id": 1, "name": "Cleo"})
+
+    table.insert({"category": "dog", "id": 1, "name": "Ignored"}, ignore=True)
+
+    assert table.last_rowid is None
+    assert table.last_pk == ("dog", 1)
+
+
 def test_insert_hash_id(fresh_db):
     dogs = fresh_db["dogs"]
     id = dogs.insert({"name": "Cleo", "twitter": "cleopaws"}, hash_id="id").last_pk
