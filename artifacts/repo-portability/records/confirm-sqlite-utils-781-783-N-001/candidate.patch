+def test_list_mode_single_ignored_insert_compound_identifiers():
+    db = Database(memory=True)
+    db.execute(
+        "create table data (kind text, id integer, name text, "
+        "primary key (kind, id))"
+    )
+    table = db["data"]
+    table.insert({"kind": "person", "id": 1, "name": "Alice"})
+
+    table.insert_all(
+        (["kind", "id", "name"], ["person", 1, "Ignored"]),
+        ignore=True,
+    )
+
+    assert table.last_rowid == 1
+    assert table.last_pk == ("person", 1)
