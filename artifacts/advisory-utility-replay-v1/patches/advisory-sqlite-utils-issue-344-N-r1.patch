+++ b/tests/test_create.py
@@ -60,6 +60,29 @@ def test_create_table(fresh_db):
     ) == table.schema
 
 
+def test_create_strict_table(fresh_db):
+    table = fresh_db["strict_table"].create(
+        {"id": int, "name": str, "rating": float}, pk="id", strict=True
+    )
+    assert table.schema == (
+        "CREATE TABLE [strict_table] (\n"
+        "   [id] INTEGER PRIMARY KEY,\n"
+        "   [name] TEXT,\n"
+        "   [rating] REAL\n"
+        ") STRICT"
+    )
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"id": 1, "name": "Cleo", "rating": "not a number"})
+
+
+def test_insert_creates_strict_table(fresh_db):
+    table = fresh_db["strict_table"].insert(
+        {"id": 1, "name": "Cleo", "rating": 4.5}, pk="id", strict=True
+    )
+    assert table.schema.endswith(") STRICT")
+    assert table.columns_dict == {"id": int, "name": str, "rating": float}
+
+
