+@pytest.mark.skipif(
+    sqlite3.sqlite_version_info < (3, 37, 0), reason="STRICT tables require SQLite 3.37"
+)
+def test_create_table_strict(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table",
+        {"id": int, "name": str, "score": float, "data": bytes, "other": "ANY"},
+        pk="id",
+        strict=True,
+    )
+    assert table.strict
+    assert table.schema == (
+        "CREATE TABLE [strict_table] (\n"
+        "   [id] INTEGER PRIMARY KEY,\n"
+        "   [name] TEXT,\n"
+        "   [score] REAL,\n"
+        "   [data] BLOB,\n"
+        "   [other] ANY\n"
+        ") STRICT"
+    )
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert(
+            {"id": 1, "name": b"not text", "score": 1.5, "data": b"", "other": 1}
+        )
+
+
+@pytest.mark.skipif(
+    sqlite3.sqlite_version_info < (3, 37, 0), reason="STRICT tables require SQLite 3.37"
+)
+def test_insert_strict_and_transform_preserves_strict(fresh_db):
+    table = fresh_db["strict_table"].insert(
+        {"id": 1, "name": "one", "score": 1.5, "other": "1"},
+        pk="id",
+        columns={"other": "ANY"},
+        strict=True,
+    )
+    assert table.strict
+    assert "[score] REAL" in table.schema
+    table.transform(rename={"name": "title"})
+    assert table.strict
+    assert "[other] ANY" in table.schema
+    assert table.get(1) == {"id": 1, "title": "one", "score": 1.5, "other": "1"}
+
+
