+        result = runner.invoke(
+            cli.cli,
+            [
+                "create-table",
+                "test.db",
+                "t",
+                "id",
+                "integer",
+                "rating",
+                "float",
+                "extra",
+                "any",
+                "--strict",
+            ],
+            catch_exceptions=False,
+        )
+        assert 0 == result.exit_code
+        table = Database("test.db")["t"]
+        assert table.strict
+        assert table.schema.endswith(") STRICT")
+        assert "[rating] REAL" in table.schema
+        assert "[extra] ANY" in table.schema
+
