+@pytest.mark.skipif(
+    sqlite3.sqlite_version_info < (3, 37), reason="STRICT requires SQLite 3.37+"
+)
+def test_create_strict_table(fresh_db):
+    table = fresh_db["strict_table"].create(
+        {"id": int, "name": str, "rating": float, "metadata": "ANY"},
+        pk="id",
+        strict=True,
+    )
+    assert table.strict
+    assert (
+        "CREATE TABLE [strict_table] (\n"
+        "   [id] INTEGER PRIMARY KEY,\n"
+        "   [name] TEXT,\n"
+        "   [rating] REAL,\n"
+        "   [metadata] ANY\n"
+        ") STRICT"
+    ) == table.schema
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"id": 1, "name": b"not text"})
+
+
+@pytest.mark.skipif(
+    sqlite3.sqlite_version_info < (3, 37), reason="STRICT requires SQLite 3.37+"
+)
+def test_insert_creates_strict_table(fresh_db):
+    table = fresh_db["strict_table"].insert(
+        {"id": 1, "rating": 4.5}, pk="id", strict=True
+    )
+    assert table.strict
+    assert "[rating] REAL" in table.schema
+
+
