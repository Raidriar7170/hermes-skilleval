+@pytest.mark.skipif(
+    sqlite3.sqlite_version_info < (3, 37, 0),
+    reason="STRICT tables require SQLite 3.37 or higher",
+)
+def test_create_table_strict(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table",
+        {
+            "text_col": str,
+            "float_col": float,
+            "int_col": int,
+            "bytes_col": bytes,
+        },
+        strict=True,
+    )
+    assert (
+        "CREATE TABLE [strict_table] (\n"
+        "   [text_col] TEXT,\n"
+        "   [float_col] REAL,\n"
+        "   [int_col] INTEGER,\n"
+        "   [bytes_col] BLOB\n"
+        ") STRICT"
+    ) == table.schema
+    table.insert(
+        {"text_col": "text", "float_col": 1.5, "int_col": 1, "bytes_col": b"x"}
+    )
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert(
+            {
+                "text_col": "text",
+                "float_col": 1.5,
+                "int_col": "not an integer",
+                "bytes_col": b"x",
+            }
+        )
+
+
+def test_create_table_sql_strict(fresh_db):
+    assert (
+        "CREATE TABLE [strict_table] (\n   [value] REAL\n) STRICT;\n        "
+        == fresh_db.create_table_sql("strict_table", {"value": float}, strict=True)
+    )
+
+
