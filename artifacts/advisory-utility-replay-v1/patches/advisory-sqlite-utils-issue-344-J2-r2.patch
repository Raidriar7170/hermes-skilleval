+@pytest.mark.skipif(
+    sqlite3.sqlite_version_info < (3, 37), reason="STRICT requires SQLite 3.37+"
+)
+def test_create_table_strict(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table",
+        {"id": int, "name": str, "score": float, "metadata": "ANY"},
+        pk="id",
+        strict=True,
+    )
+
+    assert table.strict
+    assert table.schema == (
+        "CREATE TABLE [strict_table] (\n"
+        "   [id] INTEGER PRIMARY KEY,\n"
+        "   [name] TEXT,\n"
+        "   [score] REAL,\n"
+        "   [metadata] ANY\n"
+        ") STRICT"
+    )
+    table.insert({"id": 1, "name": "Cleo", "score": 4.5, "metadata": "5"})
+    assert table.get(1)["metadata"] == "5"
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"id": "not-an-integer", "name": "Bad"})
+
+
