+@pytest.mark.skipif(
+    sqlite3.sqlite_version_info < (3, 37), reason="STRICT requires SQLite 3.37+"
+)
+def test_transform_preserves_strict(fresh_db):
+    table = fresh_db["strict_table"].create(
+        {"id": int, "score": float, "metadata": "ANY"}, pk="id", strict=True
+    )
+    table.insert({"id": 1, "score": 4.5, "metadata": "5"})
+
+    table.transform(rename={"score": "rating"})
+
+    assert table.strict
+    assert table.schema.endswith(") STRICT")
+    assert "[metadata] ANY" in table.schema
+    assert list(table.rows) == [{"id": 1, "rating": 4.5, "metadata": "5"}]
