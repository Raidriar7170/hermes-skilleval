     )
 
 
+def test_transform_preserves_strict_table(fresh_db):
+    dogs = fresh_db["dogs"].insert(
+        {"id": 1, "name": "Cleo", "age": 5, "extra": "000123"},
+        pk="id",
+        columns={"extra": "ANY"},
+        strict=True,
+    )
+    dogs.transform(rename={"age": "dog_age"})
+    assert dogs.strict
+    assert dogs.get(1) == {
+        "id": 1,
+        "name": "Cleo",
+        "dog_age": 5,
+        "extra": "000123",
+    }
+    assert dogs.columns_dict["extra"] is float
+    assert next(column for column in dogs.columns if column.name == "extra").type == "ANY"
+    assert dogs.schema.endswith(") STRICT")
+
+
