@@ -60,6 +60,33 @@ def test_create_table(fresh_db):
     ) == table.schema
 
 
+def test_create_strict_table(fresh_db):
+    table = fresh_db["strict_table"].create(
+        {"id": int, "value": float, "anything": "ANY"}, pk="id", strict=True
+    )
+    assert table.strict
+    assert table.schema == (
+        "CREATE TABLE [strict_table] (\n"
+        "   [id] INTEGER PRIMARY KEY,\n"
+        "   [value] REAL,\n"
+        "   [anything] ANY\n"
+        ") STRICT"
+    )
+    table.insert({"id": 1, "value": 1.5, "anything": {"key": "value"}})
+    assert table.get(1) == {"id": 1, "value": 1.5, "anything": '{"key": "value"}'}
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"id": 2, "value": b"not a number"})
+
+
+def test_insert_strict_table_and_add_float_column(fresh_db):
+    table = fresh_db["strict_table"].insert(
+        {"id": 1, "name": "one"}, pk="id", strict=True
+    )
+    table.add_column("score", float)
+    assert table.strict
+    assert "[score] REAL" in table.schema
+
+
 def test_create_table_compound_primary_key(fresh_db):
