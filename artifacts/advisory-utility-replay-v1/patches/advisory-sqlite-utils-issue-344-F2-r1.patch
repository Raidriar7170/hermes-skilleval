+def test_create_table_strict():
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = runner.invoke(
+            cli.cli,
+            [
+                "create-table",
+                "test.db",
+                "measurements",
+                "id",
+                "integer",
+                "value",
+                "float",
+                "metadata",
+                "any",
+                "--strict",
+            ],
+            catch_exceptions=False,
+        )
+        assert result.exit_code == 0
+        table = Database("test.db")["measurements"]
+        assert table.strict
+        assert [column.type for column in table.columns] == ["INTEGER", "REAL", "ANY"]
+
+
+def test_insert_strict(db_path):
+    result = CliRunner().invoke(
+        cli.cli,
+        ["insert", db_path, "measurements", "-", "--strict"],
+        input='{"value": 1.5}',
+        catch_exceptions=False,
+    )
+    assert result.exit_code == 0
+    table = Database(db_path)["measurements"]
+    assert table.strict
+    assert table.columns[0].type == "REAL"
+
+
