+def test_create_strict_table(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table",
+        {"id": int, "score": float, "metadata": "ANY"},
+        pk="id",
+        strict=True,
+    )
+    assert table.strict
+    assert table.schema == (
+        "CREATE TABLE [strict_table] (\n"
+        "   [id] INTEGER PRIMARY KEY,\n"
+        "   [score] REAL,\n"
+        "   [metadata] ANY\n"
+        ") STRICT"
+    )
+    table.insert({"id": 1, "score": 1.5, "metadata": "ok"})
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"id": 2, "score": "not a number", "metadata": "ok"})
+
+
+def test_insert_strict_table_and_transform(fresh_db):
+    table = fresh_db.table("strict_table", strict=True).insert(
+        {"id": 1, "score": 1.5, "metadata": "one"}, pk="id"
+    )
+    assert table.strict
+    assert {column.name: column.type for column in table.columns} == {
+        "id": "INTEGER",
+        "score": "REAL",
+        "metadata": "TEXT",
+    }
+    table.transform(types={"metadata": "ANY"})
+    assert table.strict
+    assert table.columns_dict["score"] is float
+    column_types = {column.name: column.type for column in table.columns}
+    assert column_types["metadata"] == "ANY"
+    table.transform(rename={"metadata": "details"})
+    assert table.strict
+    column_types = {column.name: column.type for column in table.columns}
+    assert column_types["details"] == "ANY"
+
+
