@@ -1061,3 +1061,59 @@ def test_create_table_sql(fresh_db, columns, expected_sql_middle):
     sql = fresh_db.create_table_sql("t", columns)
     middle = sql.split("(")[1].split(")")[0].strip()
     assert middle == expected_sql_middle
+
+
+def test_create_strict_table(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table", {"id": int, "name": str, "score": float}, strict=True
+    )
+    assert (
+        table.schema
+        == "CREATE TABLE [strict_table] (\n"
+        "   [id] INTEGER,\n"
+        "   [name] TEXT,\n"
+        "   [score] REAL\n"
+        ") STRICT"
+    )
+    assert table.strict is True
+    assert fresh_db.create_table_sql("other", {"value": float}, strict=True).endswith(
+        ") STRICT;\n        "
+    )
+
+
+@pytest.mark.parametrize("method", ("insert", "insert_all", "upsert", "upsert_all"))
+def test_strict_implicit_create(fresh_db, method):
+    record = {"id": 1, "score": 1.5}
+    records = [record] if method.endswith("_all") else record
+    getattr(fresh_db["strict_table"], method)(records, pk="id", strict=True)
+    assert fresh_db["strict_table"].strict is True
+    assert fresh_db["strict_table"].columns_dict == {"id": int, "score": float}
+
+
+def test_strict_table_factory_default(fresh_db):
+    fresh_db.table("strict_table", strict=True).insert({"value": "one"})
+    assert fresh_db["strict_table"].strict is True
+
+
+def test_transform_preserves_strict(fresh_db):
+    fresh_db["strict_table"].create({"id": int, "name": str}, strict=True)
+    fresh_db["strict_table"].transform(rename={"name": "title"})
+    assert fresh_db["strict_table"].strict is True
+    assert list(fresh_db["strict_table"].columns_dict) == ["id", "title"]
+
+
+def test_add_float_column_to_strict_table(fresh_db):
+    table = fresh_db["strict_table"].create({"id": int}, strict=True)
+    table.add_column("score", float)
+    assert table.columns[-1].type == "REAL"
+
+
+def test_alter_strict_table_with_float(fresh_db):
+    table = fresh_db["strict_table"].insert({"id": 1}, strict=True)
+    table.insert({"id": 2, "score": 1.5}, alter=True)
+    assert table.columns[-1].type == "REAL"
+
+
+def test_strict_detected_case_insensitively(fresh_db):
+    fresh_db.execute("create table strict_table (value text) strict")
+    assert fresh_db["strict_table"].strict is True
