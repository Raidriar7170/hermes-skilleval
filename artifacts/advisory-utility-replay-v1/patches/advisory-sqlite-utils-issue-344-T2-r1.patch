+@pytest.mark.parametrize("command", ("create-table", "insert", "upsert"))
+def test_cli_create_strict_table(command):
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        if command == "create-table":
+            args = [command, "test.db", "t", "score", "float", "--strict"]
+        else:
+            args = [command, "test.db", "t", "-", "--strict"]
+            if command == "upsert":
+                args.extend(("--pk", "id"))
+        result = runner.invoke(
+            cli.cli,
+            args,
+            input='[{"id": 1, "score": 1.5}]' if command != "create-table" else None,
+            catch_exceptions=False,
+        )
+        assert result.exit_code == 0
+        assert Database("test.db")["t"].strict is True
+        assert Database("test.db")["t"].columns[-1].type == "REAL"
+
+
+def test_cli_create_strict_table_any_column():
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = runner.invoke(
+            cli.cli,
+            ["create-table", "test.db", "t", "value", "any", "--strict"],
+            catch_exceptions=False,
+        )
+        assert result.exit_code == 0
+        assert Database("test.db")["t"].columns[0].type == "ANY"
+
+
