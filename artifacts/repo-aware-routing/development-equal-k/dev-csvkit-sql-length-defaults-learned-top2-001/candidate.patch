+    def test_column_length_options(self):
+        for options, expected in (
+            ([], (1, 1)),
+            (['--min-col-len', '7', '--col-len-multiplier', '3'], (7, 3)),
+        ):
+            with self.subTest(options=options):
+                with patch('csvkit.utilities.csvsql.agate.Table.to_sql') as to_sql:
+                    self.get_output(['--db', 'sqlite:///:memory:'] + options + ['examples/dummy.csv'])
+
+                kwargs = to_sql.call_args.kwargs
+                self.assertEqual((kwargs['min_col_len'], kwargs['col_len_multiplier']), expected)
+
     def setUp(self):
         self.db_file = 'foo.db'
 
