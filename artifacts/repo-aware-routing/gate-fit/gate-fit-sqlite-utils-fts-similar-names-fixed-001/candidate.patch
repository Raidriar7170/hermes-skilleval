+@pytest.mark.parametrize("table_names", (("foo", "foo2"), ("foo2", "foo")))
+def test_detect_fts_similarly_named_tables(fresh_db, table_names):
+    for table_name in table_names:
+        fresh_db[table_name].insert({"title": "Hello"}).enable_fts(["title"])
+
+    assert "foo_fts" == fresh_db["foo"].detect_fts()
+    assert "foo2_fts" == fresh_db["foo2"].detect_fts()
+
+
 def test_tables(existing_db):
     assert 1 == len(existing_db.tables)
     assert "foo" == existing_db.tables[0].name
