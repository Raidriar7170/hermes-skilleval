--- a/sqlite_utils/db.py
+++ b/sqlite_utils/db.py
@@ -42,6 +42,17 @@ SQLITE_MAX_VARS = 999
 
 _quote_fts_re = re.compile(r'\s+|(".*?")')
 
+_fts_content_re = re.compile(
+    r"""\bcontent\s*=\s*(?:
+        \[(?P<square>[^\]]*)\] |
+        "(?P<double>(?:""|[^"])*)" |
+        '(?P<single>(?:''|[^'])*)' |
+        `(?P<backtick>(?:``|[^`])*)` |
+        (?P<unquoted>[^,\s)]+)
+    )""",
+    re.VERBOSE | re.IGNORECASE,
+)
+
 _virtual_table_using_re = re.compile(
     r"""
 ^ # Start of string
@@ -2212,28 +2223,35 @@ class Table(Queryable):
 
     def detect_fts(self) -> Optional[str]:
         "Detect if table has a corresponding FTS virtual table and return it"
-        sql = (
-            textwrap.dedent(
-                """
-            SELECT name FROM sqlite_master
+        sql = textwrap.dedent(
+            """
+            SELECT name, tbl_name, sql FROM sqlite_master
                 WHERE rootpage = 0
-                AND (
-                    sql LIKE '%VIRTUAL TABLE%USING FTS%content=%{table}%'
-                    OR (
-                        tbl_name = "{table}"
-                        AND sql LIKE '%VIRTUAL TABLE%USING FTS%'
-                    )
-                )
+                AND sql LIKE '%VIRTUAL TABLE%USING FTS%'
         """
-            )
-            .strip()
-            .format(table=self.name)
-        )
+        ).strip()
         rows = self.db.execute(sql).fetchall()
-        if len(rows) == 0:
-            return None
-        else:
-            return rows[0][0]
+        # If this is itself an FTS table, it should always identify itself
+        for name, table_name, _ in rows:
+            if table_name.lower() == self.name.lower():
+                return name
+        # Otherwise, find an FTS table whose content= option exactly matches
+        # this table. A substring match would confuse names such as foo and foo2.
+        for name, _, create_sql in rows:
+            for match in _fts_content_re.finditer(create_sql):
+                group_name, content_table = next(
+                    (key, value)
+                    for key, value in match.groupdict().items()
+                    if value is not None
+                )
+                if group_name in ("double", "single", "backtick"):
+                    quote = {"double": '"', "single": "'", "backtick": "`"}[
+                        group_name
+                    ]
+                    content_table = content_table.replace(quote * 2, quote)
+                if content_table.lower() == self.name.lower():
+                    return name
+        return None
 
     def optimize(self) -> "Table":
         "Run the ``optimize`` operation against the associated full-text search index table."
