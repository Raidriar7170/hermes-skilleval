index 28a5009f3d42ddfc8d0a5fdccbe318d9f86cd3ff..1cdc9cd3265cc86e6995f6ba4416bca8a0fe847c 100644
--- a/tests/test_introspect.py
+++ b/tests/test_introspect.py
@@ -36,6 +36,25 @@ def test_detect_fts(existing_db):
     assert existing_db["foo"].detect_fts() is None
 
 
+@pytest.mark.parametrize(
+    "creation_order", (("authors", "authors_archive"), ("authors_archive", "authors"))
+)
+@pytest.mark.parametrize("fts_version", ("fts4", "fts5"))
+def test_detect_fts_similarly_named_tables(fresh_db, creation_order, fts_version):
+    for table_name in ("authors", "authors_archive"):
+        fresh_db.execute("create table [{}] (name text)".format(table_name))
+    for table_name in creation_order:
+        fresh_db.execute(
+            "create virtual table [{0}_fts] using {1} "
+            "(name, content='{0}')".format(table_name, fts_version)
+        )
+
+    assert fresh_db["authors"].detect_fts() == "authors_fts"
+    assert fresh_db["authors_archive"].detect_fts() == "authors_archive_fts"
+    assert fresh_db["authors_fts"].detect_fts() == "authors_fts"
+    assert fresh_db["authors_archive_fts"].detect_fts() == "authors_archive_fts"
+
+
 def test_tables(existing_db):
     assert 1 == len(existing_db.tables)
     assert "foo" == existing_db.tables[0].name
