index 7a06304974b12348a9336beda5d3782550f876c7..8bc582009702961d1c3c5158c50fc6c6ed4d49fe 100644
--- a/sqlite_utils/db.py
+++ b/sqlite_utils/db.py
@@ -62,6 +62,24 @@ USING\s+(?P<using>\w+)          # for example USING FTS5
     re.VERBOSE | re.IGNORECASE,
 )
 
+_fts_content_re = re.compile(
+    r"""
+    (?:\(|,)\s*content\s*=\s*
+    (
+        '(?P<squoted_content>[^']*(?:''[^']*)*)' |
+        "(?P<dquoted_content>[^"]*(?:""[^"]*)*)" |
+        `(?P<backtick_content>[^`]*(?:``[^`]*)*)` |
+        \[(?P<squarequoted_content>[^\]]+)\] |
+        (?P<identifier_content>
+            [A-Za-z_\u0080-\uffff]
+            [A-Za-z_\u0080-\uffff0-9\$]*
+        )
+    )
+    \s*(?:,|\))
+    """,
+    re.VERBOSE | re.IGNORECASE,
+)
+
 try:
     import pandas as pd  # type: ignore
 except ImportError:
@@ -2212,28 +2230,32 @@ class Table(Queryable):
 
     def detect_fts(self) -> Optional[str]:
         "Detect if table has a corresponding FTS virtual table and return it"
-        sql = (
-            textwrap.dedent(
-                """
-            SELECT name FROM sqlite_master
+        sql = textwrap.dedent(
+            """
+            SELECT name, sql FROM sqlite_master
                 WHERE rootpage = 0
-                AND (
-                    sql LIKE '%VIRTUAL TABLE%USING FTS%content=%{table}%'
-                    OR (
-                        tbl_name = "{table}"
-                        AND sql LIKE '%VIRTUAL TABLE%USING FTS%'
-                    )
-                )
+                AND sql LIKE '%VIRTUAL TABLE%USING FTS%'
         """
-            )
-            .strip()
-            .format(table=self.name)
-        )
+        ).strip()
         rows = self.db.execute(sql).fetchall()
-        if len(rows) == 0:
-            return None
-        else:
-            return rows[0][0]
+        for name, create_sql in rows:
+            if name.casefold() == self.name.casefold():
+                return name
+            match = _fts_content_re.search(create_sql)
+            if match is None:
+                continue
+            content_table = next(
+                value for value in match.groupdict().values() if value is not None
+            )
+            if match.group("squoted_content") is not None:
+                content_table = content_table.replace("''", "'")
+            elif match.group("dquoted_content") is not None:
+                content_table = content_table.replace('""', '"')
+            elif match.group("backtick_content") is not None:
+                content_table = content_table.replace("``", "`")
+            if content_table.casefold() == self.name.casefold():
+                return name
+        return None
 
     def optimize(self) -> "Table":
         "Run the ``optimize`` operation against the associated full-text search index table."
