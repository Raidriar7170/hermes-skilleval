+def test_convert_multi_dry_run(fresh_db_and_path):
+    db, db_path = fresh_db_and_path
+    original_rows = [
+        {"id": 1, "name": "Simon"},
+        {"id": 2, "name": "Cleo"},
+    ]
+    db["creatures"].insert_all(original_rows, pk="id")
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "convert",
+            db_path,
+            "creatures",
+            "name",
+            "--multi",
+            '{"upper": value.upper(), "lower": value.lower()}',
+            "--dry-run",
+        ],
+    )
+    assert result.exit_code == 0, result.output
+    assert result.output.strip() == (
+        "Simon\n"
+        " --- becomes:\n"
+        "upper: SIMON\n"
+        "lower: simon\n"
+        "\n"
+        "Cleo\n"
+        " --- becomes:\n"
+        "upper: CLEO\n"
+        "lower: cleo\n"
+        "\n"
+        "Would affect 2 rows"
+    )
+    assert list(db["creatures"].rows) == original_rows
+    assert [column.name for column in db["creatures"].columns] == ["id", "name"]
+
