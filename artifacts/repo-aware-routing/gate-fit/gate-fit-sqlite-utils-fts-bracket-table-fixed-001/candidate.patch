@@ -420,6 +420,24 @@ def test_enable_fts_replace_does_nothing_if_args_the_same():
     assert all(q[0].startswith("select ") for q in queries)
 
 
+@pytest.mark.parametrize("fts_version", ("FTS4", "FTS5"))
+def test_enable_fts_replace_legacy_bracket_quoted_content(fts_version):
+    db = Database(memory=True)
+    db["books"].insert({"title": "Habits of Australian Marsupials"})
+    db.execute(
+        "CREATE VIRTUAL TABLE books_fts USING {} "
+        "(title, content=[books])".format(fts_version)
+    )
+
+    assert db["books"].detect_fts() == "books_fts"
+    db["books"].enable_fts(["title"], fts_version=fts_version, replace=True)
+
+    assert 'content="books"' in db["books_fts"].schema
+    assert ["Habits of Australian Marsupials"] == [
+        row["title"] for row in db["books"].search("marsupials")
+    ]
+
+
