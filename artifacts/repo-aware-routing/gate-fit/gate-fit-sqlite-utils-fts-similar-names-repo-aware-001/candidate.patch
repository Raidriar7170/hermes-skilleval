+@pytest.mark.parametrize("table_names", (("items", "item"), ("item", "items")))
+def test_detect_fts_similarly_named_tables(fresh_db, table_names):
+    for table_name in table_names:
+        fresh_db[table_name].insert({"text": table_name}).enable_fts(["text"])
+
+    assert "item_fts" == fresh_db["item"].detect_fts()
+    assert "items_fts" == fresh_db["items"].detect_fts()
+
+
 def test_tables(existing_db):
     assert 1 == len(existing_db.tables)
     assert "foo" == existing_db.tables[0].name
