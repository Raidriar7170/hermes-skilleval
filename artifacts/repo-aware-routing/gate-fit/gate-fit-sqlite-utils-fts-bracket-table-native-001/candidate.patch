--- a/tests/test_fts.py
+++ b/tests/test_fts.py
@@ -420,6 +420,33 @@ def test_enable_fts_replace_does_nothing_if_args_the_same():
     assert all(q[0].startswith("select ") for q in queries)
 
 
+def test_enable_fts_replace_legacy_bracket_quoted_content_table(fresh_db):
+    fresh_db.executescript("""
+        CREATE TABLE books (title TEXT, author TEXT);
+        INSERT INTO books VALUES ('Legacy title', 'Legacy author');
+        CREATE VIRTUAL TABLE books_fts USING FTS5(title, content=[books]);
+        INSERT INTO books_fts(rowid, title) SELECT rowid, title FROM books;
+        CREATE TRIGGER books_ai AFTER INSERT ON books BEGIN
+          INSERT INTO [books_fts](rowid, title) VALUES (new.rowid, new.title);
+        END;
+    """)
+    assert list(fresh_db["books"].rows) == [
+        {"title": "Legacy title", "author": "Legacy author"}
+    ]
+    assert fresh_db["books"].triggers_dict.keys() == {"books_ai"}
+
+    fresh_db["books"].enable_fts(["author"], replace=True)
+
+    assert list(fresh_db["books"].rows) == [
+        {"title": "Legacy title", "author": "Legacy author"}
+    ]
+    assert fresh_db["books"].triggers_dict == {}
+    assert fresh_db["books_fts"].columns_dict.keys() == {"author"}
+    assert list(fresh_db["books"].search("Legacy author")) == [
+        {"rowid": 1, "title": "Legacy title", "author": "Legacy author"}
+    ]
+
