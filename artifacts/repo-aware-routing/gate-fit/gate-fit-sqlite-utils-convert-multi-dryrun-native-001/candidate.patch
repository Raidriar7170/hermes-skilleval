+def test_convert_multi_dryrun(fresh_db_and_path):
+    db, db_path = fresh_db_and_path
+    original_rows = [
+        {"id": 1, "name": "Simon"},
+        {"id": 2, "name": "Cleo"},
+    ]
+    db["creatures"].insert_all(original_rows, pk="id")
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "convert",
+            db_path,
+            "creatures",
+            "name",
+            '{"upper": value.upper(), "lower": value.lower()}',
+            "--multi",
+            "--dry-run",
+        ],
+    )
+    assert result.exit_code == 0, result.output
+    assert result.output.strip() == (
+        "Simon\n"
+        " --- becomes:\n"
+        "{'upper': 'SIMON', 'lower': 'simon'}\n"
+        "\n"
+        "Cleo\n"
+        " --- becomes:\n"
+        "{'upper': 'CLEO', 'lower': 'cleo'}\n"
+        "\n"
+        "Would affect 2 rows"
+    )
+    assert list(db["creatures"].rows) == original_rows
+
