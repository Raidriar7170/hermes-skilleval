 import itertools
 import sys
 
@@ -7,6 +8,34 @@ import agate
 from csvkit.cli import CSVKitUtility, make_default_headers
 
 
+class _NumericValue(float):
+    """A numeric value that retains its original CSV representation."""
+
+    def __new__(cls, value):
+        instance = super().__new__(cls, value)
+        instance.value = value
+        return instance
+
+    def __str__(self):
+        return self.value
+
+
+def _parse_numeric_values(rows):
+    for row in rows:
+        values = []
+
+        for value in row:
+            if isinstance(value, str):
+                try:
+                    value = _NumericValue(value)
+                except ValueError:
+                    pass
+
+            values.append(value)
+
+        yield values
+
+
 class CSVFormat(CSVKitUtility):
     description = 'Convert a CSV file to a custom output format.'
     override_flags = ['L', 'blanks', 'date-format', 'datetime-format']
@@ -83,6 +112,15 @@ class CSVFormat(CSVKitUtility):
         if self.args.skip_header:
             next(reader)
 
+        if self.args.out_quoting == csv.QUOTE_NONNUMERIC:
+            if not self.args.skip_header:
+                try:
+                    writer.writerow(next(reader))
+                except StopIteration:
+                    return
+
+            reader = _parse_numeric_values(reader)
+
         writer.writerows(reader)
 
 
