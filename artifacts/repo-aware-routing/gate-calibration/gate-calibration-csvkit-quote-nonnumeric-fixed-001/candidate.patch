 #!/usr/bin/env python
+import csv
 import itertools
 import sys
 
@@ -7,6 +8,31 @@ import agate
 from csvkit.cli import CSVKitUtility, make_default_headers
 
 
+class _NumericValue:
+    """A number that retains its original string representation."""
+
+    def __init__(self, value):
+        self.value = value
+
+    def __str__(self):
+        return self.value
+
+    def __float__(self):
+        return float(self.value)
+
+
+def _as_number(value):
+    if not isinstance(value, str):
+        return value
+
+    try:
+        float(value)
+    except ValueError:
+        return value
+
+    return _NumericValue(value)
+
+
 class CSVFormat(CSVKitUtility):
     description = 'Convert a CSV file to a custom output format.'
     override_flags = ['L', 'blanks', 'date-format', 'datetime-format']
@@ -83,6 +109,9 @@ class CSVFormat(CSVKitUtility):
         if self.args.skip_header:
             next(reader)
 
+        if self.args.out_quoting == csv.QUOTE_NONNUMERIC:
+            reader = ([_as_number(value) for value in row] for row in reader)
+
         writer.writerows(reader)
 
 
