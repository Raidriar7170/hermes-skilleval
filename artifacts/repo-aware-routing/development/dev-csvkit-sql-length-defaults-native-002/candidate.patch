diff --git a/tests/test_utilities/test_csvsql.py b/tests/test_utilities/test_csvsql.py
index c6d13ca7660e014f12e14907cf27b1da8bd449ad..8919ac75a7b82ac5bd412eb16417b8229fc667e3 100644
--- a/tests/test_utilities/test_csvsql.py
+++ b/tests/test_utilities/test_csvsql.py
@@ -57,6 +57,19 @@ class TestCSVSQL(CSVKitTestCase, EmptyFileTests):
                     f'The {args[0]} option is only valid if --insert is also specified.'
                 )
 
+    def test_column_length_options(self):
+        for options, expected in (
+            ([], (1, 1)),
+            (['--min-col-len', '7', '--col-len-multiplier', '3'], (7, 3)),
+        ):
+            with self.subTest(options=options), patch('agate.Table.to_sql') as to_sql:
+                self.get_output([
+                    '--db', 'sqlite:///:memory:', '--insert', *options, 'examples/testfixed_converted.csv'
+                ])
+
+                self.assertEqual(to_sql.call_args.kwargs['min_col_len'], expected[0])
+                self.assertEqual(to_sql.call_args.kwargs['col_len_multiplier'], expected[1])
+
     def setUp(self):
         self.db_file = 'foo.db'
 
