+@pytest.mark.parametrize(
+    "stop_before", ("does_not_exist", "hello:does_not_exist", "missing:foo")
+)
+def test_stop_before_rejects_unknown_migration(two_migrations, stop_before):
+    path, migrations_py = two_migrations
+    db_path = str(path / "test.db")
+    result = CliRunner().invoke(
+        sqlite_utils.cli.cli,
+        [
+            "migrate",
+            db_path,
+            str(migrations_py),
+            "--stop-before",
+            stop_before,
+        ],
+    )
+    assert result.exit_code == 1
+    assert "Unknown migration: {}".format(stop_before) in result.output
+    db = sqlite_utils.Database(db_path)
+    assert not db["foo"].exists()
+    assert not db["bar"].exists()
+
+
+def test_stop_before_legacy_migration_set(legacy_migrations):
+    path, migrations_py = legacy_migrations
+    db_path = str(path / "test.db")
+    result = CliRunner().invoke(
+        sqlite_utils.cli.cli,
+        [
+            "migrate",
+            db_path,
+            str(migrations_py),
+            "--stop-before",
+            "bar",
+        ],
+    )
+    assert result.exit_code == 0, result.output
+    db = sqlite_utils.Database(db_path)
+    assert db["foo"].exists()
