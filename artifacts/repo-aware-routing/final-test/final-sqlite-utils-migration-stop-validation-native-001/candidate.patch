+LEGACY_MIGRATIONS = """
+class LegacyMigrations:
+    def __init__(self):
+        self.name = "legacy"
+
+    def applied(self, db):
+        return []
+
+    def pending(self, db):
+        return [type("Migration", (), {"name": name}) for name in ("foo", "bar")]
+
+    def apply(self, db, stop_before=None):
+        if stop_before is not None and not isinstance(stop_before, str):
+            raise TypeError("stop_before must be a string")
+        for migration in self.pending(db):
+            if migration.name == stop_before:
+                return
+            db[migration.name].insert({"name": migration.name})
+
+legacy = LegacyMigrations()
+"""
+
 
