@@ -3347,6 +3347,50 @@ def _stop_before_for_migration_set(stop_before, migration_set_name):
     return matches
 
 
+def _migration_names(migration_set, db):
+    if isinstance(migration_set, sqlite_utils.Migrations):
+        return {migration.name for migration in migration_set._migrations}
+    return {
+        migration.name
+        for migration in (
+            list(migration_set.applied(db)) + list(migration_set.pending(db))
+        )
+    }
+
+
+def _resolve_stop_before(stop_before, migration_sets, db):
+    if not stop_before:
+        return [[] for _ in migration_sets]
+    names_by_set = [
+        _migration_names(migration_set, db) for migration_set in migration_sets
+    ]
+    resolved = [[] for _ in migration_sets]
+    for value in stop_before:
+        set_name, separator, migration_name = value.partition(":")
+        if not separator:
+            migration_name = set_name
+        matching_sets = [
+            index
+            for index, migration_set in enumerate(migration_sets)
+            if (not separator or migration_set.name == set_name)
+            and migration_name in names_by_set[index]
+        ]
+        if not matching_sets:
+            raise click.ClickException("Unknown migration: {}".format(value))
+        for index in matching_sets:
+            if migration_name not in resolved[index]:
+                resolved[index].append(migration_name)
+
+    for migration_set, names in zip(migration_sets, resolved):
+        if not isinstance(migration_set, sqlite_utils.Migrations) and len(names) > 1:
+            raise click.ClickException(
+                "legacy migration set '{}' only supports one --stop-before".format(
+                    migration_set.name
+                )
+            )
+    return resolved
+
+
