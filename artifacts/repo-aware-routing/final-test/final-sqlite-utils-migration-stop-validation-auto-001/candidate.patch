diff --git a/tests/test_cli_migrate.py b/tests/test_cli_migrate.py
index 229bc9cdfec332678f85ca5f74d78ffe3a089cb1..17572b929b915c9071a7e0e50e7fc29b5d053248 100644
--- a/tests/test_cli_migrate.py
+++ b/tests/test_cli_migrate.py
@@ -301,3 +301,103 @@ def test_stop_before_multiple_qualified(two_sets_same_migration_name):
     assert not db["creature_weights"].exists()
     assert db["sales"].exists()
     assert not db["sales_weights"].exists()
+
+
+@pytest.mark.parametrize("stop_before", ("unknown", "hello:unknown", "unknown_set:bar"))
+def test_stop_before_unknown_migration_does_not_apply(two_migrations, stop_before):
+    path, migrations_py = two_migrations
+    db_path = str(path / "test.db")
+    result = CliRunner().invoke(
+        sqlite_utils.cli.cli,
+        [
+            "migrate",
+            db_path,
+            str(migrations_py),
+            "--stop-before",
+            stop_before,
+        ],
+    )
+    assert result.exit_code == 1
+    assert "Unknown migration: {}".format(stop_before) in result.output
+    assert sqlite_utils.Database(db_path).table_names() == []
+
+
+LEGACY_MIGRATIONS = """
+from sqlite_utils import Migrations
+
+def make_legacy_migrations():
+    inner = Migrations("legacy")
+
+    @inner()
+    def foo(db):
+        db["foo"].insert({"hello": "world"})
+
+    @inner()
+    def bar(db):
+        db["bar"].insert({"hello": "world"})
+
+    class LegacyMigrations:
+        name = "legacy"
+
+        def applied(self, db):
+            return inner.applied(db)
+
+        def pending(self, db):
+            return inner.pending(db)
+
+        def apply(self, db, stop_before=None):
+            if isinstance(stop_before, (list, tuple, set)):
+                raise TypeError("legacy migrations accept one stop name")
+            inner.apply(db, stop_before=stop_before)
+
+    return LegacyMigrations()
+
+legacy = make_legacy_migrations()
+"""
+
+
+@pytest.fixture
+def legacy_migrations(tmpdir):
+    path = pathlib.Path(tmpdir)
+    migrations_py = path / "migrations.py"
+    migrations_py.write_text(LEGACY_MIGRATIONS, "utf-8")
+    return path, migrations_py
+
+
+@pytest.mark.parametrize(
+    "extra_args,expected_tables",
+    (
+        ((), {"foo", "bar"}),
+        (("--stop-before", "bar"), {"foo"}),
+    ),
+)
+def test_legacy_migration_set(legacy_migrations, extra_args, expected_tables):
+    path, migrations_py = legacy_migrations
+    db_path = str(path / "test.db")
+    result = CliRunner().invoke(
+        sqlite_utils.cli.cli,
+        ["migrate", db_path, str(migrations_py), *extra_args],
+    )
+    assert result.exit_code == 0, result.output
+    db = sqlite_utils.Database(db_path)
+    assert set(db.table_names()) == {"_sqlite_migrations", *expected_tables}
+
+
+def test_legacy_migration_set_rejects_multiple_stop_points(legacy_migrations):
+    path, migrations_py = legacy_migrations
+    db_path = str(path / "test.db")
+    result = CliRunner().invoke(
+        sqlite_utils.cli.cli,
+        [
+            "migrate",
+            db_path,
+            str(migrations_py),
+            "--stop-before",
+            "foo",
+            "--stop-before",
+            "bar",
+        ],
+    )
+    assert result.exit_code == 1
+    assert "legacy migration set 'legacy' only supports one --stop-before" in result.output
+    assert set(sqlite_utils.Database(db_path).table_names()) == {"_sqlite_migrations"}
