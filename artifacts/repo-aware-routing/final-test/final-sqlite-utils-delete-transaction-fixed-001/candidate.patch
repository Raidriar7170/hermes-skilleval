+def test_delete_where_does_not_commit_open_atomic_block(fresh_db):
+    fresh_db["dogs"].insert_all(
+        ({"id": i, "name": "Dog {}".format(i)} for i in range(1, 4)), pk="id"
+    )
+
+    with pytest.raises(RuntimeError):
+        with fresh_db.atomic():
+            fresh_db["dogs"].delete_where("id > ?", [1])
+            raise RuntimeError("boom")
+
+    assert list(fresh_db["dogs"].rows) == [
+        {"id": 1, "name": "Dog 1"},
+        {"id": 2, "name": "Dog 2"},
+        {"id": 3, "name": "Dog 3"},
+    ]
+
+
