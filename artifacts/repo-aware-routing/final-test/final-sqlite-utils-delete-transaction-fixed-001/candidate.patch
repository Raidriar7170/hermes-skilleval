+@pytest.mark.parametrize("analyze", (False, True))
+def test_delete_where_commits(tmpdir, analyze):
+    path = str(tmpdir / "data.db")
+    db = Database(path)
+    db["table"].insert_all(({"id": i} for i in range(1, 4)), pk="id")
+
+    db["table"].delete_where("id > ?", [1], analyze=analyze)
+    db.close()
+
+    assert list(Database(path)["table"].rows) == [{"id": 1}]
+
+
+def test_delete_commits(tmpdir):
+    path = str(tmpdir / "data.db")
+    db = Database(path)
+    db["table"].insert_all(({"id": i} for i in range(1, 4)), pk="id")
+
+    db["table"].delete(1)
+    db.close()
+
+    assert list(Database(path)["table"].rows) == [{"id": 2}, {"id": 3}]
