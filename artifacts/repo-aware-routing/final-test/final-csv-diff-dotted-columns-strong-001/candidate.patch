index f446fb7182b391b47fce3e09e679255077832acf..dd9a60154d2e4a84a4ae61802174bf2366640885 100644
--- a/csv_diff/__init__.py
+++ b/csv_diff/__init__.py
@@ -57,12 +57,26 @@ def compare(previous, current, show_unchanged=False):
         result["removed"] = [previous[id] for id in removed]
     if changed:
         for id in changed:
-            d = list(diff(previous[id], current[id], ignore=ignore_columns))
+            # CSV rows are flat dictionaries, and their headings are literal keys.
+            # Disable dictdiffer's dotted path notation so dots in a heading are
+            # not interpreted as separators. With dot notation disabled, both
+            # paths and ignored keys are represented as sequences.
+            ignore_paths = (
+                {(column,) for column in ignore_columns} if ignore_columns else None
+            )
+            d = list(
+                diff(
+                    previous[id],
+                    current[id],
+                    ignore=ignore_paths,
+                    dot_notation=False,
+                )
+            )
             if d:
                 changes = {
                     "key": id,
                     "changes": {
-                        field: [prev_value, current_value]
+                        field[0]: [prev_value, current_value]
                         for _, field, (prev_value, current_value) in d
                     },
                 }
