+    migrations_py.write_text(
+        """
+class LegacyMigrations:
+    name = "legacy"
+
+    def applied(self, db):
+        raise AssertionError("applied() should not be called before apply()")
+
+    def pending(self, db):
+        raise AssertionError("pending() should not be called before apply()")
+
+    def apply(self, db):
+        db["legacy"].insert({"ok": True})
