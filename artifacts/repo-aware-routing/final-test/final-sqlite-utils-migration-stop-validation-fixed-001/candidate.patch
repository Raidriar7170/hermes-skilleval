@@ -301,3 +301,123 @@ def test_stop_before_multiple_qualified(two_sets_same_migration_name):
     assert not db["creature_weights"].exists()
     assert db["sales"].exists()
     assert not db["sales_weights"].exists()
+
+
+@pytest.mark.parametrize(
+    "stop_before",
+    ("unknown", "hello:unknown", "unknown:foo"),
+)
+def test_stop_before_rejects_unknown_migration_without_applying(
+    two_migrations, stop_before
+):
+    path, migrations_py = two_migrations
+    db_path = str(path / "test.db")
+    result = CliRunner().invoke(
+        sqlite_utils.cli.cli,
+        [
+            "migrate",
+            db_path,
+            str(migrations_py),
+            "--stop-before",
+            stop_before,
+        ],
+    )
+    assert result.exit_code == 1
+    assert "Unknown migration: {}".format(stop_before) in result.output
+    db = sqlite_utils.Database(db_path)
+    assert not db["foo"].exists()
+    assert not db["bar"].exists()
+
+
+def test_stop_before_legacy_migration_set_receives_single_name(tmpdir):
+    path = pathlib.Path(tmpdir)
+    migrations_py = path / "migrations.py"
+    migrations_py.write_text(
+        """
+class Migration:
+    def __init__(self, name):
+        self.name = name
+
+class LegacyMigrations:
+    def __init__(self):
+        self.name = "legacy"
+
+    def applied(self, db):
+        return []
+
+    def pending(self, db):
+        return [Migration("foo"), Migration("bar")]
+
+    def apply(self, db, stop_before=None):
+        if stop_before is not None and not isinstance(stop_before, str):
+            raise TypeError("stop_before must be a string")
+        for migration in self.pending(db):
+            if migration.name == stop_before:
+                return
+            db[migration.name].insert({"id": 1})
+
+migrations = LegacyMigrations()
+""",
+        "utf-8",
+    )
+    db_path = str(path / "test.db")
+    result = CliRunner().invoke(
+        sqlite_utils.cli.cli,
+        [
+            "migrate",
+            db_path,
+            str(migrations_py),
+            "--stop-before",
+            "bar",
+        ],
+    )
+    assert result.exit_code == 0, result.output
+    db = sqlite_utils.Database(db_path)
+    assert db["foo"].exists()
+    assert not db["bar"].exists()
+
+
+def test_stop_before_legacy_migration_set_rejects_multiple_names(tmpdir):
+    path = pathlib.Path(tmpdir)
+    migrations_py = path / "migrations.py"
+    migrations_py.write_text(
+        """
+class Migration:
+    def __init__(self, name):
+        self.name = name
+
+class LegacyMigrations:
+    def __init__(self):
+        self.name = "legacy"
+
+    def applied(self, db):
+        return []
+
+    def pending(self, db):
+        return [Migration("foo"), Migration("bar")]
+
+    def apply(self, db, stop_before=None):
+        raise AssertionError("apply should not be called")
+
+migrations = LegacyMigrations()
+""",
+        "utf-8",
+    )
+    db_path = str(path / "test.db")
+    result = CliRunner().invoke(
+        sqlite_utils.cli.cli,
+        [
+            "migrate",
+            db_path,
+            str(migrations_py),
+            "--stop-before",
+            "foo",
+            "--stop-before",
+            "bar",
+        ],
+    )
+    assert result.exit_code == 1
+    assert (
+        "legacy migration set 'legacy' only supports one --stop-before"
+        in result.output.lower()
+    )
