+def test_delete_where_persists_after_close(tmpdir):
+    path = tmpdir / "data.db"
+    db = Database(str(path))
+    db["table"].insert_all(({"id": i} for i in range(1, 4)), pk="id")
+
+    db["table"].delete_where("id > ?", [1])
+    db.close()
+
+    reopened_db = Database(str(path))
+    assert list(reopened_db["table"].rows) == [{"id": 1}]
+
+
+def test_delete_where_rolls_back_with_atomic(fresh_db):
+    table = fresh_db["table"]
+    table.insert_all(({"id": i} for i in range(1, 4)), pk="id")
+
+    with pytest.raises(RuntimeError):
+        with fresh_db.atomic():
+            table.delete_where("id > ?", [1])
+            raise RuntimeError
+
+    assert list(table.rows) == [{"id": 1}, {"id": 2}, {"id": 3}]
+
