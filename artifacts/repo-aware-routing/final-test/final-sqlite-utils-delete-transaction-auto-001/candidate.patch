+
+
+@pytest.mark.parametrize("delete_method", ("delete", "delete_where"))
+def test_delete_persists_after_close(tmpdir, delete_method):
+    path = str(tmpdir / "data.db")
+    db = Database(path)
+    table = db["table"]
+    table.insert_all(({"id": i} for i in range(1, 3)), pk="id")
+    if delete_method == "delete":
+        table.delete(2)
+    else:
+        table.delete_where("id = ?", [2])
+    db.close()
+
+    assert list(Database(path)["table"].rows) == [{"id": 1}]
