diff --git a/tests/test_cli_migrate.py b/tests/test_cli_migrate.py
index 229bc9cdfec332678f85ca5f74d78ffe3a089cb1..f72a0dc33ca0710b4fae03b263ccbe9756015336 100644
--- a/tests/test_cli_migrate.py
+++ b/tests/test_cli_migrate.py
@@ -301,3 +301,108 @@ def test_stop_before_multiple_qualified(two_sets_same_migration_name):
     assert not db["creature_weights"].exists()
     assert db["sales"].exists()
     assert not db["sales_weights"].exists()
+
+
+@pytest.mark.parametrize(
+    "stop_before,expected_error",
+    (
+        ("unknown", "Unknown migration: unknown"),
+        ("hello:unknown", "Unknown migration: hello:unknown"),
+        ("unknown:foo", "Unknown migration: unknown:foo"),
+    ),
+)
+def test_stop_before_rejects_unknown_migration(
+    two_migrations, stop_before, expected_error
+):
+    path, migrations_py = two_migrations
+    db_path = str(path / "test.db")
+    result = CliRunner().invoke(
+        sqlite_utils.cli.cli,
+        [
+            "migrate",
+            db_path,
+            str(migrations_py),
+            "--stop-before",
+            stop_before,
+        ],
+    )
+    assert result.exit_code == 1
+    assert expected_error in result.output
+    assert sqlite_utils.Database(db_path).table_names() == []
+
+
+LEGACY_MIGRATIONS = """
+class Migration:
+    def __init__(self, name):
+        self.name = name
+
+class LegacyMigrations:
+    def __init__(self):
+        self.name = "legacy"
+        self._migrations = [Migration("foo"), Migration("bar")]
+
+    def applied(self, db):
+        return []
+
+    def pending(self, db):
+        return self._migrations
+
+    def apply(self, db, stop_before=None):
+        if stop_before is not None and not isinstance(stop_before, str):
+            raise TypeError("legacy stop_before must be a string")
+        for migration in self._migrations:
+            if migration.name == stop_before:
+                return
+            db[migration.name].create({"id": int})
+
+legacy = LegacyMigrations()
+"""
+
+
+@pytest.fixture
+def legacy_migrations(tmpdir):
+    path = pathlib.Path(tmpdir)
+    migrations_py = path / "migrations.py"
+    migrations_py.write_text(LEGACY_MIGRATIONS, "utf-8")
+    return path, migrations_py
+
+
+def test_stop_before_legacy_migration_set(legacy_migrations):
+    path, migrations_py = legacy_migrations
+    db_path = str(path / "test.db")
+    result = CliRunner().invoke(
+        sqlite_utils.cli.cli,
+        ["migrate", db_path, str(migrations_py), "--stop-before", "bar"],
+    )
+    assert result.exit_code == 0, result.output
+    assert sqlite_utils.Database(db_path).table_names() == ["foo"]
+
+
+def test_legacy_migration_set_without_stop_before(legacy_migrations):
+    path, migrations_py = legacy_migrations
+    db_path = str(path / "test.db")
+    result = CliRunner().invoke(
+        sqlite_utils.cli.cli, ["migrate", db_path, str(migrations_py)]
+    )
+    assert result.exit_code == 0, result.output
+    assert sqlite_utils.Database(db_path).table_names() == ["foo", "bar"]
+
+
+def test_stop_before_legacy_migration_set_rejects_multiple(legacy_migrations):
+    path, migrations_py = legacy_migrations
+    db_path = str(path / "test.db")
+    result = CliRunner().invoke(
+        sqlite_utils.cli.cli,
+        [
+            "migrate",
+            db_path,
+            str(migrations_py),
+            "--stop-before",
+            "foo",
+            "--stop-before",
+            "bar",
+        ],
+    )
+    assert result.exit_code == 1
+    assert "does not support multiple --stop-before values" in result.output
+    assert sqlite_utils.Database(db_path).table_names() == []
