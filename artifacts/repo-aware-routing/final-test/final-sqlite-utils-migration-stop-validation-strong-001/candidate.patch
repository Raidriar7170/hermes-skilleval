@@ -3347,6 +3347,53 @@ def _stop_before_for_migration_set(stop_before, migration_set_name):
     return matches
 
 
+def _migration_names(db, migration_set):
+    if isinstance(migration_set, sqlite_utils.Migrations):
+        return {migration.name for migration in migration_set._migrations}
+    return {
+        migration.name
+        for migration in itertools.chain(
+            migration_set.applied(db), migration_set.pending(db)
+        )
+    }
+
+
+def _validate_stop_before(db, migration_sets, stop_before):
+    names_by_set = [
+        (migration_set.name, _migration_names(db, migration_set))
+        for migration_set in migration_sets
+    ]
+    for value in stop_before:
+        set_name, separator, migration_name = value.partition(":")
+        if separator:
+            known = any(
+                set_name == candidate_set_name and migration_name in names
+                for candidate_set_name, names in names_by_set
+            )
+        else:
+            known = any(value in names for _, names in names_by_set)
+        if not known:
+            raise click.ClickException("Unknown migration: {}".format(value))
+
+    for migration_set in migration_sets:
+        matches = _stop_before_for_migration_set(stop_before, migration_set.name)
+        if not isinstance(migration_set, sqlite_utils.Migrations) and len(matches) > 1:
+            raise click.ClickException(
+                "Migration set '{}' does not support multiple --stop-before values".format(
+                    migration_set.name
+                )
+            )
+
+
+def _apply_migration_set(db, migration_set, stop_before):
+    matches = _stop_before_for_migration_set(stop_before, migration_set.name)
+    if isinstance(migration_set, sqlite_utils.Migrations):
+        stop_before_value = matches
+    else:
+        stop_before_value = matches[0] if matches else None
+    migration_set.apply(db, stop_before=stop_before_value)
+
+
