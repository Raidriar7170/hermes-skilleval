+@pytest.mark.parametrize("rename", [None, {"id": "item_id"}])
+def test_transform_preserves_autoincrement_high_water_mark(fresh_db, rename):
+    fresh_db.execute(
+        "CREATE TABLE items (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT)"
+    )
+    items = fresh_db.table("items")
+    items.insert_all([{"name": "one"}, {"name": "two"}, {"name": "three"}])
+    items.delete(3)
+
+    items.transform(rename=rename)
+
+    pk = "item_id" if rename else "id"
+    assert "AUTOINCREMENT" in items.schema
+    assert list(items.rows) == [
+        {pk: 1, "name": "one"},
+        {pk: 2, "name": "two"},
+    ]
+    items.insert({"name": "four"})
+    assert items.get(4) == {pk: 4, "name": "four"}
+
+
+def test_transform_non_autoincrement_table_still_works(fresh_db):
+    items = fresh_db.table("items")
+    items.insert_all([{"id": 1, "name": "one"}, {"id": 2, "name": "two"}], pk="id")
+    items.transform(rename={"name": "title"})
+    assert list(items.rows) == [
+        {"id": 1, "title": "one"},
+        {"id": 2, "title": "two"},
+    ]
+
+
+def test_transform_preserves_autoincrement_sequence_with_no_surviving_rows(fresh_db):
+    fresh_db.execute(
+        "CREATE TABLE items (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT)"
+    )
+    items = fresh_db.table("items")
+    items.insert({"name": "one"})
+    items.delete(1)
+
+    items.transform(rename={"name": "title"})
+    items.insert({"title": "two"})
+
+    assert items.get(2) == {"id": 2, "title": "two"}
+
+
+def test_transform_can_replace_autoincrement_primary_key(fresh_db):
+    fresh_db.execute(
+        "CREATE TABLE items (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT)"
+    )
+    items = fresh_db.table("items")
+    items.insert({"name": "one"})
+
+    items.transform(types={"id": str})
+
+    assert "AUTOINCREMENT" not in items.schema
+    assert items.get("1") == {"id": "1", "name": "one"}
+
