diff --git a/tests/test_transform.py b/tests/test_transform.py
index 6a8a1438ea357f8618a1ec25652591b68db4645b..01985ad7b9b2400f0da8a4ddad12e0c86cf6a4dc 100644
--- a/tests/test_transform.py
+++ b/tests/test_transform.py
@@ -1370,3 +1370,49 @@ def test_transform_refuses_to_drop_column_used_by_remaining_check(fresh_db):
     ):
         ranges.transform(drop={"maximum"})
     assert ranges.schema == schema_before
+
+
+def test_transform_preserves_autoincrement_sequence_and_rename(fresh_db):
+    fresh_db.execute(
+        "CREATE TABLE events (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT)"
+    )
+    events = fresh_db.table("events")
+    events.insert_all([{"name": "one"}, {"name": "two"}, {"name": "three"}])
+    events.delete(3)
+
+    events.transform(rename={"id": "event_id", "name": "title"})
+
+    assert "AUTOINCREMENT" in events.schema
+    assert list(events.rows) == [
+        {"event_id": 1, "title": "one"},
+        {"event_id": 2, "title": "two"},
+    ]
+    events.insert({"title": "four"})
+    assert events.last_pk == 4
+
+
+def test_transform_non_autoincrement_still_reuses_deleted_high_id(fresh_db):
+    fresh_db.execute("CREATE TABLE events (id INTEGER PRIMARY KEY, name TEXT)")
+    events = fresh_db.table("events")
+    events.insert_all([{"name": "one"}, {"name": "two"}])
+    events.delete(2)
+    events.transform(rename={"name": "title"})
+    events.insert({"title": "replacement"})
+    assert events.last_pk == 2
+
+
+@pytest.mark.parametrize(
+    "transform_kwargs,expected_id",
+    (({"pk": "name"}, 1), ({"types": {"id": str}}, "1")),
+)
+def test_transform_can_replace_autoincrement_primary_key(
+    fresh_db, transform_kwargs, expected_id
+):
+    fresh_db.execute(
+        "CREATE TABLE events (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT)"
+    )
+    events = fresh_db.table("events")
+    events.insert({"name": "one"})
+    events.transform(**transform_kwargs)
+    assert "AUTOINCREMENT" not in events.schema
+    assert list(events.rows) == [{"id": expected_id, "name": "one"}]
