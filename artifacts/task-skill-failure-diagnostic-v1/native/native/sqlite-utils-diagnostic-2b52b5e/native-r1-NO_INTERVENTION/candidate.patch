--- a/sqlite_utils/create_table_parser.py
+++ b/sqlite_utils/create_table_parser.py
@@ -279,6 +279,13 @@ def _meaningful(tokens: list[_Token]) -> list[_Token]:
     return [token for token in tokens if token.kind not in _TRIVIA]
 
 
+def has_autoincrement(create_sql: str) -> bool:
+    """Return True if CREATE TABLE SQL contains an AUTOINCREMENT keyword."""
+    return any(
+        token.is_keyword("AUTOINCREMENT") for token in _meaningful(_lex(create_sql))
+    )
+
+
 def _unquote(token: str) -> str:
     if len(token) >= 2 and token[0] in ("'", '"', "`") and token[-1] == token[0]:
         return token[1:-1].replace(token[0] * 2, token[0])
