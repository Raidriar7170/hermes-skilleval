+def index_references_identifier(create_sql: str, identifier: str) -> bool:
+    """Return ``True`` if an index body or WHERE clause uses an identifier.
+
+    The index and table names in the CREATE INDEX prefix are deliberately
+    ignored. This matters when either of those names is also a column name.
+    """
+    tokens = _meaningful(_lex(create_sql))
+    on_index = next(
+        (index for index, token in enumerate(tokens) if token.is_keyword("ON")),
+        None,
+    )
+    if on_index is None:
+        raise ParseError("CREATE INDEX statement does not contain ON")
+    open_index = next(
+        (
+            index
+            for index in range(on_index + 1, len(tokens))
+            if tokens[index].text == "("
+        ),
+        None,
+    )
+    if open_index is None:
+        raise ParseError("CREATE INDEX statement does not contain a column list")
+    folded = _ascii_fold(identifier)
+    relevant = tokens[open_index + 1 :]
+    return any(
+        _is_identifier_token(relevant, index)
+        and _ascii_fold(_unquote(token.text)) == folded
+        for index, token in enumerate(relevant)
+    )
+
