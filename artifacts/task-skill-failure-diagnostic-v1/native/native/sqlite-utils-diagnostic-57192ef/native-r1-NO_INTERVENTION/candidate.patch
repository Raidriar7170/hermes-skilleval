+def test_transform_rename_preserves_index_details_and_swapped_names(fresh_db):
+    fresh_db.execute(
+        'CREATE TABLE "inventory" ("inventory" TEXT, "first" TEXT, "second" TEXT)'
+    )
+    fresh_db.execute(
+        'CREATE UNIQUE INDEX "first" ON "inventory" '
+        '("first" COLLATE NOCASE DESC, "second" COLLATE RTRIM)'
+    )
+    table = fresh_db.table("inventory")
+    table.insert({"inventory": "row", "first": "A ", "second": "B "})
+
+    table.transform(
+        rename={"inventory": "item", "first": "second", "second": "first"}
+    )
+
+    index = next(index for index in table.indexes if index.name == "first")
+    assert index.unique == 1
+    assert index.columns == ["second", "first"]
+    assert [
+        (column.name, column.desc, column.coll)
+        for column in next(index for index in table.xindexes if index.name == "first").columns
+        if column.key
+    ] == [("second", 1, "NOCASE"), ("first", 0, "RTRIM")]
+    assert table.get(1) == {"item": "row", "second": "A ", "first": "B "}
+
