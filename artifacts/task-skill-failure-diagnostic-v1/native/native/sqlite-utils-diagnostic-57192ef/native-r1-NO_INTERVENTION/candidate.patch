+@pytest.mark.parametrize(
+    "index_sql",
+    [
+        "CREATE INDEX affected ON items(lower(name))",
+        "CREATE INDEX affected ON items(category) WHERE name IS NOT NULL",
+    ],
+)
+def test_transform_rename_refuses_affected_complex_index_atomically(
+    fresh_db, index_sql
+):
+    fresh_db.execute("CREATE TABLE items(name TEXT, category TEXT)")
+    fresh_db.execute(index_sql)
+    table = fresh_db.table("items")
+    table.insert({"name": "one", "category": "a"})
+    schema_before = table.schema
+
+    with pytest.raises(TransformError, match="partial or expression index affected"):
+        table.transform(rename={"name": "title"})
+
+    assert table.schema == schema_before
+    assert list(table.rows) == [{"name": "one", "category": "a"}]
+    assert fresh_db.execute(
+        "SELECT sql FROM sqlite_master WHERE name = 'affected'"
+    ).fetchone()[0] == index_sql
+
+
+def test_transform_rename_preserves_unaffected_complex_indexes(fresh_db):
+    fresh_db.execute("CREATE TABLE items(name TEXT, category TEXT, note TEXT)")
+    fresh_db.execute("CREATE INDEX expression_idx ON items(lower(name))")
+    fresh_db.execute(
+        "CREATE INDEX partial_idx ON items(category) WHERE name IS NOT NULL"
+    )
+
+    fresh_db.table("items").transform(rename={"note": "description"})
+
+    assert {
+        row[0]: row[1]
+        for row in fresh_db.execute(
+            "SELECT name, sql FROM sqlite_master WHERE type = 'index'"
+        ).fetchall()
+    } == {
+        "expression_idx": "CREATE INDEX expression_idx ON items(lower(name))",
+        "partial_idx": (
+            "CREATE INDEX partial_idx ON items(category) WHERE name IS NOT NULL"
+        ),
+    }
