+def test_transform_renames_indexed_columns_preserving_index_details(fresh_db):
+    fresh_db.execute(
+        'CREATE TABLE "items" ("left" TEXT, "right" TEXT, "items" TEXT)'
+    )
+    fresh_db.execute(
+        'CREATE UNIQUE INDEX "left" ON "items" '
+        '("left" COLLATE NOCASE DESC, "right" COLLATE RTRIM)'
+    )
+    items = fresh_db.table("items")
+    items.insert({"left": "a", "right": "b", "items": "c"})
+
+    items.transform(rename={"left": "right", "right": "left"})
+
+    assert list(items.rows) == [{"right": "a", "left": "b", "items": "c"}]
+    assert fresh_db.execute(
+        'SELECT sql FROM sqlite_master WHERE type = "index" AND name = "left"'
+    ).fetchone()[0] == (
+        'CREATE UNIQUE INDEX "left" ON "items" '
+        '("right" COLLATE "NOCASE" DESC, "left" COLLATE "RTRIM")'
+    )
+
+
+@pytest.mark.parametrize(
+    "index_sql",
+    [
+        "CREATE INDEX idx_items_name ON items(lower(name))",
+        "CREATE INDEX idx_items_name ON items(name) WHERE name != ''",
+    ],
+)
+def test_transform_refuses_rename_used_by_expression_or_partial_index(
+    fresh_db, index_sql
+):
+    fresh_db.execute("CREATE TABLE items(id INTEGER, name TEXT, untouched TEXT)")
+    fresh_db.execute(index_sql)
+    items = fresh_db.table("items")
+    items.insert({"id": 1, "name": "one", "untouched": "yes"})
+    schema_before = items.schema
+
+    with pytest.raises(TransformError, match="Cannot rename column 'name'"):
+        items.transform(rename={"name": "title"})
+
+    assert items.schema == schema_before
+    assert list(items.rows)[0]["name"] == "one"
+
+
+@pytest.mark.parametrize(
+    "index_sql",
+    [
+        'CREATE INDEX "name" ON items(lower(untouched))',
+        'CREATE INDEX "name" ON items(untouched) WHERE untouched != \'\'',
+    ],
+)
+def test_transform_preserves_unaffected_special_index_with_shared_name(
+    fresh_db, index_sql
+):
+    fresh_db.execute("CREATE TABLE items(name TEXT, untouched TEXT)")
+    fresh_db.execute(index_sql)
+
+    fresh_db.table("items").transform(rename={"name": "title"})
+
+    assert fresh_db.execute(
+        "SELECT sql FROM sqlite_master WHERE type = 'index' AND name = 'name'"
+    ).fetchone()[0] == index_sql
+
