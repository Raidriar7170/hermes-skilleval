+def test_extract_invalid_column(db_path):
+    db = Database(db_path)
+    db["trees"].insert({"id": 1, "species": "Palm"}, pk="id")
+
+    result = CliRunner().invoke(
+        cli.cli, ["extract", db_path, "trees", "missing"]
+    )
+
+    assert result.exit_code == 1
+    assert result.output == (
+        "Error: Invalid columns ['missing'] for table with columns "
+        "['id', 'species']\n"
+    )
+    assert list(db["trees"].rows) == [{"id": 1, "species": "Palm"}]
+    assert "missing" not in db.table_names()
+
+
+def test_extract_view(db_path):
+    db = Database(db_path)
+    db["trees"].insert({"id": 1, "species": "Palm"}, pk="id")
+    db.create_view("tree_view", "select * from trees")
+
+    result = CliRunner().invoke(
+        cli.cli, ["extract", db_path, "tree_view", "species"]
+    )
+
+    assert result.exit_code == 1
+    assert result.output == "Error: Table tree_view is actually a view\n"
+    assert list(db["trees"].rows) == [{"id": 1, "species": "Palm"}]
+    assert "species" not in db.table_names()
+
