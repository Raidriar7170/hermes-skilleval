+@pytest.mark.parametrize("command", ("insert", "upsert"))
+def test_insert_upsert_invalid_pk_existing_table(db_path, command):
+    db = Database(db_path)
+    db["dogs"].insert({"id": 1, "name": "Cleo"}, pk="id")
+
+    result = CliRunner().invoke(
+        cli.cli,
+        [command, db_path, "dogs", "-", "--pk", "missing"],
+        input='[{"id": 2, "name": "Nixie"}]',
+    )
+
+    assert result.exit_code == 1
+    assert result.output == (
+        "Error: Invalid primary key column ['missing'] for table dogs "
+        "with columns ['id', 'name']\n"
+    )
+    assert list(db["dogs"].rows) == [{"id": 1, "name": "Cleo"}]
+
