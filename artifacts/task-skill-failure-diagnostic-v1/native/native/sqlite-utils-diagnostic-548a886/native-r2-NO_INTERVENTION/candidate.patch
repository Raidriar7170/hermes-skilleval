+@pytest.mark.parametrize("command", ("insert", "upsert"))
+def test_insert_upsert_invalid_pk_existing_table(db_path, command):
+    db = Database(db_path)
+    db["items"].insert({"id": 1, "name": "One"}, pk="id")
+
+    result = CliRunner().invoke(
+        cli.cli,
+        [command, db_path, "items", "-", "--pk", "missing"],
+        input=json.dumps({"id": 2, "name": "Two"}),
+        catch_exceptions=False,
+    )
+
+    assert result.exit_code == 1
+    assert result.output == (
+        "Error: Invalid primary key column ['missing'] for table items "
+        "with columns ['id', 'name']\n"
+    )
+    assert list(db["items"].rows) == [{"id": 1, "name": "One"}]
+
