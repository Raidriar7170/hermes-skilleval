--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,6 +1,7 @@
 import unittest
 
 from csvkit.cli import match_column_identifier, parse_column_identifiers
+from csvkit.exceptions import ColumnIdentifierError
 
 
 class TestCli(unittest.TestCase):
@@ -53,6 +54,40 @@ class TestCli(unittest.TestCase):
             [],
             parse_column_identifiers('nope,missing', self.headers, ignore_unknown_columns=True),
         )
+        self.assertEqual(
+            [0, 4, 1],
+            parse_column_identifiers(
+                'id,unknown-name,more-header-values,unknown:name,name',
+                self.headers,
+                ignore_unknown_columns=True,
+            ),
+        )
+        self.assertEqual(
+            [0, 1, 2],
+            parse_column_identifiers('unknown-name,1:3', self.headers, ignore_unknown_columns=True),
+        )
+
+    def test_invalid_range(self):
+        for identifier in ('unknown-name', 'unknown:name'):
+            with self.subTest(identifier=identifier):
+                with self.assertRaisesRegex(ColumnIdentifierError, identifier):
+                    parse_column_identifiers(identifier, self.headers)
+
+    def test_invalid_excluded_range(self):
+        for identifier in ('unknown-name', 'unknown:name'):
+            with self.subTest(identifier=identifier):
+                with self.assertRaisesRegex(ColumnIdentifierError, identifier):
+                    parse_column_identifiers('id,name', self.headers, excluded_columns=identifier)
+
+        self.assertEqual(
+            [0, 1],
+            parse_column_identifiers(
+                'id,name',
+                self.headers,
+                excluded_columns='unknown-name,unknown:name',
+                ignore_unknown_columns=True,
+            ),
+        )
 
     def test_range_notation_open_ended(self):
         self.assertEqual([0, 1, 2], parse_column_identifiers(':3', self.headers))
