+def test_compound_primary_key_declaration_order_is_preserved():
+    db = Database(memory=True)
+    db.executescript("""
+    CREATE TABLE parents (
+        first TEXT NOT NULL,
+        second TEXT NOT NULL,
+        label TEXT,
+        PRIMARY KEY (second, first)
+    );
+    CREATE TABLE children (
+        id INTEGER PRIMARY KEY,
+        parent_second TEXT NOT NULL,
+        parent_first TEXT NOT NULL,
+        note TEXT,
+        FOREIGN KEY (parent_second, parent_first) REFERENCES parents
+    );
+    """)
+    db.execute("PRAGMA foreign_keys = ON")
+
+    assert db["parents"].pks == ["second", "first"]
+    assert db["children"].foreign_keys[0].other_columns == ("second", "first")
+
+    db["parents"].insert({"first": "A", "second": "B", "label": "valid"})
+    db["children"].insert(
+        {"id": 1, "parent_second": "B", "parent_first": "A", "note": "before"}
+    )
+    db["children"].transform(rename={"note": "description"})
+    assert db["children"].get(1)["description"] == "before"
+    assert db["children"].foreign_keys[0].other_columns == ("second", "first")
+    db["children"].insert(
+        {"id": 2, "parent_second": "B", "parent_first": "A"}
+    )
+    with pytest.raises(sqlite3.IntegrityError):
+        db["children"].insert(
+            {"id": 3, "parent_second": "A", "parent_first": "B"}
+        )
+
+
+def test_compound_foreign_key_inference_uses_pk_declaration_order():
+    db = Database(memory=True)
+    db.executescript("""
+    CREATE TABLE parents (
+        first TEXT NOT NULL,
+        second TEXT NOT NULL,
+        PRIMARY KEY (second, first)
+    );
+    """)
+    columns = {"id": int, "parent_second": str, "parent_first": str}
+    local_columns = ("parent_second", "parent_first")
+
+    db.create_table(
+        "created_children",
+        columns,
+        pk="id",
+        foreign_keys=[(local_columns, "parents")],
+    )
+    assert db["created_children"].foreign_keys[0].other_columns == (
+        "second",
+        "first",
+    )
+
+    db.create_table("altered_children", columns, pk="id")
+    db["altered_children"].add_foreign_key(local_columns, "parents")
+    assert db["altered_children"].foreign_keys[0].other_columns == (
+        "second",
+        "first",
+    )
+
+
