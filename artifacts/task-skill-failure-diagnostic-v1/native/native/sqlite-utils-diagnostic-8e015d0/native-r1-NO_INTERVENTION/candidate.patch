+def test_compound_primary_key_uses_declaration_order():
+    db = Database(memory=True)
+    db.executescript("""
+    CREATE TABLE parents (
+        first TEXT NOT NULL,
+        second TEXT NOT NULL,
+        PRIMARY KEY (second, first)
+    );
+    CREATE TABLE children (
+        id INTEGER PRIMARY KEY,
+        parent_second TEXT,
+        parent_first TEXT,
+        FOREIGN KEY (parent_second, parent_first) REFERENCES parents
+    );
+    """)
+    assert db["parents"].pks == ["second", "first"]
+    assert db["children"].foreign_keys[0].other_columns == ("second", "first")
+
+
+@pytest.mark.parametrize("method", ("create", "add"))
+def test_compound_foreign_key_inference_uses_pk_declaration_order(method):
+    db = Database(memory=True)
+    db.executescript("""
+    CREATE TABLE parents (
+        first TEXT NOT NULL,
+        second TEXT NOT NULL,
+        PRIMARY KEY (second, first)
+    );
+    """)
+    columns = {"id": int, "parent_second": str, "parent_first": str}
+    if method == "create":
+        db.create_table(
+            "children",
+            columns,
+            pk="id",
+            foreign_keys=[(("parent_second", "parent_first"), "parents")],
+        )
+    else:
+        db.create_table("children", columns, pk="id")
+        db["children"].add_foreign_key(
+            ("parent_second", "parent_first"), "parents"
+        )
+    assert db["children"].foreign_keys[0].other_columns == ("second", "first")
+
+
+def test_transform_preserves_reordered_implicit_compound_foreign_key():
+    db = Database(memory=True)
+    db.execute("PRAGMA foreign_keys = ON")
+    db.executescript("""
+    CREATE TABLE parents (
+        first TEXT NOT NULL,
+        second TEXT NOT NULL,
+        PRIMARY KEY (second, first)
+    );
+    CREATE TABLE children (
+        id INTEGER PRIMARY KEY,
+        label TEXT,
+        parent_second TEXT,
+        parent_first TEXT,
+        FOREIGN KEY (parent_second, parent_first) REFERENCES parents
+    );
+    INSERT INTO parents (first, second) VALUES ('one', 'two');
+    INSERT INTO children VALUES (1, 'valid', 'two', 'one');
+    """)
+
+    db["children"].transform(rename={"label": "name"})
+
+    assert db["children"].get(1)["name"] == "valid"
+    assert db["children"].foreign_keys[0].other_columns == ("second", "first")
+    with pytest.raises(sqlite3.IntegrityError):
+        db["children"].insert(
+            {
+                "id": 2,
+                "name": "reversed",
+                "parent_second": "one",
+                "parent_first": "two",
+            }
+        )
+
