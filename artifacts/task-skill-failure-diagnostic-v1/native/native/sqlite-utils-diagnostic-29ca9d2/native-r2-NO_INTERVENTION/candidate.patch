+def test_create_table_with_mixed_foreign_key_forms(fresh_db):
+    for table_name in ("one", "two", "three"):
+        fresh_db[table_name].insert({"id": 1}, pk="id")
+
+    fresh_db["m2m"].insert(
+        {"one_id": 1, "two_id": 1, "three_id": 1},
+        foreign_keys=[
+            ForeignKey("m2m", "one_id", "one", "id"),
+            ("two_id", "two", "id"),
+            "three_id",
+        ],
+    )
+
+    assert {
+        (fk.column, fk.other_table, fk.other_column)
+        for fk in fresh_db["m2m"].foreign_keys
+    } == {
+        ("one_id", "one", "id"),
+        ("two_id", "two", "id"),
+        ("three_id", "three", "id"),
+    }
+
+
+def test_create_table_with_mixed_foreign_key_forms_rejects_invalid_entry(fresh_db):
+    fresh_db["one"].insert({"id": 1}, pk="id")
+    with pytest.raises(ValueError):
+        fresh_db["m2m"].insert(
+            {"one_id": 1, "two_id": 1},
+            foreign_keys=[("one_id", "one", "id"), {"two_id": "two"}],
+        )
+
+
