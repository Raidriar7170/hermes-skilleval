+@pytest.mark.parametrize("method", ("insert", "upsert"))
+def test_insert_upsert_strict_any_type(tmpdir, method):
+    db_path = str(tmpdir / "test.db")
+    db = Database(db_path)
+    if not db.supports_strict:
+        pytest.skip("SQLite version does not support strict tables")
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            method,
+            db_path,
+            "items",
+            "-",
+            "--pk",
+            "id",
+            "--type",
+            "value",
+            "any",
+            "--strict",
+        ],
+        input='[{"id": 1, "value": "001"}]',
+    )
+    assert result.exit_code == 0, result.output
+    assert db.table("items").columns_dict == {"id": int, "value": "ANY"}
+    assert db.table("items").get(1)["value"] == "001"
+
+
+def test_cli_create_add_column_and_transform_any(tmpdir):
+    db_path = str(tmpdir / "test.db")
+    db = Database(db_path)
+    if not db.supports_strict:
+        pytest.skip("SQLite version does not support strict tables")
+    runner = CliRunner()
+    result = runner.invoke(
+        cli.cli,
+        ["create-table", db_path, "items", "id", "integer", "value", "any", "--strict"],
+    )
+    assert result.exit_code == 0, result.output
+    result = runner.invoke(cli.cli, ["add-column", db_path, "items", "extra", "ANY"])
+    assert result.exit_code == 0, result.output
+    db.table("items").insert({"id": 1, "value": "001", "extra": b"bytes"})
+    result = runner.invoke(
+        cli.cli, ["transform", db_path, "items", "--type", "value", "any"]
+    )
+    assert result.exit_code == 0, result.output
+    assert db.table("items").strict is True
+    assert db.table("items").columns_dict == {
+        "id": int,
+        "value": "ANY",
+        "extra": "ANY",
+    }
+    assert db.table("items").get(1) == {
+        "id": 1,
+        "value": "001",
+        "extra": b"bytes",
+    }
+
+
