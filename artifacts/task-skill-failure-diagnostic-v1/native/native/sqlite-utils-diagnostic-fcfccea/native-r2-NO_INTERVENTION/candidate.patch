diff --git a/tests/test_any.py b/tests/test_any.py
new file mode 100644
index 0000000000000000000000000000000000000000..199c89bda2027bc0f39ef5d99c26418fd7959eeb
--- /dev/null
+++ b/tests/test_any.py
@@ -0,0 +1,144 @@
+import sqlite3
+
+import pytest
+from click.testing import CliRunner
+
+import sqlite_utils
+from sqlite_utils import ANY, Database
+from sqlite_utils import cli
+from sqlite_utils.db import InvalidColumns
+
+
+def storage_classes(db, table, column):
+    return db.execute(
+        'select typeof("{column}"), "{column}" from "{table}" order by id'.format(
+            column=column, table=table
+        )
+    ).fetchall()
+
+
+def test_any_is_public_and_accepts_both_string_casings(fresh_db):
+    assert sqlite_utils.ANY is ANY
+    fresh_db["items"].create(
+        {"upper": ANY, "lower": "any"},
+        strict=True,
+    )
+    assert fresh_db["items"].columns_dict == {"upper": ANY, "lower": ANY}
+    fresh_db["items"].add_column("added", ANY)
+    assert fresh_db["items"].columns[-1].type == "ANY"
+
+
+def test_strict_any_preserves_storage_classes(fresh_db):
+    table = fresh_db["items"].create(
+        {"id": int, "value": ANY}, pk="id", strict=True
+    )
+    values = [1, 1.5, "text", "000123", sqlite3.Binary(b"blob"), None]
+    table.insert_all({"id": i, "value": value} for i, value in enumerate(values))
+    assert storage_classes(fresh_db, "items", "value") == [
+        ("integer", 1),
+        ("real", 1.5),
+        ("text", "text"),
+        ("text", "000123"),
+        ("blob", b"blob"),
+        ("null", None),
+    ]
+
+
+def test_any_transform_preserves_type_and_strictness(fresh_db):
+    table = fresh_db["items"].create(
+        {"id": int, "value": ANY}, pk="id", strict=True
+    )
+    table.insert({"id": 1, "value": "000123"})
+    table.transform(rename={"value": "renamed"})
+    assert table.strict is True
+    assert table.columns_dict["renamed"] == ANY
+    assert storage_classes(fresh_db, "items", "renamed") == [("text", "000123")]
+
+    # Explicit conversion to an ordinary table applies ordinary ANY numeric affinity.
+    table.transform(strict=False)
+    assert table.strict is False
+    assert table.columns_dict["renamed"] == ANY
+    assert storage_classes(fresh_db, "items", "renamed") == [("integer", 123)]
+
+
+def test_extract_strict_any_preserves_type_strictness_and_values(fresh_db):
+    table = fresh_db["items"].create(
+        {"id": int, "value": ANY}, pk="id", strict=True
+    )
+    table.insert_all(
+        [
+            {"id": 1, "value": "000123"},
+            {"id": 2, "value": 123},
+            {"id": 3, "value": sqlite3.Binary(b"123")},
+            {"id": 4, "value": None},
+        ]
+    )
+    table.extract("value")
+    lookup = fresh_db["value"]
+    assert table.strict is True
+    assert lookup.strict is True
+    assert lookup.columns_dict["value"] == ANY
+    assert storage_classes(fresh_db, "value", "value") == [
+        ("text", "000123"),
+        ("integer", 123),
+        ("blob", b"123"),
+    ]
+
+
+def test_extract_strict_any_rejects_existing_non_strict_lookup(fresh_db):
+    source = fresh_db["source"].create(
+        {"id": int, "value": ANY}, pk="id", strict=True
+    )
+    source.insert({"id": 1, "value": "000123"})
+    lookup = fresh_db["lookup"].create({"id": int, "value": ANY}, pk="id")
+
+    with pytest.raises(InvalidColumns, match="is not STRICT"):
+        source.extract("value", table="lookup")
+
+    assert lookup.count == 0
+    assert source.columns_dict == {"id": int, "value": ANY}
+
+
+@pytest.mark.parametrize("command", ("insert", "upsert"))
+def test_cli_insert_upsert_any_type(tmpdir, command):
+    path = str(tmpdir / "data.db")
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            command,
+            path,
+            "items",
+            "-",
+            "--nl",
+            "--pk",
+            "id",
+            "--type",
+            "value",
+            "any",
+            "--strict",
+        ],
+        input='{"id": 1, "value": "000123"}\n',
+    )
+    assert result.exit_code == 0, result.output
+    db = Database(path)
+    assert db["items"].columns_dict["value"] == ANY
+    assert storage_classes(db, "items", "value") == [("text", "000123")]
+
+
+def test_cli_create_table_and_transform_any(tmpdir):
+    path = str(tmpdir / "data.db")
+    runner = CliRunner()
+    result = runner.invoke(
+        cli.cli,
+        ["create-table", path, "items", "id", "integer", "value", "any", "--strict"],
+    )
+    assert result.exit_code == 0, result.output
+    db = Database(path)
+    db["items"].insert({"id": 1, "value": "000123"})
+    result = runner.invoke(
+        cli.cli, ["transform", path, "items", "--type", "value", "ANY"]
+    )
+    assert result.exit_code == 0, result.output
+    assert db["items"].strict is True
+    assert db["items"].columns_dict["value"] == ANY
+    assert storage_classes(db, "items", "value") == [("text", "000123")]
