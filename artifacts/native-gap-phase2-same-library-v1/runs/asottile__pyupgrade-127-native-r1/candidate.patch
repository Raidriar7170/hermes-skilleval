--- a/pyupgrade.py
+++ b/pyupgrade.py
@@ -548,6 +548,15 @@ def _fix_extraneous_parens(tokens, i):
         return
 
     start = i
+    # A yield expression needs its own parentheses when used as a call arg.
+    # Removing them would turn f((yield x)) into invalid f(yield x).
+    i += 1
+    while tokens[i].name in NON_CODING_TOKENS:
+        i += 1
+    if tokens[i].src == 'yield':
+        return
+
+    i = start
     depth = 1
     while depth:
         i += 1
