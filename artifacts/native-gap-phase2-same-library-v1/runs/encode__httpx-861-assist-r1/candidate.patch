diff --git a/tests/test_content_streams.py b/tests/test_content_streams.py
index 6aa91f4..d58ca3a 100644
--- a/tests/test_content_streams.py
+++ b/tests/test_content_streams.py
@@ -112,6 +112,31 @@ async def test_urlencoded_content():
     assert async_content == b"Hello=world%21"
 
 
+@pytest.mark.parametrize(
+    "data,expected_content",
+    [({}, b""), ({"Hello": "world!"}, b"Hello=world%21")],
+)
+@pytest.mark.asyncio
+async def test_empty_files_use_urlencoded_content(data, expected_content):
+    stream = encode(data=data, files={}, boundary=b"+++")
+
+    assert stream.get_headers() == {
+        "Content-Length": str(len(expected_content)),
+        "Content-Type": "application/x-www-form-urlencoded",
+    }
+    assert b"".join(stream) == expected_content
+    assert b"".join([part async for part in stream]) == expected_content
+
+
+@pytest.mark.asyncio
+async def test_empty_files_without_data_have_empty_content():
+    stream = encode(files={}, boundary=b"+++")
+
+    assert stream.get_headers() == {}
+    assert b"".join(stream) == b""
+    assert b"".join([part async for part in stream]) == b""
+
+
