+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "data, expected_content",
+    [({}, b""), ({"Hello": "world!"}, b"Hello=world%21")],
+)
+async def test_empty_files_content(data, expected_content):
+    stream = encode(data=data, files={}, boundary=b"+++")
+    sync_content = b"".join(stream)
+    async_content = b"".join([part async for part in stream])
+
+    assert stream.get_headers() == {
+        "Content-Length": str(len(expected_content)),
+        "Content-Type": "application/x-www-form-urlencoded",
+    }
+    assert sync_content == expected_content
+    assert async_content == expected_content
+
+
