diff --git a/tests/models/test_queryparams.py b/tests/models/test_queryparams.py
index 29b2ca6..5299dea 100644
--- a/tests/models/test_queryparams.py
+++ b/tests/models/test_queryparams.py
@@ -76,6 +76,38 @@ def test_queryparam_types():
     assert str(q) == "a=1&a=2"
 
 
+@pytest.mark.parametrize(
+    "source, expected",
+    [
+        ({b"testparam": b"testvalue"}, "testparam=testvalue"),
+        ({"key": b"value"}, "key=value"),
+        ({b"key": [b"one", b"two"]}, "key=one&key=two"),
+        ([(b"key", b"one"), (b"key", b"two")], "key=one&key=two"),
+        ([("key", "one"), (b"key", b"two")], "key=one&key=two"),
+        ({"key": "one", b"key": b"two"}, "key=one&key=two"),
+        ({b"caf\xc3\xa9": b"\xc3\xa9"}, "caf%C3%A9=%C3%A9"),
+        ({b"key": b"\xff"}, "key=%FF"),
+    ],
+)
+def test_queryparam_bytes(source, expected):
+    params = httpx.QueryParams(source)
+    assert str(params) == expected
+    assert str(httpx.URL("https://example.org", params=source)) == (
+        "https://example.org?" + expected
+    )
+    assert str(httpx.QueryParams(expected)) == expected
+
+
+def test_queryparam_bytes_set_add_remove():
+    params = httpx.QueryParams().set(b"key", b"one").add(b"key", b"two")
+    assert b"key" in params
+    assert params[b"key"] == "one"
+    assert params.get(b"key") == "one"
+    assert params.get_list(b"key") == ["one", "two"]
+    assert str(params) == "key=one&key=two"
+    assert str(params.remove(b"key")) == ""
+
+
 def test_empty_query_params():
     q = httpx.QueryParams({"a": ""})
     assert str(q) == "a="
