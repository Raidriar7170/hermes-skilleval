@@ -76,6 +76,34 @@ def test_queryparam_types():
     assert str(q) == "a=1&a=2"
 
 
+@pytest.mark.parametrize(
+    "source",
+    [
+        {b"testparam": b"testvalue"},
+        {b"testparam": "testvalue"},
+        {"testparam": b"testvalue"},
+        [(b"testparam", b"testvalue")],
+        {b"testparam": [b"testvalue"]},
+    ],
+)
+def test_queryparams_bytes(source):
+    q = httpx.QueryParams(source)
+    assert q.multi_items() == [("testparam", "testvalue")]
+    assert str(q) == "testparam=testvalue"
+
+
+def test_queryparams_utf8_bytes():
+    q = httpx.QueryParams({"café".encode(): "naïve".encode()})
+    assert q.multi_items() == [("café", "naïve")]
+    assert str(q) == "caf%C3%A9=na%C3%AFve"
+
+
+def test_queryparams_non_utf8_bytes():
+    q = httpx.QueryParams({b"\xff": b"\xfe"})
+    assert str(q) == "%FF=%FE"
+    assert httpx.QueryParams(str(q)) == q
+
+
