+def test_queryparam_set_and_add_bytes():
+    q = httpx.QueryParams({b"a": b"123"})
+    assert q[b"a"] == "123"
+    assert q.get(b"a") == "123"
+    assert q.get_list(b"a") == ["123"]
+    assert q.set(b"a", b"456") == httpx.QueryParams("a=456")
+    assert q.add(b"a", b"456") == httpx.QueryParams("a=123&a=456")
+    assert q.remove(b"a") == httpx.QueryParams("")
+
