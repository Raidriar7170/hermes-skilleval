diff --git a/tests/models/test_queryparams.py b/tests/models/test_queryparams.py
index 29b2ca6..325c3b0 100644
--- a/tests/models/test_queryparams.py
+++ b/tests/models/test_queryparams.py
@@ -76,6 +76,37 @@ def test_queryparam_types():
     assert str(q) == "a=1&a=2"
 
 
+@pytest.mark.parametrize(
+    "source",
+    [
+        {b"testparam": b"testvalue"},
+        [(b"testparam", b"testvalue")],
+    ],
+)
+def test_queryparams_bytes(source):
+    q = httpx.QueryParams(source)
+    assert str(q) == "testparam=testvalue"
+    assert q["testparam"] == "testvalue"
+    assert q[b"testparam"] == "testvalue"
+    assert q.get(b"testparam") == "testvalue"
+    assert q.get_list(b"testparam") == ["testvalue"]
+    assert q == httpx.QueryParams("testparam=testvalue")
+
+
+def test_queryparams_non_utf8_bytes():
+    q = httpx.QueryParams({b"\xff": [b"\xfe", "é"]})
+    assert str(q) == "%FF=%FE&%FF=%C3%A9"
+    assert httpx.QueryParams(str(q)) == q
+
+
+def test_queryparams_bytes_manipulation():
+    q = httpx.QueryParams({b"a": b"1"})
+    assert str(q.set(b"a", b"2")) == "a=2"
+    assert str(q.add(b"a", b"2")) == "a=1&a=2"
+    assert str(q.remove(b"a")) == ""
+    assert str(q.merge({b"b": b"3"})) == "a=1&b=3"
+
+
 def test_empty_query_params():
     q = httpx.QueryParams({"a": ""})
     assert str(q) == "a="
