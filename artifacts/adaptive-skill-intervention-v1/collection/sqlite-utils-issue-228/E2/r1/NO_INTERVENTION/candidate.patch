index 3ac5c4bd54a67c233f0f4952726a0ced33d43692..15fbdb93521a79bd6f7e330615c642b72fbe1e6b 100644
--- a/docs/cli.rst
+++ b/docs/cli.rst
@@ -487,6 +487,12 @@ For tab-delimited data, use ``--tsv``::
 
     $ sqlite-utils insert dogs.db dogs dogs.tsv --tsv
 
+If the file does not include a header row, use ``--no-headers``. Generated
+column names such as ``column1`` and ``column2`` will be used, and every row
+in the file will be imported::
+
+    $ sqlite-utils insert dogs.db dogs dogs.csv --csv --no-headers
+
 Data is expected to be encoded as Unicode UTF-8. If your data is an another character encoding you can specify it using the ``--encoding`` option::
 
     $ sqlite-utils insert dogs.db dogs dogs.tsv --tsv --encoding=latin-1
