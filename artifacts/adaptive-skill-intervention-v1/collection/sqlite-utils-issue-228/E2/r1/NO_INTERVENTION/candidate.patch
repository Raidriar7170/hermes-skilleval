+@pytest.mark.parametrize(
+    "content,format",
+    [
+        ('1,2,"cat,dog"\n3,4,bird', "--csv"),
+        ("1\t2\tcat,dog\n3\t4\tbird", "--tsv"),
+    ],
+)
+def test_insert_csv_tsv_no_headers(content, format, db_path, tmpdir):
+    db = Database(db_path)
+    file_path = str(tmpdir / "insert.csv-tsv")
+    open(file_path, "w").write(content)
+    result = CliRunner().invoke(
+        cli.cli,
+        ["insert", db_path, "data", file_path, format, "--no-headers"],
+        catch_exceptions=False,
+    )
+    assert 0 == result.exit_code
+    assert [
+        {"column1": "1", "column2": "2", "column3": "cat,dog"},
+        {"column1": "3", "column2": "4", "column3": "bird"},
+    ] == list(db["data"].rows)
+
