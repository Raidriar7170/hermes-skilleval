+@pytest.mark.parametrize(
+    "content,format_option,expected_first_row",
+    [
+        (
+            'first,second,"third, value"\nfourth,fifth,sixth',
+            "--csv",
+            ["first", "second", "third, value"],
+        ),
+        (
+            "first\tsecond\tthird\nfourth\tfifth\tsixth",
+            "--tsv",
+            ["first", "second", "third"],
+        ),
+    ],
+)
+def test_insert_csv_tsv_no_headers(
+    content, format_option, expected_first_row, db_path, tmpdir
+):
+    file_path = str(tmpdir / "insert-no-headers")
+    open(file_path, "w").write(content)
+    result = CliRunner().invoke(
+        cli.cli,
+        ["insert", db_path, "data", file_path, format_option, "--no-headers"],
+        catch_exceptions=False,
+    )
+    assert 0 == result.exit_code
+    rows = list(Database(db_path)["data"].rows)
+    assert 2 == len(rows)
+    assert expected_first_row == list(rows[0].values())
+    assert ["fourth", "fifth", "sixth"] == list(rows[1].values())
+
