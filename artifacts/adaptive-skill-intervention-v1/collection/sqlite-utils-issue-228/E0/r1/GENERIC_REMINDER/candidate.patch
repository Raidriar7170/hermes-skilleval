+@pytest.mark.parametrize(
+    "separator,option",
+    ((",", "--csv"), ("\t", "--tsv")),
+)
+def test_insert_csv_tsv_no_headers(separator, option, db_path, tmpdir):
+    db = Database(db_path)
+    file_path = str(tmpdir / "insert.csv-tsv")
+    open(file_path, "w").write(
+        separator.join(("one", "two", "three"))
+        + "\n"
+        + separator.join(("four", "five", "six"))
+    )
+    result = CliRunner().invoke(
+        cli.cli,
+        ["insert", db_path, "data", file_path, option, "--no-headers"],
+        catch_exceptions=False,
+    )
+    assert 0 == result.exit_code
+    assert [
+        {"column1": "one", "column2": "two", "column3": "three"},
+        {"column1": "four", "column2": "five", "column3": "six"},
+    ] == list(db["data"].rows)
+
