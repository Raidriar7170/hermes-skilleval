+++ b/tests/test_cli_entrypoints.py
@@ -0,0 +1,19 @@
+import subprocess
+import sys
+
+import pytest
+
+
+@pytest.mark.parametrize("module", ("sqlite_utils", "sqlite_utils.cli"))
+def test_python_m_entrypoint(module):
+    result = subprocess.run(
+        [sys.executable, "-m", module, "--help"],
+        capture_output=True,
+        encoding="utf-8",
+    )
+
+    assert result.returncode == 0
+    assert result.stdout.startswith("Usage: ")
+    assert "Commands:" in result.stdout
+    assert "  insert" in result.stdout
+    assert result.stderr == ""
