+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = runner.invoke(
+            cli.cli,
+            ["create-table", "test.db", "t", "id", "integer", "--strict"],
+            catch_exceptions=False,
+        )
+        assert result.exit_code == 0
+        assert Database("test.db")["t"].strict
+
+
+@pytest.mark.parametrize("command", ("insert", "upsert"))
+def test_insert_upsert_strict(command):
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = runner.invoke(
+            cli.cli,
+            [command, "test.db", "t", "-", "--pk", "id", "--strict"],
+            input='[{"id": 1, "name": "Cleo"}]',
+            catch_exceptions=False,
+        )
+        assert result.exit_code == 0
+        assert Database("test.db")["t"].strict
