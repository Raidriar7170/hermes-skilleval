diff --git a/tests/test_create.py b/tests/test_create.py
index 187d20a97c9012c186d3c8cd1ed2b4f58867b367..292b8b54607249c9caa1ca9e10c814de4c7953d7 100644
--- a/tests/test_create.py
+++ b/tests/test_create.py
@@ -60,6 +60,46 @@ def test_create_table(fresh_db):
     ) == table.schema
 
 
+def test_create_strict_table(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table", {"name": str, "score": float}, strict=True
+    )
+    assert table.strict
+    assert table.schema.endswith(") STRICT")
+    assert "[score] REAL" in table.schema
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"name": "bad", "score": "not a number"})
+
+
+def test_insert_creates_strict_table(fresh_db):
+    table = fresh_db["strict_table"].insert(
+        {"name": "Cleo", "score": 3.5}, strict=True
+    )
+    assert table.strict
+    assert table.columns_dict["score"] is float
+
+
+def test_strict_as_table_default(fresh_db):
+    table = fresh_db.table("strict_table", strict=True).insert(
+        {"name": "Cleo", "score": 3.5}
+    )
+    assert table.strict
+
+
+def test_non_strict_table_strict_property(fresh_db):
+    table = fresh_db["regular_table"].insert({"name": "Cleo"})
+    assert not table.strict
+
+
+def test_transform_preserves_strict(fresh_db):
+    table = fresh_db["strict_table"].create(
+        {"id": int, "name": str}, pk="id", strict=True
+    )
+    table.transform(rename={"name": "title"})
+    assert table.strict
+    assert table.schema.endswith(") STRICT")
+
+
 def test_create_table_compound_primary_key(fresh_db):
