--- a/tests/test_create.py
+++ b/tests/test_create.py
@@ -60,6 +60,63 @@ def test_create_table(fresh_db):
     ) == table.schema
 
 
+def test_create_strict_table(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table", {"name": str, "score": float}, strict=True
+    )
+    assert table.strict
+    assert table.schema.endswith(") STRICT")
+    assert "[score] REAL" in table.schema
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"name": "bad", "score": "not a number"})
+
+
+def test_insert_creates_strict_table(fresh_db):
+    table = fresh_db["strict_table"].insert(
+        {"name": "Cleo", "score": 3.5}, strict=True
+    )
+    assert table.strict
+    assert table.columns_dict["score"] is float
+
+
+def test_strict_table_sqlite_types(fresh_db):
+    table = fresh_db.create_table(
+        "strict_types",
+        {"id": "INT", "score": "REAL", "value": "ANY"},
+        strict=True,
+    )
+    assert "[id] INT" in table.schema
+    assert "[score] REAL" in table.schema
+    assert "[value] ANY" in table.schema
+
+
+def test_lookup_creates_strict_table(fresh_db):
+    fresh_db["species"].lookup({"name": "Palm"}, strict=True)
+    assert fresh_db["species"].strict
+
+
+def test_transform_preserves_strict(fresh_db):
+    table = fresh_db["items"].insert({"id": 1, "name": "One"}, strict=True)
+    table.transform(rename={"name": "title"})
+    assert table.strict
+    assert list(table.rows) == [{"id": 1, "title": "One"}]
+
+
+def test_alter_strict_table_adds_real_column(fresh_db):
+    table = fresh_db["items"].insert({"id": 1}, strict=True)
+    table.insert({"id": 2, "score": 3.5}, alter=True)
+    assert table.strict
+    assert table.columns_dict["score"] is float
+    assert "[score] REAL" in table.schema
+
+
+def test_strict_property_with_without_rowid(fresh_db):
+    fresh_db.execute(
+        "CREATE TABLE combo (id INTEGER PRIMARY KEY) STRICT, WITHOUT ROWID"
+    )
+    assert fresh_db["combo"].strict
+
+
