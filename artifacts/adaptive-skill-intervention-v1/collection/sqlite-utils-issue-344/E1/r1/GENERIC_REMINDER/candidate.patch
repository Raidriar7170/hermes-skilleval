index 1c0dc60750688e4617e93982261b0d2ef5a3d725..6f04b98548eb995221dc27c402696c2dd1bfa95c 100644
--- a/docs/python-api.rst
+++ b/docs/python-api.rst
@@ -600,6 +600,28 @@ Here's an example that uses these features:
     #     [score] INTEGER NOT NULL DEFAULT 1
     # )
 
+Creating STRICT tables
+======================
+
+SQLite 3.37 and higher supports `STRICT tables
+<https://www.sqlite.org/stricttables.html>`__, which reject values that cannot
+be losslessly converted to the declared column type. Pass ``strict=True`` when
+creating a table explicitly or when inserting into a table for the first time::
+
+    db["strict_items"].create(
+        {"id": int, "name": str, "price": float},
+        pk="id",
+        strict=True,
+    )
+
+    db["strict_items_from_inserts"].insert(
+        {"id": 1, "name": "Example"},
+        pk="id",
+        strict=True,
+    )
+
+The ``table.strict`` property reports whether an existing table is strict.
+
