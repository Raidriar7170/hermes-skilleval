+def test_create_table_strict():
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = runner.invoke(
+            cli.cli,
+            ["create-table", "test.db", "t", "id", "integer", "--strict"],
+            catch_exceptions=False,
+        )
+        assert result.exit_code == 0
+        assert Database("test.db")["t"].strict
+
+
+def test_insert_strict():
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = runner.invoke(
+            cli.cli,
+            ["insert", "test.db", "scores", "-", "--strict"],
+            input='[{"name": "Cleo", "score": 3.5}]',
+            catch_exceptions=False,
+        )
+        assert result.exit_code == 0
+        table = Database("test.db")["scores"]
+        assert table.strict
+        assert list(table.rows) == [{"name": "Cleo", "score": 3.5}]
+
+
