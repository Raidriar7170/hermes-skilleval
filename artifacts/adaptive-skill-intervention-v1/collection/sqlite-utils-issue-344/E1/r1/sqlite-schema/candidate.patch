+def test_create_strict_table(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table", {"name": str, "score": float}, strict=True
+    )
+    assert table.strict
+    assert table.schema.endswith(") STRICT")
+    assert "[score] REAL" in table.schema
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"name": "bad", "score": "not a number"})
+    assert not fresh_db.create_table("ordinary", {"name": str}).strict
+
+
+def test_create_strict_table_any(fresh_db):
+    table = fresh_db.create_table("strict_any", {"value": "ANY"}, strict=True)
+    table.insert_all(({"value": 1}, {"value": "one"}, {"value": b"one"}))
+    assert [row["value"] for row in table.rows] == [1, "one", b"one"]
+
+
+def test_insert_creates_strict_table(fresh_db):
+    table = fresh_db["strict_table"].insert(
+        {"name": "Cleo", "score": 3.5}, strict=True
+    )
+    assert table.strict
+    assert table.columns_dict["score"] is float
+
+
+def test_transform_preserves_strict(fresh_db):
+    table = fresh_db["strict_table"].insert({"name": "Cleo"}, strict=True)
+    table.transform(rename={"name": "display_name"})
+    assert table.strict
+    assert list(table.rows) == [{"display_name": "Cleo"}]
+
+
+def test_alter_strict_table_with_float(fresh_db):
+    table = fresh_db["strict_table"].insert({"name": "Cleo"}, strict=True)
+    table.insert({"name": "Marnie", "score": 3.5}, alter=True)
+    assert "[score] REAL" in table.schema
+    assert list(table.rows)[1] == {"name": "Marnie", "score": 3.5}
+
+
