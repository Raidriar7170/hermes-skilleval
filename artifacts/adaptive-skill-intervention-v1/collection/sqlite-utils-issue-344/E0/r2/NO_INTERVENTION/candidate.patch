--- a/tests/test_create.py
+++ b/tests/test_create.py
@@ -60,6 +60,41 @@ def test_create_table(fresh_db):
     ) == table.schema
 
 
+def test_create_table_strict(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table",
+        {"id": int, "score": float, "metadata": "ANY"},
+        pk="id",
+        strict=True,
+    )
+    assert (
+        "CREATE TABLE [strict_table] (\n"
+        "   [id] INTEGER PRIMARY KEY,\n"
+        "   [score] REAL,\n"
+        "   [metadata] ANY\n"
+        ") STRICT"
+    ) == table.schema
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"id": 1, "score": "not a number"})
+
+
+@pytest.mark.parametrize(
+    "method_name", ("insert", "insert_all", "upsert", "upsert_all")
+)
+def test_create_strict_table_from_data(fresh_db, method_name):
+    value = {"id": 1, "score": 1.5}
+    if method_name.endswith("_all"):
+        value = [value]
+    getattr(fresh_db["scores"], method_name)(value, pk="id", strict=True)
+    assert fresh_db["scores"].schema.endswith(") STRICT")
+    assert fresh_db["scores"].columns_dict == {"id": int, "score": float}
+
+
+def test_strict_table_factory_default(fresh_db):
+    fresh_db.table("scores", strict=True).insert({"score": 1.5})
+    assert fresh_db["scores"].schema.endswith(") STRICT")
+
+
