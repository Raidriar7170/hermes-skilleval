+def test_transform_preserves_strict(fresh_db):
+    scores = fresh_db["scores"]
+    scores.insert({"id": 1, "score": 1.5}, pk="id", strict=True)
+    assert scores.transform_sql(
+        rename={"score": "rating"}, tmp_suffix="suffix"
+    )[0].endswith(") STRICT;")
+    scores.transform(rename={"score": "rating"})
+    assert scores.schema.endswith(") STRICT")
+    assert scores.get(1) == {"id": 1, "rating": 1.5}
+
+
