+        {"id": int, "name": str, "score": float},
+        pk="id",
+        strict=True,
+    )
+    assert (
+        "CREATE TABLE [strict_table] (\n"
+        "   [id] INTEGER PRIMARY KEY,\n"
+        "   [name] TEXT,\n"
+        "   [score] REAL\n"
+        ") STRICT"
+    ) == table.schema
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"id": 1, "name": "One", "score": "not a number"})
+
+
+@pytest.mark.parametrize("method", ("insert", "insert_all", "upsert", "upsert_all"))
+def test_implicit_create_strict(fresh_db, method):
+    records = {"id": 1, "name": "One"}
