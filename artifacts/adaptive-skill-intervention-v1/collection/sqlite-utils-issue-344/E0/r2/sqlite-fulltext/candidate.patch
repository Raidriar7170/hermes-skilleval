+def test_create_table_strict():
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = runner.invoke(
+            cli.cli,
+            [
+                "create-table",
+                "test.db",
+                "t",
+                "id",
+                "integer",
+                "score",
+                "float",
+                "--strict",
+            ],
+            catch_exceptions=False,
+        )
+        assert 0 == result.exit_code
+        assert Database("test.db")["t"].schema == (
+            "CREATE TABLE [t] (\n   [id] INTEGER,\n   [score] REAL\n) STRICT"
+        )
+
+
+@pytest.mark.parametrize("command", ("insert", "upsert"))
+def test_insert_upsert_strict(command):
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        args = [command, "test.db", "t", "-", "--strict"]
+        if command == "upsert":
+            args.extend(("--pk", "id"))
+        result = runner.invoke(cli.cli, args, input='{"id": 1, "name": "One"}')
+        assert 0 == result.exit_code
+        assert Database("test.db")["t"].schema.endswith(") STRICT")
+
