+def test_create_strict_table(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table",
+        {"id": int, "other_id": "INT", "name": str, "score": float, "data": "ANY"},
+        pk="id",
+        strict=True,
+    )
+    assert table.strict is True
+    assert table.schema == (
+        "CREATE TABLE [strict_table] (\n"
+        "   [id] INTEGER PRIMARY KEY,\n"
+        "   [other_id] INT,\n"
+        "   [name] TEXT,\n"
+        "   [score] REAL,\n"
+        "   [data] ANY\n"
+        ") STRICT"
+    )
+    table.insert(
+        {"id": 1, "other_id": 10, "name": "Cleo", "score": 3.5, "data": {"a": 1}}
+    )
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"id": 2, "name": b"not text", "score": 4.5})
+
+
+@pytest.mark.parametrize("method", ("insert", "insert_all", "upsert", "upsert_all"))
+def test_create_strict_table_from_data(fresh_db, method):
+    records = [{"id": 1, "score": 3.5}]
+    value = records[0] if method in ("insert", "upsert") else records
+    getattr(fresh_db["strict_table"], method)(value, pk="id", strict=True)
+    assert fresh_db["strict_table"].strict is True
+    assert "[score] REAL" in fresh_db["strict_table"].schema
+
+
+def test_table_strict_default(fresh_db):
+    table = fresh_db.table("strict_table", strict=True)
+    table.insert({"id": 1})
+    assert table.strict is True
+
+
