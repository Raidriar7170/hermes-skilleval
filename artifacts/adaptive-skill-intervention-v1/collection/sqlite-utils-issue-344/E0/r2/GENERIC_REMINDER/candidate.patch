+def test_create_table_strict():
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = runner.invoke(
+            cli.cli,
+            [
+                "create-table",
+                "test.db",
+                "t",
+                "id",
+                "integer",
+                "score",
+                "float",
+                "extra",
+                "any",
+                "--strict",
+            ],
+            catch_exceptions=False,
+        )
+        assert 0 == result.exit_code
+        schema = Database("test.db")["t"].schema
+        assert schema.endswith(") STRICT")
+        assert "[score] REAL" in schema
