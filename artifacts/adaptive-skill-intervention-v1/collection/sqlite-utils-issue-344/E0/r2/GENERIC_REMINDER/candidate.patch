+def test_create_strict_table(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table",
+        {"id": int, "name": str, "score": float, "extra": "ANY"},
+        pk="id",
+        strict=True,
+    )
+    assert table.schema.endswith(") STRICT")
+    assert "[score] REAL" in table.schema
+    assert "[extra] ANY" in table.schema
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"id": 1, "name": b"not text"})
+
+    table.transform(rename={"name": "full_name"})
+    assert table.schema.endswith(") STRICT")
+    assert "[score] REAL" in table.schema
+    assert "[extra] ANY" in table.schema
+
+
+def test_create_strict_table_sql(fresh_db):
+    assert fresh_db.create_table_sql(
+        "strict_table", {"id": int}, strict=True
+    ).strip().endswith(") STRICT;")
+
