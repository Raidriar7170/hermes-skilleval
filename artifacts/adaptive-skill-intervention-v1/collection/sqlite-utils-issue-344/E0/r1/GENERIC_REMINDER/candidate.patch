+def test_create_strict_table(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table",
+        {"id": int, "name": str, "score": float, "raw": "ANY"},
+        pk="id",
+        strict=True,
+    )
+    assert table.schema == (
+        "CREATE TABLE [strict_table] (\n"
+        "   [id] INTEGER PRIMARY KEY,\n"
+        "   [name] TEXT,\n"
+        "   [score] REAL,\n"
+        "   [raw] ANY\n"
+        ") STRICT"
+    )
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"id": 1, "name": "Bad", "score": b"not a number"})
+
+
+@pytest.mark.parametrize("method", ("insert", "insert_all", "upsert", "upsert_all"))
+def test_strict_table_created_by_write_methods(fresh_db, method):
+    record = {"id": 1, "score": 1.5}
+    records = [record] if method.endswith("_all") else record
+    getattr(fresh_db[method], method)(records, pk="id", strict=True)
+    assert fresh_db[method].schema.endswith(") STRICT")
+    assert fresh_db[method].columns_dict == {"id": int, "score": float}
+
+
+def test_strict_as_table_default_and_preserved_by_transform(fresh_db):
+    table = fresh_db.table("configured", strict=True).insert(
+        {"name": "Cleo", "metadata": {"breed": "terrier"}},
+        columns={"metadata": "ANY"},
+    )
+    assert table.schema.endswith(") STRICT")
+    table.transform(rename={"name": "display_name"})
+    assert table.schema.endswith(") STRICT")
+    assert [(column.name, column.type) for column in table.columns] == [
+        ("display_name", "TEXT"),
+        ("metadata", "ANY"),
+    ]
+
+
