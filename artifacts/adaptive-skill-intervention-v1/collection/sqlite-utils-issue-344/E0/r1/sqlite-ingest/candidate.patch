+def test_create_table_strict(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table",
+        {"text_col": str, "float_col": float, "int_col": int},
+        strict=True,
+    )
+    assert (
+        "CREATE TABLE [strict_table] (\n"
+        "   [text_col] TEXT,\n"
+        "   [float_col] REAL,\n"
+        "   [int_col] INTEGER\n"
+        ") STRICT"
+    ) == table.schema
+    assert table.strict is True
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert(
+            {"text_col": "hello", "float_col": 1.5, "int_col": "not an integer"}
+        )
+
+
+def test_transform_preserves_strict(fresh_db):
+    table = fresh_db["strict_table"].create({"id": int, "name": str}, strict=True)
+    table.transform(types={"id": str})
+    assert table.strict is True
+    assert table.columns_dict["id"] is str
+
+
+@pytest.mark.parametrize("method", ("insert", "insert_all", "upsert", "upsert_all"))
+def test_create_strict_table_from_data(fresh_db, method):
+    records = [{"id": 1, "name": "Cleo", "weight": 12.5}]
+    value = records if method.endswith("_all") else records[0]
+    getattr(fresh_db.table("dogs", strict=True), method)(value, pk="id")
+    assert fresh_db["dogs"].schema.endswith(") STRICT")
+    assert fresh_db["dogs"].columns_dict["weight"] is float
+
+
+def test_lookup_creates_strict_table(fresh_db):
+    assert fresh_db["species"].lookup({"name": "Palm"}, strict=True) == 1
+    assert fresh_db["species"].strict is True
+
