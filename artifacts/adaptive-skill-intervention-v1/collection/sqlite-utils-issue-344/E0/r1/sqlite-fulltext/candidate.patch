index 187d20a97c9012c186d3c8cd1ed2b4f58867b367..80402a495904fcd00fdd79b18302222b055d8ada 100644
--- a/tests/test_create.py
+++ b/tests/test_create.py
@@ -60,6 +60,47 @@ def test_create_table(fresh_db):
     ) == table.schema
 
 
+def test_create_table_strict(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table",
+        {"id": int, "name": str, "score": float, "metadata": "ANY"},
+        pk="id",
+        strict=True,
+    )
+    assert table.strict is True
+    assert (
+        "CREATE TABLE [strict_table] (\n"
+        "   [id] INTEGER PRIMARY KEY,\n"
+        "   [name] TEXT,\n"
+        "   [score] REAL,\n"
+        "   [metadata] ANY\n"
+        ") STRICT"
+    ) == table.schema
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"id": 1, "name": b"not text"})
+
+
+def test_insert_creates_strict_table(fresh_db):
+    table = fresh_db["strict_table"].insert(
+        {"id": 1, "score": 1.5}, pk="id", strict=True
+    )
+    assert table.strict is True
+    assert "[score] REAL" in table.schema
+
+
+def test_table_strict_default(fresh_db):
+    table = fresh_db.table("strict_table", strict=True)
+    table.insert({"id": 1}, pk="id")
+    assert table.strict is True
+
+
+def test_transform_preserves_strict(fresh_db):
+    table = fresh_db["strict_table"].create({"id": int, "name": str}, strict=True)
+    table.transform(rename={"name": "title"})
+    assert table.strict is True
+    assert "[title] TEXT" in table.schema
+
+
