+def test_create_table_strict(fresh_db):
+    table = fresh_db.create_table(
+        "strict_table",
+        {"text_col": str, "float_col": float, "int_col": int},
+        strict=True,
+    )
+    assert table.strict is True
+    assert (
+        "CREATE TABLE [strict_table] (\n"
+        "   [text_col] TEXT,\n"
+        "   [float_col] REAL,\n"
+        "   [int_col] INTEGER\n"
+        ") STRICT"
+    ) == table.schema
+    with pytest.raises(sqlite3.IntegrityError):
+        table.insert({"text_col": "ok", "float_col": "not-a-number", "int_col": 1})
+
+
+def test_create_table_strict_explicit_types(fresh_db):
+    table = fresh_db["strict_table"].create(
+        {"int_col": "INT", "real_col": "REAL", "any_col": "ANY"}, strict=True
+    )
+    assert "[int_col] INT" in table.schema
+    assert "[real_col] REAL" in table.schema
+    assert "[any_col] ANY" in table.schema
+
+
+def test_create_strict_table_from_insert(fresh_db):
+    table = fresh_db["people"].insert(
+        {"name": "Cleo", "weight": 12.5}, strict=True
+    )
+    assert table.strict is True
+    assert "[weight] REAL" in table.schema
+
+
+def test_strict_table_as_table_default(fresh_db):
+    table = fresh_db.table("people", strict=True).insert({"name": "Cleo"})
