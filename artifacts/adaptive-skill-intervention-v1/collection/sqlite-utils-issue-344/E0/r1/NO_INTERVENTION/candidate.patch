@@ -204,6 +204,24 @@ def test_transform_sql_with_no_primary_key_to_primary_key_of_id(fresh_db):
     )
 
 
+def test_transform_preserves_strict(fresh_db):
+    dogs = fresh_db["dogs"].insert(
+        {"id": 1, "name": "Cleo", "age": 5, "metadata": "5"},
+        pk="id",
+        strict=True,
+        columns={"metadata": "ANY"},
+    )
+    dogs.transform(rename={"age": "dog_age"})
+    assert dogs.strict is True
+    assert "[metadata] ANY" in dogs.schema
+    assert dogs.get(1) == {
+        "id": 1,
+        "name": "Cleo",
+        "dog_age": 5,
+        "metadata": "5",
+    }
+
+
