+def test_create_table_strict():
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = runner.invoke(
+            cli.cli,
+            [
+                "create-table",
+                "test.db",
+                "t",
+                "name",
+                "text",
+                "weight",
+                "float",
+                "--strict",
+            ],
+            catch_exceptions=False,
+        )
+        assert result.exit_code == 0
+        assert Database("test.db")["t"].schema == (
+            "CREATE TABLE [t] (\n   [name] TEXT,\n   [weight] REAL\n) STRICT"
+        )
+
+
+@pytest.mark.parametrize(
+    "command,extra_args", (("insert", ()), ("upsert", ("--pk", "id")))
+)
+def test_insert_upsert_strict(tmpdir, command, extra_args):
+    db_path = str(tmpdir / "strict.db")
+    json_path = str(tmpdir / "rows.json")
+    with open(json_path, "w") as fp:
+        json.dump([{"id": 1, "name": "Cleo", "weight": 12.5}], fp)
+    result = CliRunner().invoke(
+        cli.cli,
+        [command, db_path, "dogs", json_path, "--strict"] + list(extra_args),
+        catch_exceptions=False,
+    )
+    assert result.exit_code == 0
+    table = Database(db_path)["dogs"]
+    assert table.strict is True
+    assert table.columns_dict["weight"] is float
+
+
