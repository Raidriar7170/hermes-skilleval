+def test_create_database():
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = runner.invoke(cli.cli, ["create-database", "empty.db"])
+        assert result.exit_code == 0
+        assert os.path.exists("empty.db")
+        assert os.path.getsize("empty.db") > 0
+        with open("empty.db", "rb") as fp:
+            assert fp.read(16) == b"SQLite format 3\x00"
+        assert Database("empty.db").table_names() == []
+
+
+def test_create_database_does_not_modify_existing_database():
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        Database("existing.db")["data"].insert({"value": "original"})
+        before = open("existing.db", "rb").read()
+        result = runner.invoke(cli.cli, ["create-database", "existing.db"])
+        assert result.exit_code == 1
+        assert 'Error: File "existing.db" already exists' == result.output.strip()
+        assert open("existing.db", "rb").read() == before
+        assert list(Database("existing.db")["data"].rows) == [
+            {"value": "original"}
+        ]
+
+
