+def test_create_database(tmpdir):
+    path = str(tmpdir / "created.db")
+    result = CliRunner().invoke(cli.cli, ["create-database", path])
+    assert result.exit_code == 0
+    assert os.path.getsize(path) > 0
+    db = sqlite3.connect(path)
+    assert db.execute("pragma integrity_check").fetchone() == ("ok",)
+    assert db.execute(
+        "select name from sqlite_master where type = 'table'"
+    ).fetchall() == []
+
+
+def test_create_database_does_not_overwrite(tmpdir):
+    path = str(tmpdir / "existing.db")
+    db = sqlite3.connect(path)
+    db.execute("create table data (value text)")
+    db.execute("insert into data values ('still here')")
+    db.commit()
+    db.close()
+
+    result = CliRunner().invoke(cli.cli, ["create-database", path])
+
+    assert result.exit_code != 0
+    assert "File already exists" in result.output
+    assert sqlite3.connect(path).execute("select value from data").fetchall() == [
+        ("still here",)
+    ]
+
+
