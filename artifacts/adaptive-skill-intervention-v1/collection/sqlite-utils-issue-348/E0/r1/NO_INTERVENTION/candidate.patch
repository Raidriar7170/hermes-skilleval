+def test_create_database():
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = runner.invoke(cli.cli, ["create-database", "empty.db"])
+        assert 0 == result.exit_code
+        assert os.path.getsize("empty.db") > 0
+        assert Database("empty.db").table_names() == []
+
+
+def test_create_database_does_not_overwrite_existing_database():
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        Database("existing.db")["data"].insert({"value": "still here"})
+        result = runner.invoke(cli.cli, ["create-database", "existing.db"])
+        assert 1 == result.exit_code
+        assert "Database already exists: existing.db" in result.output
+        assert list(Database("existing.db")["data"].rows) == [
+            {"value": "still here"}
+        ]
+
