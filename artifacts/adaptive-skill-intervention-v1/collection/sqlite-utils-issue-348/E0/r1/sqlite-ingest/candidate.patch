+++ b/tests/test_cli.py
@@ -41,6 +41,25 @@ def test_help(options):
     assert "-h, --help" in result.output
 
 
+def test_create_database():
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        result = runner.invoke(cli.cli, ["create-database", "empty.db"])
+        assert result.exit_code == 0
+        assert os.path.exists("empty.db")
+        assert Database("empty.db").table_names() == []
+
+
+def test_create_database_does_not_overwrite_existing_database():
+    runner = CliRunner()
+    with runner.isolated_filesystem():
+        Database("existing.db")["dogs"].insert({"name": "Cleo"})
+        result = runner.invoke(cli.cli, ["create-database", "existing.db"])
+        assert result.exit_code == 1
+        assert 'File already exists: "existing.db"' in result.output
+        assert list(Database("existing.db")["dogs"].rows) == [{"name": "Cleo"}]
+
+
