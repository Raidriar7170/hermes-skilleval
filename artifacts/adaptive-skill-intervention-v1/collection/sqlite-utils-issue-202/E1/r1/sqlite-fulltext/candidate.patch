+def test_insert_csv_with_fts(db_path, tmpdir):
+    csv_path = str(tmpdir / "articles.csv")
+    open(csv_path, "w").write(
+        "title,body,category\nFirst article,The first body,one\n"
+    )
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "articles",
+            csv_path,
+            "--csv",
+            "-f",
+            "title",
+            "-f",
+            "body",
+        ],
+    )
+    assert 0 == result.exit_code, result.output
+    db = Database(db_path)
+    assert "articles_fts" == db["articles"].detect_fts()
+    assert [
+        {
+            "rowid": 1,
+            "title": "First article",
+            "body": "The first body",
+            "category": "one",
+        }
+    ] == list(db["articles"].search("first"))
+
+
+def test_insert_fts_requires_csv(db_path):
+    result = CliRunner().invoke(
+        cli.cli,
+        ["insert", db_path, "articles", "-", "-f", "title"],
+        input=json.dumps([{"title": "First article"}]),
+    )
+    assert 1 == result.exit_code
+    assert "Error: -f/--fts must be used with --csv" == result.output.strip()
+    assert not Database(db_path)["articles"].exists()
+
+
