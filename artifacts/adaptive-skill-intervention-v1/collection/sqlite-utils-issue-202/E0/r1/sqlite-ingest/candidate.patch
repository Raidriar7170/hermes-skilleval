+def test_insert_csv_with_fts(db_path, tmpdir):
+    file_path = str(tmpdir / "articles.csv")
+    open(file_path, "w").write(
+        "title,body,category\n"
+        "First article,This is the first article,news\n"
+        "Second article,This is the second article,opinion"
+    )
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "articles",
+            file_path,
+            "--csv",
+            "-f",
+            "title",
+            "-f",
+            "body",
+        ],
+        catch_exceptions=False,
+    )
+    assert 0 == result.exit_code
+    db = Database(db_path)
+    assert "articles_fts" == db["articles"].detect_fts()
+    assert {"title", "body"} == set(db["articles_fts"].columns_dict)
+    assert [
+        {
+            "rowid": 2,
+            "title": "Second article",
+            "body": "This is the second article",
+            "category": "opinion",
+        }
+    ] == list(db["articles"].search("second"))
 
 
