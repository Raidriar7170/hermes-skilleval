+def test_insert_csv_with_fts(db_path, tmpdir):
+    db = Database(db_path)
+    file_path = str(tmpdir / "articles.csv")
+    open(file_path, "w").write(
+        "title,body,category\nFirst article,About llamas,animals\n"
+    )
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "articles",
+            file_path,
+            "--csv",
+            "-f",
+            "title",
+            "-f",
+            "body",
+        ],
+        catch_exceptions=False,
+    )
+    assert 0 == result.exit_code
+    assert "articles_fts" == db["articles"].detect_fts()
+    assert {"title", "body"} == set(db["articles_fts"].columns_dict)
+    assert [
+        {
+            "rowid": 1,
+            "title": "First article",
+            "body": "About llamas",
+            "category": "animals",
+        }
+    ] == list(db["articles"].search("llamas"))
+
+
+def test_insert_csv_without_fts_does_not_enable_fts(db_path, tmpdir):
+    db = Database(db_path)
+    file_path = str(tmpdir / "articles.csv")
+    open(file_path, "w").write("title,body\nFirst article,About llamas\n")
+    result = CliRunner().invoke(
+        cli.cli, ["insert", db_path, "articles", file_path, "--csv"]
+    )
+    assert 0 == result.exit_code
+    assert db["articles"].detect_fts() is None
+
+
