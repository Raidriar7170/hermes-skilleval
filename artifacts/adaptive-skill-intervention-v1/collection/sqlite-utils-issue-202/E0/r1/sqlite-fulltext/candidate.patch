+def test_insert_csv_with_fts(db_path, tmpdir):
+    csv_path = str(tmpdir / "articles.csv")
+    open(csv_path, "w").write(
+        "id,title,body\n"
+        "1,First article,This is the introduction\n"
+        "2,Second article,This is the conclusion\n"
+    )
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "articles",
+            csv_path,
+            "--csv",
+            "-f",
+            "title",
+            "-f",
+            "body",
+        ],
+        catch_exceptions=False,
+    )
+    assert 0 == result.exit_code, result.output
+    db = Database(db_path)
+    assert "articles_fts" == db["articles"].detect_fts()
+    assert ["title", "body"] == [
+        column.name for column in db["articles_fts"].columns
+    ]
+    assert [{"id": "2", "title": "Second article"}] == list(
+        db["articles"].search("conclusion", columns=["id", "title"])
+    )
+
+
+def test_insert_fts_requires_csv(db_path):
+    result = CliRunner().invoke(
+        cli.cli,
+        ["insert", db_path, "articles", "-", "-f", "title"],
+        input='[{"title": "First article"}]',
+    )
+    assert 0 != result.exit_code
+    assert "Error: -f can only be used with --csv" == result.output.strip()
+
+
