+def test_insert_csv_with_fts(db_path, tmpdir):
+    csv_path = str(tmpdir / "articles.csv")
+    open(csv_path, "w").write(
+        "title,body,author\n"
+        "First article,The first body,Ada\n"
+        "Second article,More text,Grace\n"
+    )
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "articles",
+            csv_path,
+            "--csv",
+            "-f",
+            "title",
+            "-f",
+            "body",
+        ],
+    )
+    assert 0 == result.exit_code, result.output
+    db = Database(db_path)
+    assert [
+        {
+            "rowid": 1,
+            "title": "First article",
+            "body": "The first body",
+            "author": "Ada",
+        }
+    ] == list(db["articles"].search("first"))
+    assert {"title", "body"} == {
+        column.name for column in db["articles_fts"].columns if column.name != "docid"
+    }
