+def test_insert_all_adds_columns_from_later_batches_with_alter(fresh_db):
+    if not hasattr(fresh_db.conn, "setlimit"):
+        pytest.skip("sqlite3.Connection.setlimit() is not available")
+    fresh_db.conn.setlimit(sqlite3.SQLITE_LIMIT_VARIABLE_NUMBER, 9)
+    fresh_db["test"].insert_all(
+        [
+            {"id": 1, "name": "one"},
+            {"id": 2, "name": "two"},
+            {
+                "id": 3,
+                "name": "three",
+                "middle": "first new column",
+                "third": 3,
+                "fourth": 4,
+                "fifth": 5,
+            },
+            {
+                "id": 4,
+                "name": "four",
+                "middle": "also present here",
+                "third": 3,
+                "fourth": 4,
+                "fifth": 5,
+            },
+            {"id": 5, "name": "five", "last": "second new column"},
+        ],
+        pk="id",
+        batch_size=2,
+        alter=True,
+    )
+
+    assert ["id", "name", "middle", "third", "fourth", "fifth", "last"] == [
+        column.name for column in fresh_db["test"].columns
+    ]
+    assert [
+        {
+            "id": 1,
+            "name": "one",
+            "middle": None,
+            "third": None,
+            "fourth": None,
+            "fifth": None,
+            "last": None,
+        },
+        {
+            "id": 2,
+            "name": "two",
+            "middle": None,
+            "third": None,
+            "fourth": None,
+            "fifth": None,
+            "last": None,
+        },
+        {
+            "id": 3,
+            "name": "three",
+            "middle": "first new column",
+            "third": 3,
+            "fourth": 4,
+            "fifth": 5,
+            "last": None,
+        },
+        {
+            "id": 4,
+            "name": "four",
+            "middle": "also present here",
+            "third": 3,
+            "fourth": 4,
+            "fifth": 5,
+            "last": None,
+        },
+        {
+            "id": 5,
+            "name": "five",
+            "middle": None,
+            "third": None,
+            "fourth": None,
+            "fifth": None,
+            "last": "second new column",
+        },
+    ] == list(fresh_db["test"].rows)
+
+
