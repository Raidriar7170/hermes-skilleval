+def test_insert_all_alter_adds_columns_from_later_batches(fresh_db):
+    later_columns = {"extra_{}".format(i): i for i in range(20)}
+    fresh_db["items"].insert_all(
+        [{"id": i, "name": "item {}".format(i)} for i in range(100)]
+        + [
+            dict({"id": i, "name": "item {}".format(i)}, **later_columns)
+            for i in range(100, 200)
+        ],
+        pk="id",
+        alter=True,
+        batch_size=100,
+    )
+
+    assert fresh_db["items"].count == 200
+    assert fresh_db["items"].get(0) == dict(
+        {"id": 0, "name": "item 0"},
+        **{"extra_{}".format(i): None for i in range(20)}
+    )
+    assert fresh_db["items"].get(199) == dict(
+        {"id": 199, "name": "item 199"}, **later_columns
+    )
+
+
 @pytest.mark.parametrize(
     "num_columns,should_error", ((900, False), (999, False), (1000, True))
 )
