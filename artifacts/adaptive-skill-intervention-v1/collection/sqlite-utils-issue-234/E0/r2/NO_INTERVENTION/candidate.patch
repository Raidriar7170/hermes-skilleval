     assert 100 == fresh_db["big"].count
 
 
+def test_insert_all_alter_adds_columns_from_later_batches(fresh_db):
+    records = [
+        {"id": 1, "name": "Cleo"},
+        {"id": 2, "name": "Pancakes"},
+        {"id": 3, "name": "Bailey", "age": 2},
+        {"id": 4, "name": "Marnie", "age": 5, "is_good": True},
+    ]
+
+    fresh_db["dogs"].insert_all(records, pk="id", alter=True, batch_size=2)
+
+    assert ["id", "name", "age", "is_good"] == [
+        column.name for column in fresh_db["dogs"].columns
+    ]
+    assert [
+        {"id": 1, "name": "Cleo", "age": None, "is_good": None},
+        {"id": 2, "name": "Pancakes", "age": None, "is_good": None},
+        {"id": 3, "name": "Bailey", "age": 2, "is_good": None},
+        {"id": 4, "name": "Marnie", "age": 5, "is_good": 1},
+    ] == list(fresh_db["dogs"].rows)
+
+
 @pytest.mark.parametrize(
     "num_columns,should_error", ((900, False), (999, False), (1000, True))
 )
