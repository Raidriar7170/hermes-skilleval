+def test_insert_all_alter_adds_columns_in_later_batches(fresh_db):
+    later_columns = {"extra_{}".format(i): i for i in range(1000)}
+    fresh_db["items"].insert_all(
+        [
+            {"id": 1, "name": "one"},
+            {"id": 2, "name": "two"},
+            {"id": 3, **later_columns},
+            {"id": 4, **later_columns},
+        ],
+        alter=True,
+        batch_size=2,
+    )
+
+    assert len(fresh_db["items"].columns) == 1002
+    assert fresh_db.execute_returning_dicts(
+        "select id, name, extra_999 from items order by id"
+    ) == [
+        {"id": 1, "name": "one", "extra_999": None},
+        {"id": 2, "name": "two", "extra_999": None},
+        {"id": 3, "name": None, "extra_999": 999},
+        {"id": 4, "name": None, "extra_999": 999},
+    ]
+
