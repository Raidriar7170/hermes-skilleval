+def test_insert_all_alter_adds_columns_from_subsequent_batches(fresh_db):
+    fresh_db["test"].insert_all(
+        [
+            {"id": 1, "name": "Cleo"},
+            {"id": 2, "name": "Pancakes"},
+            {"id": 3, "age": 6},
+            {"id": 4, "age": 2},
+            {"id": 5, "breed": "pug"},
+            {"id": 6, "breed": "terrier"},
+        ],
+        pk="id",
+        alter=True,
+        batch_size=2,
+    )
+    assert list(fresh_db["test"].rows) == [
+        {"id": 1, "name": "Cleo", "age": None, "breed": None},
+        {"id": 2, "name": "Pancakes", "age": None, "breed": None},
+        {"id": 3, "name": None, "age": 6, "breed": None},
+        {"id": 4, "name": None, "age": 2, "breed": None},
+        {"id": 5, "name": None, "age": None, "breed": "pug"},
+        {"id": 6, "name": None, "age": None, "breed": "terrier"},
+    ]
