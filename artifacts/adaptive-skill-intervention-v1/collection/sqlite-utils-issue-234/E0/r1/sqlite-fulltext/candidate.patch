+def test_insert_all_alter_columns_in_later_batch(fresh_db):
+    # https://github.com/simonw/sqlite-utils/issues/225
+    records = [{"id": i} for i in range(100)] + [
+        dict({"id": i}, **{"c{}".format(j): j for j in range(21)})
+        for i in range(100, 200)
+    ]
+    table = fresh_db["later_columns"]
+    table.insert_all(records, pk="id", alter=True, batch_size=100)
+
+    assert table.count == 200
+    assert len(table.columns) == 22
+    assert table.get(0)["c0"] is None
+    assert table.get(100)["c0"] == 0
+
