+def test_insert_all_alter_adds_columns_from_later_batches(fresh_db):
+    traced = []
+    records = iter(
+        [
+            {"id": 1, "name": "one"},
+            {"id": 2, "name": "two"},
+            {"id": 3, "name": "three", "color": "red"},
+            {"id": 4, "name": "four", "color": "blue", "rating": 4},
+        ]
+    )
+
+    with fresh_db.tracer(lambda sql, parameters: traced.append(sql)):
+        fresh_db["items"].insert_all(
+            records, pk="id", alter=True, batch_size=2
+        )
+
+    assert ["id", "name", "color", "rating"] == list(
+        fresh_db["items"].columns_dict
+    )
+    assert [
+        {"id": 1, "name": "one", "color": None, "rating": None},
+        {"id": 2, "name": "two", "color": None, "rating": None},
+        {"id": 3, "name": "three", "color": "red", "rating": None},
+        {"id": 4, "name": "four", "color": "blue", "rating": 4},
+    ] == list(fresh_db["items"].rows)
+    final_insert = [sql for sql in traced if sql.startswith("INSERT INTO")][-1]
+    assert 1 == final_insert.count("[color]")
+    assert 1 == final_insert.count("[rating]")
+
+
+def test_insert_all_alter_validates_columns_from_later_batches(fresh_db):
+    with pytest.raises(AssertionError):
+        fresh_db["items"].insert_all(
+            [{"id": 1}, {"id": 2, "invalid[column": "value"}],
+            pk="id",
+            alter=True,
+            batch_size=1,
+        )
+
+    assert ["id"] == list(fresh_db["items"].columns_dict)
+    assert [{"id": 1}] == list(fresh_db["items"].rows)
+
+
