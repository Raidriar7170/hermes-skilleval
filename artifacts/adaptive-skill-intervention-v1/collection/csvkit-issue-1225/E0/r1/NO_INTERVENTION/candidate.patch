index 9ee188e18d44b7e74f0ddbcd2ccb882e68067e22..997357996960734075523ed375b40e321a956646 100644
--- a/csvkit/utilities/in2csv.py
+++ b/csvkit/utilities/in2csv.py
@@ -65,7 +65,14 @@ class In2CSV(CSVKitUtility):
 
     def open_excel_input_file(self, path):
         if not path or path == '-':
-            return BytesIO(sys.stdin.buffer.read())
+            # Excel readers need a seekable file, and --write-sheets opens the
+            # workbook more than once. STDIN can only be read once, so retain
+            # its bytes and return a fresh buffer for each pass.
+            if not hasattr(self, '_excel_stdin_data'):
+                self._excel_stdin_data = sys.stdin.buffer.read()
+            input_file = BytesIO(self._excel_stdin_data)
+            input_file.name = 'stdin'
+            return input_file
         return open(path, 'rb')
 
     def sheet_names(self, path, filetype):
