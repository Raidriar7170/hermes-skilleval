+    db_path = str(tmpdir / "test.db")
+    csv_path = str(tmpdir / "test.csv")
+    with open(csv_path, "wb") as fp:
+        fp.write(b"\xef\xbb\xbfname,age\nCleo,4\n")
+    result = CliRunner().invoke(
+        cli.cli,
+        ["insert", db_path, "dogs", csv_path, "--csv"],
+        catch_exceptions=False,
+    )
+    assert result.exit_code == 0
+    db = Database(db_path)
+    assert db["dogs"].columns_dict == {"name": str, "age": str}
+    assert list(db["dogs"].rows) == [{"name": "Cleo", "age": "4"}]
