+@pytest.mark.parametrize("command", ("insert", "upsert"))
+def test_insert_upsert_csv_delimiter(command, db_path, tmpdir):
+    db = Database(db_path)
+    file_path = str(tmpdir / "semicolon.csv")
+    open(file_path, "w").write("id;name;age\n1;Cleo;4\n2;Pancakes;2\n")
+    result = CliRunner().invoke(
+        cli.cli,
+        [command, db_path, "dogs", file_path, "--delimiter", ";", "--pk", "id"],
+        catch_exceptions=False,
+    )
+    assert 0 == result.exit_code
+    assert [
+        {"id": "1", "name": "Cleo", "age": "4"},
+        {"id": "2", "name": "Pancakes", "age": "2"},
+    ] == list(db["dogs"].rows)
+
+
+@pytest.mark.parametrize(
+    "options,error",
+    (
+        (("--delimiter", ";;"), "--delimiter must be a single character"),
+        (("--delimiter", ";", "--nl"), "--delimiter cannot be used with --nl"),
+        (("--delimiter", ";", "--tsv"), "--delimiter cannot be used with --nl"),
+    ),
+)
+def test_csv_delimiter_errors(options, error, db_path, tmpdir):
+    file_path = str(tmpdir / "data.csv")
+    open(file_path, "w").write("id;name\n1;Cleo\n")
+    result = CliRunner().invoke(
+        cli.cli, ["insert", db_path, "dogs", file_path] + list(options)
+    )
+    assert result.exit_code == 1
+    assert error in result.output
+
