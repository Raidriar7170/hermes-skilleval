+@pytest.mark.parametrize("command", ("insert", "upsert"))
+def test_insert_delimiter_implies_csv(command, db_path, tmpdir):
+    db = Database(db_path)
+    file_path = str(tmpdir / "semicolon.csv")
+    open(file_path, "w").write("id;name\n1;Cleo\n2;Pancakes\n")
+    result = CliRunner().invoke(
+        cli.cli,
+        [command, db_path, "data", file_path, "--delimiter", ";", "--pk", "id"],
+        catch_exceptions=False,
+    )
+    assert 0 == result.exit_code
+    assert [{"id": "1", "name": "Cleo"}, {"id": "2", "name": "Pancakes"}] == list(
+        db["data"].rows
+    )
