+    db = Database(db_path)
+    file_path = str(tmpdir / "insert.csv")
+    open(file_path, "w").write('name;description\nCleo;"Good; dog"\n')
+    result = CliRunner().invoke(
+        cli.cli,
+        ["insert", db_path, "data", file_path, "--delimiter", ";"],
+        catch_exceptions=False,
+    )
+    assert 0 == result.exit_code
+    assert [{"name": "Cleo", "description": "Good; dog"}] == list(db["data"].rows)
