+def test_add_foreign_key_with_spaces_in_identifiers(fresh_db):
+    fresh_db["Reporters directory"].insert(
+        {"Reporter ID": 1, "name": "Sally"}, pk="Reporter ID"
+    )
+    fresh_db["Reports archive"].insert(
+        {"title": "A report", "Reported by ID": 1}
+    )
+
+    fresh_db["Reports archive"].add_foreign_key(
+        "Reported by ID", "Reporters directory", "Reporter ID"
+    )
+
+    assert [
+        ForeignKey(
+            table="Reports archive",
+            column="Reported by ID",
+            other_table="Reporters directory",
+            other_column="Reporter ID",
+        )
+    ] == fresh_db["Reports archive"].foreign_keys
+    assert ("ok",) == fresh_db.execute("PRAGMA integrity_check").fetchone()
+
+
