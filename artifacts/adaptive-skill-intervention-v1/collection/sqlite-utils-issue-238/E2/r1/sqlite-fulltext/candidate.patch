@@ -38,6 +38,16 @@ USING\s+(?P<using>\w+)          # e.g. USING FTS5
     re.VERBOSE | re.IGNORECASE,
 )
 
+_simple_identifier_re = re.compile(
+    r"^[A-Za-z_\u0080-\uffff][A-Za-z_\u0080-\uffff0-9\$]*$"
+)
+
+
+def _quote_for_foreign_key(identifier):
+    if _simple_identifier_re.match(identifier):
+        return identifier
+    return '"{}"'.format(identifier.replace('"', '""'))
+
 try:
     import pandas as pd
 except ImportError:
@@ -594,7 +604,9 @@ class Database:
         for table, column, other_table, other_column in foreign_keys_to_create:
