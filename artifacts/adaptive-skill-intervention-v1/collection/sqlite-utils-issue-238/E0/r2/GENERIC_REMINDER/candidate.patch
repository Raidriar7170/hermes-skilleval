+def test_add_foreign_key_column_with_space(fresh_db):
+    fresh_db["Reporters"].insert({"id": 1}, pk="id")
+    fresh_db["Reports"].insert({"id": 1, "Reported by ID": 1}, pk="id")
+
+    fresh_db["Reports"].add_foreign_key("Reported by ID", "Reporters", "id")
+
+    assert [
+        ForeignKey(
+            table="Reports",
+            column="Reported by ID",
+            other_table="Reporters",
+            other_column="id",
+        )
+    ] == fresh_db["Reports"].foreign_keys
+    assert fresh_db.execute("PRAGMA integrity_check").fetchone()[0] == "ok"
+
