+_sqlite_identifier_re = re.compile(
+    r"[A-Za-z_\u0080-\uffff][A-Za-z_\u0080-\uffff0-9\$]*"
+)
+
+
+def _quote_identifier_if_needed(identifier):
+    if _sqlite_identifier_re.fullmatch(identifier):
+        return identifier
+    return '"{}"'.format(identifier.replace('"', '""'))
+
+
 _virtual_table_using_re = re.compile(
     r"""
 ^ # Start of string
