+def test_add_foreign_key_with_spaces_in_column_name(fresh_db):
+    fresh_db["Reporters"].insert({"id": 1}, pk="id")
+    fresh_db["Reports"].insert({"Reported by ID": 1})
+
+    fresh_db["Reports"].add_foreign_key("Reported by ID", "Reporters", "id")
+
+    assert [
+        ForeignKey(
+            table="Reports",
+            column="Reported by ID",
+            other_table="Reporters",
+            other_column="id",
+        )
+    ] == fresh_db["Reports"].foreign_keys
+    assert [("ok",)] == fresh_db.conn.execute("PRAGMA integrity_check").fetchall()
+
