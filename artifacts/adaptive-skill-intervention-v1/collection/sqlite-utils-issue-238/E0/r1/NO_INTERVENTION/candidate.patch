+            # Preserve the existing SQL for simple identifiers, but quote names
+            # containing spaces or punctuation so the rewritten schema is valid.
+            def quote(identifier):
+                if re.match(r"^[A-Za-z_][A-Za-z0-9_$]*$", identifier):
+                    return identifier
+                return '"{}"'.format(identifier.replace('"', '""'))
+
             extra_sql = ",\n   FOREIGN KEY({column}) REFERENCES {other_table}({other_column})\n".format(
-                column=column, other_table=other_table, other_column=other_column
