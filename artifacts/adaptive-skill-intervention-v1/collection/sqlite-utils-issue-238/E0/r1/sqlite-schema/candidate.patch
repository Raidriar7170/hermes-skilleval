+def test_add_foreign_key_with_spaces_in_identifiers(fresh_db):
+    fresh_db["Reporters table"].insert({"Reporter ID": 1, "name": "Sally"}, pk="Reporter ID")
+    fresh_db["Reports table"].insert(
+        {"id": 1, "Reported by ID": 1, "title": "Hedgehogs of the world"},
+        pk="id",
+    )
+
+    fresh_db["Reports table"].add_foreign_key(
+        "Reported by ID", "Reporters table", "Reporter ID"
+    )
+
+    assert [
+        ForeignKey(
+            table="Reports table",
+            column="Reported by ID",
+            other_table="Reporters table",
+            other_column="Reporter ID",
+        )
+    ] == fresh_db["Reports table"].foreign_keys
+    assert [
+        {
+            "id": 1,
+            "Reported by ID": 1,
+            "title": "Hedgehogs of the world",
+        }
+    ] == list(fresh_db["Reports table"].rows)
+    assert [("ok",)] == fresh_db.execute("PRAGMA integrity_check").fetchall()
+
+
