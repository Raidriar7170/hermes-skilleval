+    path = str(tmpdir / "dump.db")
+    db = Database(path)
+    db.executescript(
+        """
+        create table people (id integer primary key, name text, photo blob);
+        create unique index people_name_idx on people(name);
+        create view names as select name from people;
+        """
+    )
+    db["people"].insert({"id": 1, "name": "O'Reilly", "photo": b"\x00\xff"})
