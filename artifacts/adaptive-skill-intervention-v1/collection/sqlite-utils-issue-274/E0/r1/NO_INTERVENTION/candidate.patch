+def test_dump(tmpdir):
+    path = str(tmpdir / "source.db")
+    db = Database(path)
+    with db.conn:
+        db.conn.executescript(
+            """
+            create table people (
+                id integer primary key,
+                name text not null
+            );
+            create index people_name on people(name);
+            insert into people values (1, 'O''Reilly');
+            insert into people values (2, 'Síle');
+            """
+        )
+
+    result = CliRunner().invoke(cli.cli, ["dump", path])
+
+    assert result.exit_code == 0
+    restored = sqlite3.connect(":memory:")
+    restored.executescript(result.output)
+    assert restored.execute(
+        "select id, name from people order by id"
+    ).fetchall() == [(1, "O'Reilly"), (2, "Síle")]
+    assert restored.execute(
+        "select name from sqlite_master where type = 'index' and name = 'people_name'"
+    ).fetchone() == ("people_name",)
+
