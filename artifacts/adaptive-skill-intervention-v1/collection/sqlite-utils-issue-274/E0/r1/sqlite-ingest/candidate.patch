+def test_dump(tmpdir):
+    path = str(tmpdir / "dump.db")
+    db = sqlite3.connect(path)
+    db.execute(
+        "create table creatures (id integer primary key, name text not null, data blob)"
+    )
+    db.executemany(
+        "insert into creatures (name, data) values (?, ?)",
+        [("Cleo's", b"\x00\xff"), ("Pancakes", None)],
+    )
+    db.commit()
+    db.close()
+
+    result = CliRunner().invoke(cli.cli, ["dump", path])
+
+    assert result.exit_code == 0
+    restored = sqlite3.connect(":memory:")
+    restored.executescript(result.output)
+    assert restored.execute(
+        "select id, name, data from creatures order by id"
+    ).fetchall() == [(1, "Cleo's", b"\x00\xff"), (2, "Pancakes", None)]
+    assert "CREATE TABLE creatures" in result.output
+
