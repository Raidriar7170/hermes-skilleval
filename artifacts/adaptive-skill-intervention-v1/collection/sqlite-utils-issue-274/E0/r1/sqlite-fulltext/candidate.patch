diff --git a/tests/test_cli.py b/tests/test_cli.py
index 5cb4af03257ba2d0574d2f665dab79be71b86a10..5bd4ba28f044d0b842542de37620df3a1da08e02 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -24,6 +24,23 @@ def db_path(tmpdir):
     return path
 
 
+def test_dump(db_path):
+    db = Database(db_path)
+    db["Gosh"].insert({"c1": "one", "c2": "It's two", "c3": None})
+
+    result = CliRunner().invoke(cli.cli, ["dump", db_path])
+
+    assert result.exit_code == 0
+    restored = sqlite3.connect(":memory:")
+    restored.executescript(result.output)
+    assert restored.execute(
+        "select c1, c2, c3 from Gosh"
+    ).fetchall() == [("one", "It's two", None)]
+    assert restored.execute(
+        "select sql from sqlite_master where name = 'Gosh'"
+    ).fetchone()[0] == "CREATE TABLE Gosh (c1 text, c2 text, c3 text)"
+
