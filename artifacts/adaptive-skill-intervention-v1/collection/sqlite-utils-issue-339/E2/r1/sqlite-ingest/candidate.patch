+def test_lookup_with_extra_values(fresh_db):
+    species = fresh_db["species"]
+    palm_id = species.lookup(
+        {"name": "Palm"}, {"common_name": "Arecaceae", "score": 1}
+    )
+    assert {
+        "id": palm_id,
+        "name": "Palm",
+        "common_name": "Arecaceae",
+        "score": 1,
+    } == species.get(palm_id)
+    # Extra values are only applied when inserting, not when a match already exists
+    assert palm_id == species.lookup(
+        {"name": "Palm"}, {"common_name": "Palmae", "score": 2}
+    )
+    assert "Arecaceae" == species.get(palm_id)["common_name"]
+    assert 1 == species.get(palm_id)["score"]
+    # Only the lookup values participate in the unique index
+    assert ["name"] == species.indexes[0].columns
+
+
+def test_lookup_with_extra_values_existing_table(fresh_db):
+    species = fresh_db.table("species", pk="id")
+    palm_id = species.insert({"name": "Palm"}).last_pk
+    assert palm_id == species.lookup({"name": "Palm"}, {"score": 1})
+    assert "score" not in species.columns_dict
+
+    oak_id = species.lookup({"name": "Oak"}, {"score": 2})
+    assert 2 == species.get(oak_id)["score"]
+
+
