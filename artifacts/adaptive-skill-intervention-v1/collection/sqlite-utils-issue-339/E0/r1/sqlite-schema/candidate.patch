+def test_lookup_with_extra_values(fresh_db):
+    species = fresh_db["species"]
+    palm_id = species.lookup(
+        {"name": "Palm"}, {"name_source": "survey", "description": "Original"}
+    )
+    assert {
+        "id": palm_id,
+        "name": "Palm",
+        "name_source": "survey",
+        "description": "Original",
+    } == species.get(palm_id)
+    assert ["name"] == species.indexes[0].columns
+
+    # Extra values are only used for an insert, not to update an existing match
+    assert palm_id == species.lookup(
+        {"name": "Palm"}, {"name_source": "import", "description": "Changed"}
+    )
+    assert "survey" == species.get(palm_id)["name_source"]
+    assert "Original" == species.get(palm_id)["description"]
+
+
+def test_lookup_with_extra_values_existing_table(fresh_db):
+    species = fresh_db.table("species", pk="id")
+    palm_id = species.insert({"name": "Palm", "description": "Original"}).last_pk
+
+    assert palm_id == species.lookup(
+        {"name": "Palm"}, {"description": "Changed", "source": "survey"}
+    )
+    assert "Original" == species.get(palm_id)["description"]
+    assert species.get(palm_id)["source"] is None
+
+
