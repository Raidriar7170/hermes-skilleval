diff --git a/tests/test_lookup.py b/tests/test_lookup.py
index ac8e1c29b660ec5a12c86d22c67c5e5a3891e29a..a4b02402c19d2cb5970b81458bdfa3b794b7987a 100644
--- a/tests/test_lookup.py
+++ b/tests/test_lookup.py
@@ -66,3 +66,35 @@ def test_lookup_fails_if_constraint_cannot_be_added(fresh_db):
     # This will fail because the name column is not unique
     with pytest.raises(Exception, match="UNIQUE constraint failed"):
         species.lookup({"name": "Palm"})
+
+
+def test_lookup_extra_values_new_table(fresh_db):
+    species = fresh_db["species"]
+    palm_id = species.lookup({"name": "Palm"}, {"common_name": "Arecaceae"})
+
+    assert species.get(palm_id) == {
+        "id": palm_id,
+        "name": "Palm",
+        "common_name": "Arecaceae",
+    }
+    assert species.indexes[0].columns == ["name"]
+
+
+def test_lookup_extra_values_only_used_for_new_record(fresh_db):
+    species = fresh_db["species"]
+    palm_id = species.lookup({"name": "Palm"}, {"description": "original"})
+
+    assert palm_id == species.lookup(
+        {"name": "Palm"}, {"description": "replacement", "new_column": "value"}
+    )
+    assert species.get(palm_id)["description"] == "original"
+    assert "new_column" not in species.columns_dict
+
+
+def test_lookup_extra_values_existing_table_new_record(fresh_db):
+    species = fresh_db["species"]
+    species.lookup({"name": "Palm"})
+
+    oak_id = species.lookup({"name": "Oak"}, {"description": "A tree"})
+
+    assert species.get(oak_id)["description"] == "A tree"
