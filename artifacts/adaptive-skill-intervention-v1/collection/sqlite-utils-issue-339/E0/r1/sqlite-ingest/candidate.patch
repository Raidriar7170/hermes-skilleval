diff --git a/tests/test_lookup.py b/tests/test_lookup.py
index ac8e1c29b660ec5a12c86d22c67c5e5a3891e29a..192434601dbecf9e605901bb03725b25dea8db3e 100644
--- a/tests/test_lookup.py
+++ b/tests/test_lookup.py
@@ -66,3 +66,40 @@ def test_lookup_fails_if_constraint_cannot_be_added(fresh_db):
     # This will fail because the name column is not unique
     with pytest.raises(Exception, match="UNIQUE constraint failed"):
         species.lookup({"name": "Palm"})
+
+
+def test_lookup_with_extra_values_new_table(fresh_db):
+    species = fresh_db["species"]
+    palm_id = species.lookup(
+        lookup_values={"name": "Palm"},
+        extra_values={"latin_name": "Arecaceae", "score": 1},
+    )
+    assert {
+        "id": palm_id,
+        "name": "Palm",
+        "latin_name": "Arecaceae",
+        "score": 1,
+    } == species.get(palm_id)
+    assert ["name"] == species.indexes[0].columns
+
+    oak_id = species.lookup({"name": "Oak"}, {"latin_name": "Quercus"})
+    assert {
+        "id": oak_id,
+        "name": "Oak",
+        "latin_name": "Quercus",
+        "score": None,
+    } == species.get(oak_id)
+
+
+def test_lookup_with_extra_values_does_not_update_existing_record(fresh_db):
+    species = fresh_db["species"]
+    palm_id = species.lookup({"name": "Palm"}, {"latin_name": "Arecaceae"})
+    assert palm_id == species.lookup(
+        {"name": "Palm"}, {"latin_name": "Palmae", "score": 2}
+    )
+    assert {
+        "id": palm_id,
+        "name": "Palm",
+        "latin_name": "Arecaceae",
+        "score": None,
+    } == species.get(palm_id)
