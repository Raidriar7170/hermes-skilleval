diff --git a/tests/test_lookup.py b/tests/test_lookup.py
index ac8e1c29b660ec5a12c86d22c67c5e5a3891e29a..467ad501ab2fc214df2b0175080cf18065fcbb02 100644
--- a/tests/test_lookup.py
+++ b/tests/test_lookup.py
@@ -66,3 +66,33 @@ def test_lookup_fails_if_constraint_cannot_be_added(fresh_db):
     # This will fail because the name column is not unique
     with pytest.raises(Exception, match="UNIQUE constraint failed"):
         species.lookup({"name": "Palm"})
+
+
+def test_lookup_with_extra_values(fresh_db):
+    species = fresh_db["species"]
+    palm_id = species.lookup(
+        {"name": "Palm"}, {"common_name": "Arecaceae", "score": 1}
+    )
+    assert {
+        "id": palm_id,
+        "name": "Palm",
+        "common_name": "Arecaceae",
+        "score": 1,
+    } == species.get(palm_id)
+    # Extra values are neither used for matching nor used to update a match
+    assert palm_id == species.lookup(
+        {"name": "Palm"}, {"common_name": "Palm tree", "score": 2}
+    )
+    assert "Arecaceae" == species.get(palm_id)["common_name"]
+    assert 1 == species.get(palm_id)["score"]
+    # They are populated for subsequent new records too
+    oak_id = species.lookup({"name": "Oak"}, {"common_name": "Quercus"})
+    assert "Quercus" == species.get(oak_id)["common_name"]
+    # Only lookup columns form the unique index
+    assert ["name"] == species.indexes[0].columns
+
+
+def test_lookup_extra_values_cannot_override_lookup_values(fresh_db):
+    species = fresh_db["species"]
+    species_id = species.lookup({"name": "Palm"}, {"name": "Not palm"})
+    assert "Palm" == species.get(species_id)["name"]
