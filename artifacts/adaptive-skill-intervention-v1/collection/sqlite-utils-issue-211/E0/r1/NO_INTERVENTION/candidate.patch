+def test_triggers_dict(fresh_db):
+    authors = fresh_db["authors"].create({"name": str})
+    assert {} == authors.triggers_dict
+    trigger_sql = """CREATE TRIGGER authors_uppercase_name
+    AFTER INSERT ON authors
+    BEGIN
+        UPDATE authors SET name = upper(new.name) WHERE rowid = new.rowid;
+    END"""
+    fresh_db.execute(trigger_sql)
+    assert {"authors_uppercase_name": trigger_sql} == authors.triggers_dict
+
