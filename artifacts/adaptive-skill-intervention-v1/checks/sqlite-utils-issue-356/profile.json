{
  "repository": "simonw/sqlite-utils",
  "packages": {
    "sqlite_utils": "."
  },
  "cli_module": "sqlite_utils.cli",
  "cli_callable": "cli",
  "cli_name": "sqlite-utils",
  "image": "hermes-asi-executor:v1",
  "writable_roots": [
    "sqlite_utils",
    "tests"
  ],
  "file_policy": {
    "version": "operations-v1",
    "rules": [
      {
        "path": "sqlite_utils",
        "operations": [
          "add",
          "modify",
          "delete"
        ],
        "max_bytes": 1000000
      },
      {
        "path": "tests",
        "operations": [
          "add",
          "modify",
          "delete"
        ],
        "max_bytes": 1000000
      }
    ]
  }
}
