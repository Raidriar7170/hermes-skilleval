 import unittest
 
 from csvkit.cli import match_column_identifier, parse_column_identifiers
+from csvkit.exceptions import ColumnIdentifierError
 
 
 class TestCli(unittest.TestCase):
@@ -35,6 +36,17 @@ class TestCli(unittest.TestCase):
         self.assertEqual([4, 3, 5], parse_column_identifiers(
             'more-header-values,3,stuff', self.headers, column_offset=0))
 
+    def test_hyphenated_column_name(self):
+        self.assertEqual([4], parse_column_identifiers('more-header-values', self.headers))
+
+    def test_unknown_hyphenated_column_name(self):
+        with self.assertRaisesRegex(ColumnIdentifierError, "neither an integer nor a column name"):
+            parse_column_identifiers('unknown-header', self.headers)
+
+    def test_unknown_excluded_hyphenated_column_name(self):
+        with self.assertRaisesRegex(ColumnIdentifierError, "neither an integer nor a column name"):
+            parse_column_identifiers(None, self.headers, excluded_columns='unknown-header')
+
     def test_range_notation_open_ended(self):
         self.assertEqual([0, 1, 2], parse_column_identifiers(':3', self.headers))
 
