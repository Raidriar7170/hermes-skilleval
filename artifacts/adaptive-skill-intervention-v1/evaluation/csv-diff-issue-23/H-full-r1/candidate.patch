+def test_load_csv_with_composite_key_list():
+    csv_file = io.StringIO("country,id,name\nUS,1,Cleo\nCA,1,Pancakes")
+
+    rows = load_csv(csv_file, key=["country", "id"])
+
+    assert {
+        ("US", "1"): {"country": "US", "id": "1", "name": "Cleo"},
+        ("CA", "1"): {"country": "CA", "id": "1", "name": "Pancakes"},
+    } == rows
+
+
+def test_load_csv_with_composite_key_tuple():
+    csv_file = io.StringIO("country,id,name\nUS,1,Cleo\nCA,1,Pancakes")
+
+    rows = load_csv(csv_file, key=("country", "id"))
+
+    assert [("US", "1"), ("CA", "1")] == list(rows)
+
+
+def test_compare_with_composite_key():
+    previous = io.StringIO("country,id,name\nUS,1,Cleo\nCA,1,Pancakes")
+    current = io.StringIO("country,id,name\nUS,1,Cleo\nCA,1,Waffles")
+
+    result = compare(
+        load_csv(previous, key=["country", "id"]),
+        load_csv(current, key=["country", "id"]),
+    )
+
+    assert [{"key": ("CA", "1"), "changes": {"name": ["Pancakes", "Waffles"]}}] == result["changed"]
+    assert [] == result["added"]
+    assert [] == result["removed"]
