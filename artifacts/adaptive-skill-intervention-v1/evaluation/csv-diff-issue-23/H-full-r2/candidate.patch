+
+COMPOSITE_TWO = """account_id,id,name
+1,1,Cleo
+2,1,Waffles"""
+
+
+@pytest.mark.parametrize("key", [["account_id", "id"], ("account_id", "id")])
+def test_composite_key(key):
+    rows = load_csv(io.StringIO(COMPOSITE_ONE), key=key)
+
+    assert rows == {
+        ("1", "1"): {"account_id": "1", "id": "1", "name": "Cleo"},
+        ("2", "1"): {"account_id": "2", "id": "1", "name": "Pancakes"},
+    }
+
+
+@pytest.mark.parametrize("key", [["account_id", "id"], ("account_id", "id")])
+def test_composite_key_compare(key):
+    diff = compare(
+        load_csv(io.StringIO(COMPOSITE_ONE), key=key),
+        load_csv(io.StringIO(COMPOSITE_TWO), key=key),
+    )
+
+    assert diff["changed"] == [
+        {"key": ("2", "1"), "changes": {"name": ["Pancakes", "Waffles"]}}
+    ]
