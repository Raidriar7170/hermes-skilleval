+def test_create_index_analyze(db_path):
+    db = Database(db_path)
+    db["Gosh"].insert({"c1": "one", "c2": "two", "c3": "three"})
+    result = CliRunner().invoke(
+        cli.cli, ["create-index", db_path, "Gosh", "c1", "--analyze"]
+    )
+    assert result.exit_code == 0
+    assert db.execute(
+        "select tbl, idx from sqlite_stat1 where idx = 'idx_Gosh_c1'"
+    ).fetchone() == ("Gosh", "idx_Gosh_c1")
