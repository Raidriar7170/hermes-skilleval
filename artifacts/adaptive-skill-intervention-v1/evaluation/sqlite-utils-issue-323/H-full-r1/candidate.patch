+from sqlite_utils.db import BadMultiValues, Database
 import pytest
+import re
+import sqlite3
+
+
+class RecordingConnection(sqlite3.Connection):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.create_function_calls = []
+
+    def create_function(self, *args, **kwargs):
+        self.create_function_calls.append((args, kwargs))
+        return super().create_function(*args, **kwargs)
 
 
 @pytest.mark.parametrize(
@@ -24,6 +36,58 @@ def test_convert(fresh_db, columns, fn, expected):
     assert list(table.rows) == [expected]
 
 
+def test_convert_uses_unique_temporary_function():
+    connection = sqlite3.connect(":memory:", factory=RecordingConnection)
+    db = Database(connection)
+    table = db["table"]
+    table.insert({"title": "Mixed Case"})
+    db.conn.create_function("convert_value", 1, lambda value: "existing")
+    statements = []
+
+    with db.tracer(lambda sql, params: statements.append(sql)):
+        table.convert("title", lambda value: value.upper())
+        table.convert("title", lambda value: value.lower())
+
+    updates = [sql for sql in statements if sql.startswith("update ")]
+    function_names = [
+        re.search(r"(convert_value_[0-9a-f]+)\(", update).group(1)
+        for update in updates
+    ]
+    assert len(set(function_names)) == 2
+    assert db.execute("select convert_value('x')").fetchone()[0] == "existing"
+    temporary_calls = [
+        args
+        for args, kwargs in connection.create_function_calls
+        if args[0].startswith("convert_value_")
+    ]
+    assert [call[0] for call in temporary_calls] == [
+        function_names[0],
+        function_names[0],
+        function_names[1],
+        function_names[1],
+    ]
+    assert [call[2] is None for call in temporary_calls] == [False, True, False, True]
+
+
+def test_convert_cleans_up_temporary_function_after_error():
+    connection = sqlite3.connect(":memory:", factory=RecordingConnection)
+    db = Database(connection)
+    table = db["table"]
+    table.insert({"title": "Mixed Case"})
+    statements = []
+
+    def fail(value):
+        raise ValueError(value)
+
+    with pytest.raises(sqlite3.OperationalError):
+        with db.tracer(lambda sql, params: statements.append(sql)):
+            table.convert("title", fail)
+
+    update = next(sql for sql in statements if sql.startswith("update "))
+    function_name = re.search(r"(convert_value_[0-9a-f]+)\(", update).group(1)
+    assert connection.create_function_calls[-1][0] == (function_name, 1, None)
+
+
 @pytest.mark.parametrize(
     "where,where_args", (("id > 1", None), ("id > :id", {"id": 1}), ("id > ?", [1]))
 )
