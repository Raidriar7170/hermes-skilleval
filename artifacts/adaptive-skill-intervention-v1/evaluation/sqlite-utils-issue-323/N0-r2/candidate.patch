+def test_convert_does_not_clobber_existing_function(fresh_db):
+    @fresh_db.register_function
+    def convert_value(value):
+        return "existing: {}".format(value)
+
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+    table.convert("title", lambda value: value.upper())
+
+    assert list(table.rows) == [{"title": "MIXED CASE"}]
+    assert fresh_db.execute("select convert_value('ok')").fetchone()[0] == "existing: ok"
+
+
+def test_convert_uses_unique_temporary_functions_and_unregisters_them(fresh_db):
+    class TrackedConnection:
+        def __init__(self, connection):
+            self.connection = connection
+            self.create_function_calls = []
+
+        def __getattr__(self, attr):
+            return getattr(self.connection, attr)
+
+        def __enter__(self):
+            self.connection.__enter__()
+            return self
+
+        def __exit__(self, *args):
+            return self.connection.__exit__(*args)
+
+        def create_function(self, name, arity, function):
+            self.create_function_calls.append((name, arity, function))
+            return self.connection.create_function(name, arity, function)
+
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+    fresh_db.conn = TrackedConnection(fresh_db.conn)
+
+    table.convert("title", lambda value: value.upper())
+    table.convert("title", lambda value: value.lower())
+
+    registrations = fresh_db.conn.create_function_calls[::2]
+    unregistrations = fresh_db.conn.create_function_calls[1::2]
+    function_names = [name for name, _, _ in registrations]
+    assert len(set(function_names)) == 2
+    assert all(name.startswith("_sqlite_utils_convert_") for name in function_names)
+    assert all(arity == 1 and callable(fn) for _, arity, fn in registrations)
+    assert unregistrations == [(name, 1, None) for name in function_names]
+
+
 @pytest.mark.parametrize(
     "where,where_args", (("id > 1", None), ("id > :id", {"id": 1}), ("id > ?", [1]))
 )
