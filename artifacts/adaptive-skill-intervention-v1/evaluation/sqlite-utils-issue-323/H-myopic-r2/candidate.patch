+def test_convert_uses_temporary_unique_function(fresh_db):
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+    fresh_db.conn.create_function("convert_value", 1, lambda value: "existing")
+    fresh_db.conn = mock.MagicMock(wraps=fresh_db.conn)
+
+    with mock.patch("sqlite_utils.db.uuid.uuid4") as uuid4:
+        uuid4.return_value.hex = "test_function"
+        table.convert("title", lambda value: value.upper())
+
+    assert list(table.rows) == [{"title": "MIXED CASE"}]
+    assert fresh_db.execute("select convert_value('value')").fetchone()[0] == "existing"
+    assert fresh_db.conn.create_function.mock_calls[-1] == mock.call(
+        "_sqlite_utils_convert_test_function", 1, None
+    )
+
+
+def test_convert_cleans_up_temporary_function_on_error(fresh_db):
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+    fresh_db.conn = mock.MagicMock(wraps=fresh_db.conn)
+
+    with mock.patch("sqlite_utils.db.uuid.uuid4") as uuid4:
+        uuid4.return_value.hex = "test_function"
+        with pytest.raises(OperationalError):
+            table.convert("title", lambda value: 1 / 0)
+
+    assert fresh_db.conn.create_function.mock_calls[-1] == mock.call(
+        "_sqlite_utils_convert_test_function", 1, None
+    )
+
+
 @pytest.mark.parametrize(
     "where,where_args", (("id > 1", None), ("id > :id", {"id": 1}), ("id > ?", [1]))
 )
