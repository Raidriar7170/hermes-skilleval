+from sqlite_utils.db import BadMultiValues, Database
 import pytest
+import sqlite3
+
+
+class TrackingConnection(sqlite3.Connection):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.function_calls = []
+
+    def create_function(self, name, num_params, func, **kwargs):
+        self.function_calls.append((name, num_params, func))
+        return super().create_function(name, num_params, func, **kwargs)
 
 
 @pytest.mark.parametrize(
@@ -24,6 +35,49 @@ def test_convert(fresh_db, columns, fn, expected):
