+def test_convert_uses_temporary_function():
+    connection = sqlite3.connect(":memory:", factory=TrackingConnection)
+    db = Database(connection)
+
+    @db.register_function
+    def convert_value(value):
+        return "existing: {}".format(value)
+
+    traced_sql = []
+    db.conn.set_trace_callback(traced_sql.append)
+    table = db["table"]
+    table.insert({"title": "Mixed Case"})
+    table.convert("title", lambda value: value.upper())
+    db.conn.set_trace_callback(None)
+
+    assert list(table.rows) == [{"title": "MIXED CASE"}]
+    assert db.execute("select convert_value('test')").fetchone()[0] == "existing: test"
+    update_sql = next(sql for sql in traced_sql if sql.lower().startswith("update "))
+    temporary_name = update_sql.split(" = ", 1)[1].split("(", 1)[0]
+    assert temporary_name.startswith("convert_value_")
+    assert connection.function_calls[-1] == (temporary_name, 1, None)
+
+
+def test_convert_cleans_up_temporary_function_on_error():
+    connection = sqlite3.connect(":memory:", factory=TrackingConnection)
+    db = Database(connection)
+    table = db["table"]
+    table.insert({"title": "Mixed Case"})
+    traced_sql = []
+    db.conn.set_trace_callback(traced_sql.append)
+
+    def raise_error(value):
+        raise ValueError
+
+    with pytest.raises(sqlite3.OperationalError, match="user-defined function"):
+        table.convert("title", raise_error)
+    db.conn.set_trace_callback(None)
+
+    update_sql = next(sql for sql in traced_sql if sql.lower().startswith("update "))
+    temporary_name = update_sql.split(" = ", 1)[1].split("(", 1)[0]
+    assert connection.function_calls[-1] == (temporary_name, 1, None)
+
+
 @pytest.mark.parametrize(
     "where,where_args", (("id > 1", None), ("id > :id", {"id": 1}), ("id > ?", [1]))
 )
