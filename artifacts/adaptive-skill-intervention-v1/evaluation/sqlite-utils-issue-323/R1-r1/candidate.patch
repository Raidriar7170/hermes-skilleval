+def test_convert_does_not_clobber_existing_function(fresh_db):
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+    fresh_db.conn.create_function("convert_value", 1, lambda value: "existing")
+
+    table.convert("title", lambda value: value.upper())
+
+    assert list(table.rows) == [{"title": "MIXED CASE"}]
+    assert fresh_db.execute("select convert_value('x')").fetchone()[0] == "existing"
+
+
+@pytest.mark.parametrize("raises", (False, True))
+def test_convert_unregisters_temporary_function(raises):
+    class TrackingConnection(sqlite3.Connection):
+        def create_function(self, name, num_params, func, **kwargs):
+            self.function_calls.append((name, num_params, func))
+            return super().create_function(name, num_params, func, **kwargs)
+
+    connection = sqlite3.connect(":memory:", factory=TrackingConnection)
+    connection.function_calls = []
+    db = Database(connection)
+    table = db["table"]
+    table.insert({"title": "Mixed Case"})
+
+    def convert(value):
+        if raises:
+            raise ValueError
+        return value.upper()
+
+    with pytest.raises(Exception) if raises else contextlib.nullcontext():
+        table.convert("title", convert)
+
+    register_call, unregister_call = connection.function_calls
+    assert register_call[0].startswith("convert_value_")
+    assert register_call[1] == 1
+    assert callable(register_call[2])
+    assert unregister_call == (register_call[0], 1, None)
+
+
 @pytest.mark.parametrize(
     "where,where_args", (("id > 1", None), ("id > :id", {"id": 1}), ("id > ?", [1]))
 )
