+def test_convert_does_not_clobber_existing_function(fresh_db):
+    fresh_db.conn.create_function("convert_value", 1, lambda value: "existing")
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+    table.convert("title", lambda value: value.upper())
+    assert list(table.rows) == [{"title": "MIXED CASE"}]
+    assert fresh_db.execute("select convert_value('value')").fetchone()[0] == "existing"
+
+
+def test_convert_unregisters_temporary_function(fresh_db):
+    class RecordingConnection:
+        def __init__(self, connection):
+            self.connection = connection
+            self.create_function_calls = []
+
+        def __getattr__(self, attr):
+            return getattr(self.connection, attr)
+
+        def __enter__(self):
+            return self.connection.__enter__()
+
+        def __exit__(self, *args):
+            return self.connection.__exit__(*args)
+
+        def create_function(self, name, arity, fn, **kwargs):
+            self.create_function_calls.append((name, arity, fn))
+            return self.connection.create_function(name, arity, fn, **kwargs)
+
+    fresh_db.conn = RecordingConnection(fresh_db.conn)
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+    table.convert("title", lambda value: value.upper())
+    table.convert("title", lambda value: value.lower())
+
+    register_one, unregister_one, register_two, unregister_two = (
+        fresh_db.conn.create_function_calls
+    )
+    assert register_one[0].startswith("convert_value_")
+    assert register_two[0].startswith("convert_value_")
+    assert register_one[0] != register_two[0]
+    assert callable(register_one[2])
+    assert callable(register_two[2])
+    assert unregister_one == (register_one[0], 1, None)
+    assert unregister_two == (register_two[0], 1, None)
+
+
 @pytest.mark.parametrize(
     "where,where_args", (("id > 1", None), ("id > :id", {"id": 1}), ("id > ?", [1]))
 )
