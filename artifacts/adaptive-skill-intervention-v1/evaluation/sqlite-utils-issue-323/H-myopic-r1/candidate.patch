@@ -24,6 +44,51 @@ def test_convert(fresh_db, columns, fn, expected):
     assert list(table.rows) == [expected]
 
 
+def test_convert_uses_unique_temporary_functions(fresh_db):
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+    fresh_db.conn.create_function("convert_value", 1, lambda value: "existing")
+    fresh_db.conn = TracingConnection(fresh_db.conn)
+
+    table.convert("title", lambda value: value.upper())
+    table.convert("title", lambda value: value.lower())
+
+    registrations = [
+        call
+        for call in fresh_db.conn.function_calls
+        if call[0].startswith("convert_value_") and call[2] is not None
+    ]
+    assert len(registrations) == 2
+    assert registrations[0][0] != registrations[1][0]
+    for name, arity, _, _ in registrations:
+        assert (name, arity, None, {}) in fresh_db.conn.function_calls
+    assert fresh_db.execute("select convert_value('x')").fetchone()[0] == "existing"
+
+
+def test_convert_cleans_up_temporary_function_after_error(fresh_db, monkeypatch):
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+    fresh_db.conn = TracingConnection(fresh_db.conn)
+    original_execute = fresh_db.execute
+
+    def execute(sql, parameters=None):
+        if sql.startswith("update"):
+            raise OperationalError("update failed")
+        return original_execute(sql, parameters)
+
+    monkeypatch.setattr(fresh_db, "execute", execute)
+
+    with pytest.raises(OperationalError):
+        table.convert("title", lambda value: value.upper())
+
+    registration, unregister = fresh_db.conn.function_calls
+    assert registration[0].startswith("convert_value_")
+    assert registration[1] == 1
+    assert callable(registration[2])
+    assert registration[3] == {}
+    assert unregister == (registration[0], 1, None, {})
+
+
 @pytest.mark.parametrize(
     "where,where_args", (("id > 1", None), ("id > :id", {"id": 1}), ("id > ?", [1]))
 )
