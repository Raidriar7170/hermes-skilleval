+from sqlite_utils import Database
+from sqlite_utils.db import BadMultiValues
+from sqlite_utils.utils import OperationalError, sqlite3
+
+
+class RecordingConnection(sqlite3.Connection):
+    def create_function(self, name, num_params, func, *args, **kwargs):
+        self.create_function_calls.append((name, num_params, func))
+        return super().create_function(name, num_params, func, *args, **kwargs)
+
+
+@pytest.fixture
+def recording_db():
+    connection = sqlite3.connect(":memory:", factory=RecordingConnection)
+    connection.create_function_calls = []
+    return Database(connection)
+
 
