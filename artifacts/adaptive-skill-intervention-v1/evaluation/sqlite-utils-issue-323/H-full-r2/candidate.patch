+def test_convert_uses_temporary_function_without_clobbering(recording_db):
+    table = recording_db["table"]
+    table.insert({"title": "Mixed Case"})
+
+    def convert_value(value):
+        return "existing: {}".format(value)
+
+    recording_db.register_function(convert_value)
+    table.convert("title", lambda value: value.upper())
+
+    assert table.get(1)["title"] == "MIXED CASE"
+    assert (
+        recording_db.execute("select convert_value('test')").fetchone()[0]
+        == "existing: test"
+    )
+    temporary_calls = [
+        call
+        for call in recording_db.conn.create_function_calls
+        if call[0].startswith("convert_value_")
+    ]
+    assert len(temporary_calls) == 2
+    assert temporary_calls[0][:2] == temporary_calls[1][:2]
+    assert callable(temporary_calls[0][2])
+    assert temporary_calls[1][2] is None
+
+
+def test_convert_cleans_up_temporary_function_on_error(recording_db):
+    table = recording_db["table"]
+    table.insert({"title": "Mixed Case"})
+
+    def raise_error(value):
+        raise ValueError
+
+    with pytest.raises(OperationalError):
+        table.convert("title", raise_error)
+
+    temporary_calls = [
+        call
+        for call in recording_db.conn.create_function_calls
+        if call[0].startswith("convert_value_")
+    ]
+    assert len(temporary_calls) == 2
+    assert temporary_calls[0][:2] == temporary_calls[1][:2]
+    assert callable(temporary_calls[0][2])
+    assert temporary_calls[1][2] is None
+
+
 @pytest.mark.parametrize(
     "where,where_args", (("id > 1", None), ("id > :id", {"id": 1}), ("id > ?", [1]))
 )
