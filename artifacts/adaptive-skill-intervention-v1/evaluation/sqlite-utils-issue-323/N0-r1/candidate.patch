+def test_convert_does_not_clobber_function_and_cleans_up(fresh_db):
+    fresh_db.conn.create_function("convert_value", 1, lambda value: "existing")
+    fresh_db.conn = TrackedConnection(fresh_db.conn)
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+    table.convert("title", lambda value: value.upper())
+    table.convert("title", lambda value: value.lower())
+
+    assert list(table.rows) == [{"title": "mixed case"}]
+    assert fresh_db.execute("select convert_value('x')").fetchone()[0] == "existing"
+    first_register, first_unregister, second_register, second_unregister = (
+        fresh_db.conn.function_calls
+    )
+    assert first_register[0].startswith("convert_value_")
+    assert second_register[0].startswith("convert_value_")
+    assert first_register[0] != second_register[0]
+    assert first_register[1] == second_register[1] == 1
+    assert callable(first_register[2])
+    assert callable(second_register[2])
+    assert first_unregister == (first_register[0], 1, None, {})
+    assert second_unregister == (second_register[0], 1, None, {})
+
+
+def test_convert_cleans_up_function_after_error(fresh_db):
+    fresh_db.conn = TrackedConnection(fresh_db.conn)
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+
+    with pytest.raises(sqlite3.OperationalError):
+        table.convert("title", lambda value: 1 / 0)
+
+    register, unregister = fresh_db.conn.function_calls
+    assert unregister == (register[0], 1, None, {})
+
+
 @pytest.mark.parametrize(
     "where,where_args", (("id > 1", None), ("id > :id", {"id": 1}), ("id > ?", [1]))
 )
