+def test_convert_does_not_clobber_existing_function(fresh_db):
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+
+    def convert_value(value):
+        return "existing: {}".format(value)
+
+    fresh_db.register_function(convert_value)
+    table.convert("title", lambda value: value.upper())
+
+    assert list(table.rows) == [{"title": "MIXED CASE"}]
+    assert (
+        fresh_db.execute("select convert_value('still here')").fetchone()[0]
+        == "existing: still here"
+    )
+
+
+def test_convert_unregisters_temporary_function():
+    calls = []
+
+    class RecordingConnection(sqlite3.Connection):
+        def create_function(self, name, num_params, func, **kwargs):
+            calls.append((name, num_params, func))
+            return super().create_function(name, num_params, func, **kwargs)
+
+    db = Database(sqlite3.connect(":memory:", factory=RecordingConnection))
+    table = db["table"]
+    table.insert({"title": "Mixed Case"})
+
+    table.convert("title", lambda value: value.upper())
+
+    assert calls[0][0].startswith("convert_value_")
+    assert calls[-1] == (calls[0][0], 1, None)
+
+
+def test_convert_unregisters_temporary_function_after_error(monkeypatch):
+    calls = []
+
+    class RecordingConnection(sqlite3.Connection):
+        def create_function(self, name, num_params, func, **kwargs):
+            calls.append((name, num_params, func))
+            return super().create_function(name, num_params, func, **kwargs)
+
+    db = Database(sqlite3.connect(":memory:", factory=RecordingConnection))
+    table = db["table"]
+    table.insert({"title": "Mixed Case"})
+
+    def fail_transform(*args, **kwargs):
+        raise RuntimeError("transform failed")
+
+    monkeypatch.setattr(table, "transform", fail_transform)
+    with pytest.raises(RuntimeError, match="transform failed"):
+        table.convert("title", lambda value: value.upper(), drop=True)
+
+    assert calls[-1] == (calls[0][0], 1, None)
+
+
 @pytest.mark.parametrize(
     "where,where_args", (("id > 1", None), ("id > :id", {"id": 1}), ("id > ?", [1]))
 )
