+def test_convert_does_not_clobber_existing_function(fresh_db):
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+    fresh_db.conn.create_function("convert_value", 1, lambda value: "original")
+
+    table.convert("title", lambda value: value.upper())
+
+    assert list(table.rows) == [{"title": "MIXED CASE"}]
+    assert fresh_db.execute("select convert_value('value')").fetchone()[0] == "original"
+
+
+def test_convert_unregisters_temporary_function(fresh_db):
+    table = fresh_db["table"]
+    table.insert({"title": "Mixed Case"})
+
+    class RecordingConnection:
+        def __init__(self, connection):
+            self.connection = connection
+            self.functions = []
+
+        def __getattr__(self, attr):
+            return getattr(self.connection, attr)
+
+        def __enter__(self):
+            self.connection.__enter__()
+            return self
+
+        def __exit__(self, *args):
+            return self.connection.__exit__(*args)
+
+        def create_function(self, name, arity, function, **kwargs):
+            self.functions.append((name, arity, function))
+            return self.connection.create_function(name, arity, function, **kwargs)
+
+    connection = RecordingConnection(fresh_db.conn)
+    fresh_db.conn = connection
+    table.convert("title", lambda value: value.upper())
+
+    assert len(connection.functions) == 2
+    function_name, arity, function = connection.functions[0]
+    assert function_name.startswith("convert_value_")
+    assert arity == 1
+    assert callable(function)
+    assert connection.functions[1] == (function_name, 1, None)
+
+
 @pytest.mark.parametrize(
