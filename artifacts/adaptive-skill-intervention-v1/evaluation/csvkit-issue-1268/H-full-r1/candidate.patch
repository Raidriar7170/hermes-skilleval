+    def test_inner_non_seekable(self):
+        def pipe(content):
+            read_fd, write_fd = os.pipe()
+            with os.fdopen(write_fd, 'w') as writer:
+                writer.write(content)
+            return os.fdopen(read_fd)
+
+        inputs = [pipe('A,B,C\n1,2,3\n'), pipe('C,D,E\n3,4,5\n')]
+        output_file = io.StringIO()
+        utility = self.Utility(['--no-inference', '-c', 'C', 'first', 'second'], output_file)
+
+        with patch.object(utility, '_open_input_file', side_effect=inputs):
+            utility.run()
+
+        self.assertEqual(output_file.getvalue(), 'A,B,C,D,E\n1,2,3,4,5\n')
+
     def test_left(self):
         output = self.get_output_as_io(['-c', 'a', '--left', 'examples/join_a.csv', 'examples/join_b.csv'])
         self.assertEqual(len(output.readlines()), 5)
