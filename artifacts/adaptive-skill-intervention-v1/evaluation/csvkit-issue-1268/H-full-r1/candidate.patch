+            buffered = None
+            try:
+                # agate seeks while sniffing the dialect, but inputs such as
+                # Bash process substitutions are pipes and cannot be seeked.
+                if f.seekable():
+                    handle = f
+                else:
+                    buffered = handle = io.StringIO(f.read())
+
+                tables.append(agate.Table.from_csv(
+                    handle,
+                    skip_lines=self.args.skip_lines,
+                    sniff_limit=sniff_limit,
+                    column_types=column_types,
+                    **self.reader_kwargs,
+                ))
+            finally:
+                if buffered is not None:
+                    buffered.close()
