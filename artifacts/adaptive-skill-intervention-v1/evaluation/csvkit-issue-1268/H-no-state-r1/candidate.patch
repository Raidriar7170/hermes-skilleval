+    def test_non_seekable_inputs(self):
+        class NonSeekableIO(io.StringIO):
+            def seekable(self):
+                return False
+
+            def seek(self, *args, **kwargs):
+                raise io.UnsupportedOperation('underlying stream is not seekable')
+
+        output = io.StringIO()
+        utility = self.Utility(['--no-inference', '-c', 'C', 'first', 'second'], output)
+
+        with patch.object(utility, '_open_input_file', side_effect=[
+            NonSeekableIO('A,B,C\n1,2,3\n'),
+            NonSeekableIO('C,D,E\n3,4,5\n'),
+        ]):
+            utility.run()
+
+        self.assertEqual(output.getvalue(), 'A,B,C,D,E\n1,2,3,4,5\n')
+
