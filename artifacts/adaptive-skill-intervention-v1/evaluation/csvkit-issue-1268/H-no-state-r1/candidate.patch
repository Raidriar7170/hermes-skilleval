+        for input_file in self.input_files:
+            f = input_file
+
+            # agate must rewind an input after sniffing its dialect. Process
+            # substitutions and named pipes are readable, but not seekable.
+            if not f.seekable():
+                f = io.StringIO(f.read())
+
+            try:
+                tables.append(agate.Table.from_csv(
+                    f,
+                    skip_lines=self.args.skip_lines,
+                    sniff_limit=sniff_limit,
+                    column_types=column_types,
+                    **self.reader_kwargs,
+                ))
+            finally:
+                f.close()
+                if f is not input_file:
+                    input_file.close()
 
         join_column_ids = []
 
