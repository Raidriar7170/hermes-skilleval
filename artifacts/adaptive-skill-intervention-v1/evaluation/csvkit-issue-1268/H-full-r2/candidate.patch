+import io
 import os
 import sys
 import unittest
@@ -52,6 +53,23 @@ class TestCSVJoin(CSVKitTestCase, EmptyFileTests):
         output = self.get_output_as_io(['-c', 'a', 'examples/join_a.csv', 'examples/join_b.csv'])
         self.assertEqual(len(output.readlines()), 3)
 
+    def test_inner_non_seekable(self):
+        inputs = []
+
+        for content in (b'A,B,C\n1,2,3\n', b'C,D,E\n3,4,5\n'):
+            read_fd, write_fd = os.pipe()
+            os.write(write_fd, content)
+            os.close(write_fd)
+            inputs.append(io.TextIOWrapper(os.fdopen(read_fd, 'rb')))
+
+        output = io.StringIO()
+        utility = self.Utility(['--no-inference', '-c', 'C', 'first', 'second'], output)
+
+        with patch.object(utility, '_open_input_file', side_effect=inputs):
+            utility.run()
+
+        self.assertEqual(output.getvalue(), 'A,B,C,D,E\n1,2,3,4,5\n')
+
     def test_left(self):
         output = self.get_output_as_io(['-c', 'a', '--left', 'examples/join_a.csv', 'examples/join_b.csv'])
         self.assertEqual(len(output.readlines()), 5)
