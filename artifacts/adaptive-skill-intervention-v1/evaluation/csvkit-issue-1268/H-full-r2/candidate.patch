@@ -1,5 +1,6 @@
 #!/usr/bin/env python
 
+import io
 import sys
 
 import agate
@@ -72,6 +73,14 @@ class CSVJoin(CSVKitUtility):
         column_types = self.get_column_types()
 
         for f in self.input_files:
+            # agate needs to rewind file-like objects after dialect sniffing. Process substitution and named pipes are
+            # file-like objects, but aren't seekable, so buffer them before parsing. csvjoin already reads every input
+            # into memory (see the epilog), and regular files continue to stream directly to agate.
+            if not f.seekable():
+                input_file = f
+                f = io.StringIO(input_file.read())
+                input_file.close()
+
             tables.append(agate.Table.from_csv(
                 f,
                 skip_lines=self.args.skip_lines,
