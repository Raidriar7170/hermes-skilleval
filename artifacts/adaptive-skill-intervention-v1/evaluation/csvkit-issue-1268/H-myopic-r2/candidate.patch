-            self.input_files.append(self._open_input_file(path))
+            f = self._open_input_file(path)
+
+            # agate seeks back to the start after sniffing the CSV dialect. Process
+            # substitution paths (for example, /dev/fd/63) are pipes and therefore
+            # can't be rewound, so buffer them before passing them to agate.
+            if self.args.sniff_limit != 0 and not f.seekable():
