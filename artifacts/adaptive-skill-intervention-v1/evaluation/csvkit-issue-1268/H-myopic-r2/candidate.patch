+    def test_non_seekable_inputs(self):
+        def pipe(content):
+            read_fd, write_fd = os.pipe()
+            os.write(write_fd, content.encode())
+            os.close(write_fd)
+            return io.TextIOWrapper(io.FileIO(read_fd, closefd=True))
+
+        output = io.StringIO()
+        utility = self.Utility(['--no-inference', '-c', 'C', 'first', 'second'], output)
+
+        with patch.object(utility, '_open_input_file', side_effect=[
+            pipe('A,B,C\n1,2,3\n'),
+            pipe('C,D,E\n3,4,5\n'),
+        ]):
+            utility.run()
+
+        self.assertEqual(output.getvalue(), 'A,B,C,D,E\n1,2,3,4,5\n')
+
