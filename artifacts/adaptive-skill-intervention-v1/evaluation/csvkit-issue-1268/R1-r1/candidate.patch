+            # Process substitution and named pipes produce non-seekable streams,
+            # but agate's dialect sniffing seeks back to the start of its sample.
+            # csvjoin already loads each input into memory, so buffer these streams.
+            source = f if f.seekable() else io.StringIO(f.read())
+
+            try:
+                tables.append(agate.Table.from_csv(
+                    source,
+                    skip_lines=self.args.skip_lines,
+                    sniff_limit=sniff_limit,
+                    column_types=column_types,
+                    **self.reader_kwargs,
+                ))
+            finally:
+                if source is not f:
+                    source.close()
+                f.close()
 
         join_column_ids = []
 
