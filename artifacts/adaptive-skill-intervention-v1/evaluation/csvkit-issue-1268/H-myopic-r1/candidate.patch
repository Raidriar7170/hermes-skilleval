+    def test_process_substitution(self):
+        input_files = []
+        for content in (b'A,B,C\n7,2,x\n', b'C,D,E\nx,4,5\n'):
+            read_fd, write_fd = os.pipe()
+            os.write(write_fd, content)
+            os.close(write_fd)
+            input_files.append(open(read_fd))
+
+        output_file = io.StringIO()
+        with patch.object(self.Utility, '_open_input_file', side_effect=input_files):
+            utility = self.Utility(['-c', 'C', 'input1', 'input2'], output_file)
+            utility.run()
+
+        self.assertEqual(output_file.getvalue(), 'A,B,C,D,E\n7,2,x,4,5\n')
+
     def test_left(self):
         output = self.get_output_as_io(['-c', 'a', '--left', 'examples/join_a.csv', 'examples/join_b.csv'])
         self.assertEqual(len(output.readlines()), 5)
