+    def test_non_seekable_inputs(self):
+        input_files = []
+        for content in (b'A,B,C\n', b'C,D,E\n'):
+            read_fd, write_fd = os.pipe()
+            os.write(write_fd, content)
+            os.close(write_fd)
+            input_files.append(os.fdopen(read_fd))
+
+        self.assertFalse(input_files[0].seekable())
+
+        inputs = iter(input_files)
+        utility = self.Utility(['-c', 'C', 'input1', 'input2'], io.StringIO())
+
+        with patch.object(utility, '_open_input_file', side_effect=lambda path: next(inputs)):
+            utility.run()
+
+        self.assertEqual(utility.output_file.getvalue(), 'A,B,C,D,E\n')
+
     def test_inner(self):
