+    def test_non_seekable_inputs(self):
+        inputs = [
+            NonSeekableStringIO('A,B,C\n1,2,3\n'),
+            NonSeekableStringIO('C,D,E\n3,4,5\n'),
+        ]
+
+        with patch.object(self.Utility, '_open_input_file', side_effect=inputs):
