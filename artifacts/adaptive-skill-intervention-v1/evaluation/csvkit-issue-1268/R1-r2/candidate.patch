         output = self.get_output_as_io(['examples/join_a.csv', 'examples/join_b.csv'])
         self.assertEqual(len(output.readlines()), 4)
 
+    def test_non_seekable_inputs(self):
+        class NonSeekableStringIO(io.StringIO):
+            def seekable(self):
+                return False
+
+            def seek(self, *args, **kwargs):
+                raise io.UnsupportedOperation('underlying stream is not seekable')
+
+            def tell(self):
+                raise io.UnsupportedOperation('underlying stream is not seekable')
+
+        inputs = [
+            NonSeekableStringIO('A,B,C\n1,2,x\n'),
+            NonSeekableStringIO('C,D,E\nx,4,5\n'),
+        ]
+
+        with patch.object(CSVJoin, '_open_input_file', side_effect=inputs):
+            self.assertRows(['--no-inference', '-c', 'C', 'first', 'second'], [
+                ['A', 'B', 'C', 'D', 'E'],
+                ['1', '2', 'x', '4', '5'],
+            ])
+
     def test_inner(self):
         output = self.get_output_as_io(['-c', 'a', 'examples/join_a.csv', 'examples/join_b.csv'])
         self.assertEqual(len(output.readlines()), 3)
