diff --git a/csvkit/utilities/csvjoin.py b/csvkit/utilities/csvjoin.py
index 07d4ee5007c7853c040336ab5e354ffe9b01a57b..973230395764b2e6b8f7c7623d06b1acc2a56d94 100644
--- a/csvkit/utilities/csvjoin.py
+++ b/csvkit/utilities/csvjoin.py
@@ -1,5 +1,6 @@
 #!/usr/bin/env python
 
+import io
 import sys
 
 import agate
@@ -49,7 +50,18 @@ class CSVJoin(CSVKitUtility):
         self.input_files = []
 
         for path in self.args.input_paths:
-            self.input_files.append(self._open_input_file(path))
+            f = self._open_input_file(path)
+
+            # agate.Table.from_csv() seeks after sniffing the CSV dialect. Process
+            # substitution and named pipes are readable, but not seekable, so copy
+            # those streams into memory first. csvjoin already reads every input
+            # into memory in order to perform the join.
+            if f != sys.stdin and not f.seekable():
+                buffered = io.StringIO(f.read())
+                f.close()
+                f = buffered
+
+            self.input_files.append(f)
 
         if self.args.columns:
             join_column_names = self._parse_join_column_names(self.args.columns)
