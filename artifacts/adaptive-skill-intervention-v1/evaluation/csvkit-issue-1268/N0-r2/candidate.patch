+    def test_non_seekable_inputs(self):
+        class NonSeekableIO(io.StringIO):
+            def seekable(self):
+                return False
+
+            def seek(self, *args, **kwargs):
+                raise io.UnsupportedOperation('underlying stream is not seekable')
+
+            def tell(self):
+                raise io.UnsupportedOperation('underlying stream is not seekable')
+
+        inputs = [NonSeekableIO('A,B,C\n1,2,3\n'), NonSeekableIO('C,D,E\n3,4,5\n')]
+        output_file = io.StringIO()
+        utility = self.Utility(['--no-inference', '-c', 'C', 'input1', 'input2'], output_file)
+
+        with patch.object(utility, '_open_input_file', side_effect=inputs):
+            utility.run()
+
+        self.assertEqual(output_file.getvalue(), 'A,B,C,D,E\n1,2,3,4,5\n')
+
     def test_inner(self):
         output = self.get_output_as_io(['-c', 'a', 'examples/join_a.csv', 'examples/join_b.csv'])
         self.assertEqual(len(output.readlines()), 3)
