index 07d4ee5007c7853c040336ab5e354ffe9b01a57b..0b286d127dcfb75660d8b3955b7f08ff449d9c63 100644
--- a/csvkit/utilities/csvjoin.py
+++ b/csvkit/utilities/csvjoin.py
@@ -1,5 +1,6 @@
 #!/usr/bin/env python
 
+import io
 import sys
 
 import agate
@@ -49,7 +50,18 @@ class CSVJoin(CSVKitUtility):
         self.input_files = []
 
         for path in self.args.input_paths:
-            self.input_files.append(self._open_input_file(path))
+            f = self._open_input_file(path)
+
+            # agate seeks after reading a sample for dialect sniffing. Named
+            # pipes, including Bash process substitutions, are not seekable.
+            # csvjoin reads every input into memory in any case, so buffer
+            # these streams to make them compatible with agate's parser.
+            if f is not sys.stdin and not f.seekable():
+                contents = f.read()
+                f.close()
+                f = io.StringIO(contents)
+
+            self.input_files.append(f)
 
         if self.args.columns:
             join_column_names = self._parse_join_column_names(self.args.columns)
