 @pytest.mark.parametrize(
@@ -67,3 +72,40 @@ def test_extracts(fresh_db, kwargs, expected_table, use_table_factory):
         {"id": 2, "species_id": 1},
         {"id": 3, "species_id": 2},
     ] == list(fresh_db["Trees"].rows)
+
+
+def test_insert_extract_repeatable(tmpdir):
+    db_path = str(tmpdir / "extracts.db")
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "trees",
+            "-",
+            "--extract",
+            "species",
+            "--extract",
+            "country",
+        ],
+        input=json.dumps(
+            [
+                {"id": 1, "species": "Oak", "country": "UK"},
+                {"id": 2, "species": "Oak", "country": "USA"},
+                {"id": 3, "species": "Palm", "country": "USA"},
+            ]
+        ),
+    )
+    assert 0 == result.exit_code, result.output
+    db = Database(db_path)
+    assert [
+        {"id": 1, "species": 1, "country": 1},
+        {"id": 2, "species": 1, "country": 2},
+        {"id": 3, "species": 2, "country": 2},
+    ] == list(db["trees"].rows)
+    assert [{"id": 1, "value": "Oak"}, {"id": 2, "value": "Palm"}] == list(
+        db["species"].rows
+    )
+    assert [{"id": 1, "value": "UK"}, {"id": 2, "value": "USA"}] == list(
+        db["country"].rows
+    )
