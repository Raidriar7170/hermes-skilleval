+def test_insert_extract_repeatable(tmpdir):
+    db_path = str(tmpdir / "dogs.db")
+    dogs = [
+        {"name": "Cleo", "breed": "mixed", "size": "small"},
+        {"name": "Pancakes", "breed": "mixed", "size": "large"},
+        {"name": "Marnie", "breed": "terrier", "size": "small"},
+    ]
+    result = CliRunner().invoke(
+        cli.cli,
+        ["insert", db_path, "dogs", "-", "--extract", "breed", "--extract", "size"],
+        input=json.dumps(dogs),
+    )
+    assert result.exit_code == 0, result.output
+    db = Database(db_path)
+    assert list(db.query("select name, breed, size from dogs order by rowid")) == [
+        {"name": "Cleo", "breed": 1, "size": 1},
+        {"name": "Pancakes", "breed": 1, "size": 2},
+        {"name": "Marnie", "breed": 2, "size": 1},
+    ]
+    assert list(db.query("select id, value from breed order by id")) == [
+        {"id": 1, "value": "mixed"},
+        {"id": 2, "value": "terrier"},
+    ]
+    assert list(db.query("select id, value from size order by id")) == [
+        {"id": 1, "value": "small"},
+        {"id": 2, "value": "large"},
+    ]
+    assert db["dogs"].count == len(dogs)
+    foreign_keys = {
+        (fk.column, fk.other_table, fk.other_column)
+        for fk in db["dogs"].foreign_keys
+    }
+    assert foreign_keys == {
+        ("breed", "breed", "id"),
+        ("size", "size", "id"),
+    }
+
+
