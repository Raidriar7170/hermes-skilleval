+            "trees",
+            "-",
+            "--pk",
+            "id",
+            "--extract",
+            "species",
+            "--extract",
+            "region",
+        ],
+        input=json.dumps(rows),
+    )
+    assert result.exit_code == 0, result.output
+
+    db = Database(db_path)
