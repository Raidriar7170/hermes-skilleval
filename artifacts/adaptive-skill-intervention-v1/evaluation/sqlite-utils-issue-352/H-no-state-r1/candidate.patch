+def test_insert_extract_repeatable(db_path):
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "Trees",
+            "-",
+            "--extract",
+            "species",
+            "--extract",
+            "region",
+        ],
+        input=json.dumps(
+            [
+                {"id": 1, "species": "Oak", "region": "North"},
+                {"id": 2, "species": "Oak", "region": "South"},
+                {"id": 3, "species": "Palm", "region": "South"},
+            ]
+        ),
+    )
+    assert result.exit_code == 0, result.output
+    db = Database(db_path)
+    assert list(db["species"].rows) == [
+        {"id": 1, "value": "Oak"},
+        {"id": 2, "value": "Palm"},
+    ]
+    assert list(db["region"].rows) == [
+        {"id": 1, "value": "North"},
+        {"id": 2, "value": "South"},
+    ]
+    assert list(db["Trees"].rows) == [
+        {"id": 1, "species": 1, "region": 1},
+        {"id": 2, "species": 1, "region": 2},
+        {"id": 3, "species": 2, "region": 2},
+    ]
+    assert {(fk.column, fk.other_table) for fk in db["Trees"].foreign_keys} == {
+        ("species", "species"),
+        ("region", "region"),
+    }
+
+
