+def test_insert_extract(db_path):
+    help_result = CliRunner().invoke(cli.cli, ["insert", "--help"])
+    assert help_result.exit_code == 0
+    assert "--extract TEXT" in help_result.output
+
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "trees",
+            "-",
+            "--extract",
+            "species",
+            "--extract",
+            "region",
+        ],
+        input=json.dumps(
+            [
+                {"name": "One", "species": "Oak", "region": "North"},
+                {"name": "Two", "species": "Oak", "region": "South"},
+                {"name": "Three", "species": "Palm", "region": "South"},
+            ]
+        ),
+    )
+    assert result.exit_code == 0, result.output
+    db = Database(db_path)
+    assert {"trees", "species", "region"}.issubset(db.table_names())
+    assert db["species"].schema == (
+        "CREATE TABLE [species] (\n   [id] INTEGER PRIMARY KEY,\n   [value] TEXT\n)"
+    )
+    assert db["region"].schema == (
+        "CREATE TABLE [region] (\n   [id] INTEGER PRIMARY KEY,\n   [value] TEXT\n)"
+    )
+    assert set(db["trees"].foreign_keys) == {
+        ForeignKey("trees", "species", "species", "id"),
+        ForeignKey("trees", "region", "region", "id"),
+    }
+    assert list(db["species"].rows) == [
+        {"id": 1, "value": "Oak"},
+        {"id": 2, "value": "Palm"},
+    ]
+    assert list(db["region"].rows) == [
+        {"id": 1, "value": "North"},
+        {"id": 2, "value": "South"},
+    ]
+    assert list(db["trees"].rows) == [
+        {"name": "One", "species": 1, "region": 1},
+        {"name": "Two", "species": 1, "region": 2},
+        {"name": "Three", "species": 2, "region": 2},
+    ]
+
+
 def test_insert_ignore(db_path, tmpdir):
