+def test_insert_extract(db_path):
+    records = [
+        {"id": 1, "species": "Oak", "location": "Park"},
+        {"id": 2, "species": "Oak", "location": "Street"},
+        {"id": 3, "species": "Palm", "location": "Park"},
+    ]
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "trees",
+            "-",
+            "--extract",
+            "species",
+            "--extract",
+            "location",
+        ],
+        input=json.dumps(records),
+    )
+    assert result.exit_code == 0, result.output
+    db = Database(db_path)
+    assert list(db["species"].rows) == [
+        {"id": 1, "value": "Oak"},
+        {"id": 2, "value": "Palm"},
+    ]
+    assert list(db["location"].rows) == [
+        {"id": 1, "value": "Park"},
+        {"id": 2, "value": "Street"},
+    ]
+    assert list(db["trees"].rows) == [
+        {"id": 1, "species": 1, "location": 1},
+        {"id": 2, "species": 1, "location": 2},
+        {"id": 3, "species": 2, "location": 1},
+    ]
+    assert db["trees"].foreign_keys == [
+        ForeignKey(
+            table="trees",
+            column="location",
+            other_table="location",
+            other_column="id",
+        ),
+        ForeignKey(
+            table="trees",
+            column="species",
+            other_table="species",
+            other_column="id",
+        ),
+    ]
+
+
 def test_insert_ignore(db_path, tmpdir):
     db = Database(db_path)
     db["dogs"].insert({"id": 1, "name": "Cleo"}, pk="id")
