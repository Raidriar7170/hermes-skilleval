+def test_insert_extract(db_path):
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "trees",
+            "-",
+            "--extract",
+            "species",
+            "--extract",
+            "family",
+        ],
+        input=json.dumps(
+            [
+                {"id": 1, "species": "Oak", "family": "Fagaceae"},
+                {"id": 2, "species": "Oak", "family": "Fagaceae"},
+                {"id": 3, "species": "Palm", "family": "Arecaceae"},
+            ]
+        ),
+    )
+    assert result.exit_code == 0, result.output
+    db = Database(db_path)
+    assert list(db["species"].rows) == [
+        {"id": 1, "value": "Oak"},
+        {"id": 2, "value": "Palm"},
+    ]
+    assert list(db["family"].rows) == [
+        {"id": 1, "value": "Fagaceae"},
+        {"id": 2, "value": "Arecaceae"},
+    ]
+    assert list(db["trees"].rows) == [
+        {"id": 1, "species": 1, "family": 1},
+        {"id": 2, "species": 1, "family": 1},
+        {"id": 3, "species": 2, "family": 2},
+    ]
+    assert {
+        (fk.column, fk.other_table, fk.other_column)
+        for fk in db["trees"].foreign_keys
+    } == {
+        ("species", "species", "id"),
+        ("family", "family", "id"),
+    }
+
