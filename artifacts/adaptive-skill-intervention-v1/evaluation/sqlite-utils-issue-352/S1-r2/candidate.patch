+def test_insert_extract(db_path):
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "trees",
+            "-",
+            "--extract",
+            "species",
+            "--extract",
+            "city",
+        ],
+        input=json.dumps(
+            [
+                {"id": 1, "species": "Oak", "city": "London"},
+                {"id": 2, "species": "Oak", "city": "Paris"},
+                {"id": 3, "species": "Palm", "city": "London"},
+            ]
+        ),
+    )
+    assert 0 == result.exit_code, result.output
+    db = Database(db_path)
+    assert [{"id": 1, "value": "Oak"}, {"id": 2, "value": "Palm"}] == list(
+        db["species"].rows
+    )
+    assert [{"id": 1, "value": "London"}, {"id": 2, "value": "Paris"}] == list(
+        db["city"].rows
+    )
+    assert [
+        {"id": 1, "species": 1, "city": 1},
+        {"id": 2, "species": 1, "city": 2},
+        {"id": 3, "species": 2, "city": 1},
+    ] == list(db["trees"].rows)
+
