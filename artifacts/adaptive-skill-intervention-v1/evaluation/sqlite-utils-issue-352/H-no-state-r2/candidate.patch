+def test_insert_extract_repeatable(db_path):
+    records = [
+        {"name": "Alice", "city": "London", "species": "Human"},
+        {"name": "Bob", "city": "London", "species": "Human"},
+        {"name": "Cleo", "city": "Paris", "species": "Dog"},
+    ]
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "people",
+            "-",
+            "--extract",
+            "city",
+            "--extract",
+            "species",
+        ],
+        input=json.dumps(records),
+    )
+    assert result.exit_code == 0, result.output
+
+    db = Database(db_path)
+    assert list(db["city"].rows) == [
+        {"id": 1, "value": "London"},
+        {"id": 2, "value": "Paris"},
+    ]
+    assert list(db["species"].rows) == [
+        {"id": 1, "value": "Human"},
+        {"id": 2, "value": "Dog"},
+    ]
+    assert list(db["people"].rows) == [
+        {"name": "Alice", "city": 1, "species": 1},
+        {"name": "Bob", "city": 1, "species": 1},
+        {"name": "Cleo", "city": 2, "species": 2},
+    ]
+    assert {fk.column for fk in db["people"].foreign_keys} == {"city", "species"}
+
+
 def test_index_foreign_keys(db_path):
     test_add_column_foreign_key(db_path)
     db = Database(db_path)
