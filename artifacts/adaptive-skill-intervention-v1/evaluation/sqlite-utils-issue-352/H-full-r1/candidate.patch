+def test_insert_extract_multiple_columns(db_path):
+    records = [
+        {"name": "Cleo", "species": "dog", "city": "London"},
+        {"name": "Pancakes", "species": "dog", "city": "Paris"},
+        {"name": "Nori", "species": "cat", "city": "London"},
+    ]
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "animals",
+            "-",
+            "--extract",
+            "species",
+            "--extract",
+            "city",
+        ],
+        input=json.dumps(records),
+    )
+    assert result.exit_code == 0, result.output
+    db = Database(db_path)
+    assert list(
+        db.query(
+            "select animals.name, species.value as species, city.value as city "
+            "from animals "
+            "join species on animals.species = species.id "
+            "join city on animals.city = city.id "
+            "order by animals.rowid"
+        )
+    ) == records
+    assert list(db.query("select value from species order by id")) == [
+        {"value": "dog"},
+        {"value": "cat"},
+    ]
+    assert list(db.query("select value from city order by id")) == [
+        {"value": "London"},
+        {"value": "Paris"},
+    ]
+
+
