@@ -774,6 +775,25 @@ def insert_upsert_implementation(
         if flatten:
             docs = (dict(_flatten(doc)) for doc in docs)
 
+    if convert:
+        # Compile the code into a function body called fn(row). The return value
+        # is deliberately ignored: --convert mutates each incoming object and
+        # every object is then passed on for insertion.
+        new_code = ["def fn(row):"]
+        for line in convert.split("\n"):
+            new_code.append("    {}".format(line))
+        code_o = compile("\n".join(new_code), "<string>", "exec")
+        locals = {}
+        globals = {"r": recipes, "recipes": recipes}
+        exec(code_o, globals, locals)
+        convert_fn = locals["fn"]
+
+        def convert_doc(doc):
+            convert_fn(doc)
+            return doc
+
+        docs = (convert_doc(doc) for doc in docs)
+
