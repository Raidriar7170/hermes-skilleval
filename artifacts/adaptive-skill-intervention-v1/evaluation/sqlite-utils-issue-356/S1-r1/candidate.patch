+    if convert_code:
+        # Compile the code into a function body called fn(row)
+        new_code = ["def fn(row):"]
+        for line in convert_code.split("\n"):
+            new_code.append("    {}".format(line))
+        code_o = compile("\n".join(new_code), "<string>", "exec")
+        locals = {}
+        exec(code_o, {}, locals)
+        convert_fn = locals["fn"]
+
+        def convert_row(row):
+            convert_fn(row)
+            return row
+
+        docs = (convert_row(doc) for doc in docs)
+    if flatten:
+        docs = (dict(_flatten(doc)) for doc in docs)
 
