+@pytest.mark.parametrize("nl", (False, True))
+def test_insert_convert(db_path, nl):
+    rows = [{"name": "one", "n": "1"}, {"name": "two", "n": "2"}]
+    input_ = "\n".join(map(json.dumps, rows)) if nl else json.dumps(rows)
+    args = [
+        "insert",
+        db_path,
+        "converted",
+        "-",
+        "--convert",
+        'row["n"] = int(row["n"]) + 1',
+    ]
+    if nl:
+        args.append("--nl")
+    result = CliRunner().invoke(cli.cli, args, input=input_)
+    assert result.exit_code == 0, result.output
+    assert list(Database(db_path)["converted"].rows) == [
+        {"name": "one", "n": 2},
+        {"name": "two", "n": 3},
+    ]
+
+
