+def test_insert_convert_preserves_and_transforms_all_objects(db_path):
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "converted",
+            "-",
+            "--nl",
+            "--convert",
+            'row["n"] = int(row["n"]) + 1',
+        ],
+        input='{"name": "one", "n": "1"}\n{"name": "two", "n": "2"}',
+    )
+    assert 0 == result.exit_code, result.output
+    assert [
+        {"name": "one", "n": 2},
+        {"name": "two", "n": 3},
+    ] == list(Database(db_path)["converted"].rows)
+
