+def test_insert_convert(db_path):
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "converted",
+            "-",
+            "--nl",
+            "--convert",
+            'row["n"] = int(row["n"]) + 1',
+        ],
+        input='{"n": "1"}\n{"n": "2"}',
+    )
+    assert result.exit_code == 0, result.output
+    assert [{"n": 2}, {"n": 3}] == list(
+        Database(db_path).query("select n from converted order by n")
+    )
+
+
