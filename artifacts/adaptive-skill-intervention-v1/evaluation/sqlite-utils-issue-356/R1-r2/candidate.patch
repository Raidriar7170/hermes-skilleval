+@pytest.mark.parametrize(
+    "input,extra_args",
+    (
+        (json.dumps([{"n": "1"}, {"n": "2"}, {"n": "3"}]), []),
+        ('{"n": "1"}\n{"n": "2"}\n{"n": "3"}', ["--nl"]),
+    ),
+)
+def test_insert_convert_preserves_and_transforms_all_objects(
+    tmpdir, input, extra_args
+):
+    db_path = str(tmpdir / "converted.db")
+    result = CliRunner().invoke(
+        cli.cli,
+        ["insert", db_path, "rows", "-", "--convert", 'row["n"] = int(row["n"]) + 1']
+        + extra_args,
+        input=input,
+    )
+    assert result.exit_code == 0, result.output
+    assert [{"n": 2}, {"n": 3}, {"n": 4}] == list(
+        Database(db_path).query("select n from rows order by rowid")
+    )
+
+
