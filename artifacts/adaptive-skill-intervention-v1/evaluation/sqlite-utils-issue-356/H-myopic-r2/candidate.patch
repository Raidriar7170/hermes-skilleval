+def test_insert_convert_preserves_and_transforms_all_objects(db_path):
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "converted",
+            "-",
+            "--nl",
+            "--convert",
+            'row["n"] = int(row["n"]) + 1',
+        ],
+        input='{"name": "one", "n": "1"}\n{"name": "two", "n": "2"}',
+    )
+    assert result.exit_code == 0, result.output
+    assert list(Database(db_path)["converted"].rows) == [
+        {"name": "one", "n": 2},
+        {"name": "two", "n": 3},
+    ]
+
+
+def test_insert_convert_can_add_columns(db_path):
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "converted",
+            "-",
+            "--convert",
+            'row["upper"] = row["name"].upper()',
+        ],
+        input='[{"name": "one"}, {"name": "two"}]',
+    )
+    assert result.exit_code == 0, result.output
+    assert list(Database(db_path)["converted"].rows) == [
+        {"name": "one", "upper": "ONE"},
+        {"name": "two", "upper": "TWO"},
+    ]
+
+
