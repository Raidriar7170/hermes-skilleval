+@pytest.mark.parametrize(
+    "input,extra_args",
+    (
+        ('[{"n": "1"}, {"n": "2"}]', []),
+        ('{"n": "1"}\n{"n": "2"}', ["--nl"]),
+    ),
+)
+def test_insert_convert_preserves_and_converts_all_rows(db_path, input, extra_args):
+    result = CliRunner().invoke(
+        cli.cli,
+        ["insert", db_path, "numbers", "-"]
+        + extra_args
+        + ["--convert", 'row["n"] = int(row["n"]) + 1'],
+        input=input,
+    )
+    assert result.exit_code == 0, result.output
+    assert [{"n": 2}, {"n": 3}] == list(Database(db_path)["numbers"].rows)
+
