+@pytest.mark.parametrize(
+    "input_,options",
+    (
+        ('[{"n": "1"}, {"n": "2"}]', []),
+        ('{"n": "1"}\n{"n": "2"}', ["--nl"]),
+    ),
+)
+def test_insert_convert_preserves_and_converts_every_row(db_path, input_, options):
+    result = CliRunner().invoke(
+        cli.cli,
+        [
+            "insert",
+            db_path,
+            "numbers",
+            "-",
+            "--convert",
+            'row["n"] = int(row["n"]) + 1',
+        ]
+        + options,
+        input=input_,
+    )
+    assert 0 == result.exit_code, result.output
+    assert [{"n": 2}, {"n": 3}] == list(Database(db_path)["numbers"].rows)
+
+
