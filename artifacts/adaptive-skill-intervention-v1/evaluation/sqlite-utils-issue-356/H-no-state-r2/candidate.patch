-        if flatten:
-            docs = (dict(_flatten(doc)) for doc in docs)
+    if convert_code:
+        # Compile the conversion once, then evaluate it for every incoming row.
+        # The explicit return ensures mutation-only code preserves every object.
+        new_code = ["def fn(row):"]
+        for line in convert_code.split("\n"):
+            new_code.append("    {}".format(line))
+        new_code.append("    return row")
+        code_o = compile("\n".join(new_code), "<string>", "exec")
+        locals = {}
+        exec(code_o, {}, locals)
+        convert_fn = locals["fn"]
+        docs = (convert_fn(doc) for doc in docs)
+    if flatten:
+        docs = (dict(_flatten(doc)) for doc in docs)
 
