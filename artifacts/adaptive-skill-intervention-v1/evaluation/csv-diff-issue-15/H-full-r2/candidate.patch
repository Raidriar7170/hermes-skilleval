+def test_row_number_key():
+    before = """name,age
+Cleo,4
+Pancakes,2"""
+    after = """name,age
+Cleo,5
+Pancakes,2"""
+
+    diff = compare(
+        load_csv(io.StringIO(before), key="__rowid__"),
+        load_csv(io.StringIO(after), key="__rowid__"),
+    )
+
+    assert diff["added"] == []
+    assert diff["removed"] == []
+    assert diff["changed"] == [{"key": 1, "changes": {"age": ["4", "5"]}}]
+
+
+def test_row_number_key_is_reserved_even_when_it_is_a_heading():
+    before = """__rowid__,name
+same,Cleo
+same,Pancakes"""
+    after = """__rowid__,name
+same,Cleo
+same,Waffles"""
+
+    diff = compare(
+        load_csv(io.StringIO(before), key="__rowid__"),
+        load_csv(io.StringIO(after), key="__rowid__"),
+    )
+
+    assert diff["changed"] == [
+        {"key": 2, "changes": {"name": ["Pancakes", "Waffles"]}}
+    ]
+
+
