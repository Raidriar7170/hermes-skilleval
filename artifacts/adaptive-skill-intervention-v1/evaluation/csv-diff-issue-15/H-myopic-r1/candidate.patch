+def test_row_number_key_matches_rows_by_position():
+    diff = compare(
+        load_csv(io.StringIO(ONE), key="__rowid__"),
+        load_csv(io.StringIO(TWO), key="__rowid__"),
+    )
+    assert diff["added"] == []
+    assert diff["removed"] == []
+    assert len(diff["changed"]) == 1
+    assert diff["changed"][0]["changes"] == {"age": ["4", "5"]}
+    assert diff["columns_added"] == []
+    assert diff["columns_removed"] == []
+
+
+def test_row_number_key_keeps_duplicate_rows():
+    csv_with_duplicates = """id,name
+1,Cleo
+1,Cleo"""
+
+    rows = load_csv(io.StringIO(csv_with_duplicates), key="__rowid__")
+
+    assert len(rows) == 2
+    assert list(rows.values()) == [
+        {"id": "1", "name": "Cleo"},
+        {"id": "1", "name": "Cleo"},
+    ]
