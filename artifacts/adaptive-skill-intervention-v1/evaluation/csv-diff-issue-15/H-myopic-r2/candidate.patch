+def test_row_number_key():
+    previous = """name,age
+Cleo,4
+Pancakes,2"""
+    current = """name,age
+Cleo,5
+Pancakes,2"""
+    diff = compare(
+        load_csv(io.StringIO(previous), key="__rowid__"),
+        load_csv(io.StringIO(current), key="__rowid__"),
+    )
+    assert diff["changed"] == [{"key": 1, "changes": {"age": ["4", "5"]}}]
+    assert diff["added"] == []
+    assert diff["removed"] == []
+
+
+def test_row_number_key_can_be_a_column_name():
+    csv_data = """__rowid__,name
+custom,Cleo"""
+    assert load_csv(io.StringIO(csv_data), key="__rowid__") == {
+        "custom": {"__rowid__": "custom", "name": "Cleo"}
+    }
