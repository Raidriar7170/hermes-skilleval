+def test_row_number_key_matches_rows_by_position():
+    before = """name,age
+Cleo,4
+Pancakes,2"""
+    after = """name,age
+Cleo,5
+Pancakes,2"""
+
+    diff = compare(
+        load_csv(io.StringIO(before), key="__rowid__"),
+        load_csv(io.StringIO(after), key="__rowid__"),
+    )
+
+    assert diff["added"] == []
+    assert diff["removed"] == []
+    assert diff["changed"] == [{"key": 0, "changes": {"age": ["4", "5"]}}]
+
+
+def test_row_number_key_defers_to_column_with_same_name():
+    csv_data = """__rowid__,name
+custom-id,Cleo"""
+
+    assert load_csv(io.StringIO(csv_data), key="__rowid__") == {
+        "custom-id": {"__rowid__": "custom-id", "name": "Cleo"}
+    }
+
