+def test_row_number_key():
+    previous = """name,age
+Cleo,4
+Pancakes,2"""
+    current = """name,age
+Cleo,5
+Pancakes,2"""
+
+    diff = compare(
+        load_csv(io.StringIO(previous), key="__rowid__"),
+        load_csv(io.StringIO(current), key="__rowid__"),
+    )
+
+    assert diff == {
+        "added": [],
+        "removed": [],
+        "changed": [{"key": 0, "changes": {"age": ["4", "5"]}}],
+        "columns_added": [],
+        "columns_removed": [],
+    }
+
+
+def test_row_number_key_keeps_duplicate_rows():
+    rows = load_csv(io.StringIO("name\nCleo\nCleo"), key="__rowid__")
+
+    assert list(rows.values()) == [{"name": "Cleo"}, {"name": "Cleo"}]
