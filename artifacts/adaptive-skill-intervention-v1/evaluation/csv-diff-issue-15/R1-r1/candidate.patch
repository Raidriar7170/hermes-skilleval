+
+
+def test_row_number_key():
+    rows = load_csv(io.StringIO(ONE), key="__rowid__")
+
+    assert list(rows.values()) == [
+        {"id": "1", "name": "Cleo", "age": "4"},
+        {"id": "2", "name": "Pancakes", "age": "2"},
+    ]
+    assert len(rows) == 2
+
+
+def test_row_number_key_matches_rows_by_position():
+    previous = load_csv(io.StringIO(ONE), key="__rowid__")
+    current = load_csv(io.StringIO(TWO), key="__rowid__")
+    first_row_key = next(iter(previous))
+    diff = compare(previous, current)
+
+    assert diff == {
+        "added": [],
+        "removed": [],
+        "changed": [{"key": first_row_key, "changes": {"age": ["4", "5"]}}],
+        "columns_added": [],
+        "columns_removed": [],
+    }
+
+
+def test_row_number_key_takes_precedence_over_a_matching_heading():
+    csv_with_rowid_heading = """__rowid__,name
+duplicate,Cleo
+duplicate,Pancakes"""
+
+    rows = load_csv(io.StringIO(csv_with_rowid_heading), key="__rowid__")
+
+    assert len(rows) == 2
+
+
+def test_other_key_modes_are_preserved():
+    rows_by_id = load_csv(io.StringIO(ONE), key="id")
+    rows_by_hash = load_csv(io.StringIO(ONE))
+
+    assert set(rows_by_id) == {"1", "2"}
+    assert len(rows_by_hash) == 2
+    assert all(len(row_hash) == 40 for row_hash in rows_by_hash)
