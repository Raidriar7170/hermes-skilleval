+def test_row_number_key():
+    diff = compare(
+        load_csv(io.StringIO(ONE), key="__rowid__"),
+        load_csv(io.StringIO(TWO), key="__rowid__"),
+    )
+    assert {
+        "added": [],
+        "removed": [],
+        "changed": [{"key": 1, "changes": {"age": ["4", "5"]}}],
+        "columns_added": [],
+        "columns_removed": [],
+    } == diff
+
+
+def test_row_number_key_matches_by_position_when_content_moves():
+    reordered = """id,name,age
+2,Pancakes,2
+1,Cleo,4"""
+    diff = compare(
+        load_csv(io.StringIO(ONE), key="__rowid__"),
+        load_csv(io.StringIO(reordered), key="__rowid__"),
+    )
+    assert not diff["added"]
+    assert not diff["removed"]
+    assert [change["key"] for change in diff["changed"]] == [1, 2]
+
+
+def test_row_number_key_falls_back_to_column_with_same_name():
+    csv_with_rowid = """__rowid__,name
+second,Cleo
+first,Pancakes"""
+    assert load_csv(io.StringIO(csv_with_rowid), key="__rowid__") == {
+        "second": {"__rowid__": "second", "name": "Cleo"},
+        "first": {"__rowid__": "first", "name": "Pancakes"},
+    }
+
