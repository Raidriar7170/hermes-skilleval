+def test_rows_inserted_using_row_number_as_key():
+    before = """name,age
+Cleo,4
+Pancakes,2"""
+    after = """name,age
+Bailey,1
+Cleo,4
+Pancakes,2"""
+
+    diff = compare(
+        load_csv(io.StringIO(before), key="__rowid__"),
+        load_csv(io.StringIO(after), key="__rowid__"),
+    )
+
+    assert [0, 1, 2] == list(load_csv(io.StringIO(after), key="__rowid__"))
+    assert [{"name": "Pancakes", "age": "2"}] == diff["added"]
+    assert [
+        {"key": 0, "changes": {"name": ["Cleo", "Bailey"], "age": ["4", "1"]}},
+        {
+            "key": 1,
+            "changes": {"name": ["Pancakes", "Cleo"], "age": ["2", "4"]},
+        },
+    ] == diff["changed"]
