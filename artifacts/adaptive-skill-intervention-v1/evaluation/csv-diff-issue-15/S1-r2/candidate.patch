+def test_row_number_key_matches_rows_by_position():
+    previous = """name,age
+Cleo,4
+Pancakes,2"""
+    current = """name,age
+Cleo,5
+Pancakes,2"""
+
+    diff = compare(
+        load_csv(io.StringIO(previous), key="__rowid__"),
+        load_csv(io.StringIO(current), key="__rowid__"),
+    )
+
+    assert diff["added"] == []
+    assert diff["removed"] == []
+    assert len(diff["changed"]) == 1
+    assert diff["changed"][0]["changes"] == {"age": ["4", "5"]}
+
