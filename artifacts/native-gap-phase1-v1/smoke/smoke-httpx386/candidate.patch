diff --git a/tests/client/test_queryparams.py b/tests/client/test_queryparams.py
index 852593c..af1c57d 100644
--- a/tests/client/test_queryparams.py
+++ b/tests/client/test_queryparams.py
@@ -54,3 +54,18 @@ def test_client_queryparams_echo():
     assert response.url == URL(
         "http://example.org/echo_queryparams?first=str&second=dict"
     )
+
+
+def test_client_queryparams_list_values():
+    url = "http://example.org/echo_queryparams"
+    with Client(
+        dispatch=MockDispatch(), params={"documentIds": ["old", "older"]}
+    ) as client:
+        response = client.get(
+            url, params={"documentIds": ["first", "second"], "other": "value"}
+        )
+
+    assert response.url == URL(
+        "http://example.org/echo_queryparams?"
+        "documentIds=first&documentIds=second&other=value"
+    )
diff --git a/tests/models/test_queryparams.py b/tests/models/test_queryparams.py
index 8c4df49..b2e2911 100644
--- a/tests/models/test_queryparams.py
+++ b/tests/models/test_queryparams.py
@@ -53,6 +53,20 @@ def test_queryparam_types():
     assert str(q) == "a=123"
 
 
+def test_queryparam_list_values():
+    q = QueryParams({"documentIds": ["first", "second"], "other": "value"})
+    assert str(q) == "documentIds=first&documentIds=second&other=value"
+    assert q.getlist("documentIds") == ["first", "second"]
+    assert q["documentIds"] == "second"
+    assert QueryParams(q) == q
+    assert QueryParams({"empty": [], "other": "value"}) == QueryParams(
+        "other=value"
+    )
+    assert QueryParams(documentIds=["first", "second"]) == QueryParams(
+        "documentIds=first&documentIds=second"
+    )
+
+
 def test_queryparam_setters():
     q = QueryParams({"a": 1})
     q.update([])
@@ -62,3 +76,10 @@ def test_queryparam_setters():
     q = QueryParams([("a", 1), ("a", 2)])
     q["a"] = "3"
     assert str(q) == "a=3"
+
+
+def test_queryparam_update_preserves_list_values():
+    q = QueryParams("a=old&a=older&b=keep")
+    q.update({"a": ["first", "second"]})
+    assert str(q) == "a=first&a=second&b=keep"
+    assert q.getlist("a") == ["first", "second"]
