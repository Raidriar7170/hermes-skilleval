+def test_py36_plus_format_on_fstring(tmpdir):
+    f = tmpdir.join('f.py')
+    source = 'print(f"foo {0}".format("bar"))\n'
+    f.write(source)
+    assert main((f.strpath, '--py36-plus')) == 0
+    assert f.read() == source
