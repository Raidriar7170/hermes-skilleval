diff --git a/tests/test_cli.py b/tests/test_cli.py
index 22c51e31908b6a3b9fb5a7a682f6ef206a468920..64f0c8d9f18a15f5f08c06a1cdcb3b5c447782c7 100644
--- a/tests/test_cli.py
