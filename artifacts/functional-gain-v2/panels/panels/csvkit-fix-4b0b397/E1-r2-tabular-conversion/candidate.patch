index 22c51e31908b6a3b9fb5a7a682f6ef206a468920..beb77136bd34caa4b7ffb531f7f38e4a8b8195d8 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,6 +1,12 @@
 import unittest
+from unittest.mock import patch
 
-from csvkit.cli import match_column_identifier, parse_column_identifiers
+from csvkit.cli import CSVKitUtility, match_column_identifier, parse_column_identifiers
+
+
+class Utility(CSVKitUtility):
+    def add_arguments(self):
+        pass
 
 
 class TestCli(unittest.TestCase):
@@ -8,6 +14,19 @@ class TestCli(unittest.TestCase):
     def setUp(self):
         self.headers = ['id', 'name', 'i_work_here', '1', 'more-header-values', 'stuff', 'blueberry']
 
+    def test_default_encoding(self):
+        for environment in ({}, {'PYTHONIOENCODING': ''}, {'PYTHONIOENCODING': ':strict'}):
+            with self.subTest(environment=environment), patch.dict('os.environ', environment, clear=True):
+                self.assertEqual(Utility([]).args.encoding, 'utf-8-sig')
+
+    def test_default_encoding_from_environment(self):
+        with patch.dict('os.environ', {'PYTHONIOENCODING': 'latin-1:strict'}):
+            self.assertEqual(Utility([]).args.encoding, 'latin-1')
+
+    def test_explicit_encoding_overrides_environment(self):
+        with patch.dict('os.environ', {'PYTHONIOENCODING': 'latin-1'}):
+            self.assertEqual(Utility(['--encoding', 'utf-16']).args.encoding, 'utf-16')
+
     def test_match_column_identifier_string(self):
         self.assertEqual(2, match_column_identifier(self.headers, 'i_work_here'))
         self.assertEqual(2, match_column_identifier(self.headers, 'i_work_here', column_offset=0))
