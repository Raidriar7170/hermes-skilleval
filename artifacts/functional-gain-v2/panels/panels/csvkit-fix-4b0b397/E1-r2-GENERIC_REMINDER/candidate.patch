     def setUp(self):
         self.headers = ['id', 'name', 'i_work_here', '1', 'more-header-values', 'stuff', 'blueberry']
 
+    def test_default_encoding(self):
+        with patch.dict('os.environ', {}, clear=True):
+            utility = Utility(['examples/test_utf8_bom.csv'])
+            self.assertEqual(utility.args.encoding, 'utf-8-sig')
+            self.assertIn('ʤ', utility._open_input_file(utility.args.input_path).read())
+
+    def test_default_encoding_from_environment(self):
+        with patch.dict('os.environ', {'PYTHONIOENCODING': 'utf-16:strict'}):
+            utility = Utility(['examples/test_utf16_little.csv'])
+            self.assertEqual(utility.args.encoding, 'utf-16')
+            self.assertIn('ʤ', utility._open_input_file(utility.args.input_path).read())
+
+    def test_explicit_encoding_overrides_environment(self):
+        with patch.dict('os.environ', {'PYTHONIOENCODING': 'latin-1'}):
+            utility = Utility(['--encoding', 'utf-8', 'examples/test_utf8.csv'])
+            self.assertEqual(utility.args.encoding, 'utf-8')
+            self.assertIn('ʤ', utility._open_input_file(utility.args.input_path).read())
+
+    def test_empty_environment_encoding_uses_default(self):
+        with patch.dict('os.environ', {'PYTHONIOENCODING': ':strict'}):
+            self.assertEqual(Utility([]).args.encoding, 'utf-8-sig')
+
