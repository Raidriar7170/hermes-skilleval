+    def test_max_rows_does_not_parse_later_rows(self):
+        class BoundedInput(io.StringIO):
+            def __next__(self):
+                if self.tell() >= len('a,b\nfoo,bar\n'):
+                    raise AssertionError('read beyond --max-rows')
+
+                return super().__next__()
+
+        output_file = io.StringIO()
+        utility = self.Utility(['--max-rows', '1', '--snifflimit', '0'], output_file)
+        utility.input_file = BoundedInput('a,b\nfoo,bar\n' + 'x' * 1024 + ',baz\n')
+
+        utility.main()
+
+        self.assertEqual(output_file.getvalue().splitlines(), [
+            '| a   | b   |',
+            '| --- | --- |',
+            '| foo | bar |',
+        ])
+
