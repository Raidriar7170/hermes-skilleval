+def test_transform_preserves_index_and_data_with_double_quotes(fresh_db):
+    table_name = 'table "name"'
+    column_name = 'column "name"'
+    index_name = 'index "name"'
+    table = fresh_db[table_name]
+    table.insert({column_name: 1})
+    table.create_index([column_name], index_name=index_name)
+
+    table.transform(types={column_name: str})
+
+    assert list(table.rows) == [{column_name: "1"}]
+    assert [(index.name, index.columns) for index in table.indexes] == [
+        (index_name, [column_name])
