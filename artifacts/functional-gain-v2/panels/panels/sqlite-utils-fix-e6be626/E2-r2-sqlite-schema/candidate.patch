+def test_indexes_with_double_quotes_in_identifiers(fresh_db):
+    table_name = 'table "name"'
+    column_name = 'column "name"'
+    index_name = 'index "name"'
+    table = fresh_db[table_name]
+    table.insert({column_name: "value"})
+    table.create_index([column_name], index_name=index_name)
+
+    assert table.indexes == [
+        Index(
+            seq=0,
+            name=index_name,
+            unique=0,
+            origin="c",
+            partial=0,
+            columns=[column_name],
+        )
+    ]
+    assert table.xindexes == [
+        XIndex(
+            name=index_name,
+            columns=[
+                XIndexColumn(
+                    seqno=0,
+                    cid=0,
+                    name=column_name,
+                    desc=0,
+                    coll="BINARY",
+                    key=1,
+                ),
+                XIndexColumn(
+                    seqno=1,
+                    cid=-1,
+                    name=None,
+                    desc=0,
+                    coll="BINARY",
+                    key=0,
+                ),
+            ],
+        )
+    ]
+
