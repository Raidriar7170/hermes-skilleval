+def _conflict_action(tokens: list[_Token], index: int) -> str:
+    if (
+        index + 2 < len(tokens)
+        and tokens[index].is_keyword("ON")
+        and tokens[index + 1].is_keyword("CONFLICT")
+    ):
+        action = tokens[index + 2].text.upper()
+        if action in ("ROLLBACK", "ABORT", "FAIL", "IGNORE", "REPLACE"):
+            return action
+    return ""
+
+
+def _column_collation(tokens: list[_Token]) -> str | None:
+    depth = 0
+    for index, token in enumerate(tokens):
+        if token.text == "(":
+            depth += 1
+        elif token.text == ")":
+            depth -= 1
+        elif depth == 0 and token.is_keyword("COLLATE"):
+            if index + 1 >= len(tokens):
+                raise ParseError("COLLATE is missing its collation name")
+            return _unquote(tokens[index + 1].text)
+    return None
+
+
+def parse_unique_constraints(create_sql: str) -> list[UniqueConstraint]:
+    """Return column and table-level UNIQUE constraints from CREATE TABLE SQL."""
+    body_info = _table_body(create_sql)
+    if body_info is None:
+        return []
+    body, _ = body_info
+    items = _split_spans(body, _lex(body))
+    # A table-level UNIQUE(a, b) inherits each column's declared collation.
+    # Capture those first so constraints can precede or follow column items.
+    column_collations: dict[str, str] = {}
+    for item, _, _ in items:
+        tokens = _meaningful(_lex(item))
+        if not tokens:
+            continue
+        item_index = 2 if tokens[0].is_keyword("CONSTRAINT") else 0
+        head = tokens[item_index] if item_index < len(tokens) else None
+        if (
+            head
+            and head.kind == "word"
+            and head.text.upper() in _TABLE_CONSTRAINT_KEYWORDS
+        ):
+            continue
+        collation = _column_collation(tokens)
+        if collation:
+            column_collations[_ascii_fold(_unquote(tokens[0].text))] = collation
+    uniques: list[UniqueConstraint] = []
+    for item, _, _ in items:
+        tokens = _meaningful(_lex(item))
+        if not tokens:
+            continue
+        item_index = 0
+        constraint_name = ""
+        if tokens[0].is_keyword("CONSTRAINT"):
+            if len(tokens) < 2:
+                raise ParseError("CONSTRAINT is missing its name")
+            constraint_name = _unquote(tokens[1].text)
+            item_index = 2
+        head = tokens[item_index] if item_index < len(tokens) else None
+        if head and head.is_keyword("UNIQUE"):
+            if item_index + 1 >= len(tokens) or tokens[item_index + 1].text != "(":
+                raise ParseError("UNIQUE must be followed by a column list")
+            close = _matching_paren(tokens, item_index + 1)
+            inner = tokens[item_index + 2 : close]
+            parts: list[list[_Token]] = []
+            start = 0
+            depth = 0
+            for index, token in enumerate(inner):
+                if token.text == "(":
+                    depth += 1
+                elif token.text == ")":
+                    depth -= 1
+                elif token.text == "," and depth == 0:
+                    parts.append(inner[start:index])
+                    start = index + 1
+            parts.append(inner[start:])
+            columns: list[str] = []
+            collations: list[str | None] = []
+            orders: list[str | None] = []
+            for part in parts:
+                if not part or part[0].kind not in ("word", "identifier"):
+                    raise ParseError(
+                        "UNIQUE contains an unsupported indexed expression"
+                    )
+                columns.append(_unquote(part[0].text))
+                collation = None
+                order = None
+                index = 1
+                while index < len(part):
+                    if part[index].is_keyword("COLLATE") and index + 1 < len(part):
+                        collation = _unquote(part[index + 1].text)
+                        index += 2
+                    elif part[index].is_keyword("ASC") or part[index].is_keyword(
+                        "DESC"
+                    ):
+                        order = part[index].text.upper()
+                        index += 1
+                    else:
+                        raise ParseError(
+                            "UNIQUE contains an unsupported indexed expression"
+                        )
+                if collation is None:
+                    collation = column_collations.get(_ascii_fold(columns[-1]))
+                collations.append(collation)
+                orders.append(order)
+            uniques.append(
+                UniqueConstraint(
+                    tuple(columns),
+                    name=constraint_name,
+                    collations=tuple(collations),
+                    orders=tuple(orders),
+                    conflict=_conflict_action(tokens, close + 1),
+                )
+            )
+            continue
+        if (
+            head
+            and head.kind == "word"
+            and head.text.upper() in _TABLE_CONSTRAINT_KEYWORDS
+        ):
+            continue
+        column = _unquote(tokens[0].text)
+        pending_name = ""
+        index = 1
+        while index < len(tokens):
+            token = tokens[index]
+            if token.text == "(":
+                index = _matching_paren(tokens, index) + 1
+                continue
+            if token.is_keyword("CONSTRAINT"):
+                if index + 1 >= len(tokens):
+                    raise ParseError("CONSTRAINT is missing its name")
+                pending_name = _unquote(tokens[index + 1].text)
+                index += 2
+                continue
+            if token.is_keyword("UNIQUE"):
+                collation = _column_collation(tokens)
+                uniques.append(
+                    UniqueConstraint(
+                        (column,),
+                        name=pending_name,
+                        column=column,
+                        collations=(collation,),
+                        orders=(None,),
+                        conflict=_conflict_action(tokens, index + 1),
+                    )
+                )
+                pending_name = ""
+            elif token.is_keyword("CHECK"):
+                # A name immediately preceding CHECK belongs to that constraint,
+                # not to a later UNIQUE constraint on the same column.
+                pending_name = ""
+            elif (
+                token.kind == "word"
+                and token.text.upper() in _OTHER_COLUMN_CONSTRAINT_KEYWORDS
+            ):
+                if not token.is_keyword("COLLATE"):
+                    pending_name = ""
+            index += 1
+    return uniques
+
+
