+def test_parse_unique_constraints():
+    sql = """
+        CREATE TABLE labels (
+            name TEXT COLLATE NOCASE CONSTRAINT unique_name
+                UNIQUE ON CONFLICT IGNORE,
+            namespace TEXT,
+            CONSTRAINT unique_pair
+                UNIQUE(namespace DESC, name COLLATE RTRIM) ON CONFLICT FAIL
+        )
+    """
+    assert parse_unique_constraints(sql) == [
+        UniqueConstraint(
+            ("name",),
+            name="unique_name",
+            column="name",
+            collations=("NOCASE",),
+            orders=(None,),
+            conflict="IGNORE",
+        ),
+        UniqueConstraint(
+            ("namespace", "name"),
+            name="unique_pair",
+            collations=(None, "RTRIM"),
+            orders=("DESC", None),
+            conflict="FAIL",
+        ),
+    ]
+
+
+def test_parse_table_unique_inherits_column_collation():
+    sql = """
+        CREATE TABLE labels (
+            namespace TEXT,
+            name TEXT COLLATE NOCASE,
+            UNIQUE(namespace, name)
+        )
+    """
+    assert parse_unique_constraints(sql) == [
+        UniqueConstraint(
+            ("namespace", "name"),
+            collations=(None, "NOCASE"),
+            orders=(None, None),
+        )
+    ]
