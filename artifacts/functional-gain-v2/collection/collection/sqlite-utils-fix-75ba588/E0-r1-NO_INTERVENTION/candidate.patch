+def test_transform_dropping_composite_unique_member_drops_constraint(fresh_db):
+    fresh_db.execute("CREATE TABLE pairs (left TEXT, right TEXT, UNIQUE(left, right))")
+    pairs = fresh_db.table("pairs")
+    pairs.insert({"left": "same", "right": "one"})
+
+    pairs.transform(drop={"right"})
+    pairs.insert({"left": "same"})
+
+    assert list(pairs.rows) == [{"left": "same"}, {"left": "same"}]
