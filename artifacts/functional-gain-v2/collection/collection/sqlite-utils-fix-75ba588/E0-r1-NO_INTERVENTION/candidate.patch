+def parse_unique_constraints(create_sql: str) -> list[UniqueConstraint]:
+    """Return column and table UNIQUE constraints from CREATE TABLE SQL.
+
+    Each indexed column includes its explicit collation and descending flag.
+    Column constraints are normalized so callers can recreate them as table
+    constraints without needing to preserve the rest of the column definition.
+    """
+    body_info = _table_body(create_sql)
+    if body_info is None:
+        return []
+    body, _ = body_info
+    constraints: list[UniqueConstraint] = []
+    for item, _, _ in _split_spans(body, _lex(body)):
+        tokens = _meaningful(_lex(item))
+        if not tokens:
+            continue
+        index = 0
+        name = ""
+        if tokens[index].is_keyword("CONSTRAINT"):
+            if len(tokens) < 3:
+                raise ParseError("CONSTRAINT is missing its definition")
+            name = _unquote(tokens[index + 1].text)
+            index += 2
+        if index < len(tokens) and tokens[index].is_keyword("UNIQUE"):
+            if index + 1 >= len(tokens) or tokens[index + 1].text != "(":
+                raise ParseError("UNIQUE must be followed by a column list")
+            close = _matching_paren(tokens, index + 1)
+            columns = []
+            inner = item[tokens[index + 1].end : tokens[close].start]
+            for part in _split_ranges(inner, _lex(inner)):
+                part_tokens = _meaningful(_lex(part))
+                if not part_tokens:
+                    raise ParseError("Empty column in UNIQUE constraint")
+                column = _unquote(part_tokens[0].text)
+                collate = ""
+                desc = False
+                for part_index, token in enumerate(part_tokens[1:], 1):
+                    if token.is_keyword("COLLATE") and part_index + 1 < len(part_tokens):
+                        collate = _unquote(part_tokens[part_index + 1].text)
+                    elif token.is_keyword("DESC"):
+                        desc = True
+                columns.append((column, collate, desc))
+            constraints.append(
+                UniqueConstraint(
+                    tuple(columns), name=name, conflict=_unique_conflict(tokens, close + 1)
+                )
+            )
+            continue
+
+        # Column definition: locate UNIQUE at top level, remembering the
+        # column's declared collation. Parenthesized type details are skipped.
+        column = _unquote(tokens[0].text)
+        collate = ""
+        unique_index = None
+        scan = 1
+        while scan < len(tokens):
+            token = tokens[scan]
+            if token.text == "(":
+                scan = _matching_paren(tokens, scan) + 1
+                continue
+            if token.is_keyword("COLLATE") and scan + 1 < len(tokens):
+                collate = _unquote(tokens[scan + 1].text)
+                scan += 2
+                continue
+            if token.is_keyword("UNIQUE"):
+                unique_index = scan
+                break
+            scan += 1
+        if unique_index is not None:
+            inline_name = ""
+            if (
+                unique_index >= 2
+                and tokens[unique_index - 2].is_keyword("CONSTRAINT")
+            ):
+                inline_name = _unquote(tokens[unique_index - 1].text)
+            constraints.append(
+                UniqueConstraint(
+                    ((column, collate, False),),
+                    name=inline_name,
+                    conflict=_unique_conflict(tokens, unique_index + 1),
+                )
+            )
+    return constraints
+
