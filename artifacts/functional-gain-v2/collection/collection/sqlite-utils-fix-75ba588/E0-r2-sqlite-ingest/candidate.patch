+def _conflict_clause(tokens: list[_Token], start: int) -> str:
+    if (
+        start + 2 < len(tokens)
+        and tokens[start].is_keyword("ON")
+        and tokens[start + 1].is_keyword("CONFLICT")
+    ):
+        action = tokens[start + 2].text.upper()
+        if action in ("ROLLBACK", "ABORT", "FAIL", "IGNORE", "REPLACE"):
+            return action
+    return ""
+
+
+def _unique_column(tokens: list[_Token]) -> UniqueColumn:
+    if not tokens or tokens[0].kind not in ("word", "identifier"):
+        raise ParseError("UNIQUE constraint contains an invalid column")
+    name = _unquote(tokens[0].text)
+    collation = ""
+    descending = False
+    index = 1
+    if index < len(tokens) and tokens[index].is_keyword("COLLATE"):
+        if index + 1 >= len(tokens):
+            raise ParseError("COLLATE is missing its collation name")
+        collation = _unquote(tokens[index + 1].text)
+        index += 2
+    if index < len(tokens) and (
+        tokens[index].is_keyword("ASC") or tokens[index].is_keyword("DESC")
+    ):
+        descending = tokens[index].is_keyword("DESC")
+        index += 1
+    if index != len(tokens):
+        raise ParseError("UNIQUE constraints on expressions are not supported")
+    return UniqueColumn(name, collation, descending)
+
+
+def parse_unique_constraints(create_sql: str) -> list[Unique]:
+    """Return column and table-level UNIQUE constraints."""
+    body_info = _table_body(create_sql)
+    if body_info is None:
+        return []
+    body, _ = body_info
+    uniques: list[Unique] = []
+    for item, _, _ in _split_spans(body, _lex(body)):
+        tokens = _meaningful(_lex(item))
+        if not tokens:
+            continue
+        index = 0
+        constraint_name = ""
+        if tokens[index].is_keyword("CONSTRAINT"):
+            if len(tokens) < 2:
+                raise ParseError("CONSTRAINT is missing its name")
+            constraint_name = _unquote(tokens[1].text)
+            index = 2
+        if index < len(tokens) and tokens[index].is_keyword("UNIQUE"):
+            if index + 1 >= len(tokens) or tokens[index + 1].text != "(":
+                raise ParseError("UNIQUE must be followed by a column list")
+            close = _matching_paren(tokens, index + 1)
+            inner = item[tokens[index + 1].end : tokens[close].start]
+            columns = tuple(
+                _unique_column(_meaningful(_lex(part)))
+                for part in _split_ranges(inner, _lex(inner))
+            )
+            uniques.append(
+                Unique(columns, constraint_name, _conflict_clause(tokens, close + 1))
+            )
+            continue
+
+        # Column constraints can occur in any order. Remember the column's
+        # COLLATE clause because it controls an inline UNIQUE constraint.
+        column = _unquote(tokens[0].text)
+        collation = ""
+        token_index = 1
+        while token_index < len(tokens):
+            if tokens[token_index].text == "(":
+                token_index = _matching_paren(tokens, token_index) + 1
+                continue
+            if (
+                tokens[token_index].is_keyword("COLLATE")
+                and token_index + 1 < len(tokens)
+            ):
+                collation = _unquote(tokens[token_index + 1].text)
+                token_index += 2
+                continue
+            token_index += 1
+        pending_name = ""
+        index = 1
+        while index < len(tokens):
+            if tokens[index].text == "(":
+                index = _matching_paren(tokens, index) + 1
+                continue
+            if tokens[index].is_keyword("COLLATE") and index + 1 < len(tokens):
+                index += 2
+                continue
+            if tokens[index].is_keyword("CONSTRAINT"):
+                if index + 1 >= len(tokens):
+                    raise ParseError("CONSTRAINT is missing its name")
+                pending_name = _unquote(tokens[index + 1].text)
+                index += 2
+                continue
+            if tokens[index].is_keyword("UNIQUE"):
+                uniques.append(
+                    Unique(
+                        (UniqueColumn(column, collation),),
+                        pending_name,
+                        _conflict_clause(tokens, index + 1),
+                    )
+                )
+                pending_name = ""
+            elif (
+                tokens[index].kind == "word"
+                and tokens[index].text.upper() in _OTHER_COLUMN_CONSTRAINT_KEYWORDS
+            ):
+                pending_name = ""
+            index += 1
+    return uniques
+
+
