+def _unique_constraint_sql(unique: Unique) -> str:
+    prefix = f"CONSTRAINT {quote_identifier(unique.name)} " if unique.name else ""
+    columns = []
+    for column in unique.columns:
+        sql = quote_identifier(column.name)
+        if column.collation:
+            sql += f" COLLATE {quote_identifier(column.collation)}"
+        if column.descending:
+            sql += " DESC"
+        columns.append(sql)
+    conflict = f" ON CONFLICT {unique.conflict}" if unique.conflict else ""
+    return f"{prefix}UNIQUE ({', '.join(columns)}){conflict}"
+
