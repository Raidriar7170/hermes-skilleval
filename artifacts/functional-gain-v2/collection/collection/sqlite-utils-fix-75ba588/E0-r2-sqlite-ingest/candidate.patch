+def test_transform_preserves_unique_constraints(fresh_db):
+    fresh_db.execute("""
+        CREATE TABLE entries (
+            id INTEGER PRIMARY KEY,
+            slug TEXT COLLATE NOCASE UNIQUE ON CONFLICT IGNORE,
+            account_id INTEGER,
+            label TEXT,
+            CONSTRAINT account_label
+                UNIQUE(account_id, label COLLATE NOCASE) ON CONFLICT IGNORE
+        )
+    """)
+    entries = fresh_db.table("entries")
+    entries.insert(
+        {"id": 1, "slug": "First", "account_id": 10, "label": "Primary"}
+    )
+
+    entries.transform(
+        rename={"slug": "key", "label": "title"},
+        types={"account_id": str},
+    )
+
+    # Existing rows survive the rebuild and renamed/type-changed columns still
+    # participate in the same case-insensitive, IGNORE-on-conflict constraints.
+    assert list(entries.rows) == [
+        {"id": 1, "key": "First", "account_id": "10", "title": "Primary"}
+    ]
+    entries.insert(
+        {"id": 2, "key": "first", "account_id": "20", "title": "Other"}
+    )
+    entries.insert(
+        {"id": 3, "key": "Second", "account_id": "10", "title": "primary"}
+    )
+    assert entries.count == 1
+
+    # Dropping one member drops the whole composite UNIQUE constraint. The
+    # single-column constraint remains in force.
+    entries.transform(drop={"title"})
+    entries.insert({"id": 4, "key": "Fourth", "account_id": "10"})
+    entries.insert({"id": 5, "key": "Fifth", "account_id": "10"})
+    assert entries.count == 3
+    entries.insert({"id": 6, "key": "FOURTH", "account_id": "30"})
+    assert entries.count == 3
