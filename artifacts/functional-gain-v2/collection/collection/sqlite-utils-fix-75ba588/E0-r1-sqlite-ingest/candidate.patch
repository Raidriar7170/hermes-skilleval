+def _unique_conflict(tokens: list[_Token], start: int) -> str:
+    """Return the conflict algorithm following a UNIQUE clause, if present."""
+    if (
+        start + 2 < len(tokens)
+        and tokens[start].is_keyword("ON")
+        and tokens[start + 1].is_keyword("CONFLICT")
+    ):
+        return _unquote(tokens[start + 2].text).upper()
+    return ""
+
+
+def _unique_indexed_columns(
+    item: str, tokens: list[_Token], open_index: int
+) -> tuple[tuple[str, ...], tuple[str, ...], tuple[bool, ...], int]:
+    close = _matching_paren(tokens, open_index)
+    inner = item[tokens[open_index].end : tokens[close].start]
+    columns: list[str] = []
+    collations: list[str] = []
+    descending: list[bool] = []
+    for term in _split_ranges(inner, _lex(inner)):
+        term_tokens = _meaningful(_lex(term))
+        if not term_tokens or term_tokens[0].kind not in ("word", "identifier"):
+            raise ParseError("UNIQUE constraint contains an invalid column")
+        columns.append(_unquote(term_tokens[0].text))
+        collation = ""
+        is_descending = False
+        index = 1
+        while index < len(term_tokens):
+            if term_tokens[index].is_keyword("COLLATE"):
+                if index + 1 >= len(term_tokens):
+                    raise ParseError("COLLATE is missing its collation name")
+                collation = _unquote(term_tokens[index + 1].text)
+                index += 2
+                continue
+            if term_tokens[index].is_keyword("DESC"):
+                is_descending = True
+            index += 1
+        collations.append(collation)
+        descending.append(is_descending)
+    return tuple(columns), tuple(collations), tuple(descending), close
+
+
+def parse_uniques(create_sql: str) -> list[Unique]:
+    """Return column and table UNIQUE constraints from CREATE TABLE SQL."""
+    body_info = _table_body(create_sql)
+    if body_info is None:
+        return []
+    body, _ = body_info
+    uniques: list[Unique] = []
+    declared_collations: dict[str, str] = {}
+    for item, _, _ in _split_spans(body, _lex(body)):
+        tokens = _meaningful(_lex(item))
+        if not tokens:
+            continue
+        index = 0
+        constraint_name = ""
+        if tokens[index].is_keyword("CONSTRAINT"):
+            if len(tokens) < 2:
+                raise ParseError("CONSTRAINT is missing its name")
+            constraint_name = _unquote(tokens[1].text)
+            index = 2
+        if index < len(tokens) and tokens[index].is_keyword("UNIQUE"):
+            if index + 1 >= len(tokens) or tokens[index + 1].text != "(":
+                raise ParseError("UNIQUE must be followed by a column list")
+            columns, collations, descending, close = _unique_indexed_columns(
+                item, tokens, index + 1
+            )
+            uniques.append(
+                Unique(
+                    columns,
+                    name=constraint_name,
+                    conflict=_unique_conflict(tokens, close + 1),
+                    collations=collations,
+                    descending=descending,
+                )
+            )
+            continue
+        # It is a column definition. Find each top-level UNIQUE clause and the
+        # column's declared collation, which controls its implicit index.
+        column = _unquote(tokens[0].text)
+        collation = ""
+        scan_index = 1
+        while scan_index < len(tokens):
+            if tokens[scan_index].text == "(":
+                scan_index = _matching_paren(tokens, scan_index) + 1
+                continue
+            if tokens[scan_index].is_keyword("COLLATE"):
+                if scan_index + 1 >= len(tokens):
+                    raise ParseError("COLLATE is missing its collation name")
+                collation = _unquote(tokens[scan_index + 1].text)
+                break
+            scan_index += 1
+        if collation:
+            declared_collations[_ascii_fold(column)] = collation
+        pending_name = ""
+        index = 1
+        while index < len(tokens):
+            token = tokens[index]
+            if token.text == "(":
+                index = _matching_paren(tokens, index) + 1
+                continue
+            if token.is_keyword("CONSTRAINT"):
+                if index + 1 >= len(tokens):
+                    raise ParseError("CONSTRAINT is missing its name")
+                pending_name = _unquote(tokens[index + 1].text)
+                index += 2
+                continue
+            if token.is_keyword("COLLATE"):
+                index += 2
+                continue
+            if token.is_keyword("UNIQUE"):
+                uniques.append(
+                    Unique(
+                        (column,),
+                        name=pending_name,
+                        conflict=_unique_conflict(tokens, index + 1),
+                        collations=(collation,),
+                        descending=(False,),
+                    )
+                )
+                pending_name = ""
+            elif (
+                token.kind == "word"
+                and token.text.upper() in _OTHER_COLUMN_CONSTRAINT_KEYWORDS
+            ):
+                pending_name = ""
+            index += 1
+    # An indexed column with no explicit COLLATE inherits its column's
+    # declared collation. Record that effective collation so a rebuilt table
+    # does not silently turn a NOCASE/RTRIM composite key into BINARY.
+    return [
+        Unique(
+            unique.columns,
+            name=unique.name,
+            conflict=unique.conflict,
+            collations=tuple(
+                collation
+                or declared_collations.get(_ascii_fold(column), "")
+                for column, collation in zip(unique.columns, unique.collations)
+            ),
+            descending=unique.descending,
+        )
+        for unique in uniques
+    ]
+
+
