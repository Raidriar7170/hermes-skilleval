+def _unique_constraint_sql(unique: Unique) -> str:
+    prefix = f"CONSTRAINT {quote_identifier(unique.name)} " if unique.name else ""
+    terms = []
+    for index, column in enumerate(unique.columns):
+        term = quote_identifier(column)
+        if index < len(unique.collations) and unique.collations[index]:
+            term += f" COLLATE {quote_identifier(unique.collations[index])}"
+        if index < len(unique.descending) and unique.descending[index]:
+            term += " DESC"
+        terms.append(term)
+    conflict = f" ON CONFLICT {unique.conflict}" if unique.conflict else ""
+    return f"{prefix}UNIQUE ({', '.join(terms)}){conflict}"
+
