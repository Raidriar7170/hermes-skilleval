+def _unique_suffix(tokens: list[_Token], start: int) -> tuple[str, int]:
+    """Return an optional ON CONFLICT action and the next token index."""
+    if (
+        start + 2 < len(tokens)
+        and tokens[start].is_keyword("ON")
+        and tokens[start + 1].is_keyword("CONFLICT")
+    ):
+        return _unquote(tokens[start + 2].text).upper(), start + 3
+    return "", start
+
