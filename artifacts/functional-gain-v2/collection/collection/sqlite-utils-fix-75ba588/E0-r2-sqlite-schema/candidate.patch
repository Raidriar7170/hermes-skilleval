+def parse_unique_constraints(create_sql: str) -> list[UniqueConstraint]:
+    """Return column and table UNIQUE constraints from CREATE TABLE SQL."""
+    body_info = _table_body(create_sql)
+    if body_info is None:
+        return []
+    body, _ = body_info
+    uniques: list[UniqueConstraint] = []
+    for item, _, _ in _split_spans(body, _lex(body)):
+        tokens = _meaningful(_lex(item))
+        if not tokens:
+            continue
+        index = 0
+        table_name = ""
+        if tokens[index].is_keyword("CONSTRAINT"):
+            if len(tokens) < 2:
+                raise ParseError("CONSTRAINT is missing its name")
+            table_name = _unquote(tokens[1].text)
+            index = 2
+        if index < len(tokens) and tokens[index].is_keyword("UNIQUE"):
+            if index + 1 >= len(tokens) or tokens[index + 1].text != "(":
+                raise ParseError("UNIQUE must be followed by a column list")
+            close = _matching_paren(tokens, index + 1)
+            column_sql = item[tokens[index + 1].end : tokens[close].start]
+            columns = []
+            for part in _split_ranges(column_sql, _lex(column_sql)):
+                part_tokens = _meaningful(_lex(part))
+                if not part_tokens:
+                    raise ParseError("UNIQUE has an empty column")
+                column = _unquote(part_tokens[0].text)
+                collate = ""
+                desc = False
+                part_index = 1
+                if (
+                    part_index + 1 < len(part_tokens)
+                    and part_tokens[part_index].is_keyword("COLLATE")
+                ):
+                    collate = _unquote(part_tokens[part_index + 1].text)
+                    part_index += 2
+                if part_index < len(part_tokens) and (
+                    part_tokens[part_index].is_keyword("ASC")
+                    or part_tokens[part_index].is_keyword("DESC")
+                ):
+                    desc = part_tokens[part_index].is_keyword("DESC")
+                    part_index += 1
+                if part_index != len(part_tokens):
+                    raise ParseError("Unsupported expression in UNIQUE constraint")
+                columns.append((column, collate, desc))
+            conflict, _ = _unique_suffix(tokens, close + 1)
+            uniques.append(
+                UniqueConstraint(tuple(columns), name=table_name, conflict=conflict)
+            )
+            continue
+
+        # Column-level constraints can occur anywhere after the declared type.
+        column = _unquote(tokens[0].text)
+        pending_name = ""
+        index = 1
+        while index < len(tokens):
+            if tokens[index].text == "(":
+                index = _matching_paren(tokens, index) + 1
+                continue
+            if tokens[index].is_keyword("CONSTRAINT"):
+                if index + 1 >= len(tokens):
+                    raise ParseError("CONSTRAINT is missing its name")
+                pending_name = _unquote(tokens[index + 1].text)
+                index += 2
+                continue
+            if tokens[index].is_keyword("UNIQUE"):
+                conflict, index = _unique_suffix(tokens, index + 1)
+                uniques.append(
+                    UniqueConstraint(
+                        ((column, "", False),),
+                        name=pending_name,
+                        conflict=conflict,
+                        column=column,
+                    )
+                )
+                pending_name = ""
+                continue
+            if tokens[index].is_keyword("CHECK"):
+                pending_name = ""
+            if (
+                tokens[index].kind == "word"
+                and tokens[index].text.upper() in _OTHER_COLUMN_CONSTRAINT_KEYWORDS
+            ):
+                pending_name = ""
+            index += 1
+    return uniques
+
+
+def parse_column_collations(create_sql: str) -> dict[str, str]:
+    """Return explicit COLLATE clauses from column definitions."""
+    body_info = _table_body(create_sql)
+    if body_info is None:
+        return {}
+    body, _ = body_info
+    collations = {}
+    for item, _, _ in _split_spans(body, _lex(body)):
+        tokens = _meaningful(_lex(item))
+        if not tokens:
+            continue
+        head = tokens[0]
+        if head.is_keyword("CONSTRAINT") or (
+            head.kind == "word" and head.text.upper() in _TABLE_CONSTRAINT_KEYWORDS
+        ):
+            continue
+        column = _unquote(head.text)
+        index = 1
+        while index + 1 < len(tokens):
+            token = tokens[index]
+            if token.text == "(":
+                index = _matching_paren(tokens, index) + 1
+                continue
+            if token.is_keyword("COLLATE"):
+                collations[column] = _unquote(tokens[index + 1].text)
+                break
+            index += 1
+    return collations
+
+
 def parse_column_comments(create_sql: str) -> dict[str, ColumnComments]:
     """Return comments immediately before and after each column definition."""
     body_info = _table_body(create_sql)
