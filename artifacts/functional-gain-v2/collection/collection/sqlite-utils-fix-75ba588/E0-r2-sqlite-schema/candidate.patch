+def test_parse_unique_constraints_and_collations():
+    sql = """CREATE TABLE t (
+        id INTEGER PRIMARY KEY,
+        code TEXT COLLATE NOCASE CONSTRAINT unique_code UNIQUE ON CONFLICT FAIL,
+        account TEXT,
+        label TEXT,
+        CONSTRAINT unique_label UNIQUE (account COLLATE RTRIM, label DESC)
+            ON CONFLICT IGNORE
+    )"""
+    sqlite3.connect(":memory:").execute(sql)
+    assert parse_column_collations(sql) == {"code": "NOCASE"}
+    assert parse_unique_constraints(sql) == [
+        UniqueConstraint(
+            (("code", "", False),),
+            name="unique_code",
+            conflict="FAIL",
+            column="code",
+        ),
+        UniqueConstraint(
+            (("account", "RTRIM", False), ("label", "", True)),
+            name="unique_label",
+            conflict="IGNORE",
+        ),
+    ]
+
