+def test_parse_unique_constraints():
+    sql = """
+        CREATE TABLE people (
+            email TEXT COLLATE NOCASE CONSTRAINT unique_email
+                UNIQUE ON CONFLICT IGNORE,
+            tenant TEXT,
+            handle TEXT,
+            CONSTRAINT unique_handle
+                UNIQUE (tenant, handle COLLATE nocase DESC) ON CONFLICT FAIL
+        )
+    """
+    sqlite3.connect(":memory:").execute(sql)
+    assert parse_unique_constraints(sql) == [
+        UniqueConstraint(
+            (UniqueColumn("email", "NOCASE"),),
+            name="unique_email",
+            conflict="IGNORE",
+            column="email",
+        ),
+        UniqueConstraint(
+            (UniqueColumn("tenant"), UniqueColumn("handle", "nocase", "DESC")),
+            name="unique_handle",
+            conflict="FAIL",
+        ),
+    ]
+    assert parse_column_collations(sql) == {"email": "NOCASE"}
+
+
