+def _unique_conflict(tokens: list[_Token], start: int) -> str:
+    if (
+        start + 2 < len(tokens)
+        and tokens[start].is_keyword("ON")
+        and tokens[start + 1].is_keyword("CONFLICT")
+    ):
+        conflict = tokens[start + 2].text.upper()
+        if conflict not in ("ROLLBACK", "ABORT", "FAIL", "IGNORE", "REPLACE"):
+            raise ParseError(f"Invalid UNIQUE conflict policy: {conflict}")
+        return conflict
+    return ""
+
+
+def _unique_column(tokens: list[_Token]) -> UniqueColumn:
+    if not tokens or tokens[0].kind not in ("word", "identifier"):
+        raise ParseError("UNIQUE constraint must contain column names")
+    name = _unquote(tokens[0].text)
+    collation = ""
+    order = ""
+    index = 1
+    while index < len(tokens):
+        if tokens[index].is_keyword("COLLATE"):
+            if index + 1 >= len(tokens):
+                raise ParseError("COLLATE is missing its collation name")
+            collation = _unquote(tokens[index + 1].text)
+            index += 2
+        elif tokens[index].is_keyword("ASC") or tokens[index].is_keyword("DESC"):
+            order = tokens[index].text.upper()
+            index += 1
+        else:
+            raise ParseError("Unsupported expression in UNIQUE constraint")
+    return UniqueColumn(name, collation, order)
+
+
+def parse_unique_constraints(create_sql: str) -> list[UniqueConstraint]:
+    """Return declared UNIQUE constraints from a CREATE TABLE statement."""
+    body_info = _table_body(create_sql)
+    if body_info is None:
+        return []
+    body, _ = body_info
+    uniques: list[UniqueConstraint] = []
+    for item, _, _ in _split_spans(body, _lex(body)):
+        tokens = _meaningful(_lex(item))
+        if not tokens:
+            continue
+        index = 0
+        constraint_name = ""
+        if tokens[index].is_keyword("CONSTRAINT"):
+            if len(tokens) < 2:
+                raise ParseError("CONSTRAINT is missing its name")
+            constraint_name = _unquote(tokens[1].text)
+            index = 2
+        if index < len(tokens) and tokens[index].is_keyword("UNIQUE"):
+            if index + 1 >= len(tokens) or tokens[index + 1].text != "(":
+                raise ParseError("UNIQUE must be followed by a column list")
+            close = _matching_paren(tokens, index + 1)
+            inner = item[tokens[index + 1].end : tokens[close].start]
+            columns = tuple(
+                _unique_column(_meaningful(_lex(part)))
+                for part in _split_ranges(inner, _lex(inner))
+            )
+            if not columns:
+                raise ParseError("UNIQUE constraint must contain columns")
+            uniques.append(
+                UniqueConstraint(
+                    columns,
+                    name=constraint_name,
+                    conflict=_unique_conflict(tokens, close + 1),
+                )
+            )
+            continue
+
+        # Column definition: locate each inline UNIQUE constraint and the
+        # column's COLLATE clause, which determines comparison for its index.
+        column = _unquote(tokens[0].text)
+        collation = ""
+        scan_index = 1
+        while scan_index < len(tokens):
+            if tokens[scan_index].text == "(":
+                scan_index = _matching_paren(tokens, scan_index) + 1
+                continue
+            if tokens[scan_index].is_keyword("COLLATE"):
+                if scan_index + 1 >= len(tokens):
+                    raise ParseError("COLLATE is missing its collation name")
+                collation = _unquote(tokens[scan_index + 1].text)
+                scan_index += 2
+                continue
+            scan_index += 1
+        pending_name = ""
+        index = 1
+        while index < len(tokens):
+            token = tokens[index]
+            if token.text == "(":
+                index = _matching_paren(tokens, index) + 1
+                continue
+            if token.is_keyword("COLLATE"):
+                index += 2
+                continue
+            if token.is_keyword("CONSTRAINT"):
+                if index + 1 >= len(tokens):
+                    raise ParseError("CONSTRAINT is missing its name")
+                pending_name = _unquote(tokens[index + 1].text)
+                index += 2
+                continue
+            if token.is_keyword("UNIQUE"):
+                uniques.append(
+                    UniqueConstraint(
+                        (UniqueColumn(column, collation),),
+                        name=pending_name,
+                        conflict=_unique_conflict(tokens, index + 1),
+                        column=column,
+                    )
+                )
+                pending_name = ""
+            elif token.kind == "word" and token.text.upper() in (
+                _OTHER_COLUMN_CONSTRAINT_KEYWORDS - {"COLLATE"}
+            ):
+                pending_name = ""
+            index += 1
+    return uniques
+
+
+def parse_column_collations(create_sql: str) -> dict[str, str]:
+    """Return explicit COLLATE clauses from column definitions."""
+    body_info = _table_body(create_sql)
+    if body_info is None:
+        return {}
+    body, _ = body_info
+    collations: dict[str, str] = {}
+    for item, _, _ in _split_spans(body, _lex(body)):
+        tokens = _meaningful(_lex(item))
+        if not tokens:
+            continue
+        if tokens[0].is_keyword("CONSTRAINT") or (
+            tokens[0].kind == "word"
+            and tokens[0].text.upper() in _TABLE_CONSTRAINT_KEYWORDS
+        ):
+            continue
+        column = _unquote(tokens[0].text)
+        index = 1
+        while index < len(tokens):
+            if tokens[index].text == "(":
+                index = _matching_paren(tokens, index) + 1
+                continue
+            if tokens[index].is_keyword("COLLATE"):
+                if index + 1 >= len(tokens):
+                    raise ParseError("COLLATE is missing its collation name")
+                collations[column] = _unquote(tokens[index + 1].text)
+                index += 2
+                continue
+            index += 1
+    return collations
+
+
 def parse_column_comments(create_sql: str) -> dict[str, ColumnComments]:
     """Return comments immediately before and after each column definition."""
     body_info = _table_body(create_sql)
