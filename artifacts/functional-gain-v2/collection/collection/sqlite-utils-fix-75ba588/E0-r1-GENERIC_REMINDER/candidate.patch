+def _conflict_clause(tokens: list[_Token], start: int) -> str:
+    if (
+        start + 2 < len(tokens)
+        and tokens[start].is_keyword("ON")
+        and tokens[start + 1].is_keyword("CONFLICT")
+        and tokens[start + 2].kind in ("word", "identifier")
+    ):
+        action = _unquote(tokens[start + 2].text).upper()
+        if action in ("ROLLBACK", "ABORT", "FAIL", "IGNORE", "REPLACE"):
+            return action
+    return ""
+
+
+def _unique_columns(tokens: list[_Token], open_index: int) -> tuple[UniqueColumn, ...]:
+    close = _matching_paren(tokens, open_index)
+    columns: list[UniqueColumn] = []
+    start = open_index + 1
+    depth = 0
+    ranges: list[tuple[int, int]] = []
+    for index in range(start, close):
+        token = tokens[index]
+        if token.text == "(":
+            depth += 1
+        elif token.text == ")":
+            depth -= 1
+        elif token.text == "," and depth == 0:
+            ranges.append((start, index))
+            start = index + 1
+    ranges.append((start, close))
+    for item_start, item_end in ranges:
+        item = tokens[item_start:item_end]
+        if not item or item[0].kind not in ("word", "identifier"):
+            raise ParseError("UNIQUE constraint contains an invalid column")
+        collation = ""
+        descending = False
+        index = 1
+        while index < len(item):
+            if item[index].is_keyword("COLLATE"):
+                if index + 1 >= len(item):
+                    raise ParseError("COLLATE is missing its collation name")
+                collation = _unquote(item[index + 1].text)
+                index += 2
+            elif item[index].is_keyword("DESC"):
+                descending = True
+                index += 1
+            elif item[index].is_keyword("ASC"):
+                index += 1
+            else:
+                raise ParseError("UNIQUE constraint contains an invalid indexed column")
+        columns.append(UniqueColumn(_unquote(item[0].text), collation, descending))
+    return tuple(columns)
+
+
+def _column_collation(tokens: list[_Token]) -> str:
+    """Return a column's top-level COLLATE constraint, ignoring expressions."""
+    collation = ""
+    index = 1
+    while index < len(tokens):
+        if tokens[index].text == "(":
+            index = _matching_paren(tokens, index) + 1
+            continue
+        if tokens[index].is_keyword("COLLATE"):
+            if index + 1 >= len(tokens):
+                raise ParseError("COLLATE is missing its collation name")
+            collation = _unquote(tokens[index + 1].text)
+            index += 2
+            continue
+        index += 1
+    return collation
+
+
+def parse_uniques(create_sql: str) -> list[Unique]:
+    """Return column and table UNIQUE constraints from CREATE TABLE SQL."""
+    body_info = _table_body(create_sql)
+    if body_info is None:
+        return []
+    body, _ = body_info
+    items = _split_spans(body, _lex(body))
+    # Table-level UNIQUE(a, b) inherits each column's declared collation when
+    # the indexed-column does not provide an explicit COLLATE clause.
+    column_collations: dict[str, str] = {}
+    for item, _, _ in items:
+        tokens = _meaningful(_lex(item))
+        if not tokens:
+            continue
+        head = tokens[0]
+        if head.is_keyword("CONSTRAINT") or (
+            head.kind == "word" and head.text.upper() in _TABLE_CONSTRAINT_KEYWORDS
+        ):
+            continue
+        collation = _column_collation(tokens)
+        if collation:
+            column_collations[_ascii_fold(_unquote(head.text))] = collation
+
+    uniques: list[Unique] = []
+    for item, _, _ in items:
+        tokens = _meaningful(_lex(item))
+        if not tokens:
+            continue
+        index = 0
+        constraint_name = ""
+        if tokens[index].is_keyword("CONSTRAINT"):
+            if len(tokens) < 2:
+                raise ParseError("CONSTRAINT is missing its name")
+            constraint_name = _unquote(tokens[1].text)
+            index = 2
+        if index < len(tokens) and tokens[index].is_keyword("UNIQUE"):
+            if index + 1 >= len(tokens) or tokens[index + 1].text != "(":
+                raise ParseError("UNIQUE must be followed by a column list")
+            close = _matching_paren(tokens, index + 1)
+            unique_columns = _unique_columns(tokens, index + 1)
+            unique_columns = tuple(
+                UniqueColumn(
+                    column.name,
+                    column.collation
+                    or column_collations.get(_ascii_fold(column.name), ""),
+                    column.descending,
+                )
+                for column in unique_columns
+            )
+            uniques.append(
+                Unique(
+                    unique_columns,
+                    constraint_name,
+                    _conflict_clause(tokens, close + 1),
+                )
+            )
+            continue
+        # Column definition: track its declared collation and each named
+        # constraint. SQLite permits COLLATE before or after UNIQUE, but the
+        # column's collation applies to its implicit unique index either way.
+        column = _unquote(tokens[0].text)
+        collation = column_collations.get(_ascii_fold(column), "")
+        pending_name = ""
+        index = 1
+        while index < len(tokens):
+            if tokens[index].text == "(":
+                index = _matching_paren(tokens, index) + 1
+                continue
+            if tokens[index].is_keyword("CONSTRAINT"):
+                if index + 1 >= len(tokens):
+                    raise ParseError("CONSTRAINT is missing its name")
+                pending_name = _unquote(tokens[index + 1].text)
+                index += 2
+                continue
+            if tokens[index].is_keyword("UNIQUE"):
+                uniques.append(
+                    Unique(
+                        (UniqueColumn(column, collation),),
+                        pending_name,
+                        _conflict_clause(tokens, index + 1),
+                    )
+                )
+                pending_name = ""
+            elif (
+                tokens[index].kind == "word"
+                and tokens[index].text.upper() in _OTHER_COLUMN_CONSTRAINT_KEYWORDS
+                and not tokens[index].is_keyword("COLLATE")
+            ):
+                pending_name = ""
+            index += 1
+    return uniques
+
