+def test_parse_column_and_table_uniques():
+    sql = """
+        CREATE TABLE people (
+            email TEXT COLLATE NOCASE CONSTRAINT distinct_email
+                UNIQUE ON CONFLICT IGNORE,
+            tenant INTEGER,
+            name TEXT,
+            CONSTRAINT distinct_name UNIQUE(
+                tenant, name COLLATE RTRIM DESC
+            ) ON CONFLICT REPLACE
+        )
+    """
+    assert parse_uniques(sql) == [
+        Unique(
+            (UniqueColumn("email", "NOCASE"),),
+            name="distinct_email",
+            conflict="IGNORE",
+        ),
+        Unique(
+            (
+                UniqueColumn("tenant"),
+                UniqueColumn("name", "RTRIM", descending=True),
+            ),
+            name="distinct_name",
+            conflict="REPLACE",
+        ),
+    ]
+
+
+def test_parse_table_unique_inherits_column_collation():
+    assert parse_uniques(
+        "CREATE TABLE t(name TEXT COLLATE NOCASE, scope TEXT, UNIQUE(name, scope))"
+    ) == [
+        Unique((UniqueColumn("name", "NOCASE"), UniqueColumn("scope")))
+    ]
+
+
+def test_parse_unique_does_not_inherit_collation_from_expression():
+    assert parse_uniques(
+        "CREATE TABLE t(name TEXT CHECK(name COLLATE NOCASE != ''), UNIQUE(name))"
+    ) == [Unique((UniqueColumn("name"),))]
+
