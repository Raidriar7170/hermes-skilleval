+def _conflict_clause(tokens: list[_Token], start: int) -> str:
+    if (
+        start + 2 < len(tokens)
+        and tokens[start].is_keyword("ON")
+        and tokens[start + 1].is_keyword("CONFLICT")
+        and tokens[start + 2].text.upper()
+        in ("ROLLBACK", "ABORT", "FAIL", "IGNORE", "REPLACE")
+    ):
+        return tokens[start + 2].text.upper()
+    return ""
+
+
+def _column_collation(tokens: list[_Token]) -> str | None:
+    index = 1
+    while index < len(tokens) - 1:
+        if tokens[index].text == "(":
+            index = _matching_paren(tokens, index) + 1
+            continue
+        if tokens[index].is_keyword("COLLATE"):
+            return _unquote(tokens[index + 1].text)
+        index += 1
+    return None
+
+
+def parse_unique_constraints(create_sql: str) -> list[UniqueConstraint]:
+    """Return column and table-level UNIQUE constraints from CREATE TABLE SQL."""
+    body_info = _table_body(create_sql)
+    if body_info is None:
+        return []
+    body, _ = body_info
+    uniques: list[UniqueConstraint] = []
+    for item, _, _ in _split_spans(body, _lex(body)):
+        tokens = _meaningful(_lex(item))
+        if not tokens:
+            continue
+        index = 0
+        name = ""
+        if tokens[index].is_keyword("CONSTRAINT"):
+            if len(tokens) < 2:
+                raise ParseError("CONSTRAINT is missing its name")
+            name = _unquote(tokens[1].text)
+            index = 2
+        if index < len(tokens) and tokens[index].is_keyword("UNIQUE"):
+            if index + 1 >= len(tokens) or tokens[index + 1].text != "(":
+                raise ParseError("UNIQUE must be followed by a column list")
+            close = _matching_paren(tokens, index + 1)
+            inner = item[tokens[index + 1].end : tokens[close].start]
+            columns: list[str] = []
+            collations: list[str | None] = []
+            for term in _split_ranges(inner, _lex(inner)):
+                term_tokens = _meaningful(_lex(term))
+                if not term_tokens or term_tokens[0].kind not in ("word", "identifier"):
+                    raise ParseError("UNIQUE contains an invalid column")
+                columns.append(_unquote(term_tokens[0].text))
+                collation = None
+                for term_index, token in enumerate(term_tokens[:-1]):
+                    if token.is_keyword("COLLATE"):
+                        collation = _unquote(term_tokens[term_index + 1].text)
+                        break
+                collations.append(collation)
+            uniques.append(
+                UniqueConstraint(
+                    tuple(columns),
+                    tuple(collations),
+                    name=name,
+                    conflict=_conflict_clause(tokens, close + 1),
+                )
+            )
+            continue
+
+        # A column definition can contain multiple named constraints. Track the
+        # name immediately preceding UNIQUE, not a name belonging to CHECK etc.
+        column = _unquote(tokens[0].text)
+        pending_name = ""
+        token_index = 1
+        while token_index < len(tokens):
+            token = tokens[token_index]
+            if token.text == "(":
+                token_index = _matching_paren(tokens, token_index) + 1
+                continue
+            if token.is_keyword("CONSTRAINT") and token_index + 1 < len(tokens):
+                pending_name = _unquote(tokens[token_index + 1].text)
+                token_index += 2
+                continue
+            if token.is_keyword("UNIQUE"):
+                uniques.append(
+                    UniqueConstraint(
+                        (column,),
+                        (_column_collation(tokens),),
+                        name=pending_name,
+                        conflict=_conflict_clause(tokens, token_index + 1),
+                    )
+                )
+                pending_name = ""
+            elif (
+                token.kind == "word"
+                and token.text.upper() in _OTHER_COLUMN_CONSTRAINT_KEYWORDS
+            ):
+                pending_name = ""
+            token_index += 1
+    return uniques
+
