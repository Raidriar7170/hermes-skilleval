+def test_transform_preserves_column_unique_collation_and_conflict(fresh_db):
+    fresh_db.execute("""
+        CREATE TABLE contacts (
+            id INTEGER PRIMARY KEY,
+            email TEXT COLLATE NOCASE UNIQUE ON CONFLICT IGNORE,
+            note TEXT
+        )
+    """)
+    contacts = fresh_db.table("contacts")
+    contacts.insert({"id": 1, "email": "One@example.com", "note": "original"})
+
+    contacts.transform(
+        rename={"email": "address"},
+        types={"email": str},
+    )
+
+    assert list(contacts.rows) == [
+        {"id": 1, "address": "One@example.com", "note": "original"}
+    ]
+    # Both NOCASE and ON CONFLICT IGNORE must still apply after the rebuild.
+    fresh_db.execute(
+        "INSERT INTO contacts (id, address, note) VALUES (2, ?, ?)",
+        ["one@EXAMPLE.com", "duplicate"],
+    )
+    assert contacts.count == 1
+
+
+def test_transform_preserves_composite_unique_and_drops_it_as_a_unit(fresh_db):
+    fresh_db.execute("""
+        CREATE TABLE memberships (
+            id INTEGER PRIMARY KEY,
+            account TEXT,
+            role INTEGER,
+            CONSTRAINT one_role UNIQUE (
+                account COLLATE NOCASE,
+                role
+            ) ON CONFLICT IGNORE
+        )
+    """)
+    memberships = fresh_db.table("memberships")
+    memberships.insert({"id": 1, "account": "Alice", "role": 3})
+
+    memberships.transform(
+        rename={"account": "username"},
+        types={"role": str},
+    )
+    assert memberships.get(1) == {"id": 1, "username": "Alice", "role": "3"}
+    fresh_db.execute(
+        "INSERT INTO memberships (id, username, role) VALUES (2, ?, ?)",
+        ["ALICE", "3"],
+    )
+    assert memberships.count == 1
+
+    memberships.transform(drop={"role"})
+    # Dropping one member removes the whole composite constraint. A duplicate
+    # value in the remaining column is therefore allowed.
+    memberships.insert({"id": 2, "username": "ALICE"})
+    assert memberships.count == 2
