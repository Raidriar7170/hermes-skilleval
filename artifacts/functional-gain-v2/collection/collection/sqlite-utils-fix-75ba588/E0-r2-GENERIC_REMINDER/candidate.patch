+def test_parse_unique_constraints():
+    sql = '''
+        CREATE TABLE people (
+            email TEXT COLLATE NOCASE
+                CONSTRAINT "unique email" UNIQUE ON CONFLICT IGNORE,
+            tenant TEXT,
+            username TEXT,
+            CONSTRAINT tenant_username UNIQUE (
+                tenant,
+                username COLLATE RTRIM DESC
+            ) ON CONFLICT FAIL
+        )
+    '''
+    assert parse_unique_constraints(sql) == [
+        UniqueConstraint(
+            ("email",),
+            ("NOCASE",),
+            name="unique email",
+            conflict="IGNORE",
+        ),
+        UniqueConstraint(
+            ("tenant", "username"),
+            (None, "RTRIM"),
+            name="tenant_username",
+            conflict="FAIL",
+        ),
+    ]
+
+
+def test_parse_unique_does_not_borrow_later_conflict_clause():
+    sql = """
+        CREATE TABLE t (
+            value TEXT UNIQUE NOT NULL ON CONFLICT REPLACE
+        )
+    """
+    assert parse_unique_constraints(sql) == [
+        UniqueConstraint(("value",), (None,))
+    ]
+
