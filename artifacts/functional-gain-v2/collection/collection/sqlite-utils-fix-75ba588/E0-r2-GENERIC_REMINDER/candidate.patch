+def _unique_constraint_sql(unique: UniqueConstraint) -> str:
+    prefix = f"CONSTRAINT {quote_identifier(unique.name)} " if unique.name else ""
+    columns = []
+    collations = unique.collations or (None,) * len(unique.columns)
+    for column, collation in zip(unique.columns, collations):
+        sql = quote_identifier(column)
+        if collation:
+            sql += f" COLLATE {quote_identifier(collation)}"
+        columns.append(sql)
+    conflict = f" ON CONFLICT {unique.conflict}" if unique.conflict else ""
+    return f"{prefix}UNIQUE ({', '.join(columns)}){conflict}"
+
