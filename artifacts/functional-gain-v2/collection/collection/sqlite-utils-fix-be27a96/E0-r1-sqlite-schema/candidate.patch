diff --git a/tests/test_foreign_keys.py b/tests/test_foreign_keys.py
index 1fabce75694889574a2d082fc493875b37c0b08b..8dd63cd9e60a11db046db06198476df4e0068f6f 100644
--- a/tests/test_foreign_keys.py
+++ b/tests/test_foreign_keys.py
@@ -41,6 +41,81 @@ def test_compound_foreign_key(compound_db):
     # Scalar column/other_column can't sensibly hold a compound key
     assert fk.column is None
     assert fk.other_column is None
+    assert fk.on_delete == "NO ACTION"
+    assert fk.on_update == "NO ACTION"
+
+
+@pytest.mark.parametrize("compound", (False, True))
+def test_foreign_key_actions_survive_transform(compound):
+    db = Database(memory=True)
+    db.executescript("""
+        CREATE TABLE parents (
+            a INTEGER,
+            b INTEGER,
+            PRIMARY KEY (a, b),
+            UNIQUE (a)
+        );
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            a INTEGER,
+            b INTEGER,
+            parent_a INTEGER REFERENCES parents(a)
+                ON DELETE SET NULL ON UPDATE CASCADE,
+            FOREIGN KEY (a, b) REFERENCES parents(a, b)
+                ON DELETE CASCADE ON UPDATE SET NULL
+        );
+        INSERT INTO parents VALUES (1, 2);
+        INSERT INTO children VALUES (1, 1, 2, 1);
+    """)
+    fk = next(fk for fk in db["children"].foreign_keys if fk.is_compound == compound)
+    assert (fk.on_delete, fk.on_update) == (
+        ("CASCADE", "SET NULL") if compound else ("SET NULL", "CASCADE")
+    )
+
+    db["children"].transform(rename={"id": "child_id"})
+
+    fk = next(fk for fk in db["children"].foreign_keys if fk.is_compound == compound)
+    assert (fk.on_delete, fk.on_update) == (
+        ("CASCADE", "SET NULL") if compound else ("SET NULL", "CASCADE")
+    )
+    assert list(db["children"].rows) == [
+        {"child_id": 1, "a": 1, "b": 2, "parent_a": 1}
+    ]
+
+    # Exercise the retained actions, not just their introspected values.
+    db.execute("PRAGMA foreign_keys = ON")
+    db.execute("UPDATE parents SET a = 3, b = 4 WHERE a = 1 AND b = 2")
+    assert list(db["children"].rows) == [
+        {"child_id": 1, "a": None, "b": None, "parent_a": 3}
+    ]
+    db.execute("DELETE FROM parents WHERE a = 3 AND b = 4")
+    assert list(db["children"].rows) == [
+        {"child_id": 1, "a": None, "b": None, "parent_a": None}
+    ]
+
+
+def test_create_table_foreign_key_actions(departments_db):
+    departments_db.create_table(
+        "courses",
+        {"course_code": str, "campus_name": str, "dept_code": str},
+        pk="course_code",
+        foreign_keys=[
+            ForeignKey(
+                "courses",
+                None,
+                "departments",
+                None,
+                columns=["campus_name", "dept_code"],
+                other_columns=["campus_name", "dept_code"],
+                is_compound=True,
+                on_delete="CASCADE",
+                on_update="SET NULL",
+            )
+        ],
+    )
+    fk = departments_db["courses"].foreign_keys[0]
+    assert fk.on_delete == "CASCADE"
+    assert fk.on_update == "SET NULL"
 
 
