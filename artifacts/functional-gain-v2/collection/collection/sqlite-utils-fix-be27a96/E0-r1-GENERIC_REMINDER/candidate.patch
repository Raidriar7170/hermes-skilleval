     # No separate single-column indexes for the members
     assert ["campus_name"] not in index_columns
     assert ["dept_code"] not in index_columns
+
+
+def test_foreign_key_actions_default_to_no_action(fresh_db):
+    fresh_db.executescript("""
+        CREATE TABLE authors (id INTEGER PRIMARY KEY);
+        CREATE TABLE books (
+            id INTEGER PRIMARY KEY,
+            author_id INTEGER REFERENCES authors(id)
+        );
+    """)
+    fk = fresh_db["books"].foreign_keys[0]
+    assert fk.on_delete == "NO ACTION"
+    assert fk.on_update == "NO ACTION"
+
+
+def test_create_table_with_foreign_key_actions(fresh_db):
+    fresh_db.create_table("authors", {"id": int}, pk="id")
+    fresh_db.create_table(
+        "books",
+        {"id": int, "author_id": int},
+        pk="id",
+        foreign_keys=[
+            ForeignKey(
+                "books",
+                "author_id",
+                "authors",
+                "id",
+                on_delete="CASCADE",
+                on_update="SET NULL",
+            )
+        ],
+    )
+    fk = fresh_db["books"].foreign_keys[0]
+    assert fk.on_delete == "CASCADE"
+    assert fk.on_update == "SET NULL"
+    assert "ON DELETE CASCADE ON UPDATE SET NULL" in fresh_db["books"].schema
+
+
+def test_transform_preserves_foreign_key_actions_and_data(fresh_db):
+    fresh_db.executescript("""
+        CREATE TABLE authors (id INTEGER PRIMARY KEY);
+        CREATE TABLE books (
+            id INTEGER PRIMARY KEY,
+            title TEXT,
+            author_id INTEGER REFERENCES authors(id)
+                ON DELETE CASCADE ON UPDATE SET NULL
+        );
+        INSERT INTO authors VALUES (1);
+        INSERT INTO books VALUES (1, 'One', 1);
+    """)
+    fresh_db.execute("PRAGMA foreign_keys = ON")
+    fresh_db["books"].transform(rename={"title": "name"})
+    fk = fresh_db["books"].foreign_keys[0]
+    assert fk.on_delete == "CASCADE"
+    assert fk.on_update == "SET NULL"
+    assert list(fresh_db["books"].rows) == [
+        {"id": 1, "name": "One", "author_id": 1}
+    ]
+    fresh_db.execute("UPDATE authors SET id = 2 WHERE id = 1")
+    assert fresh_db["books"].get(1)["author_id"] is None
+
+
+def test_compound_foreign_key_actions_survive_transform():
+    db = Database(memory=True)
+    db.executescript("""
+        CREATE TABLE departments (
+            campus TEXT,
+            code TEXT,
+            PRIMARY KEY (campus, code)
+        );
+        CREATE TABLE courses (
+            id INTEGER PRIMARY KEY,
+            campus TEXT,
+            code TEXT,
+            title TEXT,
+            FOREIGN KEY (campus, code) REFERENCES departments(campus, code)
+                ON DELETE SET NULL ON UPDATE CASCADE
+        );
+        INSERT INTO departments VALUES ('north', 'math');
+        INSERT INTO courses VALUES (1, 'north', 'math', 'Algebra');
+    """)
+    db.execute("PRAGMA foreign_keys = ON")
+    fk = db["courses"].foreign_keys[0]
+    assert fk.on_delete == "SET NULL"
+    assert fk.on_update == "CASCADE"
+
+    db["courses"].transform(rename={"title": "name"})
+
+    fk = db["courses"].foreign_keys[0]
+    assert fk.is_compound is True
+    assert fk.on_delete == "SET NULL"
+    assert fk.on_update == "CASCADE"
+    assert list(db["courses"].rows) == [
+        {"id": 1, "campus": "north", "code": "math", "name": "Algebra"}
+    ]
+    db.execute(
+        "UPDATE departments SET campus = 'south' "
+        "WHERE campus = 'north' AND code = 'math'"
+    )
+    assert db["courses"].get(1)["campus"] == "south"
+    db.execute("DELETE FROM departments WHERE campus = 'south' AND code = 'math'")
+    row = db["courses"].get(1)
+    assert row["campus"] is None
+    assert row["code"] is None
