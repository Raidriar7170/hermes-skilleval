+
+def test_foreign_key_actions_create_introspect_and_transform(fresh_db):
+    fresh_db.execute("PRAGMA foreign_keys = ON")
+    fresh_db["authors"].create({"id": int, "name": str}, pk="id")
+    fresh_db["books"].create(
+        {"id": int, "author_id": int, "title": str},
+        pk="id",
+        foreign_keys=[
+            ForeignKey(
+                "books",
+                "author_id",
+                "authors",
+                "id",
+                on_delete="CASCADE",
+                on_update="SET NULL",
+            )
+        ],
+    )
+    fresh_db["authors"].insert({"id": 1, "name": "A"})
+    fresh_db["authors"].insert({"id": 2, "name": "B"})
+    fresh_db["books"].insert({"id": 1, "author_id": 1, "title": "T"})
+    fresh_db["books"].insert({"id": 2, "author_id": 2, "title": "U"})
+
+    fresh_db["books"].transform(rename={"title": "name"})
+
+    fk = fresh_db["books"].foreign_keys[0]
+    assert fk.on_delete == "CASCADE"
+    assert fk.on_update == "SET NULL"
+    assert list(fresh_db["books"].rows) == [
+        {"id": 1, "author_id": 1, "name": "T"},
+        {"id": 2, "author_id": 2, "name": "U"},
+    ]
+    fresh_db["authors"].delete(1)
+    fresh_db["authors"].update(2, {"id": 3})
+    assert list(fresh_db["books"].rows) == [
+        {"id": 2, "author_id": None, "name": "U"}
+    ]
+
+
+def test_compound_foreign_key_actions_survive_transform(compound_db):
+    compound_db.execute("PRAGMA foreign_keys = ON")
+    compound_db.execute("DROP TABLE courses")
+    compound_db.execute(
+        """CREATE TABLE courses (
+            course_code TEXT PRIMARY KEY,
+            campus_name TEXT,
+            dept_code TEXT,
+            FOREIGN KEY (campus_name, dept_code)
+                REFERENCES departments(campus_name, dept_code)
+                ON DELETE SET NULL ON UPDATE CASCADE
+        )"""
+    )
+    compound_db["departments"].insert(
+        {"campus_name": "North", "dept_code": "CS", "dept_name": "Computing"}
+    )
+    compound_db["courses"].insert(
+        {"course_code": "101", "campus_name": "North", "dept_code": "CS"}
+    )
+
+    compound_db["courses"].transform(rename={"course_code": "code"})
+
+    fk = compound_db["courses"].foreign_keys[0]
+    assert fk.on_delete == "SET NULL"
+    assert fk.on_update == "CASCADE"
+    assert list(compound_db["courses"].rows) == [
+        {"code": "101", "campus_name": "North", "dept_code": "CS"}
+    ]
+    compound_db["departments"].update(
+        ("North", "CS"), {"campus_name": "South", "dept_code": "SE"}
+    )
+    assert compound_db["courses"].get("101") == {
+        "code": "101",
+        "campus_name": "South",
+        "dept_code": "SE",
+    }
+    compound_db["departments"].delete(("South", "SE"))
+    assert compound_db["courses"].get("101") == {
+        "code": "101",
+        "campus_name": None,
+        "dept_code": None,
+    }
 
 
