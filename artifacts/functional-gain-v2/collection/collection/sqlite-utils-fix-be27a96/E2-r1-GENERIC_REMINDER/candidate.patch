+@pytest.mark.parametrize("compound", (False, True))
+def test_db_add_foreign_keys_preserves_actions(departments_db, compound):
+    departments_db.create_table(
+        "courses",
+        {"campus_name": str, "dept_code": str},
+    )
+    fk = ForeignKey(
+        "courses",
+        None if compound else "campus_name",
+        "departments",
+        None if compound else "campus_name",
+        columns=["campus_name", "dept_code"] if compound else [],
+        other_columns=["campus_name", "dept_code"] if compound else [],
+        is_compound=compound,
+        on_delete="CASCADE",
+        on_update="RESTRICT",
+    )
+    departments_db.add_foreign_keys([fk])
+    introspected = departments_db["courses"].foreign_keys[0]
+    assert introspected.on_delete == "CASCADE"
+    assert introspected.on_update == "RESTRICT"
+
+
 def test_index_foreign_keys_compound_creates_composite_index(compound_db):
     compound_db.index_foreign_keys()
     index_columns = [i.columns for i in compound_db["courses"].indexes]
@@ -324,3 +347,89 @@ def test_index_foreign_keys_compound_creates_composite_index(compound_db):
     # No separate single-column indexes for the members
     assert ["campus_name"] not in index_columns
     assert ["dept_code"] not in index_columns
+
