+@pytest.mark.parametrize("compound", (False, True))
+def test_foreign_key_actions_survive_transform(compound):
+    db = Database(memory=True)
+    db.executescript(
+        """
+        PRAGMA foreign_keys = ON;
+        CREATE TABLE parents (a INTEGER, b INTEGER, PRIMARY KEY (a, b));
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            a INTEGER,
+            b INTEGER,
+            note TEXT,
+            FOREIGN KEY (a, b) REFERENCES parents(a, b)
+                ON DELETE CASCADE ON UPDATE SET NULL
+        );
+        """
+        if compound
+        else """
+        PRAGMA foreign_keys = ON;
+        CREATE TABLE parents (id INTEGER PRIMARY KEY);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES parents(id)
+                ON DELETE CASCADE ON UPDATE SET NULL,
+            note TEXT
+        );
+        """
+    )
+    db["parents"].insert({"a": 1, "b": 2} if compound else {"id": 1})
+    child = {"id": 1, "note": "retained"}
+    child.update({"a": 1, "b": 2} if compound else {"parent_id": 1})
+    db["children"].insert(child)
+
+    fk = db["children"].foreign_keys[0]
+    assert fk.on_delete == "CASCADE"
+    assert fk.on_update == "SET NULL"
+    db["children"].transform(rename={"note": "description"})
+
+    fk = db["children"].foreign_keys[0]
+    assert fk.on_delete == "CASCADE"
+    assert fk.on_update == "SET NULL"
+    assert db["children"].get(1)["description"] == "retained"
+    if compound:
+        db["parents"].update((1, 2), {"a": 3})
+        assert db["children"].get(1)["a"] is None
+        assert db["children"].get(1)["b"] is None
+    else:
+        db["parents"].delete(1)
+        assert db["children"].count == 0
+
+
+def test_foreign_key_action_defaults_and_create_table_sql(departments_db):
+    fk = ForeignKey(
+        "courses",
+        None,
+        "departments",
+        None,
+        columns=["campus_name", "dept_code"],
+        other_columns=["campus_name", "dept_code"],
+        is_compound=True,
+        on_delete="CASCADE",
+        on_update="RESTRICT",
+    )
+    assert ForeignKey("t", "parent_id", "parents", "id").on_delete == "NO ACTION"
+    departments_db.create_table(
+        "courses",
+        {"campus_name": str, "dept_code": str},
+        foreign_keys=[fk],
+    )
+    introspected = departments_db["courses"].foreign_keys[0]
+    assert introspected.on_delete == "CASCADE"
+    assert introspected.on_update == "RESTRICT"
+
+
+def test_foreign_key_actions_are_normalized_and_validated():
+    fk = ForeignKey(
+        "children", "parent_id", "parents", "id", on_delete="cascade"
+    )
+    assert fk.on_delete == "CASCADE"
+    assert fk.on_update == "NO ACTION"
+    with pytest.raises(ValueError, match="Invalid ON UPDATE action"):
+        ForeignKey(
+            "children", "parent_id", "parents", "id", on_update="SOMETHING ELSE"
+        )
