+def test_compound_foreign_key_actions_survive_transform_and_retain_data(
+    departments_db,
+):
+    departments_db.execute("PRAGMA foreign_keys = ON")
+    departments_db["courses"].create(
+        {"course_code": str, "campus_name": str, "dept_code": str},
+        pk="course_code",
+        foreign_keys=[
+            ForeignKey(
+                "courses",
+                None,
+                "departments",
+                None,
+                columns=["campus_name", "dept_code"],
+                other_columns=["campus_name", "dept_code"],
+                is_compound=True,
+                on_delete="CASCADE",
+                on_update="CASCADE",
+            )
+        ],
+    )
+    departments_db["departments"].insert(
+        {"campus_name": "North", "dept_code": "CS", "dept_name": "Computing"}
+    )
+    departments_db["courses"].insert(
+        {"course_code": "101", "campus_name": "North", "dept_code": "CS"}
+    )
+
+    departments_db["courses"].transform(rename={"course_code": "code"})
+
+    fk = departments_db["courses"].foreign_keys[0]
+    assert fk.on_delete == "CASCADE"
+    assert fk.on_update == "CASCADE"
+    assert dict(departments_db["courses"].get("101")) == {
+        "code": "101",
+        "campus_name": "North",
+        "dept_code": "CS",
+    }
+    departments_db.execute(
+        "UPDATE departments SET dept_code = 'EE' WHERE campus_name = 'North'"
+    )
+    assert departments_db["courses"].get("101")["dept_code"] == "EE"
+    departments_db["departments"].delete(("North", "EE"))
+    assert departments_db["courses"].count == 0
+
+
