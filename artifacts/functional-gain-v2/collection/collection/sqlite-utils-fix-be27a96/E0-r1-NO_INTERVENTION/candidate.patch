+def test_foreign_key_actions_survive_transform_and_retain_data():
+    db = Database(memory=True)
+    db.execute("PRAGMA foreign_keys = ON")
+    db["authors"].create({"id": int, "name": str}, pk="id")
+    db["books"].create(
+        {"id": int, "title": str, "author_id": int},
+        pk="id",
+        foreign_keys=[
+            ForeignKey(
+                "books",
+                "author_id",
+                "authors",
+                "id",
+                on_delete="set null",
+                on_update="cascade",
+            )
+        ],
+    )
+    db["authors"].insert({"id": 1, "name": "A"})
+    db["books"].insert({"id": 1, "title": "Book", "author_id": 1})
+
+    db["books"].transform(rename={"title": "name"})
+
+    fk = db["books"].foreign_keys[0]
+    assert fk.on_delete == "SET NULL"
+    assert fk.on_update == "CASCADE"
+    assert dict(db["books"].get(1)) == {"id": 1, "name": "Book", "author_id": 1}
+    db.execute("UPDATE authors SET id = 2 WHERE id = 1")
+    assert db["books"].get(1)["author_id"] == 2
+    db["authors"].delete(2)
+    assert db["books"].get(1)["author_id"] is None
 
 
