+@pytest.mark.parametrize("on_delete", ("CASCADE", "SET NULL", "SET DEFAULT"))
+def test_transform_in_transaction_refuses_destructive_inbound_foreign_key(
+    fresh_db, on_delete
+):
+    fresh_db.conn.execute("PRAGMA foreign_keys=ON")
+    fresh_db.executescript(
+        """
+        CREATE TABLE authors (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE books (
+            id INTEGER PRIMARY KEY,
+            author_id INTEGER DEFAULT 2
+                REFERENCES authors(id) ON DELETE {}
+        );
+        INSERT INTO authors VALUES (1, 'Ursula K. Le Guin');
+        INSERT INTO authors VALUES (2, 'Octavia E. Butler');
+        INSERT INTO books VALUES (1, 1);
+        """.format(on_delete)
+    )
+    original_schemas = (fresh_db["authors"].schema, fresh_db["books"].schema)
+    fresh_db.conn.execute("BEGIN")
+
+    with pytest.raises(TransactionError) as ex:
+        fresh_db["authors"].transform(rename={"name": "author_name"})
+
+    assert "books" in str(ex.value)
+    assert "ON DELETE {}".format(on_delete) in str(ex.value)
+    assert fresh_db.conn.in_transaction
+    assert (fresh_db["authors"].schema, fresh_db["books"].schema) == original_schemas
+    assert list(fresh_db["authors"].rows) == [
+        {"id": 1, "name": "Ursula K. Le Guin"},
+        {"id": 2, "name": "Octavia E. Butler"},
+    ]
+    assert list(fresh_db["books"].rows) == [{"id": 1, "author_id": 1}]
+    fresh_db.conn.rollback()
+
+
+@pytest.mark.parametrize("on_delete", ("CASCADE", "SET NULL", "SET DEFAULT"))
+def test_transform_in_transaction_refuses_destructive_self_reference(
+    fresh_db, on_delete
+):
+    fresh_db.conn.execute("PRAGMA foreign_keys=ON")
+    fresh_db.executescript(
+        """
+        CREATE TABLE people (
+            id INTEGER PRIMARY KEY,
+            name TEXT,
+            parent_id INTEGER DEFAULT 1
+                REFERENCES people(id) ON DELETE {}
+        );
+        INSERT INTO people VALUES (1, 'Parent', NULL);
+        INSERT INTO people VALUES (2, 'Child', 1);
+        """.format(on_delete)
+    )
+    original_schema = fresh_db["people"].schema
+    fresh_db.conn.execute("BEGIN")
+
+    with pytest.raises(TransactionError) as ex:
+        fresh_db["people"].transform(rename={"name": "full_name"})
+
+    assert "people" in str(ex.value)
+    assert "ON DELETE {}".format(on_delete) in str(ex.value)
+    assert fresh_db["people"].schema == original_schema
+    assert list(fresh_db["people"].rows) == [
+        {"id": 1, "name": "Parent", "parent_id": None},
+        {"id": 2, "name": "Child", "parent_id": 1},
+    ]
+    fresh_db.conn.rollback()
+
+
