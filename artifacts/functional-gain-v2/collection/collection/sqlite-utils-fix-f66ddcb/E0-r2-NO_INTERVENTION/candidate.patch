+@pytest.mark.parametrize("action", ("CASCADE", "SET NULL", "SET DEFAULT"))
+def test_transform_destructive_inbound_foreign_key_in_transaction(fresh_db, action):
+    fresh_db.executescript(
+        """
+        PRAGMA foreign_keys=ON;
+        CREATE TABLE parents (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER DEFAULT 1
+                REFERENCES parents(id) ON DELETE {}
+        );
+        """.format(action)
+    )
+    fresh_db["parents"].insert({"id": 1, "name": "one"})
+    fresh_db["children"].insert({"id": 1, "parent_id": 1})
+    original_schema = fresh_db["parents"].schema
+    fresh_db.conn.execute("BEGIN")
+
+    with pytest.raises(TransactionError) as ex:
+        fresh_db["parents"].transform(rename={"name": "label"})
+
+    assert "children" in str(ex.value)
+    assert "ON DELETE {}".format(action) in str(ex.value)
+    assert fresh_db["parents"].schema == original_schema
+    assert list(fresh_db["parents"].rows) == [{"id": 1, "name": "one"}]
+    assert list(fresh_db["children"].rows) == [{"id": 1, "parent_id": 1}]
+
+
+def test_transform_self_referential_destructive_foreign_key_in_transaction(fresh_db):
+    fresh_db.executescript(
+        """
+        PRAGMA foreign_keys=ON;
+        CREATE TABLE nodes (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES nodes(id) ON DELETE CASCADE,
+            name TEXT
+        );
+        """
+    )
+    fresh_db["nodes"].insert_all(
+        [
+            {"id": 1, "parent_id": None, "name": "root"},
+            {"id": 2, "parent_id": 1, "name": "child"},
+        ]
+    )
+    fresh_db.conn.execute("BEGIN")
+
+    with pytest.raises(TransactionError, match="table 'nodes'.*ON DELETE CASCADE"):
+        fresh_db["nodes"].transform(rename={"name": "label"})
+
+    assert list(fresh_db["nodes"].rows) == [
+        {"id": 1, "parent_id": None, "name": "root"},
+        {"id": 2, "parent_id": 1, "name": "child"},
+    ]
+
+
+@pytest.mark.parametrize(
+    "foreign_keys_on,table_to_transform,on_delete",
+    (
+        (True, "parents", "NO ACTION"),
+        (True, "parents", "RESTRICT"),
+        (True, "children", "CASCADE"),
+        (False, "parents", "CASCADE"),
+    ),
+)
+def test_transform_safe_foreign_key_cases_in_transaction(
+    fresh_db, foreign_keys_on, table_to_transform, on_delete
+):
+    fresh_db.executescript(
+        """
+        CREATE TABLE parents (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES parents(id) ON DELETE {}
+        );
+        """.format(on_delete)
+    )
+    fresh_db.conn.execute(
+        "PRAGMA foreign_keys={}".format("ON" if foreign_keys_on else "OFF")
+    )
+    fresh_db["parents"].insert({"id": 1, "name": "one"})
+    fresh_db["children"].insert({"id": 1, "parent_id": 1})
+    fresh_db.conn.execute("BEGIN")
+
+    fresh_db[table_to_transform].transform()
+
+    assert list(fresh_db["parents"].rows) == [{"id": 1, "name": "one"}]
+    assert list(fresh_db["children"].rows) == [{"id": 1, "parent_id": 1}]
+
+
