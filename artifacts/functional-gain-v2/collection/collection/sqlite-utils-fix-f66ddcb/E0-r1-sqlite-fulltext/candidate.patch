+@pytest.mark.parametrize("action", ("CASCADE", "SET NULL", "SET DEFAULT"))
+def test_transform_in_transaction_refuses_destructive_inbound_foreign_key(
+    fresh_db, action
+):
+    fresh_db.executescript(
+        """
+        CREATE TABLE parent (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE child (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER DEFAULT 1,
+            FOREIGN KEY (parent_id) REFERENCES parent(id) ON DELETE {}
+        );
+        INSERT INTO parent VALUES (1, 'one');
+        INSERT INTO child VALUES (1, 1);
+        """.format(action)
+    )
+    fresh_db.execute("PRAGMA foreign_keys = ON")
+    original_schema = fresh_db["parent"].schema
+
+    with fresh_db.atomic():
+        with pytest.raises(TransactionError) as exc:
+            fresh_db["parent"].transform(types={"name": str})
+        assert "table 'child'" in str(exc.value)
+        assert "ON DELETE {}".format(action) in str(exc.value)
+        assert fresh_db["parent"].schema == original_schema
+        assert list(fresh_db["child"].rows) == [{"id": 1, "parent_id": 1}]
+
+
+def test_transform_in_transaction_refuses_destructive_self_reference(fresh_db):
+    fresh_db.executescript(
+        """
+        CREATE TABLE nodes (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER,
+            name TEXT,
+            FOREIGN KEY (parent_id) REFERENCES nodes(id) ON DELETE CASCADE
+        );
+        INSERT INTO nodes VALUES (1, NULL, 'root');
+        INSERT INTO nodes VALUES (2, 1, 'child');
+        """
+    )
+    fresh_db.execute("PRAGMA foreign_keys = ON")
+
+    with fresh_db.atomic():
+        with pytest.raises(TransactionError, match="table 'nodes'.*ON DELETE CASCADE"):
+            fresh_db["nodes"].transform(types={"name": str})
+        assert fresh_db["nodes"].count == 2
+
+
+def test_transform_in_transaction_allows_non_destructive_inbound_key(fresh_db):
+    fresh_db.executescript(
+        """
+        CREATE TABLE parent (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE child (
+            parent_id INTEGER REFERENCES parent(id) ON DELETE NO ACTION
+        );
+        INSERT INTO parent VALUES (42, 'one');
+        INSERT INTO child VALUES (42);
+        """
+    )
+    fresh_db.execute("PRAGMA foreign_keys = ON")
+
+    with fresh_db.atomic():
+        fresh_db["parent"].transform(types={"name": str})
+        assert list(fresh_db.query("SELECT rowid AS original_rowid, * FROM parent")) == [
+            {"original_rowid": 42, "id": 42, "name": "one"}
+        ]
+
+
+def test_transform_in_transaction_allows_destructive_outbound_key(fresh_db):
+    fresh_db.executescript(
+        """
+        CREATE TABLE parent (id INTEGER PRIMARY KEY);
+        CREATE TABLE child (
+            parent_id INTEGER REFERENCES parent(id) ON DELETE CASCADE,
+            name TEXT
+        );
+        INSERT INTO parent VALUES (1);
+        INSERT INTO child (rowid, parent_id, name) VALUES (37, 1, 'one');
+        """
+    )
+    fresh_db.execute("PRAGMA foreign_keys = ON")
+
+    with fresh_db.atomic():
+        fresh_db["child"].transform(types={"name": str})
+        assert list(fresh_db.query("SELECT rowid, * FROM child")) == [
+            {"rowid": 37, "parent_id": 1, "name": "one"}
+        ]
+
+
+def test_transform_in_transaction_allows_destructive_inbound_key_if_disabled(
+    fresh_db,
