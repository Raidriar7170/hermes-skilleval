+@pytest.mark.parametrize("action", ("CASCADE", "SET NULL", "SET DEFAULT"))
+def test_transform_rejects_destructive_inbound_foreign_key_in_atomic(
+    fresh_db, action
+):
+    fresh_db.conn.execute("PRAGMA foreign_keys=ON")
+    fresh_db.executescript(
+        """
+        CREATE TABLE parents (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER DEFAULT 0
+                REFERENCES parents(id) ON DELETE {}
+        );
+        INSERT INTO parents VALUES (0, 'default'), (1, 'one');
+        INSERT INTO children VALUES (1, 1);
+        """.format(action)
+    )
+    original_schema = fresh_db["parents"].schema
+
+    with fresh_db.atomic():
+        with pytest.raises(TransactionError) as exc_info:
+            fresh_db["parents"].transform(rename={"name": "label"})
+        assert "children" in str(exc_info.value)
+        assert "ON DELETE {}".format(action) in str(exc_info.value)
+
+    assert fresh_db["parents"].schema == original_schema
+    assert list(fresh_db["children"].rows) == [{"id": 1, "parent_id": 1}]
+
+
+def test_transform_rejects_destructive_self_reference_in_atomic(fresh_db):
+    fresh_db.conn.execute("PRAGMA foreign_keys=ON")
+    fresh_db.executescript("""
+        CREATE TABLE nodes (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES nodes(id) ON DELETE CASCADE,
+            name TEXT
+        );
+        INSERT INTO nodes VALUES (1, NULL, 'root'), (2, 1, 'child');
+        """)
+
+    with fresh_db.atomic():
+        with pytest.raises(TransactionError, match="nodes.*ON DELETE CASCADE"):
+            fresh_db["nodes"].transform(rename={"name": "label"})
+
+    assert list(fresh_db["nodes"].rows) == [
+        {"id": 1, "parent_id": None, "name": "root"},
+        {"id": 2, "parent_id": 1, "name": "child"},
+    ]
+
+
+@pytest.mark.parametrize("action", ("NO ACTION", "RESTRICT"))
+def test_transform_allows_non_destructive_inbound_foreign_key_in_atomic(
+    fresh_db, action
+):
+    fresh_db.conn.execute("PRAGMA foreign_keys=ON")
+    fresh_db.executescript(
+        """
+        CREATE TABLE parents (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES parents(id) ON DELETE {}
+        );
+        INSERT INTO parents VALUES (1, 'one');
+        INSERT INTO children VALUES (1, 1);
+        """.format(action)
+    )
+
+    with fresh_db.atomic():
+        fresh_db["parents"].transform(rename={"name": "label"})
+
+    assert list(fresh_db["parents"].rows) == [{"id": 1, "label": "one"}]
+    assert list(fresh_db["children"].rows) == [{"id": 1, "parent_id": 1}]
+
+
+def test_transform_allows_child_only_destructive_foreign_key_in_atomic(fresh_db):
+    fresh_db.conn.execute("PRAGMA foreign_keys=ON")
+    fresh_db.executescript("""
+        CREATE TABLE parents (id INTEGER PRIMARY KEY);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES parents(id) ON DELETE CASCADE,
+            name TEXT
+        );
+        INSERT INTO parents VALUES (1);
+        INSERT INTO children VALUES (1, 1, 'child');
+        """)
+
+    with fresh_db.atomic():
+        fresh_db["children"].transform(rename={"name": "label"})
+
+    assert list(fresh_db["children"].rows) == [
+        {"id": 1, "parent_id": 1, "label": "child"}
+    ]
+
+
+def test_transform_allows_destructive_inbound_key_with_foreign_keys_off(fresh_db):
+    fresh_db.executescript("""
+        CREATE TABLE parents (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES parents(id) ON DELETE CASCADE
+        );
+        INSERT INTO parents VALUES (1, 'one');
+        INSERT INTO children VALUES (1, 1);
+        """)
+
+    with fresh_db.atomic():
+        fresh_db["parents"].transform(rename={"name": "label"})
+
+    assert list(fresh_db["parents"].rows) == [{"id": 1, "label": "one"}]
+    assert list(fresh_db["children"].rows) == [{"id": 1, "parent_id": 1}]
+
