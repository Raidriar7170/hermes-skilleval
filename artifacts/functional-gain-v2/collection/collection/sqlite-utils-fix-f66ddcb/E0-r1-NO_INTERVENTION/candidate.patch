+@pytest.mark.parametrize("on_delete", ("CASCADE", "SET NULL", "SET DEFAULT"))
+def test_transform_in_transaction_refuses_destructive_inbound_foreign_key(
+    fresh_db, on_delete
+):
+    fresh_db.execute("PRAGMA foreign_keys=ON")
+    fresh_db.executescript(
+        """
+        CREATE TABLE parents (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER DEFAULT 1
+                REFERENCES parents(id) ON DELETE {}
+        );
+        INSERT INTO parents VALUES (1, 'Parent');
+        INSERT INTO children VALUES (1, 1);
+        """.format(on_delete)
+    )
+    original_schema = fresh_db["parents"].schema
+    original_rows = list(fresh_db.query("SELECT rowid AS _rowid_, * FROM parents"))
+    original_children = list(fresh_db["children"].rows)
+
+    fresh_db.execute("BEGIN")
+    with pytest.raises(TransactionError) as ex:
+        fresh_db["parents"].transform(rename={"name": "display_name"})
+
+    assert "children" in str(ex.value)
+    assert "ON DELETE {}".format(on_delete) in str(ex.value)
+    assert fresh_db["parents"].schema == original_schema
+    assert (
+        list(fresh_db.query("SELECT rowid AS _rowid_, * FROM parents"))
+        == original_rows
+    )
+    assert list(fresh_db["children"].rows) == original_children
+    fresh_db.conn.rollback()
+
+
+def test_transform_in_transaction_refuses_destructive_self_reference(fresh_db):
+    fresh_db.execute("PRAGMA foreign_keys=ON")
+    fresh_db.executescript("""
+        CREATE TABLE nodes (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES nodes(id) ON DELETE CASCADE,
+            name TEXT
+        );
+        INSERT INTO nodes VALUES (1, NULL, 'Root');
+        INSERT INTO nodes VALUES (2, 1, 'Child');
+        """)
+    original_schema = fresh_db["nodes"].schema
+    original_rows = list(
+        fresh_db.query("SELECT rowid AS _rowid_, * FROM nodes ORDER BY id")
+    )
+
+    fresh_db.execute("BEGIN")
+    with pytest.raises(TransactionError) as ex:
+        fresh_db["nodes"].transform(rename={"name": "label"})
+
+    assert 'table "nodes" has an ON DELETE CASCADE' in str(ex.value)
+    assert fresh_db["nodes"].schema == original_schema
+    assert (
+        list(
+            fresh_db.query("SELECT rowid AS _rowid_, * FROM nodes ORDER BY id")
+        )
+        == original_rows
+    )
+    fresh_db.conn.rollback()
+
+
+@pytest.mark.parametrize(
+    "foreign_keys,on_delete", ((False, "CASCADE"), (True, "NO ACTION"))
+)
+def test_transform_in_transaction_allows_non_destructive_inbound_foreign_key(
+    fresh_db, foreign_keys, on_delete
+):
+    fresh_db.execute("PRAGMA foreign_keys={}".format("ON" if foreign_keys else "OFF"))
+    fresh_db.executescript("""
+        CREATE TABLE parents (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES parents(id) ON DELETE {}
+        );
+        INSERT INTO parents VALUES (1, 'Parent');
+        INSERT INTO children VALUES (1, 1);
+        """.format(on_delete)
+    )
+    fresh_db.execute("BEGIN")
+    fresh_db["parents"].transform(rename={"name": "display_name"})
+    assert list(fresh_db.query("SELECT rowid AS _rowid_, * FROM parents")) == [
+        {"_rowid_": 1, "id": 1, "display_name": "Parent"}
+    ]
+    assert list(fresh_db["children"].rows) == [{"id": 1, "parent_id": 1}]
+    fresh_db.conn.rollback()
+
+
+def test_transform_in_transaction_allows_child_only_outbound_foreign_key(fresh_db):
+    fresh_db.execute("PRAGMA foreign_keys=ON")
+    fresh_db.executescript("""
+        CREATE TABLE parents (id INTEGER PRIMARY KEY);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES parents(id) ON DELETE CASCADE,
+            name TEXT
+        );
+        INSERT INTO parents VALUES (1);
+        INSERT INTO children VALUES (1, 1, 'Child');
+        """)
+    fresh_db.execute("BEGIN")
+    fresh_db["children"].transform(rename={"name": "display_name"})
+    assert list(fresh_db.query("SELECT rowid AS _rowid_, * FROM children")) == [
+        {"_rowid_": 1, "id": 1, "parent_id": 1, "display_name": "Child"}
+    ]
+    fresh_db.conn.rollback()
+
