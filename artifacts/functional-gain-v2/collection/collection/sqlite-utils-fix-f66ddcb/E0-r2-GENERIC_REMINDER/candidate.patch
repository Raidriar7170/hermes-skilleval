+@pytest.mark.parametrize("action", ["CASCADE", "SET NULL", "SET DEFAULT"])
+def test_transform_in_transaction_refuses_destructive_inbound_foreign_key(
+    fresh_db, action
+):
+    fresh_db.executescript(
+        """
+        PRAGMA foreign_keys=ON;
+        CREATE TABLE parents (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER DEFAULT 1
+                REFERENCES parents(id) ON DELETE {}
+        );
+        INSERT INTO parents VALUES (1, 'one');
+        INSERT INTO children VALUES (1, 1);
+        """.format(action)
+    )
+    schemas_before = dict(fresh_db.execute(
+        "SELECT name, sql FROM sqlite_master WHERE type = 'table'"
+    ).fetchall())
+
+    fresh_db.conn.execute("BEGIN")
+    with pytest.raises(TransactionError) as excinfo:
+        fresh_db["parents"].transform(rename={"name": "label"})
+
+    assert "children" in str(excinfo.value)
+    assert "ON DELETE {}".format(action) in str(excinfo.value)
+    assert dict(fresh_db.execute(
+        "SELECT name, sql FROM sqlite_master WHERE type = 'table'"
+    ).fetchall()) == schemas_before
+    assert list(fresh_db["parents"].rows) == [{"id": 1, "name": "one"}]
+    assert list(fresh_db["children"].rows) == [{"id": 1, "parent_id": 1}]
+    fresh_db.conn.rollback()
+
+
+def test_transform_in_transaction_refuses_destructive_self_reference(fresh_db):
+    fresh_db.executescript("""
+        PRAGMA foreign_keys=ON;
+        CREATE TABLE nodes (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES nodes(id) ON DELETE CASCADE,
+            name TEXT
+        );
+        INSERT INTO nodes VALUES (1, NULL, 'root');
+        INSERT INTO nodes VALUES (2, 1, 'child');
+        """)
+
+    fresh_db.conn.execute("BEGIN")
+    with pytest.raises(TransactionError, match="nodes.*ON DELETE CASCADE"):
+        fresh_db["nodes"].transform(rename={"name": "label"})
+    assert list(fresh_db["nodes"].rows) == [
+        {"id": 1, "parent_id": None, "name": "root"},
+        {"id": 2, "parent_id": 1, "name": "child"},
+    ]
+    fresh_db.conn.rollback()
+
+
+@pytest.mark.parametrize("action", ["NO ACTION", "RESTRICT"])
+def test_transform_in_transaction_allows_non_destructive_inbound_foreign_key(
+    fresh_db, action
+):
+    fresh_db.executescript(
+        """
+        PRAGMA foreign_keys=ON;
+        CREATE TABLE parents (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES parents(id) ON DELETE {}
+        );
+        INSERT INTO parents VALUES (1, 'one');
+        INSERT INTO children VALUES (1, 1);
+        """.format(action)
+    )
+
+    fresh_db.conn.execute("BEGIN")
+    fresh_db["parents"].transform(rename={"name": "label"})
+    assert list(fresh_db["parents"].rows) == [{"id": 1, "label": "one"}]
+    assert list(fresh_db["children"].rows) == [{"id": 1, "parent_id": 1}]
+    fresh_db.conn.rollback()
+
+
+def test_transform_in_transaction_allows_outbound_key_and_foreign_keys_off(fresh_db):
+    fresh_db.executescript("""
+        CREATE TABLE parents (id INTEGER PRIMARY KEY);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES parents(id) ON DELETE CASCADE,
+            name TEXT
+        );
+        INSERT INTO parents VALUES (1);
+        INSERT INTO children VALUES (1, 1, 'child');
+        """)
+    fresh_db.conn.execute("BEGIN")
+    fresh_db["children"].transform(rename={"name": "label"})
+    assert list(fresh_db["children"].rows) == [
+        {"id": 1, "parent_id": 1, "label": "child"}
+    ]
+    # foreign_keys is off, so transforming the referenced table is allowed too
+    fresh_db["parents"].transform()
+    assert list(fresh_db["children"].rows) == [
+        {"id": 1, "parent_id": 1, "label": "child"}
+    ]
+    fresh_db.conn.rollback()
+
+
+def test_transform_in_transaction_preserves_rowids(fresh_db):
+    fresh_db.executescript("""
+        PRAGMA foreign_keys=ON;
+        CREATE TABLE items (name TEXT, quantity INTEGER);
+        INSERT INTO items(rowid, name, quantity) VALUES (2, 'two', 2);
+        INSERT INTO items(rowid, name, quantity) VALUES (9, 'nine', 9);
+        """)
+
+    fresh_db.conn.execute("BEGIN")
+    fresh_db["items"].transform(types={"quantity": str})
+    assert [tuple(row) for row in fresh_db.execute(
+        "SELECT rowid, name, quantity FROM items ORDER BY rowid"
+    )] == [(2, "two", "2"), (9, "nine", "9")]
+    fresh_db.conn.rollback()
+
