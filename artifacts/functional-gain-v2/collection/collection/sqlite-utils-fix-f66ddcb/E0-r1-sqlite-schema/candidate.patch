+@pytest.mark.parametrize("on_delete", ("CASCADE", "SET NULL", "SET DEFAULT"))
+def test_transform_in_transaction_refuses_destructive_inbound_foreign_key(
+    fresh_db, on_delete
+):
+    fresh_db.execute("PRAGMA foreign_keys=ON")
+    fresh_db.execute("CREATE TABLE parent (id INTEGER PRIMARY KEY, name TEXT)")
+    fresh_db.execute(
+        "CREATE TABLE child (id INTEGER PRIMARY KEY, parent_id INTEGER DEFAULT 1 "
+        "REFERENCES parent(id) ON DELETE {})".format(on_delete)
+    )
+    fresh_db.execute("INSERT INTO parent VALUES (1, 'one')")
+    fresh_db.execute("INSERT INTO child VALUES (1, 1)")
+    fresh_db.conn.commit()
+    schema_before = fresh_db["parent"].schema
+    rows_before = list(fresh_db.query("SELECT rowid, * FROM child"))
+
+    fresh_db.execute("BEGIN")
+    with pytest.raises(TransactionError) as excinfo:
+        fresh_db["parent"].transform(types={"name": str})
+
+    assert "table 'child'" in str(excinfo.value)
+    assert "ON DELETE {}".format(on_delete) in str(excinfo.value)
+    assert fresh_db["parent"].schema == schema_before
+    assert list(fresh_db.query("SELECT rowid, * FROM child")) == rows_before
+    assert fresh_db.table_names() == ["parent", "child"]
+
+
+def test_transform_in_transaction_refuses_destructive_self_reference(fresh_db):
+    fresh_db.execute("PRAGMA foreign_keys=ON")
+    fresh_db.execute(
+        "CREATE TABLE node (id INTEGER PRIMARY KEY, parent_id INTEGER "
+        "REFERENCES node(id) ON DELETE CASCADE, name TEXT)"
+    )
+    fresh_db.execute("INSERT INTO node VALUES (1, NULL, 'root')")
+    fresh_db.execute("INSERT INTO node VALUES (2, 1, 'child')")
+    fresh_db.conn.commit()
+    rows_before = list(fresh_db.query("SELECT rowid, * FROM node"))
+
+    fresh_db.execute("BEGIN")
+    with pytest.raises(TransactionError, match="table 'node'.*ON DELETE CASCADE"):
+        fresh_db["node"].transform(types={"name": str})
+
+    assert list(fresh_db.query("SELECT rowid, * FROM node")) == rows_before
+
+
+@pytest.mark.parametrize("case", ("non_destructive_inbound", "outbound", "fk_off"))
+def test_transform_in_transaction_allowed_foreign_key_cases(fresh_db, case):
+    fresh_db.execute(
+        "PRAGMA foreign_keys={}".format("OFF" if case == "fk_off" else "ON")
+    )
+    fresh_db.execute("CREATE TABLE parent (id INTEGER PRIMARY KEY, name TEXT)")
+    action = "CASCADE" if case in ("outbound", "fk_off") else "NO ACTION"
+    fresh_db.execute(
+        "CREATE TABLE child (id INTEGER PRIMARY KEY, parent_id INTEGER "
+        "REFERENCES parent(id) ON DELETE {})".format(action)
+    )
+    fresh_db.execute("INSERT INTO parent VALUES (1, 'one')")
+    fresh_db.execute("INSERT INTO child VALUES (1, 1)")
+    fresh_db.conn.commit()
+    table_name = "child" if case == "outbound" else "parent"
+    rows_before = list(fresh_db.query("SELECT rowid, * FROM {}".format(table_name)))
+
+    fresh_db.execute("BEGIN")
+    fresh_db[table_name].transform(
+        column_order=("name",) if table_name == "parent" else None
+    )
+
+    assert (
+        list(fresh_db.query("SELECT rowid, * FROM {}".format(table_name)))
+        == rows_before
+    )
+    assert list(fresh_db["child"].rows) == [{"id": 1, "parent_id": 1}]
+
