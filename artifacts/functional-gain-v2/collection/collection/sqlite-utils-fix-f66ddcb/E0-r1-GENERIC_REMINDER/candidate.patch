+@pytest.mark.parametrize("action", ["CASCADE", "SET NULL", "SET DEFAULT"])
+def test_transform_in_transaction_refuses_destructive_inbound_foreign_key(
+    fresh_db, action
+):
+    fresh_db.conn.execute("PRAGMA foreign_keys=ON")
+    fresh_db.executescript(
+        """
+        CREATE TABLE parents (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE children (
+            parent_id INTEGER DEFAULT 1
+                REFERENCES parents(id) ON DELETE {}
+        );
+        """.format(action)
+    )
+    fresh_db["parents"].insert({"id": 1, "name": "one"})
+    fresh_db["children"].insert({"parent_id": 1})
+    original_schema = fresh_db["parents"].schema
+
+    fresh_db.conn.execute("BEGIN")
+    with pytest.raises(TransactionError) as exc:
+        fresh_db["parents"].transform(rename={"name": "label"})
+    assert "children" in str(exc.value)
+    assert "ON DELETE {}".format(action) in str(exc.value)
+    assert fresh_db["parents"].schema == original_schema
+    assert list(fresh_db["parents"].rows) == [{"id": 1, "name": "one"}]
+    assert list(fresh_db["children"].rows) == [{"parent_id": 1}]
+    assert fresh_db.execute("select rowid from parents").fetchone()[0] == 1
+    fresh_db.conn.rollback()
+
+
+@pytest.mark.parametrize(
+    "foreign_keys_on,action,transform_table",
+    [
+        (True, "NO ACTION", "parents"),
+        (True, "CASCADE", "children"),
+        (False, "CASCADE", "parents"),
+    ],
+)
+def test_transform_in_transaction_allows_safe_foreign_key_cases(
+    fresh_db, foreign_keys_on, action, transform_table
+):
+    fresh_db.conn.execute(
+        "PRAGMA foreign_keys={}".format("ON" if foreign_keys_on else "OFF")
+    )
+    fresh_db.executescript(
+        """
+        CREATE TABLE parents (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES parents(id) ON DELETE {}
+        );
+        INSERT INTO parents VALUES (7, 'seven');
+        INSERT INTO children VALUES (11, 7);
+        """.format(action)
+    )
+
+    fresh_db.conn.execute("BEGIN")
+    fresh_db[transform_table].transform(types={"id": int})
+    assert list(fresh_db["parents"].rows) == [{"id": 7, "name": "seven"}]
+    assert list(fresh_db["children"].rows) == [{"id": 11, "parent_id": 7}]
+    assert fresh_db.execute("select rowid from parents").fetchone()[0] == 7
+    assert fresh_db.execute("select rowid from children").fetchone()[0] == 11
+    fresh_db.conn.rollback()
+
+
+def test_transform_in_transaction_refuses_destructive_self_reference(fresh_db):
+    fresh_db.conn.execute("PRAGMA foreign_keys=ON")
+    fresh_db.executescript(
+        """
+        CREATE TABLE nodes (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES nodes(id) ON DELETE CASCADE
+        );
+        INSERT INTO nodes VALUES (1, NULL), (2, 1);
+        """
+    )
+    original_schema = fresh_db["nodes"].schema
+
+    fresh_db.conn.execute("BEGIN")
+    with pytest.raises(TransactionError) as exc:
+        fresh_db["nodes"].transform(rename={"parent_id": "ancestor_id"})
+    assert "nodes" in str(exc.value)
+    assert "ON DELETE CASCADE" in str(exc.value)
+    assert fresh_db["nodes"].schema == original_schema
+    assert list(fresh_db["nodes"].rows) == [
+        {"id": 1, "parent_id": None},
+        {"id": 2, "parent_id": 1},
+    ]
+    fresh_db.conn.rollback()
+
+
