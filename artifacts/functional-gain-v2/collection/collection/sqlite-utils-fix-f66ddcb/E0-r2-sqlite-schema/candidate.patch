+@pytest.mark.parametrize("on_delete", ("CASCADE", "SET NULL", "SET DEFAULT"))
+def test_transform_in_transaction_rejects_destructive_inbound_foreign_key(
+    fresh_db, on_delete
+):
+    fresh_db.execute("PRAGMA foreign_keys=ON")
+    fresh_db.executescript(
+        """
+        CREATE TABLE authors (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE books (
+            id INTEGER PRIMARY KEY,
+            author_id INTEGER DEFAULT 0
+                REFERENCES authors(id) ON DELETE {}
+        );
+        INSERT INTO authors VALUES (1, 'Ursula K. Le Guin');
+        INSERT INTO books VALUES (1, 1);
+        """.format(on_delete)
+    )
+    original_schema = fresh_db["authors"].schema
+    original_rows = list(fresh_db.execute("SELECT rowid, * FROM books"))
+
+    fresh_db.begin()
+    with pytest.raises(TransactionError) as ex:
+        fresh_db["authors"].transform(rename={"name": "author_name"})
+
+    assert "books" in str(ex.value)
+    assert on_delete in str(ex.value)
+    assert fresh_db["authors"].schema == original_schema
+    assert list(fresh_db.execute("SELECT rowid, * FROM books")) == original_rows
+    fresh_db.rollback()
+
+
+@pytest.mark.parametrize("on_delete", ("CASCADE", "SET NULL", "SET DEFAULT"))
+def test_transform_in_transaction_rejects_destructive_self_referential_key(
+    fresh_db, on_delete
+):
+    fresh_db.execute("PRAGMA foreign_keys=ON")
+    fresh_db.execute(
+        """CREATE TABLE nodes (
+            id INTEGER PRIMARY KEY,
+            name TEXT,
+            parent_id INTEGER DEFAULT 1
+                REFERENCES nodes(id) ON DELETE {}
+        )""".format(on_delete)
+    )
+    fresh_db["nodes"].insert_all(
+        ({"id": 1, "name": "root"}, {"id": 2, "name": "child", "parent_id": 1})
+    )
+    original_schema = fresh_db["nodes"].schema
+    original_rows = list(fresh_db.execute("SELECT rowid, * FROM nodes"))
+
+    fresh_db.begin()
+    with pytest.raises(TransactionError) as ex:
+        fresh_db["nodes"].transform(rename={"name": "label"})
+
+    assert "nodes" in str(ex.value)
+    assert on_delete in str(ex.value)
+    assert fresh_db["nodes"].schema == original_schema
+    assert list(fresh_db.execute("SELECT rowid, * FROM nodes")) == original_rows
+    fresh_db.rollback()
+
+
+@pytest.mark.parametrize("on_delete", ("NO ACTION", "RESTRICT"))
+def test_transform_in_transaction_allows_non_destructive_inbound_key(
+    fresh_db, on_delete
+):
+    fresh_db.execute("PRAGMA foreign_keys=ON")
+    fresh_db.executescript(
+        """
+        CREATE TABLE parents (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            parent_id INTEGER REFERENCES parents(id) ON DELETE {}
+        );
+        INSERT INTO parents VALUES (1, 'one');
+        INSERT INTO children VALUES (1, 1);
+        """.format(on_delete)
+    )
+    fresh_db.begin()
+    fresh_db["parents"].transform(rename={"name": "label"})
+    assert list(fresh_db["parents"].rows) == [{"id": 1, "label": "one"}]
+    assert list(fresh_db["children"].rows) == [{"id": 1, "parent_id": 1}]
+    fresh_db.rollback()
+
+
+def test_transform_in_transaction_allows_outbound_key_and_foreign_keys_off(fresh_db):
+    fresh_db.executescript(
+        """
+        CREATE TABLE parents (id INTEGER PRIMARY KEY);
+        CREATE TABLE children (
+            id INTEGER PRIMARY KEY,
+            name TEXT,
+            parent_id INTEGER REFERENCES parents(id) ON DELETE CASCADE
+        );
+        INSERT INTO parents VALUES (1);
+        INSERT INTO children VALUES (1, 'one', 1);
+        """
+    )
+    # A child-only outbound key is safe even with enforcement enabled.
+    fresh_db.execute("PRAGMA foreign_keys=ON")
+    fresh_db.begin()
+    fresh_db["children"].transform(rename={"name": "label"})
+    fresh_db.commit()
+    assert list(fresh_db["children"].rows) == [
+        {"id": 1, "label": "one", "parent_id": 1}
+    ]
+
+    # A destructive inbound key retains the existing behavior when disabled.
+    fresh_db.execute("PRAGMA foreign_keys=OFF")
+    fresh_db.begin()
+    fresh_db["parents"].transform(types={"id": int})
+    fresh_db.commit()
+    assert list(fresh_db["children"].rows) == [
+        {"id": 1, "label": "one", "parent_id": 1}
+    ]
+
