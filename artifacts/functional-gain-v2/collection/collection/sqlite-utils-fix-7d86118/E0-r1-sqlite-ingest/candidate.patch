+def test_failed_execute_write_does_not_leave_implicit_transaction(tmpdir):
+    path = str(tmpdir / "test.db")
+    db = Database(path)
+    db.execute("create table t (id integer primary key)")
+    with pytest.raises(sqlite3.IntegrityError):
+        db.execute("insert into t values (1), (1)")
+    assert not db.conn.in_transaction
+    db.execute("insert into t values (2)")
+    db.close()
+
+    reopened = Database(path)
+    assert [row["id"] for row in reopened["t"].rows] == [2]
+    reopened.close()
+
+
+@pytest.mark.parametrize("transaction", ["begin", "atomic"])
+def test_failed_execute_write_preserves_explicit_transaction(fresh_db, transaction):
+    fresh_db.execute("create table t (id integer primary key)")
+
+    def exercise():
+        fresh_db.execute("insert into t values (1)")
+        with pytest.raises(sqlite3.IntegrityError):
+            fresh_db.execute("insert into t values (2), (2)")
+        assert fresh_db.conn.in_transaction
+        fresh_db.execute("insert into t values (3)")
+
+    if transaction == "begin":
+        fresh_db.begin()
+        exercise()
+        fresh_db.commit()
+    else:
+        with fresh_db.atomic():
+            exercise()
+
+    assert [row["id"] for row in fresh_db["t"].rows] == [1, 3]
+
