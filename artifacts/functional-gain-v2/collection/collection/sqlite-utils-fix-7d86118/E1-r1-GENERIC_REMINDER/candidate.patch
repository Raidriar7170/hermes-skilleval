--- a/tests/test_atomic.py
+++ b/tests/test_atomic.py
@@ -247,6 +247,50 @@ def test_execute_write_respects_explicit_transaction(fresh_db):
     assert [r["id"] for r in fresh_db["t"].rows] == [1]
 
 
+def test_execute_failed_write_does_not_leave_implicit_transaction(tmpdir):
+    path = str(tmpdir / "test.db")
+    db = Database(path)
+    db["t"].insert({"id": 1}, pk="id")
+
+    with pytest.raises(sqlite3.IntegrityError):
+        db.execute("insert into t (id) values (1)")
+
+    assert not db.conn.in_transaction
+    db.execute("insert into t (id) values (2)")
+    db.close()
+
+    reopened = Database(path)
+    assert [row["id"] for row in reopened["t"].rows] == [1, 2]
+    reopened.close()
+
+
+def test_execute_failed_write_preserves_manual_transaction(fresh_db):
+    fresh_db["t"].insert({"id": 1}, pk="id")
+    fresh_db.begin()
+    fresh_db.execute("insert into t (id) values (2)")
+
+    with pytest.raises(sqlite3.IntegrityError):
+        fresh_db.execute("insert into t (id) values (1)")
+
+    assert fresh_db.conn.in_transaction
+    fresh_db.execute("insert into t (id) values (3)")
+    fresh_db.commit()
+    assert [row["id"] for row in fresh_db["t"].rows] == [1, 2, 3]
+
+
+def test_execute_failed_write_preserves_atomic_transaction(fresh_db):
+    fresh_db["t"].insert({"id": 1}, pk="id")
+
+    with fresh_db.atomic():
+        fresh_db.execute("insert into t (id) values (2)")
+        with pytest.raises(sqlite3.IntegrityError):
+            fresh_db.execute("insert into t (id) values (1)")
+        assert fresh_db.conn.in_transaction
+        fresh_db.execute("insert into t (id) values (3)")
+
+    assert [row["id"] for row in fresh_db["t"].rows] == [1, 2, 3]
+
+
