diff --git a/tests/test_extract.py b/tests/test_extract.py
index 1c0fa01eb84cb83057cd815a824624dc23c77fb2..c26b00bce333aa65c0b14f28e79a41edae417fa7 100644
--- a/tests/test_extract.py
+++ b/tests/test_extract.py
@@ -271,3 +271,29 @@ def test_extract_null_values_existing_lookup_table_with_null_row(fresh_db):
         {"id": 10, "name": "Terriana", "species_id": 2},
         {"id": 11, "name": "Spenidorm", "species_id": None},
     ]
+
+
+def test_reuse_lookup_table_with_null_value(fresh_db):
+    fresh_db["sightings"].insert(
+        {"id": 1, "common_name": "Wolf", "latin_name": None}, pk="id"
+    )
+    fresh_db["individuals"].insert(
+        {"id": 2, "name": "Terriana", "common_name": "Wolf", "latin_name": None},
+        pk="id",
+    )
+
+    extract_kwargs = {
+        "columns": ["common_name", "latin_name"],
+        "table": "species",
+        "fk_column": "species_id",
+    }
+    fresh_db["sightings"].extract(**extract_kwargs)
+    fresh_db["individuals"].extract(**extract_kwargs)
+
+    assert list(fresh_db["species"].rows) == [
+        {"id": 1, "common_name": "Wolf", "latin_name": None}
+    ]
+    assert list(fresh_db["sightings"].rows) == [{"id": 1, "species_id": 1}]
+    assert list(fresh_db["individuals"].rows) == [
+        {"id": 2, "name": "Terriana", "species_id": 1}
+    ]
