+def test_reuse_lookup_table_with_null_values(fresh_db):
+    fresh_db["first"].insert_all(
+        [
+            {"id": 1, "name": "One", "category": None},
+            {"id": 2, "name": "Two", "category": "number"},
+        ],
+        pk="id",
+    )
+    fresh_db["second"].insert_all(
+        [
+            {"id": 3, "name": "One", "category": None},
+            {"id": 4, "name": "Two", "category": "number"},
+            {"id": 5, "name": None, "category": None},
+        ],
+        pk="id",
+    )
+
+    for table in ("first", "second"):
+        fresh_db[table].extract(
+            ["name", "category"], table="items", fk_column="item_id"
+        )
+
+    assert list(fresh_db["items"].rows) == [
+        {"id": 1, "name": "One", "category": None},
+        {"id": 2, "name": "Two", "category": "number"},
+    ]
+    assert list(fresh_db["first"].rows) == [
+        {"id": 1, "item_id": 1},
+        {"id": 2, "item_id": 2},
+    ]
+    assert list(fresh_db["second"].rows) == [
+        {"id": 3, "item_id": 1},
+        {"id": 4, "item_id": 2},
+        {"id": 5, "item_id": None},
+    ]
+
+
