+def test_reuse_lookup_table_with_null_values(fresh_db):
+    fresh_db["first_works"].insert_all(
+        [
+            {"id": 1, "title": "Shared", "creator": None},
+            {"id": 2, "title": "Complete", "creator": "Someone"},
+            {"id": 3, "title": None, "creator": None},
+        ],
+        pk="id",
+    )
+    fresh_db["second_works"].insert_all(
+        [
+            {"id": 4, "title": "Shared", "creator": None},
+            {"id": 5, "title": "Complete", "creator": "Someone"},
+            {"id": 6, "title": None, "creator": None},
+        ],
+        pk="id",
+    )
+
+    for source_table in ("first_works", "second_works"):
+        fresh_db[source_table].extract(
+            ["title", "creator"], table="works", fk_column="work_id"
+        )
+
+    assert list(fresh_db["works"].rows) == [
+        {"id": 1, "title": "Shared", "creator": None},
+        {"id": 2, "title": "Complete", "creator": "Someone"},
+    ]
+    assert list(fresh_db["first_works"].rows) == [
+        {"id": 1, "work_id": 1},
+        {"id": 2, "work_id": 2},
+        {"id": 3, "work_id": None},
+    ]
+    assert list(fresh_db["second_works"].rows) == [
+        {"id": 4, "work_id": 1},
+        {"id": 5, "work_id": 2},
+        {"id": 6, "work_id": None},
+    ]
+
+
