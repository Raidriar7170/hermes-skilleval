@@ -367,9 +367,14 @@ class CSVKitUtility:
                     text_type,
                 ]
 
-                # In order to parse dates like "20010101".
-                if self.args.date_format or self.args.datetime_format:
+                # Explicit formats take precedence over numbers, so that values like
+                # "20010101" can be parsed as dates. Keep Number ahead of the
+                # default DateTime parser, which can otherwise interpret decimals
+                # like "5.5" as datetimes.
+                if self.args.datetime_format:
                     types.insert(-1, number_type)
+                elif self.args.date_format:
+                    types.insert(-2, number_type)
                 else:
                     types.insert(1, number_type)
 
