+    def test_date_format_keeps_decimal_number(self):
+        utility = self.Utility(['-f', 'csv', '--date-format', '%d/%m/%Y'])
+        types = utility.get_column_types().run([['5.5', '31/12/2020']], ['number', 'date'])
