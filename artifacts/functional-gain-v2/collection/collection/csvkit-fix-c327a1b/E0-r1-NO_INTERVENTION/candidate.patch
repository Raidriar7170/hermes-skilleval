-                # In order to parse dates like "20010101".
-                if self.args.date_format or self.args.datetime_format:
+                # Give explicitly formatted temporal values precedence over numbers (for example,
+                # a date formatted as "20010101"), without letting the other temporal type's
+                # permissive default parser claim values like "5.5".
+                if self.args.datetime_format:
                     types.insert(-1, number_type)
+                elif self.args.date_format:
+                    types.insert(3, number_type)
                 else:
                     types.insert(1, number_type)
 
