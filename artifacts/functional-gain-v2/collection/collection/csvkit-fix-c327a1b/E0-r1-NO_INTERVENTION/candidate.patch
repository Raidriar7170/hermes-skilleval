+    def test_date_format_does_not_parse_decimal_as_datetime(self):
+        input_file = io.BytesIO(b'date,number\n20010101,5.5')
+
+        with stdin_as_string(input_file):
+            self.assertLines(['-f', 'csv', '--date-format', '%Y%m%d'], [
