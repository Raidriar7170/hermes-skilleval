@@ -367,9 +367,14 @@ class CSVKitUtility:
                     text_type,
                 ]
 
-                # In order to parse dates like "20010101".
-                if self.args.date_format or self.args.datetime_format:
+                # Give an explicit format precedence over numbers, in order to
+                # parse dates and datetimes like "20010101". A format for one
+                # type should not, however, give the other date type precedence
+                # over numbers (for example, DateTime can parse "5.5").
+                if self.args.datetime_format:
                     types.insert(-1, number_type)
+                elif self.args.date_format:
+                    types.insert(-2, number_type)
                 else:
                     types.insert(1, number_type)
 
