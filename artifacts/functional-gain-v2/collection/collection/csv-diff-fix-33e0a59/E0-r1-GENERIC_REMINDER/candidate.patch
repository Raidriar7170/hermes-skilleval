@@ -35,15 +35,33 @@ def load_json(fp, key=None):
         keyfn = lambda r: hashlib.sha1(
             json.dumps(r, sort_keys=True).encode("utf8")
         ).hexdigest()
-    return {keyfn(r): _simplify_json_row(r) for r in raw_list}
+
+    # JSON objects in the same array do not necessarily all have the same
+    # fields. Treat those fields like CSV columns, filling absent values with
+    # None so that a value appearing or disappearing can be compared normally.
+    rows = []
+    fields = []
+    seen_fields = set()
+    for raw_row in raw_list:
+        row_key = keyfn(raw_row)
+        row = _simplify_json_row(raw_row)
+        rows.append((row_key, row))
+        for field in row:
+            if field not in seen_fields:
+                seen_fields.add(field)
+                fields.append(field)
+    return {
+        row_key: {field: row.get(field) for field in fields}
+        for row_key, row in rows
+    }
 
 
 def _simplify_json_row(r):
     # Convert list/dict values into JSON serialized strings
-    for key, value in r.items():
-        if isinstance(value, (dict, tuple, list)):
-            r[key] = json.dumps(value)
-    return r
+    return {
+        key: json.dumps(value) if isinstance(value, (dict, tuple, list)) else value
+        for key, value in r.items()
+    }
 
 
 def compare(previous, current, show_unchanged=False):
