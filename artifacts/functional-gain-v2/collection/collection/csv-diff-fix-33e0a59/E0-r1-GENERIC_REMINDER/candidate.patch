+    one = tmpdir / "one.json"
+    one.write('[{"id": 1}, {"id": 2, "age": 2}]')
+    two = tmpdir / "two.json"
+    two.write('[{"id": 1, "age": 3}, {"id": 2, "age": 2}]')
