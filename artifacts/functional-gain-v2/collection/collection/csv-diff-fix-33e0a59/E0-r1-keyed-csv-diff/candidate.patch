+def test_load_json_fills_missing_fields_and_preserves_nested_values():
+    rows = load_json(
+        io.StringIO(
+            json.dumps(
+                [
+                    {"id": 1, "details": {"kind": "cat"}},
+                    {"id": 2, "tags": ["friendly"]},
+                ]
+            )
+        ),
+        key="id",
+    )
+
+    assert rows == {
+        1: {"id": 1, "details": {"kind": "cat"}, "tags": None},
+        2: {"id": 2, "tags": ["friendly"], "details": None},
+    }
+
+
+def test_json_missing_field_becoming_present_is_a_change():
+    previous = load_json(
+        io.StringIO('[{"id": 1}, {"id": 2, "name": "Pancakes"}]'), key="id"
+    )
+    current = load_json(
+        io.StringIO('[{"id": 1, "name": "Cleo"}, {"id": 2, "name": "Pancakes"}]'),
+        key="id",
+    )
+
+    assert compare(previous, current)["changed"] == [
+        {"key": 1, "changes": {"name": [None, "Cleo"]}}
+    ]
+
