+def test_json_output_for_missing_field_becoming_present(tmpdir):
+    one = tmpdir / "one.json"
+    one.write('[{"id": 1}, {"id": 2, "name": "Pancakes"}]')
+    two = tmpdir / "two.json"
+    two.write('[{"id": 1, "name": "Cleo"}, {"id": 2, "name": "Pancakes"}]')
+
+    result = CliRunner().invoke(
+        cli.cli,
+        [str(one), str(two), "--key", "id", "--json", "--format", "json"],
+        catch_exceptions=False,
+    )
+
