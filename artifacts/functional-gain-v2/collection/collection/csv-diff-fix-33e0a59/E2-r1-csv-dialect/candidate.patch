+def test_json_missing_field_becomes_present(tmpdir):
+    one = tmpdir / "one.json"
+    one.write(
+        json.dumps(
+            [
+                {"id": 1, "nested": {"foo": [1]}},
+                {"id": 2, "nested": {"foo": [2]}, "note": "existing"},
+            ]
+        )
+    )
+    two = tmpdir / "two.json"
+    two.write(
+        json.dumps(
+            [
+                {"id": 1, "nested": {"foo": [1]}, "note": "new"},
+                {"id": 2, "nested": {"foo": [2]}, "note": "existing"},
+            ]
+        )
+    )
+
+    result = CliRunner().invoke(
+        cli.cli,
+        [str(one), str(two), "--key", "id", "--json", "--format", "json"],
+        catch_exceptions=False,
+    )
+
+    assert result.exit_code == 0
+    assert json.loads(result.output) == {
+        "added": [],
+        "removed": [],
+        "changed": [{"key": 1, "changes": {"note": [None, "new"]}}],
+        "columns_added": [],
+        "columns_removed": [],
+    }
+
+
