+def test_load_json_fills_missing_fields_and_preserves_nested_values():
+    rows = load_json(
+        io.StringIO(
+            json.dumps(
+                [
+                    {"id": 1, "name": "Cleo"},
+                    {"id": 2, "name": "Pancakes", "metadata": {"likes": ["naps"]}},
+                ]
+            )
+        ),
+        key="id",
+    )
+
+    assert rows == {
+        1: {"id": 1, "name": "Cleo", "metadata": None},
+        2: {
+            "id": 2,
+            "name": "Pancakes",
+            "metadata": '{"likes": ["naps"]}',
+        },
+    }
