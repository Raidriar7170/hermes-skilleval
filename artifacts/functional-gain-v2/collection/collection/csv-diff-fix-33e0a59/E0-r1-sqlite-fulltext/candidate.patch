 def load_json(fp, key=None):
     raw_list = json.load(fp)
     assert isinstance(raw_list, list)
+    # JSON records do not necessarily all have the same fields. Treat them as
+    # rows in a table by finding every field used in the file and filling in
+    # missing values with None. Preserve first-seen order for human output.
+    columns = []
+    seen_columns = set()
+    for row in raw_list:
+        for column in row:
+            if column not in seen_columns:
+                columns.append(column)
+                seen_columns.add(column)
+    rows = []
+    for raw_row in raw_list:
+        row = dict(raw_row)
+        for column in columns:
+            row.setdefault(column, None)
+        rows.append(_simplify_json_row(row))
     if key:
         keyfn = lambda r: r[key]
     else:
         keyfn = lambda r: hashlib.sha1(
