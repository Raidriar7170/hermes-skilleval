+def test_json_output_for_missing_field(tmpdir):
+    one = tmpdir / "one.json"
+    one.write('[{"id": 1}, {"id": 2, "value": "already present"}]')
+    two = tmpdir / "two.json"
+    two.write(
+        '[{"id": 1, "value": {"nested": [1, 2]}}, '
+        '{"id": 2, "value": "already present"}]'
+    )
+
+    result = CliRunner().invoke(
+        cli.cli,
+        [str(one), str(two), "--key", "id", "--format", "json", "--json"],
+        catch_exceptions=False,
+    )
+
+    assert result.exit_code == 0
+    assert json.loads(result.output) == {
+        "added": [],
+        "removed": [],
+        "changed": [
+            {
+                "key": 1,
+                "changes": {"value": [None, '{"nested": [1, 2]}']},
+            }
+        ],
+        "columns_added": [],
+        "columns_removed": [],
+    }
+
+
 def test_sniff_format(tsv_files):
     one, two = tsv_files
     result = CliRunner().invoke(cli.cli, [one, two, "--key", "id", "--json"])
