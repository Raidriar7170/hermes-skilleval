index a9038aaba9befee79ea5bbc6a9779d3061d0abb5..23eac796416bf7710f4975d6cdbc9b15d90c0ad9 100644
--- a/csv_diff/__init__.py
+++ b/csv_diff/__init__.py
@@ -29,6 +29,19 @@ def load_csv(fp, key=None, dialect=None):
 def load_json(fp, key=None):
     raw_list = json.load(fp)
     assert isinstance(raw_list, list)
+    # JSON objects do not have to contain an identical set of fields. Treat a
+    # field omitted from an object like an empty CSV cell so dictdiffer sees a
+    # value change (None -> value), rather than a structural add operation.
+    fields = []
+    seen_fields = set()
+    for row in raw_list:
+        for field in row:
+            if field not in seen_fields:
+                fields.append(field)
+                seen_fields.add(field)
+    for row in raw_list:
+        for field in fields:
+            row.setdefault(field, None)
     if key:
         keyfn = lambda r: r[key]
     else:
