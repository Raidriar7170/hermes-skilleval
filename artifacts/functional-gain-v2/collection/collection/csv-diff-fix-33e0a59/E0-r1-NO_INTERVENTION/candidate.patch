+from csv_diff import load_csv, load_json, compare
 import io
+import json
 
 ONE = """id,name,age
 1,Cleo,4
@@ -115,3 +116,40 @@ def test_tsv():
         "columns_added": [],
         "columns_removed": [],
     } == diff
+
+
+def test_load_json_fills_missing_fields_and_preserves_nested_values():
+    rows = load_json(
+        io.StringIO(
+            json.dumps(
+                [
+                    {"id": 1, "name": "Cleo"},
+                    {"id": 2, "name": "Pancakes", "details": {"age": 2}},
+                ]
+            )
+        ),
+        key="id",
+    )
+
+    assert rows == {
+        1: {"id": 1, "name": "Cleo", "details": None},
+        2: {"id": 2, "name": "Pancakes", "details": '{"age": 2}'},
+    }
+
+
+def test_compare_json_field_missing_then_present():
+    previous = load_json(
+        io.StringIO('[{"id": 1}, {"id": 2, "value": {"nested": true}}]'),
+        key="id",
+    )
+    current = load_json(
+        io.StringIO(
+            '[{"id": 1, "value": [1, 2]}, '
+            '{"id": 2, "value": {"nested": true}}]'
+        ),
+        key="id",
+    )
+
+    assert compare(previous, current)["changed"] == [
+        {"key": 1, "changes": {"value": [None, "[1, 2]"]}}
+    ]
