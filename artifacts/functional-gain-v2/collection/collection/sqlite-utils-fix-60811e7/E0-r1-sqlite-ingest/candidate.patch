+    def _resolve_ignored_insert(
+        self,
+        record: Dict[str, Any],
+        conversions: Dict[str, str],
+        extracts: Optional[Union[Dict[str, str], List[str]]],
+    ) -> Optional[Tuple[Any, Optional[int]]]:
+        """Return the identity of the row that made an insert be ignored.
+
+        More than one unique constraint can match different rows. In that case
+        there is no single honest answer, so leave both identity attributes
+        unset. Partial and expression indexes, and values changed before insert,
+        are likewise not safe to infer from the original record.
+        """
+        record_keys = {key.lower(): key for key in record}
+        unsafe_columns = {key.lower() for key in conversions}
+        if isinstance(extracts, dict):
+            unsafe_columns.update(key.lower() for key in extracts)
+        else:
+            unsafe_columns.update(key.lower() for key in (extracts or ()))
+
+        unique_column_sets = []
+        if self.use_rowid:
+            # A supplied rowid can use any of SQLite's three aliases.
+            for alias in ("rowid", "_rowid_", "oid"):
+                if alias in record_keys:
+                    unique_column_sets.append((alias,))
+        else:
+            unique_column_sets.append(tuple(self.pks))
+        unique_column_sets.extend(
+            tuple(index.columns)
+            for index in self.indexes
+            if index.unique
+            and not index.partial
+            and index.columns
+            and all(column is not None for column in index.columns)
+        )
+
+        matches: Dict[Any, Tuple[Any, Optional[int]]] = {}
+        for columns in unique_column_sets:
+            lowered = [column.lower() for column in columns]
+            if (
+                any(column not in record_keys for column in lowered)
+                or any(column in unsafe_columns for column in lowered)
+            ):
+                continue
+            values = [
+                jsonify_if_needed(record[record_keys[column]]) for column in lowered
+            ]
+            # NULL values do not collide under SQLite unique constraints.
+            if any(value is None for value in values):
+                continue
+            where = " AND ".join(
+                "{} = ?".format(quote_identifier(column)) for column in columns
+            )
+            select = "*"
+            if self.use_rowid:
+                select = "rowid AS __sqlite_utils_rowid__, *"
+            rows = list(self.rows_where(where, values, select=select, limit=2))
+            for row in rows:
+                if self.use_rowid:
+                    rowid = row["__sqlite_utils_rowid__"]
+                    identity = rowid
+                else:
+                    pk_values = tuple(row[resolve_casing(pk, row)] for pk in self.pks)
+                    identity = pk_values[0] if len(pk_values) == 1 else pk_values
+                    # Named primary-key tables normally still have a rowid.
+                    try:
+                        rowid_row = self.db.execute(
+                            "SELECT rowid FROM {} WHERE {} LIMIT 1".format(
+                                quote_identifier(self.name), where
+                            ),
+                            values,
+                        ).fetchone()
+                        rowid = rowid_row[0] if rowid_row else None
+                    except OperationalError:
+                        rowid = None
+                matches[identity] = (identity, rowid)
+        if len(matches) == 1:
+            return next(iter(matches.values()))
+        return None
