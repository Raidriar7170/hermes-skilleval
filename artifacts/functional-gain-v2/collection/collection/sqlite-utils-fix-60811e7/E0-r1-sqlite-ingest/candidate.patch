diff --git a/tests/test_insert_identity_reporting.py b/tests/test_insert_identity_reporting.py
new file mode 100644
index 0000000000000000000000000000000000000000..d3cb3aa2dfcd1010d7033c951315c944a890bf58
--- /dev/null
+++ b/tests/test_insert_identity_reporting.py
@@ -0,0 +1,94 @@
+import pytest
+
+from sqlite_utils import Database
+
+
+@pytest.mark.parametrize("alias", ("rowid", "_rowid_", "oid"))
+@pytest.mark.parametrize("operation", ("upsert", "replace", "ignore"))
+def test_rowid_alias_identity_reporting(alias, operation):
+    db = Database(memory=True)
+    table = db["items"]
+    table.insert({"name": "original"})
+
+    record = {alias: 1, "name": "changed"}
+    if operation == "upsert":
+        table.upsert(record, pk=alias)
+        expected_name = "changed"
+    elif operation == "replace":
+        table.insert(record, pk=alias, replace=True)
+        expected_name = "changed"
+    else:
+        table.insert(record, pk=alias, ignore=True)
+        expected_name = "original"
+
+    assert table.last_pk == 1
+    if operation != "upsert":
+        assert table.last_rowid == 1
+    assert list(db.query("select rowid, name from items")) == [
+        {"rowid": 1, "name": expected_name}
+    ]
+
+
+def test_ignore_reports_existing_row_for_unique_conflict_not_input_pk():
+    db = Database(memory=True)
+    table = db["items"]
+    table.insert({"id": 1, "code": "one", "value": "original"}, pk="id")
+    table.create_index(["code"], unique=True)
+
+    table.insert(
+        {"id": 2, "code": "one", "value": "replacement"},
+        pk="id",
+        ignore=True,
+    )
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+    assert list(table.rows) == [{"id": 1, "code": "one", "value": "original"}]
+
+
+def test_ignore_reports_compound_pk_in_list_mode():
+    db = Database(memory=True)
+    table = db["items"]
+    table.insert({"a": "x", "b": 2, "value": "original"}, pk=("a", "b"))
+
+    table.insert_all(
+        [["a", "b", "value"], ["x", 2, "replacement"]],
+        pk=("a", "b"),
+        ignore=True,
+    )
+
+    assert table.last_pk == ("x", 2)
+    assert table.last_rowid == 1
+    assert list(table.rows) == [{"a": "x", "b": 2, "value": "original"}]
+
+
+def test_ignore_does_not_report_ambiguous_conflicting_rows():
+    db = Database(memory=True)
+    table = db["items"]
+    table.insert_all(
+        [
+            {"id": 1, "email": "one@example.com", "username": "one"},
+            {"id": 2, "email": "two@example.com", "username": "two"},
+        ],
+        pk="id",
+    )
+    table.create_index(["email"], unique=True)
+    table.create_index(["username"], unique=True)
+
+    table.insert(
+        {"id": 3, "email": "one@example.com", "username": "two"},
+        pk="id",
+        ignore=True,
+    )
+
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
+def test_ignore_hash_id_semantics_are_preserved():
+    db = Database(memory=True)
+    table = db["items"]
+    first_pk = table.insert({"name": "one"}, hash_id="id").last_pk
+    table.insert({"name": "one"}, hash_id="id", ignore=True)
+    assert table.last_pk == first_pk
+    assert table.last_rowid == 1
