diff --git a/tests/test_insert_reporting.py b/tests/test_insert_reporting.py
new file mode 100644
index 0000000000000000000000000000000000000000..d5da82a79748afa5cb66eff111528bb20e57479b
--- /dev/null
+++ b/tests/test_insert_reporting.py
@@ -0,0 +1,152 @@
+import pytest
+
+from sqlite_utils import Database
+
+
+@pytest.mark.parametrize("alias", ("rowid", "_rowid_", "oid"))
+@pytest.mark.parametrize("operation", ("upsert", "replace", "ignore"))
+def test_rowid_alias_primary_key_reporting(alias, operation):
+    db = Database(memory=True)
+    table = db["items"]
+    table.insert({"name": "before"})
+
+    record = {alias: 1, "name": "after"}
+    if operation == "upsert":
+        table.upsert(record, pk=alias)
+        assert table.get(1)["name"] == "after"
+    elif operation == "replace":
+        table.insert(record, pk=alias, replace=True)
+        assert table.get(1)["name"] == "after"
+    else:
+        table.insert(record, pk=alias, ignore=True)
+        assert table.get(1)["name"] == "before"
+
+    assert table.last_pk == 1
+    if operation != "upsert":
+        assert table.last_rowid == 1
+
+
+def test_ignored_unique_conflict_reports_existing_rowid():
+    db = Database(memory=True)
+    db.execute("create table items (name text unique)")
+    table = db["items"].insert({"name": "one"})
+
+    table.insert({"name": "one"}, ignore=True)
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+
+
+def test_ignored_unique_conflict_reports_zero_rowid():
+    db = Database(memory=True)
+    db.execute("create table items (name text unique)")
+    db.execute("insert into items (rowid, name) values (0, 'zero')")
+    table = db["items"]
+
+    table.insert({"name": "zero"}, ignore=True)
+
+    assert table.last_pk == 0
+    assert table.last_rowid == 0
+
+
+def test_ignored_unique_conflict_reports_existing_compound_pk():
+    db = Database(memory=True)
+    db.execute(
+        "create table people (team text, id integer, email text unique, "
+        "primary key (team, id)) without rowid"
+    )
+    table = db["people"].insert(
+        {"team": "red", "id": 1, "email": "one@example.com"}
+    )
+
+    table.insert(
+        {"team": "blue", "id": 2, "email": "one@example.com"}, ignore=True
+    )
+
+    assert table.last_pk == ("red", 1)
+    assert table.last_rowid is None
+
+
+def test_ignored_unique_conflict_reports_compound_pk_and_physical_rowid():
+    db = Database(memory=True)
+    db.execute(
+        "create table people (team text, id integer, email text unique, "
+        "primary key (team, id))"
+    )
+    table = db["people"].insert(
+        {"team": "red", "id": 1, "email": "one@example.com"}
+    )
+
+    table.insert(
+        {"team": "blue", "id": 2, "email": "one@example.com"}, ignore=True
+    )
+
+    assert table.last_pk == ("red", 1)
+    assert table.last_rowid == 1
+
+
+@pytest.mark.parametrize("operation", ("replace", "ignore"))
+def test_real_rowid_column_is_not_treated_as_hidden_alias(operation):
+    db = Database(memory=True)
+    db.execute("create table items (rowid text unique, name text)")
+    table = db["items"].insert({"rowid": "custom", "name": "before"}, pk="rowid")
+
+    table.insert(
+        {"rowid": "custom", "name": "after"},
+        pk="rowid",
+        replace=operation == "replace",
+        ignore=operation == "ignore",
+    )
+
+    assert table.last_pk == "custom"
+    assert table.last_rowid is not None
+
+
+def test_ignored_unique_conflict_list_mode_reports_existing_compound_pk():
+    db = Database(memory=True)
+    db.execute(
+        "create table people (team text, id integer, email text unique, "
+        "primary key (team, id)) without rowid"
+    )
+    table = db["people"].insert(
+        {"team": "red", "id": 1, "email": "one@example.com"}
+    )
+
+    table.insert_all(
+        [["team", "id", "email"], ["blue", 2, "one@example.com"]],
+        ignore=True,
+    )
+
+    assert table.last_pk == ("red", 1)
+    assert table.last_rowid is None
+
+
+def test_ignored_conflicts_with_different_rows_reports_no_identity():
+    db = Database(memory=True)
+    db.execute("create table people (username text unique, email text unique)")
+    db["people"].insert_all(
+        [
+            {"username": "one", "email": "one@example.com"},
+            {"username": "two", "email": "two@example.com"},
+        ]
+    )
+    table = db["people"]
+
+    table.insert(
+        {"username": "one", "email": "two@example.com"}, ignore=True
+    )
+
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
+def test_ignored_hash_id_preserves_record_and_identity():
+    db = Database(memory=True)
+    record = {"name": "Cleo"}
+    table = db["dogs"].insert(record, hash_id="id")
+    expected_pk = table.last_pk
+
+    table.insert(record, hash_id="id", ignore=True)
+
+    assert record == {"name": "Cleo"}
+    assert table.last_pk == expected_pk
