+    _rowid_aliases = ("rowid", "_rowid_", "oid")
+
+    def _rowid_alias(self) -> Optional[str]:
+        """Return an unshadowed name that can be used to address the rowid."""
+        if "WITHOUT ROWID" in self.schema.upper():
+            return None
+        column_names = {column.name.lower() for column in self.columns}
+        return next(
+            (alias for alias in self._rowid_aliases if alias not in column_names), None
+        )
+
+    def _is_rowid_pk(self, pk: Any) -> bool:
+        column_names = {column.name.lower() for column in self.columns}
+        return (
+            self.use_rowid
+            and isinstance(pk, str)
+            and pk.lower() in self._rowid_aliases
+            and pk.lower() not in column_names
+        )
+
+    def _ignored_insert_row(self, record: Dict[str, Any]) -> Optional[Tuple[dict, Any]]:
+        """Find the existing row responsible for an ignored constraint failure.
+
+        More than one unique constraint can match different rows. In that case
+        there is no honest single identity to report, so return None.
+        """
+        record_keys = {key.lower(): key for key in record}
+        constraints = []
+        if self._rowid_alias() is not None:
+            for alias in self._rowid_aliases:
+                if alias in record_keys and self._is_rowid_pk(alias):
+                    constraints.append((record_keys[alias],))
+        if not self.use_rowid:
+            constraints.append(tuple(self.pks))
+
+        for index_row in self.db.execute(
+            "PRAGMA index_list({})".format(quote_identifier(self.name))
+        ).fetchall():
+            # Partial indexes and expression indexes cannot safely be resolved
+            # from the submitted values alone.
+            if not index_row[2] or index_row[4]:
+                continue
+            columns = tuple(
+                row[2]
+                for row in self.db.execute(
+                    "PRAGMA index_info({})".format(quote_identifier(index_row[1]))
+                ).fetchall()
+            )
+            if columns and all(column is not None for column in columns):
+                constraints.append(columns)
+
+        rowid_alias = self._rowid_alias()
+        matches = []
+        for columns in constraints:
+            try:
+                keys = [record_keys[column.lower()] for column in columns]
+            except KeyError:
+                continue
+            values = [record[key] for key in keys]
+            # NULL never conflicts with an ordinary UNIQUE constraint.
+            if any(value is None for value in values):
+                continue
+            select = "*"
+            if rowid_alias:
+                select = "{} AS __sqlite_utils_rowid__, *".format(rowid_alias)
+            rows = list(
+                self.rows_where(
+                    " AND ".join(
+                        "{} = ?".format(quote_identifier(column))
+                        for column in columns
+                    ),
+                    values,
+                    select=select,
+                    limit=2,
+                )
+            )
+            if len(rows) == 1:
+                row = rows[0]
+                physical_rowid = row["__sqlite_utils_rowid__"] if rowid_alias else None
+                identity = (
+                    physical_rowid
+                    if physical_rowid is not None
+                    else tuple(row[pk] for pk in self.pks)
+                )
+                if matches and any(previous[1] != identity for previous in matches):
+                    return None
+                matches.append(((row, physical_rowid), identity))
+        return matches[0][0] if matches else None
+
