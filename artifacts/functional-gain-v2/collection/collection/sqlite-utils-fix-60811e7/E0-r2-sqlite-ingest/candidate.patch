diff --git a/tests/test_insert_identity.py b/tests/test_insert_identity.py
new file mode 100644
index 0000000000000000000000000000000000000000..0c03620fca5b395cc8f9290952b759386a4f8c48
--- /dev/null
+++ b/tests/test_insert_identity.py
@@ -0,0 +1,136 @@
+import pytest
+
+from sqlite_utils import Database
+
+
+@pytest.mark.parametrize("alias", ("rowid", "_rowid_", "oid"))
+@pytest.mark.parametrize("operation", ("upsert", "replace", "ignore"))
+@pytest.mark.parametrize("use_old_upsert", (False, True))
+def test_rowid_alias_can_be_used_as_primary_key(alias, operation, use_old_upsert):
+    db = Database(memory=True, use_old_upsert=use_old_upsert)
+    table = db["items"]
+    table.insert({"name": "original"})
+
+    record = {alias: 1, "name": "replacement"}
+    if operation == "upsert":
+        table.upsert(record, pk=alias)
+    else:
+        table.insert(record, pk=alias, **{operation: True})
+
+    expected_name = "original" if operation == "ignore" else "replacement"
+    assert list(table.rows) == [{"name": expected_name}]
+    assert table.last_pk == 1
+    if operation != "upsert":
+        assert table.last_rowid == 1
+
+
+def test_ignore_reports_existing_compound_primary_key_row():
+    db = Database(memory=True)
+    table = db["items"]
+    table.insert(
+        {"kind": "book", "number": 1, "value": "original"},
+        pk=("kind", "number"),
+    )
+
+    table.insert(
+        {"kind": "book", "number": 1, "value": "ignored"},
+        pk=("kind", "number"),
+        ignore=True,
+    )
+
+    assert list(table.rows) == [{"kind": "book", "number": 1, "value": "original"}]
+    assert table.last_pk == ("book", 1)
+    assert table.last_rowid == 1
+
+
+def test_ignore_reports_without_rowid_compound_primary_key():
+    db = Database(memory=True)
+    db.execute(
+        "create table items (kind text, number integer, value text, "
+        "primary key (kind, number)) without rowid"
+    )
+    table = db["items"]
+    table.insert({"kind": "book", "number": 1, "value": "original"})
+
+    table.insert(
+        {"kind": "book", "number": 1, "value": "ignored"}, ignore=True
+    )
+
+    assert list(table.rows) == [
+        {"kind": "book", "number": 1, "value": "original"}
+    ]
+    assert table.last_pk == ("book", 1)
+    assert table.last_rowid is None
+
+
+def test_ignore_reports_existing_row_in_list_mode():
+    db = Database(memory=True)
+    table = db["items"]
+    table.insert({"id": 1, "value": "original"}, pk="id")
+
+    table.insert_all([["id", "value"], [1, "ignored"]], pk="id", ignore=True)
+
+    assert list(table.rows) == [{"id": 1, "value": "original"}]
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+
+
+@pytest.mark.parametrize("alias", ("rowid", "_rowid_", "oid"))
+def test_ignore_reports_rowid_alias_in_list_mode(alias):
+    db = Database(memory=True)
+    table = db["items"]
+    table.insert({"value": "original"})
+
+    table.insert_all([[alias, "value"], [1, "ignored"]], pk=alias, ignore=True)
+
+    assert list(table.rows) == [{"value": "original"}]
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+
+
+def test_ignore_does_not_report_unrelated_input_primary_key():
+    db = Database(memory=True)
+    table = db["items"]
+    table.create({"id": int, "name": str}, pk="id")
+    table.create_index(["name"], unique=True)
+    table.insert({"id": 1, "name": "one"})
+
+    table.insert({"id": 2, "name": "one"}, ignore=True)
+
+    assert list(table.rows) == [{"id": 1, "name": "one"}]
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
+def test_ignore_reports_json_primary_key_as_stored():
+    db = Database(memory=True)
+    table = db["items"]
+    table.insert({"id": [1, 2], "value": "original"}, pk="id")
+
+    table.insert({"id": [1, 2], "value": "ignored"}, ignore=True)
+
+    assert list(table.rows) == [{"id": "[1, 2]", "value": "original"}]
+    assert table.last_pk == "[1, 2]"
+    assert table.last_rowid == 1
+
+
+def test_ignore_preserves_hash_id_identity_and_original_values():
+    db = Database(memory=True)
+    table = db["items"]
+    table.insert(
+        {"name": "one", "value": "original"},
+        hash_id="id",
+        hash_id_columns=("name",),
+    )
+    original_pk = table.last_pk
+
+    table.insert(
+        {"name": "one", "value": "ignored"},
+        hash_id="id",
+        hash_id_columns=("name",),
+        ignore=True,
+    )
+
+    assert list(table.rows) == [{"id": original_pk, "name": "one", "value": "original"}]
+    assert table.last_pk == original_pk
+    assert table.last_rowid == 1
