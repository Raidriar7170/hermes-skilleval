diff --git a/tests/test_list_mode.py b/tests/test_list_mode.py
index 746c9c17601247988bf9b737f972e489a6188b94..de60c1342aeff310e3d400bb09cf916b1d060543 100644
--- a/tests/test_list_mode.py
+++ b/tests/test_list_mode.py
@@ -286,3 +286,12 @@ def test_list_mode_single_record_upsert_last_pk():
 
     # Verify last_pk is populated correctly
     assert table.last_pk == 1
+
+
+def test_list_mode_single_ignored_record_last_compound_pk():
+    db = Database(memory=True)
+    table = db["items"]
+    table.insert({"a": "one", "b": 2}, pk=("a", "b"))
+    table.insert_all([["a", "b"], ["one", 2]], pk=("a", "b"), ignore=True)
+    assert table.last_pk == ("one", 2)
+    assert table.last_rowid == 1
diff --git a/tests/test_upsert.py b/tests/test_upsert.py
index a782b260dbd94d610f2a993f934205499c839270..2c384d6133aa333744fb350c3e62e8ebc606c215 100644
--- a/tests/test_upsert.py
+++ b/tests/test_upsert.py
@@ -184,3 +184,84 @@ def test_upsert_compound_primary_key(fresh_db):
     # .upsert_all() with a single item should set .last_pk
     table.upsert_all([{"species": "cat", "id": 1, "age": 5}], pk=("species", "id"))
     assert ("cat", 1) == table.last_pk
+
+
+@pytest.mark.parametrize("alias", ("rowid", "_rowid_", "oid"))
+@pytest.mark.parametrize("operation", ("upsert", "replace", "ignore"))
+def test_rowid_alias_as_pk(fresh_db, alias, operation):
+    table = fresh_db["items"]
+    table.insert({"name": "before"})
+    kwargs = {"pk": alias}
+    if operation == "upsert":
+        table.upsert({alias: 1, "name": "after"}, **kwargs)
+    else:
+        kwargs[operation] = True
+        table.insert({alias: 1, "name": "after"}, **kwargs)
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+    assert list(table.rows) == [
+        {"name": "before" if operation == "ignore" else "after"}
+    ]
+
+
+def test_insert_ignore_reports_compound_pk_and_rowid(fresh_db):
+    table = fresh_db["items"]
+    table.insert({"a": "one", "b": 2, "value": "before"}, pk=("a", "b"))
+    table.insert(
+        {"a": "one", "b": 2, "value": "after"},
+        pk=("a", "b"),
+        ignore=True,
+    )
+    assert table.last_pk == ("one", 2)
+    assert table.last_rowid == 1
+    assert table.get(("one", 2))["value"] == "before"
+
+
+def test_insert_ignore_reports_compound_pk_without_rowid(fresh_db):
+    fresh_db.execute(
+        "create table items (a text, b integer, value text, "
+        "primary key (a, b)) without rowid"
+    )
+    table = fresh_db["items"]
+    table.insert({"a": "one", "b": 2, "value": "before"}, pk=("a", "b"))
+    table.insert(
+        {"a": "one", "b": 2, "value": "after"},
+        pk=("a", "b"),
+        ignore=True,
+    )
+    assert table.last_pk == ("one", 2)
+    assert table.last_rowid is None
+    assert table.get(("one", 2))["value"] == "before"
+
+
+def test_insert_ignore_preserves_original_pk_value(fresh_db):
+    table = fresh_db["items"]
+    table.insert({"id": 1, "value": "before"}, pk="id")
+    table.insert({"id": "1", "value": "after"}, pk="id", ignore=True)
+    assert table.last_pk == "1"
+    assert table.last_rowid == 1
+    assert table.get(1)["value"] == "before"
+
+
+def test_insert_ignore_unresolvable_conflict_has_no_identity(fresh_db):
+    table = fresh_db["items"]
+    table.insert({"id": 1, "name": "one", "email": "one@example.com"}, pk="id")
+    table.insert({"id": 2, "name": "two", "email": "two@example.com"}, pk="id")
+    table.create_index(["name"], unique=True)
+    table.create_index(["email"], unique=True)
+    table.insert(
+        {"id": 3, "name": "one", "email": "two@example.com"},
+        pk="id",
+        ignore=True,
+    )
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
+def test_insert_ignore_resolves_unique_conflict_on_rowid_table(fresh_db):
+    table = fresh_db["items"]
+    table.insert({"name": "one"})
+    table.create_index(["name"], unique=True)
+    table.insert({"name": "one"}, ignore=True)
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
