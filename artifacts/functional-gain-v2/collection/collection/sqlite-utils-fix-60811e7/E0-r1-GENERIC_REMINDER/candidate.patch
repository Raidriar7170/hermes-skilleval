+    def _rowid_alias(self, column: str) -> Optional[str]:
+        """Return the usable SQLite rowid alias named by ``column``, if any."""
+        aliases = {"rowid", "_rowid_", "oid"}
+        folded = fold_identifier_case(column)
+        real_columns = {fold_identifier_case(c.name) for c in self.columns}
+        if (
+            "without rowid" not in self.schema.lower()
+            and folded in aliases
+            and folded not in real_columns
+        ):
+            return folded
+        return None
+
+    def _ignored_insert_identity(
+        self, record: Dict[str, Any], pk: Optional[Any]
+    ) -> Optional[Tuple[Optional[int], Any]]:
+        """Resolve an ignored insert to one unambiguous existing row."""
+        rowid_alias = next(
+            (
+                alias
+                for alias in ("rowid", "_rowid_", "oid")
+                if fold_identifier_case(alias)
+                not in {fold_identifier_case(c.name) for c in self.columns}
+            ),
+            None,
+        )
+        has_rowid = "without rowid" not in self.schema.lower() and rowid_alias
+
+        candidates = []
+        if pk:
+            candidates.append(([pk] if isinstance(pk, str) else list(pk), True))
+        candidates.extend(
+            (index.columns, False)
+            for index in self.indexes
+            if index.unique and not index.partial and all(index.columns)
+        )
+
+        matched_rows = {}
+        explicit_pk_identities = set()
+        for columns, is_explicit_pk in candidates:
+            try:
+                keys = [resolve_casing(column, record) for column in columns]
+                values = [record[key] for key in keys]
+            except (KeyError, TypeError):
+                continue
+            if any(value is None for value in values):
+                continue
+            where = " and ".join(
+                "{} = ?".format(quote_identifier(column)) for column in columns
+            )
+            select = "*"
+            if has_rowid:
+                select = "{} as {}, *".format(
+                    quote_identifier(cast(str, rowid_alias)),
+                    quote_identifier("__sqlite_utils_rowid__"),
+                )
+            sql = "select {select} from {table} where {where}".format(
+                select=select, table=quote_identifier(self.name), where=where
+            )
+            rows = list(self.db.query(sql, values))
+            for row in rows:
+                if has_rowid:
+                    identity = row["__sqlite_utils_rowid__"]
+                else:
+                    identity = tuple(row[column] for column in self.pks)
+                matched_rows[identity] = row
+                if is_explicit_pk:
+                    explicit_pk_identities.add(identity)
+
+        if len(matched_rows) != 1:
+            return None
+        identity, row = next(iter(matched_rows.items()))
+        if identity in explicit_pk_identities and pk:
+            pk_columns = [pk] if isinstance(pk, str) else list(pk)
+            original_values = tuple(
+                record[resolve_casing(column, record)] for column in pk_columns
+            )
+            last_pk = (
+                original_values[0] if len(original_values) == 1 else original_values
+            )
+        else:
+            table_pks = self.pks
+            last_pk = identity if table_pks == ["rowid"] else (
+                row[table_pks[0]]
+                if len(table_pks) == 1
+                else tuple(row[column] for column in table_pks)
+            )
+        return (cast(int, identity) if has_rowid else None), last_pk
+
