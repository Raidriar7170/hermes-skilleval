+def test_insert_ignore_infers_existing_integer_pk(fresh_db):
+    fresh_db.conn.execute(
+        "create table users (id integer primary key, name text)"
+    )
+    table = fresh_db["users"]
+    table.insert({"id": 1, "name": "Original"})
+
+    table.insert({"id": 1, "name": "Replacement"}, ignore=True)
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+    assert list(table.rows) == [{"id": 1, "name": "Original"}]
+
+
+@pytest.mark.parametrize("pk", ("rowid", "_rowid_", "oid"))
+@pytest.mark.parametrize("operation", ("upsert", "replace", "ignore"))
+@pytest.mark.parametrize("use_old_upsert", (False, True))
+def test_rowid_alias_pk_reporting(pk, operation, use_old_upsert):
+    db = Database(memory=True, use_old_upsert=use_old_upsert)
+    table = db["items"]
+    table.insert({"value": "original"})
+
+    record = {pk: 1, "value": "new"}
+    if operation == "upsert":
+        table.upsert(record, pk=pk)
+    else:
+        table.insert(
+            record,
+            pk=pk,
+            replace=operation == "replace",
+            ignore=operation == "ignore",
+        )
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+    assert list(table.rows) == [
+        {"value": "original" if operation == "ignore" else "new"}
+    ]
+
+
+@pytest.mark.parametrize("list_mode", (False, True))
+def test_insert_ignore_reports_row_for_other_unique_constraint(fresh_db, list_mode):
+    fresh_db.conn.execute(
+        "create table users (id integer primary key, email text unique, name text)"
+    )
+    table = fresh_db["users"]
+    table.insert({"id": 1, "email": "one@example.com", "name": "Original"})
+    record = {"id": 2, "email": "one@example.com", "name": "Replacement"}
+    records = (
+        [["id", "email", "name"], list(record.values())]
+        if list_mode
+        else [record]
+    )
+
+    table.insert_all(records, pk="id", ignore=True)
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+    assert list(table.rows) == [
+        {"id": 1, "email": "one@example.com", "name": "Original"}
+    ]
+
+
+@pytest.mark.parametrize("list_mode", (False, True))
+def test_insert_ignore_reports_compound_pk(fresh_db, list_mode):
+    fresh_db.conn.execute(
+        "create table memberships (team text, person integer, role text, "
+        "primary key (team, person))"
+    )
+    table = fresh_db["memberships"]
+    table.insert({"team": "A", "person": 1, "role": "admin"})
+    record = {"team": "A", "person": 1, "role": "member"}
+    records = (
+        [["team", "person", "role"], list(record.values())]
+        if list_mode
+        else [record]
+    )
+
+    table.insert_all(records, pk=("team", "person"), ignore=True)
+
+    assert table.last_pk == ("A", 1)
+    assert table.last_rowid == 1
+    assert list(table.rows)[0]["role"] == "admin"
+
+
+def test_insert_ignore_does_not_report_ambiguous_conflict(fresh_db):
+    fresh_db.conn.execute(
+        "create table pairs (id integer primary key, left_value text unique, "
+        "right_value text unique)"
+    )
+    table = fresh_db["pairs"]
+    table.insert({"id": 1, "left_value": "a", "right_value": "b"})
+    table.insert({"id": 2, "left_value": "c", "right_value": "d"})
+
+    table.insert(
+        {"id": 3, "left_value": "a", "right_value": "d"},
+        pk="id",
+        ignore=True,
+    )
+
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
