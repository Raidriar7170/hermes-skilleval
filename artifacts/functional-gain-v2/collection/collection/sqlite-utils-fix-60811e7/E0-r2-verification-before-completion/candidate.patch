+@pytest.mark.parametrize("alias", ("rowid", "_rowid_", "oid"))
+@pytest.mark.parametrize("operation", ("upsert", "replace", "ignore"))
+def test_rowid_alias_as_pk(fresh_db, alias, operation):
+    table = fresh_db["items"].insert({"name": "original"})
+    record = {alias: 1, "name": "updated"}
+
+    if operation == "upsert":
+        table.upsert(record, pk=alias)
+    else:
+        table.insert(record, pk=alias, **{operation: True})
+
+    assert table.last_pk == 1
+    assert list(table.rows) == [
+        {"name": "original" if operation == "ignore" else "updated"}
+    ]
+
+
+def test_unshadowed_rowid_alias_as_pk(fresh_db):
+    fresh_db.conn.execute('create table items ("rowid" text, name text)')
+    table = fresh_db["items"].insert({"rowid": "visible", "name": "original"})
+
+    table.insert(
+        {"_rowid_": 1, "rowid": "different", "name": "ignored"},
+        pk="_rowid_",
+        ignore=True,
+    )
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+    assert list(table.rows) == [{"rowid": "visible", "name": "original"}]
+
+
+def test_insert_ignore_reports_existing_compound_pk_and_rowid(fresh_db):
+    fresh_db.conn.execute(
+        "create table items (kind text, name text, value text, primary key(kind, name))"
+    )
+    table = fresh_db["items"].insert(
+        {"kind": "animal", "name": "Cleo", "value": "original"}
+    )
+
+    table.insert({"kind": "animal", "name": "Cleo", "value": "ignored"}, ignore=True)
+
+    assert table.last_pk == ("animal", "Cleo")
+    assert table.last_rowid == 1
+
+
+def test_insert_ignore_reports_row_from_other_unique_constraint(fresh_db):
+    fresh_db.conn.execute(
+        "create table users (id integer primary key, email text unique)"
+    )
+    table = fresh_db["users"].insert({"id": 1, "email": "one@example.com"})
+
+    table.insert({"id": 2, "email": "one@example.com"}, ignore=True)
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+
+
+def test_insert_ignore_does_not_report_ambiguous_or_constraint_identity(fresh_db):
+    fresh_db.conn.execute(
+        "create table users "
+        "(id integer primary key, email text unique, required text not null)"
+    )
+    table = fresh_db["users"]
+    table.insert({"id": 1, "email": "one@example.com", "required": "yes"})
+    table.insert({"id": 2, "email": "two@example.com", "required": "yes"})
+
+    table.insert({"id": 1, "email": "two@example.com", "required": "yes"}, ignore=True)
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+    table.insert({"id": 3, "email": "three@example.com"}, ignore=True)
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
+def test_insert_ignore_list_mode_reports_existing_identity(fresh_db):
+    table = fresh_db["items"].insert({"id": 1, "value": "original"}, pk="id")
+
+    table.insert_all([["id", "value"], [1, "ignored"]], pk="id", ignore=True)
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+
+
+def test_insert_ignore_preserves_hash_id_and_input_record(fresh_db):
+    table = fresh_db["items"]
+    record = {"name": "Cleo", "species": "dog"}
+    expected_record = dict(record)
+    expected_pk = table.insert(record, hash_id="id").last_pk
+    assert record == expected_record
+
+    table.insert(record, hash_id="id", ignore=True)
+
+    assert record == expected_record
+    assert table.last_pk == expected_pk
+    assert table.last_rowid == 1
+
+
