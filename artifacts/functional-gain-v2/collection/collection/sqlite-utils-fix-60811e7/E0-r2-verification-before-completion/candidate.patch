+    def _ignored_insert_identity(
+        self, record: Dict[str, Any]
+    ) -> Optional[Tuple[Any, Optional[int]]]:
+        """Return the identity of an existing row conflicting with ``record``.
+
+        An INSERT OR IGNORE can also be ignored by constraints that do not
+        identify an existing row (for example NOT NULL or CHECK).  Only return
+        an identity when the supplied values match exactly one existing row
+        through a primary key or non-partial unique index.
+        """
+        columns = self.columns_dict
+        values = dict(record)
+        hidden_rowid_alias = None
+
+        # Unshadowed rowid aliases all refer to the same hidden primary key.
+        if self.use_rowid:
+            aliases = ("rowid", "_rowid_", "oid")
+            hidden_aliases = [
+                alias
+                for alias in aliases
+                if resolve_casing(alias, columns) not in columns
+            ]
+            if hidden_aliases:
+                hidden_rowid_alias = hidden_aliases[0]
+            supplied_alias_values = []
+            for alias in hidden_aliases:
+                actual = resolve_casing(alias, values)
+                if actual in values:
+                    supplied_alias_values.append(values[actual])
+            if supplied_alias_values and all(
+                value == supplied_alias_values[0] for value in supplied_alias_values
+            ):
+                values[hidden_rowid_alias] = supplied_alias_values[0]
+
+        constraints = []
+        if self.use_rowid:
+            if hidden_rowid_alias and hidden_rowid_alias in values:
+                constraints.append((hidden_rowid_alias,))
+        else:
+            constraints.append(tuple(self.pks))
+        constraints.extend(
+            tuple(index.columns)
+            for index in self.indexes
+            if index.unique and not index.partial and all(index.columns)
+        )
+
+        matching_identities = []
+        seen_constraints = set()
+        for constraint in constraints:
+            folded_constraint = tuple(fold_identifier_case(c) for c in constraint)
+            if folded_constraint in seen_constraints:
+                continue
+            seen_constraints.add(folded_constraint)
+            resolved = [resolve_casing(column, values) for column in constraint]
+            if any(
+                column not in values or values[column] is None for column in resolved
+            ):
+                continue
+            where = " AND ".join(
+                "{} = ?".format(quote_identifier(column)) for column in constraint
+            )
+            try:
+                rows = list(
+                    self.rows_where(
+                        where,
+                        [values[column] for column in resolved],
+                        select='{} AS "__sqlite_utils_rowid__", *'.format(
+                            quote_identifier(hidden_rowid_alias or "rowid")
+                        ),
+                        limit=2,
+                    )
+                )
+            except OperationalError:
+                # WITHOUT ROWID tables still have a usable declared PK.
+                rows = list(
+                    self.rows_where(
+                        where,
+                        [values[column] for column in resolved],
+                        limit=2,
+                    )
+                )
+            if len(rows) != 1:
+                continue
+            row = rows[0]
+            rowid = row.get("__sqlite_utils_rowid__")
+            if self.use_rowid:
+                last_pk = rowid
+            else:
+                pk_values = tuple(row[resolve_casing(pk, row)] for pk in self.pks)
+                last_pk = pk_values[0] if len(pk_values) == 1 else pk_values
+            matching_identities.append((last_pk, rowid))
+
+        if not matching_identities:
+            return None
+        first_identity = matching_identities[0]
+        if any(identity != first_identity for identity in matching_identities[1:]):
+            return None
+        return first_identity
+
