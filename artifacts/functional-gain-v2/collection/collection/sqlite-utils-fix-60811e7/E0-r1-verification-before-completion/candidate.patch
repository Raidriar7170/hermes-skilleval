+    def _ignored_insert_identity(
+        self,
+        record: Dict[str, Any],
+        conversions: Optional[Dict[str, str]] = None,
+    ) -> Optional[Tuple[Any, Optional[int]]]:
+        """Resolve the identity of a row that caused an INSERT OR IGNORE.
+
+        More than one unique constraint can reject an insert, potentially due
+        to different existing rows. Only return an identity if every matching
+        constraint points at the same row.
+        """
+        conversions = conversions or {}
+        record_keys = {key.casefold(): key for key in record}
+        # Each constraint is a tuple of (column name, collation) pairs. A
+        # collation from an explicit index must be repeated in the lookup or
+        # values such as "A" and "a" may fail to find a NOCASE conflict.
+        constraints: List[Tuple[Tuple[str, Optional[str]], ...]] = []
+        declared_pks = [column.name for column in self.columns if column.is_pk]
+        if declared_pks:
+            constraints.append(tuple((column, None) for column in declared_pks))
+        else:
+            # Any unshadowed SQLite rowid alias can identify a rowid conflict.
+            for alias in ("rowid", "_rowid_", "oid"):
+                if alias in record_keys and alias not in {
+                    column.name.casefold() for column in self.columns
+                }:
+                    constraints.append(((record_keys[alias], None),))
+        xindexes = {index.name: index for index in self.xindexes}
+        for index in self.indexes:
+            # Partial and expression indexes cannot be safely reconstructed
+            # from their indexed column values alone.
+            if index.unique and not index.partial and all(index.columns):
+                xindex = xindexes[index.name]
+                columns = tuple(
+                    (column.name, column.coll)
+                    for column in xindex.columns
+                    if column.key and column.name is not None
+                )
+                if columns and columns not in constraints:
+                    constraints.append(columns)
+
+        physical_columns = {column.name.casefold() for column in self.columns}
+        rowid_alias = next(
+            (
+                alias
+                for alias in ("rowid", "_rowid_", "oid")
+                if alias not in physical_columns
+            ),
+            None,
+        )
+        select_parts = []
+        if rowid_alias is not None and "WITHOUT ROWID" not in self.schema.upper():
+            select_parts.append(
+                "{} AS {}".format(
+                    quote_identifier(rowid_alias),
+                    quote_identifier("__sqlite_utils_rowid"),
+                )
+            )
+        select_parts.extend(quote_identifier(column) for column in declared_pks)
+        if not select_parts:
+            return None
+
+        matches = set()
+        identities = {}
+        for constraint in constraints:
+            resolved = []
+            values = []
+            for column, collation in constraint:
+                key = record_keys.get(column.casefold())
+                if key is None or record[key] is None:
+                    break
+                resolved.append((column, collation, conversions.get(key, "?")))
+                values.append(record[key])
+            else:
+                rows = list(
+                    self.rows_where(
+                        " AND ".join(
+                            "{}{} = {}".format(
+                                quote_identifier(column),
+                                (
+                                    " COLLATE {}".format(quote_identifier(collation))
+                                    if collation
+                                    else ""
+                                ),
+                                conversion,
+                            )
+                            for column, collation, conversion in resolved
+                        ),
+                        values,
+                        select=", ".join(select_parts),
+                        limit=2,
+                    )
+                )
+                for row in rows:
+                    rowid = row.get("__sqlite_utils_rowid")
+                    if declared_pks:
+                        pk_values = tuple(row[column] for column in declared_pks)
+                        last_pk = pk_values[0] if len(pk_values) == 1 else pk_values
+                        identity_key = ("pk",) + pk_values
+                    else:
+                        last_pk = rowid
+                        identity_key = ("rowid", rowid)
+                    matches.add(identity_key)
+                    identities[identity_key] = (last_pk, rowid)
+        if len(matches) == 1:
+            return identities[next(iter(matches))]
+        return None
