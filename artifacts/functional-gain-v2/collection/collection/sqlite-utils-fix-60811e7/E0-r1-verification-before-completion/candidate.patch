index 0000000000000000000000000000000000000000..18d2e38d993d3014eb2e046243cd742108b99cff
--- /dev/null
+++ b/tests/test_insert_identity.py
@@ -0,0 +1,154 @@
+import pytest
+
+from sqlite_utils import Database
+
+
+@pytest.mark.parametrize("alias", ("rowid", "_rowid_", "oid"))
+@pytest.mark.parametrize("operation", ("upsert", "replace", "ignore"))
+@pytest.mark.parametrize("use_old_upsert", (False, True))
+def test_rowid_alias_primary_key_reporting(alias, operation, use_old_upsert):
+    db = Database(memory=True, use_old_upsert=use_old_upsert)
+    table = db["items"]
+    table.insert({"name": "original"})
+
+    record = {alias: 1, "name": "changed"}
+    if operation == "upsert":
+        table.upsert(record, pk=alias)
+        assert table.get(1)["name"] == "changed"
+    elif operation == "replace":
+        table.insert(record, pk=alias, replace=True)
+        assert table.get(1)["name"] == "changed"
+    else:
+        table.insert(record, pk=alias, ignore=True)
+        assert table.get(1)["name"] == "original"
+        assert table.last_rowid == 1
+    assert table.last_pk == 1
+
+
+def test_insert_ignore_reports_row_that_conflicted_on_unique_column():
+    db = Database(memory=True)
+    db.execute("create table users (id integer primary key, email text unique, name text)")
+    table = db["users"]
+    table.insert({"id": 1, "email": "a@example.com", "name": "Original"})
+
+    record = {"id": 2, "email": "a@example.com", "name": "Ignored"}
+    table.insert(record, ignore=True)
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+    assert record == {"id": 2, "email": "a@example.com", "name": "Ignored"}
+    assert table.get(1)["name"] == "Original"
+
+
+def test_insert_ignore_reports_compound_primary_key_in_list_mode():
+    db = Database(memory=True)
+    db.execute(
+        "create table memberships (team text, user text, email text unique, "
+        "primary key (team, user))"
+    )
+    table = db["memberships"]
+    table.insert({"team": "A", "user": "one", "email": "same"})
+
+    table.insert_all(
+        [["team", "user", "email"], ["B", "two", "same"]], ignore=True
+    )
+
+    assert table.last_pk == ("A", "one")
+    assert table.last_rowid == 1
+
+
+def test_insert_ignore_does_not_report_ambiguous_conflicting_row():
+    db = Database(memory=True)
+    db.execute(
+        "create table users (id integer primary key, email text unique, handle text unique)"
+    )
+    table = db["users"]
+    table.insert_all(
+        [
+            {"id": 1, "email": "a", "handle": "one"},
+            {"id": 2, "email": "b", "handle": "two"},
+        ]
+    )
+
+    table.insert({"id": 3, "email": "a", "handle": "two"}, ignore=True)
+
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
+def test_insert_ignore_unresolvable_constraint_has_no_identity():
+    db = Database(memory=True)
+    db.execute("create table items (id integer primary key, name text not null)")
+    table = db["items"]
+    table.insert({"id": 1, "name": None}, ignore=True)
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
+def test_insert_ignore_preserves_hash_id_and_original_values():
+    db = Database(memory=True)
+    table = db["items"]
+    record = {"name": "Cleo", "kind": "cat"}
+    expected_pk = table.insert(record, hash_id="id").last_pk
+
+    table.insert(record, hash_id="id", ignore=True)
+
+    assert table.last_pk == expected_pk
+    assert table.last_rowid == 1
+    assert record == {"name": "Cleo", "kind": "cat"}
+    assert list(table.rows) == [{"id": expected_pk, "kind": "cat", "name": "Cleo"}]
+
+
+def test_ordinary_insert_identity_and_values_are_unchanged():
+    db = Database(memory=True)
+    table = db["items"]
+    record = {"name": "Cleo"}
+
+    table.insert(record)
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+    assert record == {"name": "Cleo"}
+
+
+def test_insert_ignore_resolves_collated_unique_index():
+    db = Database(memory=True)
+    db.execute("create table users (id integer primary key, email text)")
+    db.execute("create unique index users_email on users(email collate nocase)")
+    table = db["users"]
+    table.insert({"id": 1, "email": "A@example.com"})
+
+    table.insert({"id": 2, "email": "a@example.com"}, ignore=True)
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+
+
+def test_insert_ignore_resolves_values_after_conversion():
+    db = Database(memory=True)
+    db.execute("create table users (id integer primary key, name text unique)")
+    table = db["users"]
+    table.insert({"id": 1, "name": "cleo"})
+
+    table.insert(
+        {"id": 2, "name": "CLEO"},
+        ignore=True,
+        conversions={"name": "lower(?)"},
+    )
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+
+
+def test_insert_ignore_resolves_extracted_values_without_mutating_record():
+    db = Database(memory=True)
+    db.execute("create table sightings (id integer primary key, species integer unique)")
+    table = db["sightings"]
+    table.insert({"id": 1, "species": "dog"}, extracts=["species"])
+    record = {"id": 2, "species": "dog"}
+
+    table.insert(record, ignore=True, extracts=["species"])
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+    assert record == {"id": 2, "species": "dog"}
