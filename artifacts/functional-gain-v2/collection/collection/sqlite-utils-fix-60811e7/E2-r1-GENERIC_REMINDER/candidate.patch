index 42fa1c4222e2597a6a303480eb1b71841f924ddc..130b0016d073310a806a3f497877a41ae57943c3 100644
--- a/tests/test_create.py
+++ b/tests/test_create.py
@@ -1008,6 +1008,185 @@ def test_insert_ignore_with_pk_after_other_table_insert(fresh_db):
     assert list(fresh_db["users"].rows) == [user]
 
 
+@pytest.mark.parametrize("pk", ("rowid", "_rowid_", "oid"))
+@pytest.mark.parametrize("operation", ("upsert", "replace", "ignore"))
+@pytest.mark.parametrize("declared_pk", (False, True))
+def test_rowid_alias_pk_reporting(fresh_db, pk, operation, declared_pk):
+    if declared_pk:
+        fresh_db.conn.execute(
+            "create table items (id integer primary key, value text)"
+        )
+    table = fresh_db["items"]
+    table.insert(
+        {"id": 1, "value": "original"}
+        if declared_pk
+        else {"value": "original"}
+    )
+
+    record = {pk: 1, "value": "new"}
+    if operation == "upsert":
+        table.upsert(record, pk=pk)
+    else:
+        table.insert(
+            record,
+            pk=pk,
+            replace=operation == "replace",
+            ignore=operation == "ignore",
+        )
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+    expected = {"value": "original" if operation == "ignore" else "new"}
+    if declared_pk:
+        expected = {"id": 1, **expected}
+    assert list(table.rows) == [expected]
+
+
+@pytest.mark.parametrize("list_mode", (False, True))
+def test_insert_ignore_reports_row_for_other_unique_constraint(fresh_db, list_mode):
+    fresh_db.conn.execute(
+        "create table users (id integer primary key, email text unique, name text)"
+    )
+    table = fresh_db["users"]
+    table.insert({"id": 1, "email": "one@example.com", "name": "Original"})
+    record = {"id": 2, "email": "one@example.com", "name": "Replacement"}
+    records = (
+        [["id", "email", "name"], list(record.values())]
+        if list_mode
+        else [record]
+    )
+
+    table.insert_all(records, pk="id", ignore=True)
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+    assert list(table.rows) == [
+        {"id": 1, "email": "one@example.com", "name": "Original"}
+    ]
+
+
+@pytest.mark.parametrize("list_mode", (False, True))
+def test_insert_ignore_reports_compound_pk(fresh_db, list_mode):
+    fresh_db.conn.execute(
+        "create table memberships (team text, person integer, role text, "
+        "primary key (team, person))"
+    )
+    table = fresh_db["memberships"]
+    table.insert({"team": "A", "person": 1, "role": "admin"})
+    record = {"team": "A", "person": 1, "role": "member"}
+    records = (
+        [["team", "person", "role"], list(record.values())]
+        if list_mode
+        else [record]
+    )
+
+    table.insert_all(records, pk=("team", "person"), ignore=True)
+
+    assert table.last_pk == ("A", 1)
+    assert table.last_rowid == 1
+    assert list(table.rows)[0]["role"] == "admin"
+
+
+def test_insert_ignore_does_not_report_ambiguous_conflict(fresh_db):
+    fresh_db.conn.execute(
+        "create table pairs (id integer primary key, left_value text unique, "
+        "right_value text unique)"
+    )
+    table = fresh_db["pairs"]
+    table.insert({"id": 1, "left_value": "a", "right_value": "b"})
+    table.insert({"id": 2, "left_value": "c", "right_value": "d"})
+
+    table.insert(
+        {"id": 3, "left_value": "a", "right_value": "d"},
+        pk="id",
+        ignore=True,
+    )
+
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
+def test_insert_ignore_does_not_treat_non_unique_pk_as_conflict(fresh_db):
+    fresh_db.conn.execute("create table checks (id integer, value integer check(value > 0))")
+    table = fresh_db["checks"]
+    table.insert({"id": 1, "value": 1})
+
+    table.insert({"id": 1, "value": -1}, pk="id", ignore=True)
+
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
+def test_insert_ignore_resolves_unique_conflict_despite_non_unique_pk(fresh_db):
+    fresh_db.conn.execute("create table contacts (id integer, email text unique)")
+    table = fresh_db["contacts"]
+    table.insert({"id": 1, "email": "one@example.com"})
+    table.insert({"id": 2, "email": "two@example.com"})
+
+    table.insert(
+        {"id": 1, "email": "two@example.com"}, pk="id", ignore=True
+    )
+
+    assert table.last_pk == 2
+    assert table.last_rowid == 2
+
+
+def test_insert_ignore_same_non_unique_pk_does_not_hide_ambiguity(fresh_db):
+    fresh_db.conn.execute(
+        "create table ambiguous (id integer, left_value text unique, "
+        "right_value text unique)"
+    )
+    table = fresh_db["ambiguous"]
+    table.insert({"id": 1, "left_value": "a", "right_value": "b"})
+    table.insert({"id": 1, "left_value": "c", "right_value": "d"})
+
+    table.insert(
+        {"id": 1, "left_value": "a", "right_value": "d"},
+        pk="id",
+        ignore=True,
+    )
+
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
+@pytest.mark.parametrize(
+    "value,conversion",
+    (({"key": "value"}, None), ("mixed-case", "upper(?)")),
+)
+def test_insert_ignore_resolves_converted_unique_values(
+    fresh_db, value, conversion
+):
+    fresh_db.conn.execute(
+        "create table converted (id integer primary key, value text unique)"
+    )
+    table = fresh_db["converted"]
+    stored_value = "MIXED-CASE" if conversion else value
+    table.insert({"id": 1, "value": stored_value})
+
+    table.insert(
+        {"id": 2, "value": value},
+        pk="id",
+        ignore=True,
+        conversions={"value": conversion} if conversion else None,
+    )
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+
+
+def test_insert_ignore_hash_id_identity_and_original_record(fresh_db):
+    record = {"name": "Cleo", "twitter": "cleopaws"}
+    table = fresh_db["dogs"]
+    expected_hash = table.insert(record, hash_id="id").last_pk
+
+    table.insert(record, hash_id="id", ignore=True)
+
+    assert table.last_pk == expected_hash
+    assert table.last_rowid == 1
+    assert record == {"name": "Cleo", "twitter": "cleopaws"}
+
