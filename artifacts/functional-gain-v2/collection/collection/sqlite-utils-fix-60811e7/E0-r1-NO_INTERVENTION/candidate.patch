+@pytest.mark.parametrize("alias", ("rowid", "_rowid_", "oid"))
+@pytest.mark.parametrize("operation", ("upsert", "replace", "ignore"))
+def test_rowid_alias_as_pk(fresh_db, alias, operation):
+    table = fresh_db["items"]
+    table.insert({"name": "original"})
+
+    record = {alias: 1, "name": "updated"}
+    if operation == "upsert":
+        table.upsert(record, pk=alias)
+    else:
+        table.insert(
+            record,
+            pk=alias,
+            replace=operation == "replace",
+            ignore=operation == "ignore",
+        )
+
+    assert table.last_pk == 1
+    assert list(table.rows) == [
+        {"name": "original" if operation == "ignore" else "updated"}
+    ]
+    if operation == "ignore":
+        assert table.last_rowid == 1
+
+
+def test_insert_ignore_reports_row_that_conflicted_on_unique_index(fresh_db):
+    table = fresh_db["users"]
+    table.insert({"id": 1, "email": "one@example.com"}, pk="id")
+    table.create_index(["email"], unique=True)
+
+    table.insert({"id": 2, "email": "one@example.com"}, pk="id", ignore=True)
+
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+
+
+def test_insert_ignore_reports_compound_pk_in_list_mode(fresh_db):
+    fresh_db.conn.execute(
+        "create table memberships (team text, person text, role text, "
+        "primary key (team, person))"
+    )
+    table = fresh_db["memberships"]
+    table.insert({"team": "A", "person": "Sam", "role": "admin"})
+
+    table.insert_all(
+        [["team", "person", "role"], ["A", "Sam", "member"]],
+        ignore=True,
+    )
+
+    assert table.last_pk == ("A", "Sam")
+    assert table.last_rowid == 1
+    assert list(table.rows)[0]["role"] == "admin"
+
+
+def test_insert_ignore_does_not_report_unresolvable_identity(fresh_db):
+    table = fresh_db["items"]
+    table.create({"id": int, "required": str}, pk="id", not_null=("required",))
+
+    table.insert({"id": 1, "required": None}, ignore=True)
+
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
+def test_insert_ignore_does_not_choose_between_different_conflicting_rows(fresh_db):
+    table = fresh_db["users"]
+    table.insert_all(
+        [
+            {"id": 1, "email": "one@example.com", "username": "one"},
+            {"id": 2, "email": "two@example.com", "username": "two"},
+        ],
+        pk="id",
+    )
+    table.create_index(["email"], unique=True)
+    table.create_index(["username"], unique=True)
+
+    table.insert(
+        {"id": 3, "email": "one@example.com", "username": "two"},
+        pk="id",
+        ignore=True,
+    )
+
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
+def test_insert_ignore_preserves_hash_id_identity(fresh_db):
+    table = fresh_db["events"]
+    table.insert({"kind": "login", "user": "sue"}, hash_id="id")
+    expected_pk = table.last_pk
+    expected_rowid = table.last_rowid
+
+    table.insert({"kind": "login", "user": "sue"}, hash_id="id", ignore=True)
+
+    assert table.last_pk == expected_pk
+    assert table.last_rowid == expected_rowid
+
+
+def test_insert_ignore_reports_compound_pk_without_rowid(fresh_db):
+    fresh_db.conn.execute(
+        "create table pairs (left text, right text, value text, "
+        "primary key (left, right)) without rowid"
+    )
+    table = fresh_db["pairs"]
+    table.insert({"left": "a", "right": "b", "value": "original"})
+
+    table.insert({"left": "a", "right": "b", "value": "new"}, ignore=True)
+
+    assert table.last_pk == ("a", "b")
+    assert table.last_rowid is None
+
+
