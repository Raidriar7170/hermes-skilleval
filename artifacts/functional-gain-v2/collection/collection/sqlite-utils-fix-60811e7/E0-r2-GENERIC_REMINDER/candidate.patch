index 0000000000000000000000000000000000000000..133f0472b1c9e267ac1f5edac20b8a9a98f3527a
--- /dev/null
+++ b/tests/test_insert_identity.py
@@ -0,0 +1,118 @@
+import pytest
+
+from sqlite_utils import Database
+from sqlite_utils.db import hash_record
+
+
+@pytest.mark.parametrize("alias", ("rowid", "_rowid_", "oid"))
+@pytest.mark.parametrize("operation", ("upsert", "replace", "ignore"))
+def test_rowid_alias_primary_key_reporting(alias, operation):
+    db = Database(memory=True)
+    table = db["items"]
+    table.insert({"name": "original"})
+
+    record = {alias: 1, "name": "new"}
+    if operation == "upsert":
+        table.upsert(record, pk=alias)
+        expected_name = "new"
+    else:
+        table.insert(
+            record,
+            pk=alias,
+            replace=operation == "replace",
+            ignore=operation == "ignore",
+        )
+        expected_name = "original" if operation == "ignore" else "new"
+
+    assert list(table.rows) == [{"name": expected_name}]
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+
+
+@pytest.mark.parametrize("alias", ("rowid", "_rowid_", "oid"))
+@pytest.mark.parametrize("use_old_upsert", (False, True))
+def test_rowid_alias_upsert_reporting_in_list_mode(alias, use_old_upsert):
+    db = Database(memory=True, use_old_upsert=use_old_upsert)
+    table = db["items"]
+    table.insert({"name": "original"})
+
+    table.upsert_all([[alias, "name"], [1, "new"]], pk=alias)
+
+    assert list(table.rows) == [{"name": "new"}]
+    assert table.last_pk == 1
+    assert table.last_rowid == 1
+
+
+def test_insert_ignore_reports_row_from_other_unique_constraint():
+    db = Database(memory=True)
+    db.execute(
+        "create table items (tenant text, id integer, slug text unique, "
+        "primary key (tenant, id))"
+    )
+    table = db["items"]
+    table.insert({"tenant": "a", "id": 1, "slug": "one"})
+
+    attempted = {"tenant": "b", "id": 2, "slug": "one"}
+    table.insert(attempted, ignore=True)
+
+    assert table.last_pk == ("a", 1)
+    assert table.last_rowid == 1
+    assert attempted == {"tenant": "b", "id": 2, "slug": "one"}
+
+
+def test_insert_ignore_reports_compound_pk_in_list_mode():
+    db = Database(memory=True)
+    table = db["items"]
+    table.insert({"tenant": "a", "id": 1, "value": "old"}, pk=("tenant", "id"))
+
+    table.insert_all(
+        [["tenant", "id", "value"], ["a", 1, "new"]],
+        pk=("tenant", "id"),
+        ignore=True,
+    )
+
+    assert table.last_pk == ("a", 1)
+    assert table.last_rowid == 1
+    assert table.get(("a", 1))["value"] == "old"
+
+
+def test_insert_ignore_ambiguous_conflict_has_no_identity():
+    db = Database(memory=True)
+    db.execute("create table items (id integer primary key, value text unique)")
+    table = db["items"]
+    table.insert_all([{"id": 1, "value": "a"}, {"id": 2, "value": "b"}])
+
+    table.insert({"id": 1, "value": "b"}, ignore=True)
+
+    assert table.last_pk is None
+    assert table.last_rowid is None
+
+
+def test_insert_ignore_preserves_hash_id_reporting():
+    db = Database(memory=True)
+    table = db["items"]
+    record = {"name": "one"}
+    expected = hash_record(record)
+    table.insert(record, hash_id="id")
+
+    table.insert(record, hash_id="id", ignore=True)
+
+    assert table.last_pk == expected
+    assert table.last_rowid == 1
+    assert record == {"name": "one"}
+
+
+def test_insert_ignore_without_rowid_reports_compound_pk():
+    db = Database(memory=True)
+    db.execute(
+        "create table items (tenant text, id integer, value text, "
+        "primary key (tenant, id)) without rowid"
+    )
+    table = db["items"]
+    table.insert({"tenant": "a", "id": 1, "value": "old"})
+
+    table.insert({"tenant": "a", "id": 1, "value": "new"}, ignore=True)
+
+    assert table.last_pk == ("a", 1)
+    assert table.last_rowid is None
+    assert table.get(("a", 1))["value"] == "old"
