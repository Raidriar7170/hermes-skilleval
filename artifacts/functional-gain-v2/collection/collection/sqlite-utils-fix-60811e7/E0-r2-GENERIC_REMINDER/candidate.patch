+    def _resolve_insert_ignore(
+        self, attempted_record: Dict[str, Any]
+    ) -> Optional[Tuple[Any, Optional[int]]]:
+        """Return the identity of the row that made INSERT OR IGNORE a no-op.
+
+        A conflict is only considered resolvable when a complete, non-NULL
+        primary key or non-partial unique index identifies exactly one row.
+        This deliberately returns None instead of guessing from the attempted
+        primary key when a different constraint may have caused the conflict.
+        """
+        actual_columns = self.columns_dict
+        values = {
+            resolve_casing(key, actual_columns): value
+            for key, value in attempted_record.items()
+        }
+        if self.use_rowid:
+            supplied_rowid = next(
+                (
+                    value
+                    for key, value in attempted_record.items()
+                    if key.lower() in ROWID_ALIASES
+                ),
+                None,
+            )
+            if supplied_rowid is not None:
+                # SQLite's three hidden row identifier spellings are
+                # interchangeable unless shadowed by a declared column.
+                values.update({alias: supplied_rowid for alias in ROWID_ALIASES})
+        unique_column_sets = [self.pks]
+        unique_column_sets.extend(
+            index.columns
+            for index in self.indexes
+            if index.unique and not index.partial and all(index.columns)
+        )
+        # Use an unshadowed rowid spelling where one is available.
+        rowid_name = None
+        if not re.search(r"\bWITHOUT\s+ROWID\b", self.schema, re.IGNORECASE):
+            rowid_name = next(
+                (
+                    alias
+                    for alias in ("rowid", "_rowid_", "oid")
+                    if alias not in actual_columns
+                ),
+                None,
+            )
+        rowid_result_key = "__sqlite_utils_rowid__"
+        identities = set()
+        for columns in unique_column_sets:
+            lookup_columns = [resolve_casing(column, values) for column in columns]
+            if any(
+                column not in values or values[column] is None
+                for column in lookup_columns
+            ):
+                continue
+            selected = list(self.pks)
+            selected_sql = [quote_identifier(column) for column in selected]
+            if rowid_name is not None:
+                selected_sql.insert(
+                    0,
+                    "{} as {}".format(
+                        quote_identifier(rowid_name),
+                        quote_identifier(rowid_result_key),
+                    ),
+                )
+            sql = "select {} from {} where {} limit 2".format(
+                ", ".join(selected_sql),
+                quote_identifier(self.name),
+                " and ".join(
+                    "{} = ?".format(quote_identifier(column)) for column in columns
+                ),
+            )
+            rows = list(
+                self.db.query(sql, [values[column] for column in lookup_columns])
+            )
+            if len(rows) == 1:
+                row = rows[0]
+                pk_values = tuple(row[column] for column in self.pks)
+                last_pk = pk_values[0] if len(pk_values) == 1 else pk_values
+                last_rowid = (
+                    row[rowid_result_key] if rowid_name is not None else None
+                )
+                identities.add((last_pk, last_rowid))
+        return identities.pop() if len(identities) == 1 else None
