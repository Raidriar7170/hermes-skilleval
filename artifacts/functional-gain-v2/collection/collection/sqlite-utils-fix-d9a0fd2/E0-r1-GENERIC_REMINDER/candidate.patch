diff --git a/tests/test_query.py b/tests/test_query.py
index f4aa3369f49e0a25b5e1139cc22bb963837b76b5..d19cf07a6ba787ba195c3181e81cf2b28b98bfa2 100644
--- a/tests/test_query.py
+++ b/tests/test_query.py
@@ -110,6 +110,54 @@ def test_query_error_leaves_no_transaction_open(fresh_db):
     assert not fresh_db.conn.in_transaction
 
 
+def test_query_preserves_error_from_transaction_destroying_trigger(fresh_db):
+    fresh_db.execute("create table t (id integer primary key, v text)")
+    fresh_db.execute(
+        """
+        create trigger no_bad before insert on t
+        when new.v = 'bad'
+        begin
+            select raise(rollback, 'trigger says no');
+        end
+        """
+    )
+    with pytest.raises(sqlite3.IntegrityError, match="trigger says no"):
+        fresh_db.query("insert into t (v) values ('bad') returning id")
+    assert not fresh_db.conn.in_transaction
+    assert fresh_db.execute("select count(*) from t").fetchone()[0] == 0
+
+
+def test_query_preserves_trigger_error_inside_transaction(fresh_db):
+    fresh_db.execute("create table t (id integer primary key, v text)")
+    fresh_db.execute(
+        """
+        create trigger no_bad before insert on t
+        when new.v = 'bad'
+        begin
+            select raise(rollback, 'trigger says no');
+        end
+        """
+    )
+    fresh_db.begin()
+    fresh_db.execute("insert into t (v) values ('before')")
+    with pytest.raises(sqlite3.IntegrityError, match="trigger says no"):
+        fresh_db.query("insert into t (v) values ('bad') returning id")
+    # RAISE(ROLLBACK) destroys the caller's transaction and query savepoint,
+    # including writes made before query() was called.
+    assert not fresh_db.conn.in_transaction
+    assert fresh_db.execute("select count(*) from t").fetchone()[0] == 0
+
+
+def test_query_preserves_error_from_insert_or_rollback(fresh_db):
+    fresh_db["t"].insert({"id": 1}, pk="id")
+    with pytest.raises(sqlite3.IntegrityError):
+        fresh_db.query("insert or rollback into t (id) values (1) returning id")
+    assert not fresh_db.conn.in_transaction
+    fresh_db.execute("insert into t (id) values (2)")
+    assert not fresh_db.conn.in_transaction
+    assert [row["id"] for row in fresh_db["t"].rows] == [1, 2]
+
+
