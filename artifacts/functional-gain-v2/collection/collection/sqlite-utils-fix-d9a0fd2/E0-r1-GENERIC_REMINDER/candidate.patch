                 yield self
             except BaseException:
-                self.conn.execute("ROLLBACK TO SAVEPOINT {};".format(savepoint))
-                self.conn.execute("RELEASE SAVEPOINT {};".format(savepoint))
+                # RAISE(ROLLBACK) and INSERT OR ROLLBACK roll back the whole
+                # transaction, including every savepoint. Do not replace the
+                # original exception with "no such savepoint" in that case.
+                if self.conn.in_transaction:
+                    try:
+                        self.conn.execute(
+                            "ROLLBACK TO SAVEPOINT {};".format(savepoint)
+                        )
+                        self.conn.execute("RELEASE SAVEPOINT {};".format(savepoint))
+                    except sqlite3.OperationalError:
+                        # If the savepoint was removed independently, ensure no
+                        # partial transaction is left behind while preserving
+                        # the exception raised from the body of the block.
+                        if self.conn.in_transaction:
+                            self.conn.execute("ROLLBACK")
                 raise
             else:
                 self.conn.execute("RELEASE SAVEPOINT {};".format(savepoint))
@@ -612,7 +625,9 @@ class Database:
             try:
                 yield self
             except BaseException:
-                self.conn.execute("ROLLBACK")
+                # A ROLLBACK conflict action may already have ended it.
+                if self.conn.in_transaction:
+                    self.conn.execute("ROLLBACK")
                 raise
             else:
                 try:
@@ -872,8 +887,17 @@ class Database:
         finally:
             if not released:
                 # An error occurred - undo anything the statement changed
-                self.conn.execute('ROLLBACK TO "sqlite_utils_query"')
-                self.conn.execute('RELEASE "sqlite_utils_query"')
+                # unless SQLite already rolled back the entire transaction
+                # (RAISE(ROLLBACK) and INSERT OR ROLLBACK both do that).
+                if self.conn.in_transaction:
+                    try:
+                        self.conn.execute('ROLLBACK TO "sqlite_utils_query"')
+                        self.conn.execute('RELEASE "sqlite_utils_query"')
+                    except sqlite3.OperationalError:
+                        # Preserve the original error and avoid leaving a
+                        # transaction containing partial writes behind.
+                        if self.conn.in_transaction:
