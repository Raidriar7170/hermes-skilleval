     assert not fresh_db.conn.in_transaction
 
 
+def test_query_preserves_error_from_transaction_destroying_trigger(fresh_db):
+    fresh_db.execute("create table t (id integer primary key, v text)")
+    fresh_db.execute(
+        """
+        create trigger no_bad before insert on t when new.v = 'bad'
+        begin select raise(rollback, 'trigger says no'); end
+        """
+    )
+    with pytest.raises(sqlite3.IntegrityError, match="trigger says no"):
+        fresh_db.query("insert into t (v) values ('bad') returning id")
+    assert not fresh_db.conn.in_transaction
+    assert fresh_db.execute("select count(*) from t").fetchone()[0] == 0
+
+
+def test_query_transaction_destroying_trigger_inside_atomic(fresh_db):
+    fresh_db.execute("create table t (id integer primary key, v text)")
+    fresh_db.execute(
+        """
+        create trigger no_bad before insert on t when new.v = 'bad'
+        begin select raise(rollback, 'trigger says no'); end
+        """
+    )
+    with pytest.raises(sqlite3.IntegrityError, match="trigger says no"):
+        with fresh_db.atomic():
+            fresh_db.execute("insert into t (v) values ('good')")
+            fresh_db.query("insert into t (v) values ('bad') returning id")
+    assert not fresh_db.conn.in_transaction
+    assert fresh_db.execute("select count(*) from t").fetchone()[0] == 0
+
+
+def test_query_preserves_error_from_insert_or_rollback(fresh_db):
+    fresh_db.execute("create table t (id integer primary key)")
+    fresh_db.execute("insert into t values (1)")
+    with pytest.raises(sqlite3.IntegrityError):
+        fresh_db.query("insert or rollback into t values (1) returning id")
+    assert not fresh_db.conn.in_transaction
+    assert fresh_db.execute("select id from t").fetchall() == [(1,)]
+
+
