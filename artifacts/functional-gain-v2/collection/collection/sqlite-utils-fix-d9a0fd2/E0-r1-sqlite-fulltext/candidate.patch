diff --git a/tests/test_query.py b/tests/test_query.py
index f4aa3369f49e0a25b5e1139cc22bb963837b76b5..5b2785df7e7ba7fe7c719ede0311c643b3855dd1 100644
--- a/tests/test_query.py
