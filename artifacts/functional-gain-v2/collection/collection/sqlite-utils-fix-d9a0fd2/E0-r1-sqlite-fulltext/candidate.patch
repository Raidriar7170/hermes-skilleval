@@ -602,8 +602,13 @@ class Database:
             try:
                 yield self
             except BaseException:
-                self.conn.execute("ROLLBACK TO SAVEPOINT {};".format(savepoint))
-                self.conn.execute("RELEASE SAVEPOINT {};".format(savepoint))
+                # RAISE(ROLLBACK) and INSERT OR ROLLBACK end the entire
+                # transaction, destroying this savepoint in the process. In
+                # that case there is nothing left to clean up, and attempting
+                # ROLLBACK TO would mask the original exception.
+                if self.conn.in_transaction:
+                    self.conn.execute("ROLLBACK TO SAVEPOINT {};".format(savepoint))
+                    self.conn.execute("RELEASE SAVEPOINT {};".format(savepoint))
                 raise
             else:
                 self.conn.execute("RELEASE SAVEPOINT {};".format(savepoint))
@@ -612,7 +617,10 @@ class Database:
             try:
                 yield self
             except BaseException:
-                self.conn.execute("ROLLBACK")
+                # SQLite may already have rolled back the transaction (for
+                # example, due to RAISE(ROLLBACK) or INSERT OR ROLLBACK).
+                if self.conn.in_transaction:
+                    self.conn.execute("ROLLBACK")
                 raise
             else:
                 try:
@@ -872,8 +880,11 @@ class Database:
         finally:
             if not released:
                 # An error occurred - undo anything the statement changed
-                self.conn.execute('ROLLBACK TO "sqlite_utils_query"')
-                self.conn.execute('RELEASE "sqlite_utils_query"')
+                # unless SQLite already rolled back the whole transaction and
+                # destroyed the savepoint. Avoid masking that original error.
+                if self.conn.in_transaction:
+                    self.conn.execute('ROLLBACK TO "sqlite_utils_query"')
+                    self.conn.execute('RELEASE "sqlite_utils_query"')
 
     def execute(
