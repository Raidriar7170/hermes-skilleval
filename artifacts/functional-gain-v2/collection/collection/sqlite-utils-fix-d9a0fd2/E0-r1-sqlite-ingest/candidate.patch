@@ -602,8 +602,13 @@ class Database:
             try:
                 yield self
             except BaseException:
-                self.conn.execute("ROLLBACK TO SAVEPOINT {};".format(savepoint))
-                self.conn.execute("RELEASE SAVEPOINT {};".format(savepoint))
+                # RAISE(ROLLBACK) and INSERT OR ROLLBACK roll back the whole
+                # transaction, destroying every savepoint. In that case there
+                # is nothing left to clean up, and attempting to do so would
+                # mask the original IntegrityError with "no such savepoint".
+                if self.conn.in_transaction:
+                    self.conn.execute("ROLLBACK TO SAVEPOINT {};".format(savepoint))
+                    self.conn.execute("RELEASE SAVEPOINT {};".format(savepoint))
                 raise
             else:
                 self.conn.execute("RELEASE SAVEPOINT {};".format(savepoint))
@@ -612,13 +617,18 @@ class Database:
             try:
                 yield self
             except BaseException:
-                self.conn.execute("ROLLBACK")
+                # The failing statement may already have rolled back the
+                # transaction (for example RAISE(ROLLBACK)). Preserve that
+                # original exception instead of issuing a redundant ROLLBACK.
+                if self.conn.in_transaction:
+                    self.conn.execute("ROLLBACK")
                 raise
             else:
                 try:
                     self.conn.execute("COMMIT")
                 except BaseException:
-                    self.conn.execute("ROLLBACK")
+                    if self.conn.in_transaction:
+                        self.conn.execute("ROLLBACK")
                     raise
 
     def begin(self) -> None:
@@ -870,8 +880,10 @@ class Database:
                 return (dict(zip(keys, row)) for row in fetched)
             return (dict(zip(keys, row)) for row in cursor)
         finally:
-            if not released:
+            if not released and self.conn.in_transaction:
                 # An error occurred - undo anything the statement changed
+                # unless the statement itself rolled back the transaction and
+                # destroyed this savepoint (RAISE(ROLLBACK) / OR ROLLBACK).
                 self.conn.execute('ROLLBACK TO "sqlite_utils_query"')
                 self.conn.execute('RELEASE "sqlite_utils_query"')
 
