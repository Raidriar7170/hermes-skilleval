--- /dev/null
+++ b/tests/test_utilities/test_csvpy.py
@@ -0,0 +1,33 @@
+import csv
+import tempfile
+from unittest.mock import patch
+
+from csvkit.utilities.csvpy import CSVPy
+from tests.utils import CSVKitTestCase
+
+
+class TestCSVPy(CSVKitTestCase):
+    Utility = CSVPy
+
+    def run_csvpy(self, args, expected):
+        def interact(_banner, local):
+            self.assertEqual(list(local['reader']), expected)
+
+        with patch('code.interact', side_effect=interact):
+            self.Utility(args).run()
+
+    def test_dict_maxfieldsize(self):
+        previous_limit = csv.field_size_limit()
+        field = 'x' * 140000
+
+        try:
+            with tempfile.NamedTemporaryFile(mode='w+', encoding='utf-8', newline='', suffix='.csv') as f:
+                f.write(f'a\n{field}\n')
+                f.flush()
+
+                self.run_csvpy(['--dict', '--maxfieldsize', '150000', f.name], [{'a': field}])
+        finally:
+            csv.field_size_limit(previous_limit)
+
+    def test_dict_ordinary_csv(self):
+        self.run_csvpy(['--dict', 'examples/dummy.csv'], [{'a': '1', 'b': '2', 'c': '3'}])
