+    def get_dict_reader_kwargs(self):
+        """
+        Return CSV reader keyword arguments suitable for ``csv.DictReader``.
+
+        Unlike agate's reader, DictReader doesn't accept ``field_size_limit``.
+        The standard library exposes that setting as process-wide state instead.
+        """
+        kwargs = self.reader_kwargs.copy()
+        field_size_limit = kwargs.pop('field_size_limit', None)
+
+        if field_size_limit:
+            csv.field_size_limit(field_size_limit)
+
+        return kwargs
