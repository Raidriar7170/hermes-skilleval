diff --git a/tests/test_utilities/test_csvpy.py b/tests/test_utilities/test_csvpy.py
new file mode 100644
index 0000000000000000000000000000000000000000..5e2fcfe05c0e0e24e904660338aafcae5bc31f7c
--- /dev/null
+++ b/tests/test_utilities/test_csvpy.py
@@ -0,0 +1,29 @@
+import csv
+import os
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from csvkit.utilities.csvpy import CSVPy
+
+
+class TestCSVPy(unittest.TestCase):
+
+    def test_dict_max_field_size(self):
+        original_limit = csv.field_size_limit()
+        value = 'x' * (original_limit + 1)
+
+        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', delete=False) as f:
+            f.write(f'a\n{value}\n')
+            path = f.name
+
+        def interact(banner, local):
+            self.assertIn('agate.csv.DictReader', banner)
+            self.assertEqual(list(local['reader']), [{'a': value}])
+
+        try:
+            with patch('code.interact', side_effect=interact):
+                CSVPy(['--dict', '--maxfieldsize', str(len(value)), path]).run()
+        finally:
+            csv.field_size_limit(original_limit)
+            os.unlink(path)
