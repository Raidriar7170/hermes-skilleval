index 0000000000000000000000000000000000000000..49beec78025f9e194db129b2803a8702520fb18b
--- /dev/null
+++ b/tests/test_utilities/test_csvpy.py
@@ -0,0 +1,37 @@
+import csv
+import tempfile
+from unittest.mock import patch
+
+from csvkit.utilities.csvpy import CSVPy
+from tests.utils import CSVKitTestCase
+
+
+class TestCSVPy(CSVKitTestCase):
+    Utility = CSVPy
+
+    def test_dict_field_size_limit(self):
+        previous_limit = csv.field_size_limit()
+        self.addCleanup(csv.field_size_limit, previous_limit)
+        value = 'x' * (previous_limit + 1)
+        rows = []
+
+        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8') as f:
+            f.write(f'a\n{value}\n')
+            f.flush()
+
+            with patch('code.interact', side_effect=lambda banner, local: rows.extend(local['reader'])):
+                self.Utility(['--dict', '-z', str(len(value)), f.name]).run()
+
+        self.assertEqual(rows, [{'a': value}])
+
+    def test_dict_field_size_limit_bound(self):
+        previous_limit = csv.field_size_limit()
+        self.addCleanup(csv.field_size_limit, previous_limit)
+
+        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8') as f:
+            f.write('a\n12345\n')
+            f.flush()
+
+            with patch('code.interact', side_effect=lambda banner, local: list(local['reader'])):
+                with self.assertRaises(csv.Error):
+                    self.Utility(['--dict', '-z', '4', f.name]).run()
