+    def _extract_csv_dict_reader_kwargs(self):
+        """
+        Adapt the input CSV reader arguments for ``agate.csv.DictReader``.
+
+        Unlike ``agate.csv.reader``, ``DictReader`` does not accept a
+        ``field_size_limit`` keyword. The underlying csv module's field size
+        limit is process-wide, so apply it before constructing the reader.
+        """
+        kwargs = self.reader_kwargs.copy()
+        field_size_limit = kwargs.pop('field_size_limit', None)
+
+        if field_size_limit is not None:
+            csv.field_size_limit(field_size_limit)
+
+        return kwargs
+
