+    def _extract_csv_dict_reader_kwargs(self):
+        """
+        Extract CSV reader arguments for a DictReader.
+
+        Unlike agate.csv.reader, agate.csv.DictReader does not accept a
+        field_size_limit keyword. Apply that process-wide csv setting before
+        removing it from the keyword arguments passed to DictReader.
+        """
+        kwargs = self.reader_kwargs.copy()
+        field_size_limit = kwargs.pop('field_size_limit', None)
+
+        if field_size_limit:
+            csv.field_size_limit(field_size_limit)
+
+        return kwargs
+
