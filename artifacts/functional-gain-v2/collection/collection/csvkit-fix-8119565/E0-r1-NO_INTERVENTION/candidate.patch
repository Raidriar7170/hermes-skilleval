diff --git a/tests/test_utilities/test_csvpy.py b/tests/test_utilities/test_csvpy.py
new file mode 100644
index 0000000000000000000000000000000000000000..71bea698ca00f53cc60bcb22f58204b0d4096d20
--- /dev/null
+++ b/tests/test_utilities/test_csvpy.py
@@ -0,0 +1,51 @@
+import csv
+import tempfile
+from unittest.mock import patch
+
+from csvkit.utilities.csvpy import CSVPy
+from tests.utils import CSVKitTestCase
+
+
+class TestCSVPy(CSVKitTestCase):
+    Utility = CSVPy
+
+    def test_dict(self):
+        def consume_reader(*args, **kwargs):
+            self.assertEqual(next(kwargs['local']['reader']), {'a': '1', 'b': '2', 'c': '3'})
+
+        with patch('code.interact', side_effect=consume_reader):
+            self.get_output(['--dict', 'examples/dummy.csv'])
+
+    def test_dict_max_field_size(self):
+        field = 'x' * 150000
+        previous_limit = csv.field_size_limit()
+
+        def consume_reader(*args, **kwargs):
+            self.assertEqual(next(kwargs['local']['reader']), {'a': field})
+
+        try:
+            with tempfile.NamedTemporaryFile(mode='w+', newline='') as f:
+                f.write('a\n{}\n'.format(field))
+                f.flush()
+
+                with patch('code.interact', side_effect=consume_reader):
+                    self.get_output(['--dict', '--maxfieldsize', '200000', f.name])
+        finally:
+            csv.field_size_limit(previous_limit)
+
+    def test_dict_max_field_size_bound(self):
+        previous_limit = csv.field_size_limit()
+
+        def consume_reader(*args, **kwargs):
+            with self.assertRaises(csv.Error):
+                next(kwargs['local']['reader'])
+
+        try:
+            with tempfile.NamedTemporaryFile(mode='w+', newline='') as f:
+                f.write('a\n12345678901\n')
+                f.flush()
+
+                with patch('code.interact', side_effect=consume_reader):
+                    self.get_output(['--dict', '-z', '10', f.name])
+        finally:
+            csv.field_size_limit(previous_limit)
