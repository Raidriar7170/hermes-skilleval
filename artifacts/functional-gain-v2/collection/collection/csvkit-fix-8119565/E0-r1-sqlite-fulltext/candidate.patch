diff --git a/tests/test_utilities/test_csvpy.py b/tests/test_utilities/test_csvpy.py
new file mode 100644
index 0000000000000000000000000000000000000000..d389637f9657b5f1a3964483bf1a18a2cebb377e
--- /dev/null
+++ b/tests/test_utilities/test_csvpy.py
@@ -0,0 +1,37 @@
+import csv
+import os
+import tempfile
+from unittest.mock import patch
+
+from csvkit.utilities.csvpy import CSVPy
+from tests.utils import CSVKitTestCase
+
+
+class TestCSVPy(CSVKitTestCase):
+    Utility = CSVPy
+
+    def test_dict(self):
+        rows = []
+
+        with patch('code.interact', side_effect=lambda *args, **kwargs: rows.extend(kwargs['local']['reader'])):
+            self.Utility(['--dict', 'examples/dummy.csv']).run()
+
+        self.assertEqual(rows, [{'a': '1', 'b': '2', 'c': '3'}])
+
+    def test_dict_field_size_limit(self):
+        default_limit = csv.field_size_limit()
+        field = 'a' * (default_limit + 1)
+        rows = []
+
+        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', newline='', delete=False) as f:
+            f.write(f'header\n{field}\n')
+            path = f.name
+
+        try:
+            with patch('code.interact', side_effect=lambda *args, **kwargs: rows.extend(kwargs['local']['reader'])):
+                self.Utility(['--dict', '--maxfieldsize', str(len(field)), path]).run()
+        finally:
+            os.remove(path)
+            csv.field_size_limit(default_limit)
+
+        self.assertEqual(rows, [{'header': field}])
