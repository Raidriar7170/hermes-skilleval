+    def _extract_csv_dict_reader_kwargs(self):
+        """
+        Return reader keyword arguments suitable for ``csv.DictReader``.
+
+        Unlike agate's reader, ``csv.DictReader`` does not accept a
+        ``field_size_limit`` keyword argument. The setting belongs to the csv
+        module, so apply it there and omit it from the constructor arguments.
+        """
+        kwargs = self.reader_kwargs.copy()
+        field_size_limit = kwargs.pop('field_size_limit', None)
+
+        if field_size_limit:
+            csv.field_size_limit(field_size_limit)
+
+        return kwargs
