+class _NumericString(str):
+    """A string that the csv module recognizes as numeric."""
+
+    def __float__(self):
+        return float(str(self))
+
+    def replace(self, old, new, count=-1):
+        # agate normalizes line endings on strings before passing them to csv.writer.
+        return _NumericString(super().replace(old, new, count))
+
+
