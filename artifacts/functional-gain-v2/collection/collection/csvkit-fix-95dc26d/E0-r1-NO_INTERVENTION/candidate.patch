@@ -83,6 +94,28 @@ class CSVFormat(CSVKitUtility):
         if self.args.skip_header:
             next(reader)
 
+        if self.args.out_quoting == 2:
+            number_type = agate.Number(locale=self.args.locale)
+
+            def infer_numbers(row):
+                inferred = []
+                for value in row:
+                    try:
+                        number = number_type.cast(value)
+                    except agate.CastError:
+                        number = None
+
+                    inferred.append(_NumericString(value) if number is not None else value)
+
+                return inferred
+
+            if not self.args.skip_header:
+                header = next(reader, None)
+                if header is not None:
+                    writer.writerow(header)
+
+            reader = map(infer_numbers, reader)
+
         writer.writerows(reader)
 
 
