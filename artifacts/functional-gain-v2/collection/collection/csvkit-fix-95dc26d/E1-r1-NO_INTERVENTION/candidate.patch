@@ -9,7 +9,18 @@ from csvkit.cli import CSVKitUtility, make_default_headers
 
 class CSVFormat(CSVKitUtility):
     description = 'Convert a CSV file to a custom output format.'
-    override_flags = ['L', 'blanks', 'date-format', 'datetime-format']
+    override_flags = ['blanks', 'date-format', 'datetime-format']
+
+    class _NumericValue(float):
+        """A numeric value that preserves its original CSV representation."""
+
+        def __new__(cls, value):
+            number = super().__new__(cls, 0)
+            number.value = value
+            return number
+
+        def __str__(self):
+            return self.value
 
     def add_arguments(self):
         self.argparser.add_argument(
@@ -83,6 +94,31 @@ class CSVFormat(CSVKitUtility):
         if self.args.skip_header:
             next(reader)
 
+        if self.args.out_quoting == 2:
+            number_type = agate.Number(locale=self.args.locale)
+
+            if not self.args.skip_header:
+                header = next(reader, None)
+                if header is None:
+                    return
+                writer.writerow(header)
+
+            def infer_numbers(rows):
+                for row in rows:
+                    values = []
+                    for value in row:
+                        try:
+                            number = number_type.cast(value)
+                        except agate.CastError:
+                            number = None
+
+                        if number is not None:
+                            value = self._NumericValue(value)
+                        values.append(value)
+                    yield values
+
+            reader = infer_numbers(reader)
+
         writer.writerows(reader)
 
 
