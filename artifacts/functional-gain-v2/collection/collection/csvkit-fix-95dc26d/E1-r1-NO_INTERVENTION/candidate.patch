@@ -95,3 +95,41 @@ class TestCSVFormat(CSVKitTestCase, EmptyFileTests):
         self.assertLines(['-M', 'XYZ', 'examples/dummy.csv'], [
             'a,b,cXYZ1,2,3XYZ',
         ], newline_at_eof=False)
+
+    def test_quote_nonnumeric(self):
+        input_file = io.BytesIO(b'number,text,formatted\n001.20,foo,"1,234.56"\n')
+
+        with stdin_as_string(input_file):
+            self.assertLines(['--out-quoting', '2'], [
+                '"number","text","formatted"',
+                '001.20,"foo","1,234.56"',
+            ])
+
+        input_file.close()
+
+    def test_quote_nonnumeric_locale(self):
+        input_file = io.BytesIO('number;text\n1.234,56;foo\n'.encode())
+
+        with stdin_as_string(input_file):
+            self.assertLines(['-d', ';', '-D', ';', '--locale', 'de_DE', '-U', '2'], [
+                '"number";"text"',
+                '1.234,56;"foo"',
+            ])
+
+        input_file.close()
+
+    def test_quote_nonnumeric_skip_header(self):
+        self.assertLines(['--skip-header', '--out-quoting', '2', 'examples/dummy.csv'], [
+            '1,2,3',
+        ])
+
+    def test_other_quoting_modes(self):
+        expected = {
+            '0': ['a,b,c', '1,2,3'],
+            '1': ['"a","b","c"', '"1","2","3"'],
+            '3': ['a,b,c', '1,2,3'],
+        }
+
+        for mode, lines in expected.items():
+            with self.subTest(mode=mode):
+                self.assertLines(['--out-quoting', mode, 'examples/dummy.csv'], lines)
