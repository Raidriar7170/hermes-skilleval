+Quote text fields but not numeric fields, using the selected locale to recognize
+numbers while preserving their original representation:
+
+.. code-block:: bash
+
+   printf 'value;text\n1.234,56;example\n' | csvformat -d ';' -D ';' -L de_DE -U 2
+
 To avoid escaping quote characters when using :code:`--quoting 3`, add :code:`--out-quotechar ""`:
 
 .. code-block:: bash
diff --git a/tests/test_utilities/test_csvformat.py b/tests/test_utilities/test_csvformat.py
index 7123f2c233683ed787b5de8a0910d4ebddb7698a..5d0c31b96422705f08166684aff287a2a9074f3b 100644
--- a/tests/test_utilities/test_csvformat.py
+++ b/tests/test_utilities/test_csvformat.py
@@ -95,3 +95,52 @@ class TestCSVFormat(CSVKitTestCase, EmptyFileTests):
         self.assertLines(['-M', 'XYZ', 'examples/dummy.csv'], [
             'a,b,cXYZ1,2,3XYZ',
         ], newline_at_eof=False)
+
+    def test_quote_nonnumeric(self):
+        input_file = io.BytesIO(b'number,text,formatted\n001.20,foo,"1,234.56"\n')
+
+        with stdin_as_string(input_file):
+            self.assertLines(['--out-quoting', '2'], [
+                '"number","text","formatted"',
+                '001.20,"foo","1,234.56"',
+            ])
+
+        input_file.close()
+
+    def test_quote_nonnumeric_locale(self):
+        input_file = io.BytesIO('number;text\n1.234,56;foo\n'.encode())
+
+        with stdin_as_string(input_file):
+            self.assertLines(['-d', ';', '-D', ';', '--locale', 'de_DE', '-U', '2'], [
+                '"number";"text"',
+                '1.234,56;"foo"',
+            ])
+
+        input_file.close()
+
+    def test_quote_nonnumeric_skip_header(self):
+        self.assertLines(['--skip-header', '--out-quoting', '2', 'examples/dummy.csv'], [
+            '1,2,3',
+        ])
+
+    def test_quote_nonnumeric_input(self):
+        input_file = io.BytesIO(b'"number","text"\n1,"foo"\n')
+
+        with stdin_as_string(input_file):
+            self.assertLines(['--quoting', '2', '--out-quoting', '2'], [
+                '"number","text"',
+                '1.0,"foo"',
+            ])
+
+        input_file.close()
+
+    def test_other_quoting_modes_unchanged(self):
+        expected = {
+            0: ['a,b', '1,text'],
+            1: ['"a","b"', '"1","text"'],
+            3: ['a,b', '1,text'],
+        }
+
+        for mode, lines in expected.items():
+            with self.subTest(mode=mode), stdin_as_string(io.BytesIO(b'a,b\n1,text\n')):
+                self.assertLines(['--out-quoting', str(mode)], lines)
