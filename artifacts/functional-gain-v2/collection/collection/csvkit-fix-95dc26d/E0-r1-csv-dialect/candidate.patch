@@ -7,9 +7,39 @@ import agate
 from csvkit.cli import CSVKitUtility, make_default_headers
 
 
+class NumericValue:
+    """A value that the CSV writer recognizes as numeric without reformatting it."""
+
+    def __init__(self, value):
+        self.value = value
+
+    def __float__(self):
+        return 0.0
+
+    def __str__(self):
+        return self.value
+
+
+def infer_numeric_values(row, number_type):
+    values = []
+
+    for value in row:
+        try:
+            number = number_type.cast(value)
+        except agate.CastError:
+            number = None
+
+        if number is not None and isinstance(value, str):
+            value = NumericValue(value)
+
+        values.append(value)
+
+    return tuple(values)
+
+
 class CSVFormat(CSVKitUtility):
     description = 'Convert a CSV file to a custom output format.'
-    override_flags = ['L', 'blanks', 'date-format', 'datetime-format']
+    override_flags = ['blanks', 'date-format', 'datetime-format']
 
     def add_arguments(self):
         self.argparser.add_argument(
@@ -82,6 +112,14 @@ class CSVFormat(CSVKitUtility):
 
         if self.args.skip_header:
             next(reader)
+        elif self.args.out_quoting == 2:
+            header = next(reader, None)
+            if header is not None:
+                writer.writerow(header)
+
+        if self.args.out_quoting == 2:
+            number_type = agate.Number(locale=self.args.locale)
+            reader = (infer_numeric_values(row, number_type) for row in reader)
 
