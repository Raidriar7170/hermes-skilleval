--- a/csvkit/utilities/csvformat.py
+++ b/csvkit/utilities/csvformat.py
@@ -7,9 +7,22 @@ import agate
 from csvkit.cli import CSVKitUtility, make_default_headers
 
 
+class _NumberString:
+    """A string that the CSV writer recognizes as numeric without changing it."""
+
+    def __init__(self, value):
+        self.value = value
+
+    def __str__(self):
+        return self.value
+
+    def __float__(self):
+        return 0.0
+
+
 class CSVFormat(CSVKitUtility):
     description = 'Convert a CSV file to a custom output format.'
-    override_flags = ['L', 'blanks', 'date-format', 'datetime-format']
+    override_flags = ['blanks', 'date-format', 'datetime-format']
 
     def add_arguments(self):
         self.argparser.add_argument(
@@ -81,7 +94,30 @@ class CSVFormat(CSVKitUtility):
             reader = itertools.chain([headers, _row], reader)
 
         if self.args.skip_header:
-            next(reader)
+            next(reader, None)
+
+        if self.args.out_quoting == 2:
+            number_type = agate.Number(locale=self.args.locale)
+
+            def infer_number(value):
+                if not value:
+                    return value
+                try:
+                    number_type.cast(value)
+                except agate.CastError:
+                    return value
+                return _NumberString(value)
+
+            def infer_numbers(rows):
+                for row in rows:
+                    yield [infer_number(value) for value in row]
+
+            if not self.args.skip_header:
+                header = next(reader, None)
+                if header is None:
+                    return
+                writer.writerow(header)
+            reader = infer_numbers(reader)
 
         writer.writerows(reader)
 
