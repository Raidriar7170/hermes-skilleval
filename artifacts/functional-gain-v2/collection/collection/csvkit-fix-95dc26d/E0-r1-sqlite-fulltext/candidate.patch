@@ -83,9 +83,39 @@ class CSVFormat(CSVKitUtility):
         if self.args.skip_header:
             next(reader)
 
+        if self.args.out_quoting == 2:
+            number_type = agate.Number(locale=self.args.locale)
+
+            def infer_numbers(row):
+                inferred = []
+                for value in row:
+                    try:
+                        number = number_type.cast(value)
+                    except agate.CastError:
+                        inferred.append(value)
+                    else:
+                        inferred.append(NumericString(value) if number is not None else value)
+                return inferred
+
+            if not self.args.skip_header:
+                header = next(reader, None)
+                if header is not None:
+                    writer.writerow(header)
+            reader = map(infer_numbers, reader)
+
         writer.writerows(reader)
 
 
+class NumericString(str):
+    """A string that csv.writer recognizes as numeric without changing its contents."""
+
+    def __float__(self):
+        return 0.0
+
+    def replace(self, old, new, count=-1):
+        return NumericString(super().replace(old, new, count))
+
+
 def launch_new_instance():
     utility = CSVFormat()
     utility.run()
