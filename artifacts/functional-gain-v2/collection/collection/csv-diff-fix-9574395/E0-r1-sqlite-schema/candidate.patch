+def test_dotted_column_names_are_literal():
+    previous = {
+        "1": {
+            "id": "1",
+            "one.dot": "old",
+            "two.dots.here": "before",
+            "same.dot": "same",
+            "old.column": "old",
+        },
+        "2": {
+            "id": "2",
+            "one.dot": "removed",
+            "two.dots.here": "row",
+            "same.dot": "same",
+            "old.column": "old",
+        },
+    }
+    current = {
+        "1": {
+            "id": "1",
+            "one.dot": "new",
+            "two.dots.here": "after",
+            "same.dot": "same",
+            "new.column": "new",
+        },
+        "3": {
+            "id": "3",
+            "one.dot": "added",
+            "two.dots.here": "row",
+            "same.dot": "same",
+            "new.column": "new",
+        },
+    }
+
+    assert compare(previous, current, show_unchanged=True) == {
+        "added": [current["3"]],
+        "removed": [previous["2"]],
+        "changed": [
+            {
+                "key": "1",
+                "changes": {
+                    "one.dot": ["old", "new"],
+                    "two.dots.here": ["before", "after"],
+                },
+                "unchanged": {"same.dot": "same", "old.column": "old"},
+            },
+        ],
+        "columns_added": ["new.column"],
+        "columns_removed": ["old.column"],
+    }
