+def test_dotted_column_names_are_preserved():
+    previous = """id,profile.name,profile.age,status.code,plain
+1,Cleo,4,active,same"""
+    current = """id,profile.name,profile.age,status.code,plain
+1,Clio,5,active,changed"""
+
+    diff = compare(
+        load_csv(io.StringIO(previous), key="id"),
+        load_csv(io.StringIO(current), key="id"),
+        show_unchanged=True,
+    )
+
+    assert diff["changed"] == [
+        {
+            "key": "1",
+            "changes": {
+                "profile.name": ["Cleo", "Clio"],
+                "profile.age": ["4", "5"],
+                "plain": ["same", "changed"],
+            },
+            "unchanged": {"status.code": "active"},
+        }
+    ]
+
+
+def test_dotted_names_with_added_removed_rows_and_columns():
+    previous = """id,profile.name,same.dot,removed.dot
+1,Cleo,same,gone
+2,Deleted,same,gone"""
+    current = """id,profile.name,same.dot,added.dot
+1,Clio,same,here
+3,Added,same,here"""
+
+    diff = compare(
+        load_csv(io.StringIO(previous), key="id"),
+        load_csv(io.StringIO(current), key="id"),
+        show_unchanged=True,
+    )
+
+    assert diff == {
+        "added": [
+            {
+                "id": "3",
+                "profile.name": "Added",
+                "same.dot": "same",
+                "added.dot": "here",
+            }
+        ],
+        "removed": [
+            {
+                "id": "2",
+                "profile.name": "Deleted",
+                "same.dot": "same",
+                "removed.dot": "gone",
+            }
+        ],
+        "changed": [
+            {
+                "key": "1",
+                "changes": {"profile.name": ["Cleo", "Clio"]},
+                "unchanged": {"same.dot": "same", "removed.dot": "gone"},
+            }
+        ],
+        "columns_added": ["added.dot"],
+        "columns_removed": ["removed.dot"],
+    }
+
+
