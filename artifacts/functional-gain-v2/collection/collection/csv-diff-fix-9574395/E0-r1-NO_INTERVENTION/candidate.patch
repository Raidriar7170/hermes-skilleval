+def test_json_dotted_column_names_preserve_other_diff_results(tmpdir):
+    one = tmpdir / "one.csv"
+    one.write("id,a.b,c.d,removed.column\n1,old,same,x\n2,gone,same,x")
+    two = tmpdir / "two.csv"
+    two.write("id,a.b,c.d,added.column\n1,new,same,y\n3,added,same,y")
+
+    result = CliRunner().invoke(
+        cli.cli,
+        [str(one), str(two), "--key", "id", "--json", "--show-unchanged"],
+    )
+
+    assert result.exit_code == 0
+    assert json.loads(result.output) == {
+        "added": [{"id": "3", "a.b": "added", "c.d": "same", "added.column": "y"}],
+        "removed": [{"id": "2", "a.b": "gone", "c.d": "same", "removed.column": "x"}],
+        "changed": [
+            {
+                "key": "1",
+                "changes": {"a.b": ["old", "new"]},
+                "unchanged": {"c.d": "same", "removed.column": "x"},
+            }
+        ],
+        "columns_added": ["added.column"],
+        "columns_removed": ["removed.column"],
+    }
+
