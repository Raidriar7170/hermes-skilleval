+def test_upsert_csv_detect_types(tmpdir):
+    db_path = str(tmpdir / "test.db")
+    runner = CliRunner()
+
+    result = runner.invoke(
+        cli.cli,
+        ["upsert", db_path, "creatures", "-", "--csv", "-d", "--pk", "id"],
+        input="id,name,age,weight\n1,Cleo,6,45.5\n2,Dori,1,3.5",
+        catch_exceptions=False,
+    )
+    assert result.exit_code == 0
+
+    # A subsequent upsert should match the integer primary key, update the
+    # detected numeric values and leave values omitted from the CSV untouched.
+    result = runner.invoke(
+        cli.cli,
+        [
+            "upsert",
+            db_path,
+            "creatures",
+            "-",
+            "--csv",
+            "--detect-types",
+            "--pk",
+            "id",
+        ],
+        input="id,age,weight\n1,7,46.25",
+        catch_exceptions=False,
+    )
+    assert result.exit_code == 0
+
+    db = Database(db_path)
+    assert list(db["creatures"].rows_where(order_by="id")) == [
+        {"id": 1, "name": "Cleo", "age": 7, "weight": 46.25},
+        {"id": 2, "name": "Dori", "age": 1, "weight": 3.5},
+    ]
+    assert {column.name: column.type for column in db["creatures"].columns} == {
+        "id": "INTEGER",
+        "name": "TEXT",
+        "age": "INTEGER",
+        "weight": "FLOAT",
+    }
+
+
