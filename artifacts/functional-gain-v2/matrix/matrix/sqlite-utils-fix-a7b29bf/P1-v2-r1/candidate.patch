+@pytest.mark.parametrize("detect_types", ("-d", "--detect-types"))
+def test_upsert_csv_detect_types(db_path, detect_types):
+    runner = CliRunner()
+    result = runner.invoke(
+        cli.cli,
+        ["upsert", db_path, "creatures", "-", "--csv", "--pk", "id", detect_types],
+        input="id,name,age,weight\n1,Cleo,6,45.5\n2,Dori,1,3.5",
+        catch_exceptions=False,
+    )
+    assert result.exit_code == 0
+
+    db = Database(db_path)
+    assert list(db["creatures"].rows) == [
+        {"id": 1, "name": "Cleo", "age": 6, "weight": 45.5},
+        {"id": 2, "name": "Dori", "age": 1, "weight": 3.5},
+    ]
+    assert {column.name: column.type for column in db["creatures"].columns} == {
+        "id": "INTEGER",
+        "name": "TEXT",
+        "age": "INTEGER",
+        "weight": "FLOAT",
+    }
+
+    result = runner.invoke(
+        cli.cli,
+        ["upsert", db_path, "creatures", "-", "--csv", "--pk", "id", detect_types],
+        input="id,name,age,weight\n1,Cleo,7,46.25",
+        catch_exceptions=False,
+    )
+    assert result.exit_code == 0
+    assert list(db["creatures"].rows) == [
+        {"id": 1, "name": "Cleo", "age": 7, "weight": 46.25},
+        {"id": 2, "name": "Dori", "age": 1, "weight": 3.5},
+    ]
+
+
