+@pytest.mark.parametrize("detect_types", ("-d", "--detect-types"))
+def test_upsert_csv_detect_types(tmpdir, detect_types):
+    db_path = str(tmpdir / "test.db")
+    runner = CliRunner()
+    result = runner.invoke(
+        cli.cli,
+        ["upsert", db_path, "creatures", "-", "--csv", detect_types, "--pk", "id"],
+        input="id,name,age,weight\n1,Cleo,6,45.5\n2,Dori,1,3.5",
+        catch_exceptions=False,
+    )
+    assert result.exit_code == 0
+
+    db = Database(db_path)
+    assert db["creatures"].columns_dict == {
+        "id": int,
+        "name": str,
+        "age": int,
+        "weight": float,
+    }
+    assert list(db["creatures"].rows) == [
+        {"id": 1, "name": "Cleo", "age": 6, "weight": 45.5},
+        {"id": 2, "name": "Dori", "age": 1, "weight": 3.5},
+    ]
+
+    # A subsequent upsert should update populated numeric values while preserving
+    # columns that were not included in the CSV.
+    result = runner.invoke(
+        cli.cli,
+        ["upsert", db_path, "creatures", "-", "--csv", detect_types, "--pk", "id"],
+        input="id,age,weight\n1,7,46.25\n2,2,4.75",
+        catch_exceptions=False,
+    )
+    assert result.exit_code == 0
+    assert list(db["creatures"].rows) == [
+        {"id": 1, "name": "Cleo", "age": 7, "weight": 46.25},
+        {"id": 2, "name": "Dori", "age": 2, "weight": 4.75},
+    ]
+
+
