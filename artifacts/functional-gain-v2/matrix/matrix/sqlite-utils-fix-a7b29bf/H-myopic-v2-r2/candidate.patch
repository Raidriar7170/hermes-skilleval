+@pytest.mark.parametrize("option", ("-d", "--detect-types"))
+def test_upsert_csv_detect_types(tmpdir, option):
+    db_path = str(tmpdir / "test.db")
+    runner = CliRunner()
+
+    result = runner.invoke(
+        cli.cli,
+        ["upsert", db_path, "creatures", "-", "--csv", option, "--pk", "id"],
+        input="id,name,age,weight\n1,Cleo,6,45.5\n2,Dori,1,3.5",
+        catch_exceptions=False,
+    )
+    assert result.exit_code == 0
+
+    # A subsequent upsert should update matching rows while retaining the
+    # detected numeric types and leaving omitted columns unchanged.
+    result = runner.invoke(
+        cli.cli,
+        ["upsert", db_path, "creatures", "-", "--csv", option, "--pk", "id"],
+        input="id,age,weight\n1,7,46.25\n2,2,4.75",
+        catch_exceptions=False,
+    )
+    assert result.exit_code == 0
+    db = Database(db_path)
+    assert list(db["creatures"].rows) == [
+        {"id": 1, "name": "Cleo", "age": 7, "weight": 46.25},
+        {"id": 2, "name": "Dori", "age": 2, "weight": 4.75},
+    ]
+    assert {column.name: column.type for column in db["creatures"].columns} == {
+        "id": "INTEGER",
+        "name": "TEXT",
+        "age": "INTEGER",
+        "weight": "FLOAT",
+    }
+
+
