-from csvkit.cleanup import join_rows
+from csvkit.cleanup import RowChecker, join_rows
+
+
+class Reader:
+    def __init__(self, rows):
+        self.rows = iter(rows)
+        self.line_num = 0
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        self.line_num += 1
+        return next(self.rows)
+
+
+class TestRowChecker:
+    def test_empty_columns_with_short_and_long_rows(self):
+        rows = [['a', 'b', 'c'], ['1'], ['2', '', '', 'extra']]
+        checker = RowChecker(Reader(rows), empty_columns=True)
+
+        assert list(checker.checked_rows()) == rows[1:]
+        assert len(checker.errors) == 1
+        assert checker.errors[0].msg == "Empty columns named 'b', 'c'! Try: csvcut -C 2,3"
 
 
 class TestCleanup(unittest.TestCase):
