+    def test_empty_columns_with_short_and_long_rows(self):
+        reader = csv.reader(io.StringIO('a,b,c,d\n1,,\n2,,,\n3,x,,extra,too many\n'))
+        checker = RowChecker(reader, empty_columns=True)
+
+        rows = list(checker.checked_rows())
+
+        self.assertEqual(rows, [['1', '', ''], ['2', '', '', ''], ['3', 'x', '', 'extra', 'too many']])
+        self.assertEqual(len(checker.errors), 1)
+        self.assertEqual(checker.errors[0].msg, "Empty columns named 'c'! Try: csvcut -C 3")
+
+    def test_empty_columns_counts_omitted_trailing_fields(self):
+        reader = csv.reader(io.StringIO('a,b,c\n1\n2\n'))
+        checker = RowChecker(reader, empty_columns=True)
+
+        self.assertEqual(list(checker.checked_rows()), [['1'], ['2']])
+        self.assertEqual(checker.errors[0].msg, "Empty columns named 'b', 'c'! Try: csvcut -C 2,3")
+
