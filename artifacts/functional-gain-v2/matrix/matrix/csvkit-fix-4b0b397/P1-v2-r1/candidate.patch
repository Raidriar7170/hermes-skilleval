+def _default_input_encoding():
+    """Return the input encoding configured for Python's standard streams."""
+    python_io_encoding = os.environ.get('PYTHONIOENCODING')
+    if python_io_encoding:
+        # PYTHONIOENCODING can include an error handler (for example, ``cp1252:strict``).
+        encoding = python_io_encoding.split(':', 1)[0]
+        if encoding:
+            return encoding
+
+    return 'utf-8-sig'
+
+
