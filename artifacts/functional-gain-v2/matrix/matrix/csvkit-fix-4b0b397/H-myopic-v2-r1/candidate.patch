+    def test_encoding_defaults_to_pythonioencoding(self):
+        with patch.dict(os.environ, {'PYTHONIOENCODING': 'cp1252:strict'}, clear=True):
+            utility = DummyUtility([])
+
+        self.assertEqual(utility.args.encoding, 'cp1252')
+
+        with tempfile.NamedTemporaryFile() as input_file:
+            input_file.write('name\nAndr\xe9\n'.encode('cp1252'))
+            input_file.flush()
+            self.assertEqual(utility._open_input_file(input_file.name).read(), 'name\nAndr\xe9\n')
+
+    def test_encoding_option_overrides_pythonioencoding(self):
