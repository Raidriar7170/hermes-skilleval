@@ -0,0 +1,36 @@
+import os
+import unittest
+from unittest.mock import patch
+
+from csvkit.cli import CSVKitUtility
+
+
+class DummyUtility(CSVKitUtility):
+    def add_arguments(self):
+        pass
+
+
+class EncodingTests(unittest.TestCase):
+    def test_default_encoding(self):
+        with patch.dict(os.environ, {}, clear=True):
+            utility = DummyUtility([])
+
+        self.assertEqual(utility.args.encoding, 'utf-8-sig')
+
+    def test_pythonioencoding(self):
+        with patch.dict(os.environ, {'PYTHONIOENCODING': 'latin1:replace'}, clear=True):
+            utility = DummyUtility([])
+
+        self.assertEqual(utility.args.encoding, 'latin1')
+
+        input_file = utility._open_input_file('examples/test_latin1.csv')
+        try:
+            self.assertEqual(input_file.read(), 'a,b,c\n1,2,3\n4,5,©')
+        finally:
+            input_file.close()
+
+    def test_explicit_encoding_overrides_pythonioencoding(self):
+        with patch.dict(os.environ, {'PYTHONIOENCODING': 'latin1'}, clear=True):
+            utility = DummyUtility(['--encoding', 'utf-8'])
+
+        self.assertEqual(utility.args.encoding, 'utf-8')
