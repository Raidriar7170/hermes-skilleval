+def get_default_encoding():
+    """Return the input encoding requested by Python's I/O environment."""
+    encoding = os.environ.get('PYTHONIOENCODING')
+    if encoding:
+        return encoding.split(':', 1)[0] or 'utf-8-sig'
+    return 'utf-8-sig'
