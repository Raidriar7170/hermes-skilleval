+def _get_default_input_encoding():
+    """Return the encoding configured for Python's standard streams."""
+    python_io_encoding = os.environ.get('PYTHONIOENCODING')
+    if python_io_encoding:
+        # PYTHONIOENCODING can include an error handler (for example,
+        # ``latin1:strict``), whereas the ``encoding`` argument to open() and
+        # reconfigure() accepts only the encoding name.
+        encoding = python_io_encoding.partition(':')[0]
+        if encoding:
+            return encoding
+
+    return 'utf-8-sig'
+
