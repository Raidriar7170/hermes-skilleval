+def default_input_encoding():
+    """Return the input encoding configured for Python's standard streams."""
+    python_io_encoding = os.environ.get('PYTHONIOENCODING')
+
+    if python_io_encoding:
+        # PYTHONIOENCODING accepts ``encoding:errorhandler``. File-opening
+        # functions need only the encoding portion.
+        encoding = python_io_encoding.partition(':')[0]
+        if encoding:
+            return encoding
+
+    return 'utf-8-sig'
+
