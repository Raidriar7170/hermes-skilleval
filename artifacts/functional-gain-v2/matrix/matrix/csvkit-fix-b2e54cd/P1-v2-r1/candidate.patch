+    def test_convert_xlsx_recalculates_understated_dimensions(self):
+        source = io.BytesIO()
+        workbook = openpyxl.Workbook()
+        workbook.active.append(['ignored'])
+        sheet = workbook.create_sheet('data')
+        sheet.append(['name', 'value'])
+        sheet.append(['first', 1])
+        sheet.append(['second', 2])
+        workbook.save(source)
+
+        understated = io.BytesIO()
+        source.seek(0)
+        with zipfile.ZipFile(source) as input_zip, zipfile.ZipFile(understated, 'w') as output_zip:
+            for item in input_zip.infolist():
+                data = input_zip.read(item)
+                if item.filename == 'xl/worksheets/sheet2.xml':
+                    self.assertIn(b'<dimension ref="A1:B3"', data)
+                    data = data.replace(b'<dimension ref="A1:B3"', b'<dimension ref="A1:A1"')
+                output_zip.writestr(item, data)
+
+        understated.seek(0)
+        with stdin_as_string(understated):
+            self.assertLines(['-f', 'xlsx', '--sheet', 'data', '--no-inference'], [
+                'name,value',
+                'first,1',
+                'second,2',
+            ])
+
