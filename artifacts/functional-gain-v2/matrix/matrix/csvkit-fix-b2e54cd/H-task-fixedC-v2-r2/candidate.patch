+    def test_convert_xlsx_with_understated_dimensions(self):
+        with tempfile.TemporaryDirectory() as directory:
+            source = os.path.join(directory, 'source.xlsx')
+            understated = os.path.join(directory, 'understated.xlsx')
+
+            workbook = openpyxl.Workbook()
+            workbook.active.append(['not', 'this', 'sheet'])
+            worksheet = workbook.create_sheet('data')
+            worksheet.append(['a', 'b', 'c'])
+            worksheet.append([1, 2, 3])
+            worksheet.append([4, None, 6])
+            workbook.save(source)
+
+            with zipfile.ZipFile(source) as archive, zipfile.ZipFile(understated, 'w') as output:
+                for member in archive.infolist():
+                    contents = archive.read(member)
+                    if member.filename == 'xl/worksheets/sheet2.xml':
