+                            br'<dimension ref="A1:C3"\s*/>', b'<dimension ref="A1:B2"/>', contents)
+                        self.assertNotEqual(contents, understated_contents)
+                        contents = understated_contents
+                    output.writestr(member, contents)
+
+            self.assertLines(['--sheet', 'data', '--no-inference', understated], [
+                'a,b,c',
+                '1,2,3',
+                '4,,6',
+            ])
