         if filetype in ('xls', 'xlsx'):
             kwargs['header'] = not self.args.no_header_row
 
+        if filetype == 'xlsx':
+            # Worksheet dimension metadata is only a hint and can understate the
+            # range containing data. Recalculate it to avoid silently dropping
+            # cells outside the declared range.
+            kwargs['reset_dimensions'] = True
+
         if filetype not in ('dbf', 'geojson', 'json', 'ndjson'):  # csv, fixed, xls, xlsx
             kwargs['skip_lines'] = self.args.skip_lines
 
