+    def test_convert_xlsx_with_understated_dimensions(self):
+        source = io.BytesIO()
+        workbook = openpyxl.Workbook()
+        workbook.active.title = 'ignored'
+        workbook.active.append(['wrong sheet'])
+        sheet = workbook.create_sheet('data')
+        sheet.append(['a', 'b', 'c'])
+        sheet.append(['first', 2, 'kept'])
+        sheet.append(['second', 4, 'also kept'])
+        workbook.save(source)
+        source.seek(0)
+
+        understated = io.BytesIO()
+        with ZipFile(source) as archive, ZipFile(understated, 'w', ZIP_DEFLATED) as output:
