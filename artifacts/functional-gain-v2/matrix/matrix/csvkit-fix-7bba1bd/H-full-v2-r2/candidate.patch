+    def test_max_rows_does_not_read_later_records(self):
+        class BoundedInput(io.StringIO):
+            def __init__(self, content, line_limit):
+                super().__init__(content)
+                self.line_limit = line_limit
+                self.lines_read = 0
+
+            def __next__(self):
+                self.lines_read += 1
+                if self.lines_read > self.line_limit:
+                    raise AssertionError('read beyond --max-rows')
+                return super().__next__()
+
+        later_record = 'x' * 1000 + ',3\n'
+        for max_rows, content, line_limit, displayed, expected in (
+            (0, 'a,b\n' + later_record, 1, None, '| ... | ... |'),
+            (1, 'a,b\n1,2\n' + later_record, 2, '| True | 2 |', '|  ... | ... |'),
+            (1, 'a,b\n"first\nsecond",2\n' + later_record, 3, 'first↵second', '| ...          | ... |'),
+        ):
+            with self.subTest(max_rows=max_rows):
+                output_file = io.StringIO()
+                utility = self.Utility(
+                    ['--max-rows', str(max_rows), '--snifflimit', '0', '-'], output_file)
+                utility.input_file = BoundedInput(content, line_limit)
+
+                with patch.object(utility, 'additional_input_expected', return_value=False):
+                    utility.main()
+
+                output = output_file.getvalue()
+                if displayed is not None:
+                    self.assertIn(displayed, output)
+                self.assertEqual(output.splitlines()[-1], expected)
+
