         )
 
 
+def test_transform_preserves_index_and_data_with_double_quoted_identifiers(fresh_db):
+    table = fresh_db.table('table "quoted')
+    row = {'column "quoted': "Cleo", "age": "5"}
+    table.insert(row)
+    table.create_index(['column "quoted'], index_name='index "quoted')
+
+    table.transform(types={"age": int})
+
+    assert list(table.rows) == [{'column "quoted': "Cleo", "age": 5}]
+    assert len(table.indexes) == 1
+    assert table.indexes[0].name == 'index "quoted'
+    assert table.indexes[0].columns == ['column "quoted']
+
+
