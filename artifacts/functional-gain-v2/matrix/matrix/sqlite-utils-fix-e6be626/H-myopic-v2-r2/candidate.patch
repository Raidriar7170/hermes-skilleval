+++ b/tests/test_introspect.py
@@ -161,6 +161,46 @@ def test_xindexes(fresh_db):
     ]
 
 
+def test_indexes_with_double_quotes_in_identifiers(fresh_db):
+    table = fresh_db.table('table "quoted')
+    table.insert({'column "quoted': "Cleo", "other": 1})
+    table.create_index(['column "quoted'], index_name='index "quoted')
+
+    assert table.indexes == [
+        Index(
+            seq=0,
+            name='index "quoted',
+            unique=0,
+            origin="c",
+            partial=0,
+            columns=['column "quoted'],
+        )
+    ]
+    assert table.xindexes == [
+        XIndex(
+            name='index "quoted',
+            columns=[
+                XIndexColumn(
+                    seqno=0,
+                    cid=0,
+                    name='column "quoted',
+                    desc=0,
+                    coll="BINARY",
+                    key=1,
+                ),
+                XIndexColumn(
+                    seqno=1,
+                    cid=-1,
+                    name=None,
+                    desc=0,
+                    coll="BINARY",
+                    key=0,
+                ),
+            ],
+        )
+    ]
+
+
