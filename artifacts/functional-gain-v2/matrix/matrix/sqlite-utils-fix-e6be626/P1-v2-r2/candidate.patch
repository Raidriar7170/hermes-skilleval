+def test_transform_table_with_double_quotes_in_identifiers(fresh_db):
+    table = fresh_db.table('table "quoted"')
+    row = {"id": 1, 'column "quoted"': "value", "age": 4}
+    table.insert(row, pk="id")
+    table.create_index(['column "quoted"'], index_name='index "quoted"')
+
+    table.transform(types={"age": str})
+
+    assert table.get(1) == {**row, "age": "4"}
+    assert table.indexes[0].name == 'index "quoted"'
+    assert table.indexes[0].columns == ['column "quoted"']
+
+
