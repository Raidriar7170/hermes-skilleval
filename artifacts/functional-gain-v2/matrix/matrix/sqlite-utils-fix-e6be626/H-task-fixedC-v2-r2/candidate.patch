@@ -865,6 +865,30 @@ def test_transform_indexes(fresh_db, indexes, transform_params):
         )
 
 
+@pytest.mark.parametrize("index_name", (None, 'index "quoted"'))
+def test_transform_table_with_double_quotes_in_identifiers(fresh_db, index_name):
+    table_name = 'table "quoted"'
+    column_name = 'column "quoted"'
+    table = fresh_db.table(table_name).insert(
+        {column_name: "value", "number": 42}, pk=column_name
+    )
+    table.create_index(["number"], index_name=index_name)
+
+    table.transform(types={"number": str})
+
+    assert list(table.rows) == [{column_name: "value", "number": "42"}]
+    assert [index.columns for index in table.indexes if index.origin != "pk"] == [
+        ["number"]
+    ]
+    assert [
+        [column.name for column in index.columns if column.key]
+        for index in table.xindexes
+        if any(column.name == "number" for column in index.columns)
+    ] == [["number"]]
+    if index_name is not None:
+        assert any(index.name == index_name for index in table.indexes)
+
+
