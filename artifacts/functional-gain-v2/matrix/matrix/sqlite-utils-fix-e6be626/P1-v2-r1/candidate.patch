+    table = fresh_db.table('table "one"').insert({'column "one"': "value"})
+    table.create_index(['column "one"'], index_name='index "one"')
+
+    assert table.indexes == [
+        Index(
+            seq=0,
+            name='index "one"',
+            unique=0,
+            origin="c",
