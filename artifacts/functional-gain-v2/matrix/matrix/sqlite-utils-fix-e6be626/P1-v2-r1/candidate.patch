+def test_transform_table_with_double_quotes_in_identifiers(fresh_db):
+    table = fresh_db.table('table "one"').insert(
+        {"id": 1, 'column "one"': "value"}, pk="id"
+    )
+    table.create_index(['column "one"'], index_name='index "one"')
+
+    table.transform(types={'column "one"': str})
+
+    assert list(table.rows) == [{"id": 1, 'column "one"': "value"}]
+    assert [(index.name, index.columns) for index in table.indexes] == [
+        ('index "one"', ['column "one"'])
+    ]
+
