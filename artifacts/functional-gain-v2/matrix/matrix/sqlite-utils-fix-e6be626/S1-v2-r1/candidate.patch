@@ -865,6 +865,28 @@ def test_transform_indexes(fresh_db, indexes, transform_params):
         )
 
 
+def test_transform_preserves_index_and_data_with_double_quotes(fresh_db):
+    table = fresh_db.table('table "quoted"')
+    table.insert_all(
+        [
+            {'id': 1, 'column "quoted"': 10},
+            {'id': 2, 'column "quoted"': 20},
+        ],
+        pk="id",
+    )
+    table.create_index(['column "quoted"'])
+
+    table.transform(types={'column "quoted"': str})
+
+    assert list(table.rows) == [
+        {"id": 1, 'column "quoted"': "10"},
+        {"id": 2, 'column "quoted"': "20"},
+    ]
+    assert [index.columns for index in table.indexes if index.origin != "pk"] == [
+        ['column "quoted"']
+    ]
+
+
