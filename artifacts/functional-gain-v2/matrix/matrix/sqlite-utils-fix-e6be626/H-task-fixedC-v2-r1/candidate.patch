         )
 
 
+def test_transform_preserves_index_and_data_with_double_quotes(fresh_db):
+    table = fresh_db.table('table "one')
+    table.insert({"id": 1, 'column "one': 42}, pk="id")
+    table.create_index(['column "one'], index_name='index "one')
+
+    table.transform(types={'column "one': str})
+
+    assert list(table.rows) == [{"id": 1, 'column "one': "42"}]
+    assert [(index.name, index.columns) for index in table.indexes] == [
+        ('index "one', ['column "one'])
+    ]
+
+
