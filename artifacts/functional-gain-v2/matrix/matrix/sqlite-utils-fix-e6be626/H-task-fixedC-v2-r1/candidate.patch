+def test_indexes_with_double_quotes_in_identifiers(fresh_db):
+    table = fresh_db.table('table "one')
+    table.insert({'column "one': "value", "ordinary": 1})
+    table.create_index(['column "one', "ordinary"], index_name='index "one')
+
+    assert table.indexes == [
+        Index(
+            seq=0,
+            name='index "one',
+            unique=0,
+            origin="c",
+            partial=0,
+            columns=['column "one', "ordinary"],
+        )
+    ]
+    assert table.xindexes == [
+        XIndex(
+            name='index "one',
+            columns=[
+                XIndexColumn(
+                    seqno=0,
+                    cid=0,
+                    name='column "one',
+                    desc=0,
+                    coll="BINARY",
+                    key=1,
+                ),
+                XIndexColumn(
+                    seqno=1,
+                    cid=1,
+                    name="ordinary",
+                    desc=0,
+                    coll="BINARY",
+                    key=1,
+                ),
+                XIndexColumn(
+                    seqno=2,
+                    cid=-1,
+                    name=None,
+                    desc=0,
+                    coll="BINARY",
+                    key=0,
+                ),
+            ],
+        )
+    ]
+
