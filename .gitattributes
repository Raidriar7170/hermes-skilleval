# Preserve source excerpts and generated evidence byte-for-byte (including CRLF).
configs/repo-portability/confirmation-v1/*-public.md whitespace=-trailing-space,-blank-at-eof
artifacts/repo-portability/** whitespace=-trailing-space,-blank-at-eof
docs/repo-portability/licenses/* whitespace=-trailing-space,-blank-at-eof
# Raw assist patches and JUnit failure excerpts retain their original whitespace.
artifacts/product-closeout/*/candidate.patch whitespace=-trailing-space,-blank-at-eof
artifacts/product-closeout/*/*-junit.xml whitespace=-trailing-space,-blank-at-eof
# Preserve original whitespace in this study's immutable JUnit/patch evidence.
artifacts/repo-aware-routing/**/*.xml whitespace=-trailing-space,-blank-at-eof
artifacts/repo-aware-routing/**/*.patch whitespace=-trailing-space,-blank-at-eof
# Repair study patch context lines are immutable captured evidence.
artifacts/repo-aware-routing-r-repair-v1/**/*.patch whitespace=-trailing-space,-blank-at-eof
# Frozen skill source excerpts retain upstream RST headings and whitespace.
# Seven '=' characters below are RST section adornments, not merge conflicts.
configs/conditional-applicability-v1/skills/*/LICENSE conflict-marker-size=32
configs/conditional-applicability-v1/skills/*/COPYING whitespace=-trailing-space
configs/conditional-applicability-v1/skills/csv-dialect/SKILL.md whitespace=-blank-at-eof
configs/conditional-applicability-v1/skills/csv-relational-join/SKILL.md whitespace=-blank-at-eof conflict-marker-size=32
