# Preserve source excerpts and generated evidence byte-for-byte (including CRLF).
configs/repo-portability/confirmation-v1/*-public.md whitespace=-trailing-space,-blank-at-eof
artifacts/repo-portability/** whitespace=-trailing-space,-blank-at-eof
docs/repo-portability/licenses/* whitespace=-trailing-space,-blank-at-eof
# Raw assist patches and JUnit failure excerpts retain their original whitespace.
artifacts/product-closeout/*/candidate.patch whitespace=-trailing-space,-blank-at-eof
artifacts/product-closeout/*/*-junit.xml whitespace=-trailing-space,-blank-at-eof
