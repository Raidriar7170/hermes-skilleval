{
  "version": "assist-repository-v1",
  "profile": {
    "repository": "wireservice/csvkit",
    "packages": {
      "csvkit": "."
    },
    "cli_module": "csvkit.utilities.in2csv",
    "cli_callable": "launch_new_instance",
    "cli_name": "in2csv",
    "image": "hermes-repo-aware-data:v1",
    "writable_roots": [
      "csvkit",
      "tests"
    ],
    "file_policy": {
      "version": "operations-v1",
      "rules": [
        {
          "path": "csvkit",
          "operations": [
            "add",
            "modify",
            "delete"
          ]
        },
        {
          "path": "tests",
          "operations": [
            "add",
            "modify"
          ]
        },
        {
          "path": "examples",
          "operations": [
            "add"
          ],
          "data_only": true,
          "max_bytes": 100000
        }
      ]
    }
  },
  "exclude_input": []
}
